  218|  40.2M|  $($s)* fn half_kernel(
  219|  40.2M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  40.2M|  ) -> (T, T) {
  221|  40.2M|    let t = Self::ADD(p1, p0.0);
  222|  40.2M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
