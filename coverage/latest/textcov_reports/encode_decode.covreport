  178|  7.17M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  7.17M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  7.17M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  7.17M|) -> Distortion {
  182|  7.17M|  // See get_weighted_sse in src/dist.rs.
  183|  7.17M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  7.17M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  7.17M|
  186|  7.17M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  7.17M|  // importance block size in a non-subsampled plane.
  188|  7.17M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  7.17M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  7.17M|
  191|  7.17M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  7.17M|
  193|  7.17M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  7.17M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  7.17M|
  196|  7.17M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  7.17M|  // passed directly. To do this, we would need different versions of the
  198|  7.17M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  7.17M|  // eliminating use of unbiased sse.
  200|  7.17M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  7.17M|
  202|  7.17M|  // Copy biases into a buffer.
  203|  7.17M|  let mut buf_storage = Aligned::new(
  204|  7.17M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  7.17M|  );
  206|  7.17M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  7.17M|  let buf = init_slice_repeat_mut(
  208|  7.17M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  7.17M|    0,
  210|  7.17M|  );
  211|       |
  212|  10.6M|  for block_y in 0..n_imp_blocks_h {
  213|  22.1M|    for block_x in 0..n_imp_blocks_w {
  214|  22.1M|      let block = Area::StartingAt {
  215|  22.1M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  22.1M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  22.1M|      };
  218|  22.1M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  22.1M|    }
  220|       |  }
  221|       |
  222|  7.17M|  Distortion(get_weighted_sse(
  223|  7.17M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  7.17M|  ))
  225|  7.17M|}
