   41|    272|      let mut min_segment = MAX_SEGMENTS;
   42|    272|      for i in 0..MAX_SEGMENTS {
   43|    272|        if fs.segmentation.features[i][SegLvl::SEG_LVL_ALT_Q as usize]
   44|    272|          && fs.segmentation.data[i][SegLvl::SEG_LVL_ALT_Q as usize]
   45|    272|            >= offset_lower_limit
   46|       |        {
   47|    272|          min_segment = i;
   48|    272|          break;
   49|      0|        }
   50|       |      }
   51|    272|      assert_ne!(min_segment, MAX_SEGMENTS);
   52|    272|      fs.segmentation.min_segment = min_segment as u8;
   53|    272|      fs.segmentation.update_threshold(fi.base_q_idx, fi.config.bit_depth);
   54|    272|      return;
