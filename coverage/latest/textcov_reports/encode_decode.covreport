_RNvMs2_NtCs3tIhnEwGhQF_5rav1e4rateNtB5_19QuantizerParameters14new_from_log_q:
  525|  1.37k|  fn new_from_log_q(
  526|  1.37k|    log_base_q: i64, log_target_q: i64, bit_depth: usize,
  527|  1.37k|    chroma_sampling: ChromaSampling, is_intra: bool,
  528|  1.37k|    log_isqrt_mean_scale: i64,
  529|  1.37k|  ) -> QuantizerParameters {
  530|  1.37k|    let scale = log_isqrt_mean_scale + q57(QSCALE + bit_depth as i32 - 8);
