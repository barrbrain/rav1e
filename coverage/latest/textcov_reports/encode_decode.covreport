_RINvNtNtCsgzd1EjkjF4V_5rav1e4dist4rust16cdef_dist_kernelhEB6_:
  296|  50.9k|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  50.9k|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  50.9k|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  50.9k|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  50.9k|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  50.9k|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  50.9k|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  50.9k|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  50.9k|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|   309k|    for j in 0..h {
  319|   309k|      let row1 = &src[j][0..w];
  320|   309k|      let row2 = &dst[j][0..w];
  321|  1.22M|      for (s, d) in row1.iter().zip(row2) {
  322|  1.22M|        let s: u32 = u32::cast_from(*s);
  323|  1.22M|        let d: u32 = u32::cast_from(*d);
  324|  1.22M|        sum_s += s;
  325|  1.22M|        sum_d += d;
  326|  1.22M|
  327|  1.22M|        sum_s2 += s * s;
  328|  1.22M|        sum_d2 += d * d;
  329|  1.22M|        sum_sd += s * d;
  330|  1.22M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  50.9k|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  50.9k|
  337|  50.9k|    // Convert to 64-bits to avoid overflow when squaring
  338|  50.9k|    let sum_s = sum_s as u64;
  339|  50.9k|    let sum_d = sum_d as u64;
  340|  50.9k|
  341|  50.9k|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  50.9k|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  50.9k|    //    (n = # samples i.e. area)
  344|  50.9k|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  50.9k|    // When w and h are powers of two, this can be done via shifting.
  346|  50.9k|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  50.9k|    let div_shift = AREA_DIVISOR_BITS;
  348|  50.9k|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  50.9k|    // two. Saturate to avoid underflow.
  350|  50.9k|    let mut svar = sum_s2.saturating_sub(
  351|  50.9k|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  50.9k|    );
  353|  50.9k|    let mut dvar = sum_d2.saturating_sub(
  354|  50.9k|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  50.9k|    );
  356|  50.9k|
  357|  50.9k|    // Scale variances up to 8x8 size.
  358|  50.9k|    //   scaled variance = var * (8x8) / wxh
  359|  50.9k|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  50.9k|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  50.9k|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  50.9k|    svar =
  363|  50.9k|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  50.9k|    dvar =
  365|  50.9k|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  50.9k|
  367|  50.9k|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  50.9k|  }
_RINvNtNtCsgzd1EjkjF4V_5rav1e4dist4rust16get_weighted_ssehEB6_:
  237|  61.9k|  pub fn get_weighted_sse<T: Pixel>(
  238|  61.9k|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|  61.9k|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|  61.9k|    _cpu: CpuFeatureLevel,
  241|  61.9k|  ) -> u64 {
  242|  61.9k|    // Always chunk and apply scaling on the sse of squares the size of
  243|  61.9k|    // decimated/sub-sampled importance block sizes.
  244|  61.9k|    // Warning: Changing this will require changing/disabling assembly.
  245|  61.9k|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|  61.9k|
  247|  61.9k|    let mut sse: u64 = 0;
  248|       |
  249|   135k|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|   417k|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|   417k|        let mut block_sse: u32 = 0;
  252|       |
  253|  1.54M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|  1.54M|          let s1 = &src1[block_y * chunk_size + j]
  255|  1.54M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|  1.54M|          let s2 = &src2[block_y * chunk_size + j]
  257|  1.54M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|  1.54M|
  259|  1.54M|          block_sse += s1
  260|  1.54M|            .iter()
  261|  1.54M|            .zip(s2)
  262|  1.54M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|  1.54M|            })
  266|  1.54M|            .sum::<u32>();
  267|  1.54M|        }
  268|       |
  269|   417k|        sse += (block_sse as u64
  270|   417k|          * scale[block_y * scale_stride + block_x] as u64
  271|   417k|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|   417k|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|  61.9k|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|  61.9k|    (sse + (den >> 1)) / den
  277|  61.9k|  }
