  784|  10.2M|  // Stage 0
  785|  10.2M|  // 24279/32768 = (Sin[31*Pi/64] + Cos[31*Pi/64])/Sqrt[2] = 0.74095112535496
  786|  10.2M|  //  11003/8192 = (Sin[31*Pi/64] - Cos[31*Pi/64])*Sqrt[2] = 1.34311790969404
  787|  10.2M|  //  1137/16384 = Cos[31*Pi/64]*Sqrt[2]                   = 0.06939217050794
  788|  10.2M|  let (s0, sf) =
  789|  10.2M|    RotateAddShift::kernel(s0, sf, ((24279, 15), (11003, 13), (1137, 14)));
  790|  10.2M|  // 1645/2048 = (Sin[29*Pi/64] + Cos[29*Pi/64])/Sqrt[2] = 0.8032075314806449
  791|  10.2M|  //   305/256 = (Sin[29*Pi/64] - Cos[29*Pi/64])*Sqrt[2] = 1.1913986089848667
  792|  10.2M|  //  425/2048 = Cos[29*Pi/64]*Sqrt[2]                   = 0.2075082269882116
  793|  10.2M|  let (se, s1) =
  794|  10.2M|    RotateSubShift::kernel(se, s1, ((1645, 11), (305, 8), (425, 11)));
  795|  10.2M|  // 14053/32768 = (Sin[27*Pi/64] + Cos[27*Pi/64])/Sqrt[2] = 0.85772861000027
  796|  10.2M|  //   8423/8192 = (Sin[27*Pi/64] - Cos[27*Pi/64])*Sqrt[2] = 1.02820548838644
  797|  10.2M|  //   2815/8192 = Cos[27*Pi/64]*Sqrt[2]                   = 0.34362586580705
  798|  10.2M|  let (s2, sd) =
  799|  10.2M|    RotateAddShift::kernel(s2, sd, ((14053, 14), (8423, 13), (2815, 13)));
  800|  10.2M|  // 14811/16384 = (Sin[25*Pi/64] + Cos[25*Pi/64])/Sqrt[2] = 0.90398929312344
  801|  10.2M|  //   7005/8192 = (Sin[25*Pi/64] - Cos[25*Pi/64])*Sqrt[2] = 0.85511018686056
  802|  10.2M|  //   3903/8192 = Cos[25*Pi/64]*Sqrt[2]                   = 0.47643419969316
  803|  10.2M|  let (sc, s3) =
