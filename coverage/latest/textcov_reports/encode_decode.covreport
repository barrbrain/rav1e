  115|  76.6M|  /*t is x in the range [0.25, 1) in QINSHIFT, or x*2^(-s).
  116|  76.6M|  Shift by log2(x) - log2(0.25*(1 << INSHIFT)) to ensure 0.25 lower bound.*/
  117|  76.6M|  let s: i16 = 2 * k - (INSHIFT as i16 - 2);
  118|  76.6M|  let t: u16 = if s > 0 { x >> s } else { x << -s } as u16;
  119|       |
  120|       |  /*We want to express od_rsqrt() in terms of od_rsqrt_norm(), which is
  121|       |   defined as (2^OUTSHIFT)/sqrt(t*(2^-INSHIFT)) with t=x*(2^-s).
  122|       |  This simplifies to 2^(OUTSHIFT+(INSHIFT/2)+(s/2))/sqrt(x), so the caller
  123|       |   needs to shift right by OUTSHIFT + INSHIFT/2 + s/2.*/
