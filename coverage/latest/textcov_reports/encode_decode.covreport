  218|  71.2M|  $($s)* fn half_kernel(
  219|  71.2M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  71.2M|  ) -> (T, T) {
  221|  71.2M|    let t = Self::ADD(p1, p0.0);
  222|  71.2M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  71.2M|    let out0 = b.add(c);
  224|  71.2M|    let shifted = Self::SHIFT(c);
  225|  71.2M|    let out1 = Self::SUB(a, shifted);
  226|  71.2M|    (out0, out1)
  227|  71.2M|  }
