 1506|       |          // stripe x pixel locations must be clipped to frame, last may need to stretch
 1507|  8.31k|          let x = rux * rp.cfg.unit_size;
 1508|  8.31k|          let size =
 1509|  8.31k|            if rux == rp.cfg.cols - 1 { crop_w - x } else { rp.cfg.unit_size };
