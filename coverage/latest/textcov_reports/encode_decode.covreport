 1104|  3.40M|$($s)* fn daala_fdct_ii_32<T: TxOperations>(
 1105|  3.40M|  t0: T, t1: T, t2: T, t3: T, t4: T, t5: T, t6: T, t7: T, t8: T, t9: T, ta: T,
