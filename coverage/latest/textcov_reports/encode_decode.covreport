 1358|   266k|    for x in (1 << xdec..cols).step_by(1 << xdec) {
 1359|   266k|      filter_v_edge(
 1360|   266k|        deblock,
 1361|   266k|        blocks,
 1362|   266k|        TileBlockOffset(BlockOffset { x, y: 0 }),
 1363|   266k|        p,
 1364|   266k|        pli,
 1365|   266k|        bd,
 1366|   266k|        xdec,
 1367|   266k|        ydec,
 1368|   266k|      );
 1369|   266k|    }
 1370|  14.5k|    if rows > 1 << ydec {
 1371|   265k|      for x in (1 << xdec..cols).step_by(1 << xdec) {
 1372|   265k|        filter_v_edge(
 1373|   265k|          deblock,
 1374|   265k|          blocks,
 1375|   265k|          TileBlockOffset(BlockOffset { x, y: 1 << ydec }),
 1376|   265k|          p,
 1377|   265k|          pli,
 1378|   265k|          bd,
 1379|   265k|          xdec,
 1380|   265k|          ydec,
 1381|   265k|        );
 1382|   265k|      }
 1383|     32|    }
 1384|      0|  }
 1385|       |
 1386|       |  // filter rows where vertical and horizontal edge filtering both
