   90|   146M|unsafe fn dequantize_avx2(
   91|   146M|  qindex: u8, coeffs_ptr: *const i16, _eob: usize, rcoeffs_ptr: *mut i16,
   92|   146M|  tx_size: TxSize, bit_depth: usize, dc_delta_q: i8, ac_delta_q: i8,
   93|   146M|) {
   94|   146M|  let log_tx_scale = _mm256_set1_epi32(get_log_tx_scale(tx_size) as i32);
   95|   146M|
