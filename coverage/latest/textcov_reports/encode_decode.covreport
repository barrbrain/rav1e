 2112|     38|    MAX_PLANES
 2113|       |  };
 2114|     38|  assert!(fi.sequence.enable_cdef || fi.sequence.enable_restoration);
 2115|       |  // Determine area of optimization: Which plane has the largest LRUs?
 2116|       |  // How many LRUs for each?
 2117|     38|  let mut sb_w = 1; // how many superblocks wide the largest LRU
 2118|     38|                    // is/how many SBs we're processing (same thing)
