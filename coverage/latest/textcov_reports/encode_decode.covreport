_RNvNtCs5T1csxkeGwJ_5rav1e2me12get_mv_range:
  338|   341k|fn get_mv_range(
  339|   341k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   341k|  blk_h: usize,
  341|   341k|) -> (isize, isize, isize, isize) {
  342|   341k|  let border_w = 128 + blk_w as isize * 8;
  343|   341k|  let border_h = 128 + blk_h as isize * 8;
  344|   341k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   341k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   341k|    * (8 * MI_SIZE) as isize
  347|   341k|    + border_w;
  348|   341k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   341k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   341k|    * (8 * MI_SIZE) as isize
  351|   341k|    + border_h;
  352|   341k|
  353|   341k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   341k|  use crate::context::{MV_LOW, MV_UPP};
  355|   341k|  (
  356|   341k|    mvx_min.max(MV_LOW as isize + 1),
  357|   341k|    mvx_max.min(MV_UPP as isize - 1),
  358|   341k|    mvy_min.max(MV_LOW as isize + 1),
  359|   341k|    mvy_max.min(MV_UPP as isize - 1),
  360|   341k|  )
  361|   341k|}
