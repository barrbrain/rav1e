  694|  12.9k|    } else if nhev4(p1, p0, q0, q1, bd - 8) <= level {
  695|  1.74k|      filter_narrow4_6(p2, p1, p0, q0, q1, q2, bd - 8)
  696|       |    } else {
  697|  11.1k|      filter_narrow2_6(p2, p1, p0, q0, q1, q2, bd - 8)
  698|       |    };
  699|  16.1k|    Some(x)
  700|       |  } else {
  701|   179k|    None
  702|       |  }
