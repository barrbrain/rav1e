  180|  15.7M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  15.7M|) -> Distortion {
  182|  15.7M|  // See get_weighted_sse in src/dist.rs.
  183|  15.7M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  15.7M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  15.7M|
  186|  15.7M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  15.7M|  // importance block size in a non-subsampled plane.
  188|  15.7M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  15.7M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  15.7M|
