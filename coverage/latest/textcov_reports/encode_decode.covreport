 1504|  44.2M|fn get_mv_rate(
 1505|  44.2M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  44.2M|) -> u32 {
 1507|  44.2M|  #[inline(always)]
 1508|  44.2M|  fn diff_to_rate(diff: i16, allow_high_precision_mv: bool) -> u32 {
 1509|  44.2M|    let d = if allow_high_precision_mv { diff } else { diff >> 1 };
 1510|  44.2M|    2 * ILog::ilog(d.abs()) as u32
 1511|  44.2M|  }
 1512|  44.2M|
 1513|  44.2M|  diff_to_rate(a.row - b.row, allow_high_precision_mv)
 1514|  44.2M|    + diff_to_rate(a.col - b.col, allow_high_precision_mv)
 1515|  44.2M|}
