  369|      0|        return (true, score);
  370|     44|      }
  371|     44|
  372|     44|      // Check for scenecut before flash
  373|     44|      // If distance longer than max flash length
  374|     44|      if back_over_tr_count == 0
  375|      0|        && forward_over_tr_count == 1
  376|      0|        && forward_deque[0].forward_adjusted_cost >= forward_deque[0].threshold
  377|       |      {
  378|      0|        return (true, score);
  379|     44|      }
  380|     44|
  381|     44|      if back_over_tr_count != 0 || forward_over_tr_count != 0 {
  382|     44|        return (false, score);
  383|      0|      }
  384|     60|    }
  385|       |
  386|     60|    (cost >= score.threshold, score)
