  178|  3.80M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  3.80M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  3.80M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  3.80M|) -> Distortion {
  182|  3.80M|  // See get_weighted_sse in src/dist.rs.
  183|  3.80M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  3.80M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  3.80M|
  186|  3.80M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  3.80M|  // importance block size in a non-subsampled plane.
  188|  3.80M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  3.80M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  3.80M|
  191|  3.80M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  3.80M|
  193|  3.80M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  3.80M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  3.80M|
  196|  3.80M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  3.80M|  // passed directly. To do this, we would need different versions of the
  198|  3.80M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  3.80M|  // eliminating use of unbiased sse.
  200|  3.80M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  3.80M|
  202|  3.80M|  // Copy biases into a buffer.
  203|  3.80M|  let mut buf_storage = Aligned::new(
  204|  3.80M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  3.80M|  );
  206|  3.80M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  3.80M|  let buf = init_slice_repeat_mut(
  208|  3.80M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  3.80M|    0,
  210|  3.80M|  );
  211|       |
  212|  6.17M|  for block_y in 0..n_imp_blocks_h {
  213|  10.1M|    for block_x in 0..n_imp_blocks_w {
  214|  10.1M|      let block = Area::StartingAt {
  215|  10.1M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  10.1M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  10.1M|      };
  218|  10.1M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  10.1M|    }
  220|       |  }
  221|       |
  222|  3.80M|  Distortion(get_weighted_sse(
