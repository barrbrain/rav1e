  218|  65.8M|  $($s)* fn half_kernel(
  219|  65.8M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  65.8M|  ) -> (T, T) {
  221|  65.8M|    let t = Self::ADD(p1, p0.0);
  222|  65.8M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  65.8M|    let out0 = b.add(c);
  224|  65.8M|    let shifted = Self::SHIFT(c);
  225|  65.8M|    let out1 = Self::SUB(a, shifted);
  226|  65.8M|    (out0, out1)
  227|  65.8M|  }
