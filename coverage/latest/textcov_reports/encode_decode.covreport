 1487|    108|  let ydec = rec.plane_cfg.ydec;
 1488|    108|  assert!(xdec <= 1 && ydec <= 1);
 1489|    108|  let rect = rec.rect();
 1490|    108|  let cols = (cmp::min(
 1491|    108|    blocks.cols(),
 1492|    108|    (crop_w - rect.x as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1493|    108|  ) + (1 << xdec >> 1))
 1494|    108|    >> xdec
 1495|    108|    << xdec; // Clippy can go suck an egg
 1496|    108|  let rows = (cmp::min(
 1497|    108|    blocks.rows(),
 1498|    108|    (crop_h - rect.y as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1499|    108|  ) + (1 << ydec >> 1))
 1500|    108|    >> ydec
 1501|    108|    << ydec; // Clippy can go suck an egg
 1502|       |
 1503|       |  // No horizontal edge filtering along top of frame
 1504|  1.83k|  for x in (1 << xdec..cols).step_by(1 << xdec) {
 1505|  1.83k|    sse_v_edge(
 1506|  1.83k|      blocks,
 1507|  1.83k|      TileBlockOffset(BlockOffset { x, y: 0 }),
 1508|  1.83k|      rec,
 1509|  1.83k|      src,
 1510|  1.83k|      v_sse,
 1511|  1.83k|      pli,
 1512|  1.83k|      bd,
 1513|  1.83k|      xdec,
 1514|  1.83k|      ydec,
 1515|  1.83k|    );
 1516|  1.83k|  }
 1517|       |
