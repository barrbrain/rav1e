  174|     36|  }
_RNvNtCsgzd1EjkjF4V_5rav1e4rate13chroma_offset:
  509|     30|fn chroma_offset(
  510|     30|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|     30|) -> (i64, i64) {
  512|     30|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|     30|  let y = match chroma_sampling {
  515|      3|    ChromaSampling::Cs400 => 0,
  516|     10|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|      9|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|      8|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|     30|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|     30|}
_RNvNtCsgzd1EjkjF4V_5rav1e4rate26iir_bessel2_get_parameters:
  140|     36|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|     36|  // This borrows some code from an unreleased version of Postfish.
  142|     36|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|     36|  //  on deriving the filter coefficients.
  144|     36|  // alpha is Q24
  145|     36|  let alpha = (1 << 24) / delay;
  146|     36|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|     36|  let warp = warp_alpha(alpha).max(1) as i64;
  148|     36|  // k1 is 9.12 (6.12?)
  149|     36|  let k1 = 3 * warp;
  150|     36|  // k2 is 16.24 (11.24?)
  151|     36|  let k2 = k1 * warp;
  152|     36|  // d is 16.15 (10.15?)
  153|     36|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|     36|  // a is 0.32, since d is larger than both 1.0 and k2
  155|     36|  let a = (k2 << 23) / d;
  156|     36|  // ik2 is 25.24
  157|     36|  let ik2 = (1i64 << 48) / k2;
  158|     36|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|     36|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|     36|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|     36|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|     36|  // All of the filter parameters are Q24.
  163|     36|  (
  164|     36|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|     36|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|     36|    ((a + 128) >> 8) as i32,
  167|     36|  )
  168|     36|}
_RNvMs3_NtCsgzd1EjkjF4V_5rav1e4rateNtB5_7RCState3new:
  597|      9|  pub fn new(
  598|      9|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|      9|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|      9|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|      9|    maybe_reservoir_frame_delay: Option<i32>,
  602|      9|  ) -> RCState {
  603|      9|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|      9|    //  frames; whichever is smaller, with a minimum of 12.
  605|      9|    // For user set values, we enforce a minimum of 12.
  606|      9|    // The interval is short enough to allow reaction, but long enough to allow
  607|      9|    //  looking into the next GOP (avoiding the case where the last frames
  608|      9|    //  before an I-frame get starved), in most cases.
  609|      9|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|      9|    //  errors in the worst case.
  611|      9|    let reservoir_frame_delay = maybe_reservoir_frame_delay
  612|      9|      .unwrap_or_else(|| ((max_key_frame_interval * 3) >> 1).min(240))
  613|      9|      .max(12);
  614|      9|    // TODO: What are the limits on these?
  615|      9|    let npixels = (frame_width as i64) * (frame_height as i64);
  616|      9|    // Insane framerates or frame sizes mean insane bitrates.
  617|      9|    // Let's not get carried away.
  618|      9|    // We also subtract 16 bits from each temporal unit to account for the
  619|      9|    //  temporal delimiter, whose bits are not included in the frame sizes
  620|      9|    //  reported to update_state().
  621|      9|    // TODO: Support constraints imposed by levels.
  622|      9|    let bits_per_tu = clamp(
  623|      9|      (target_bitrate as i64) * framerate_den / framerate_num,
  624|      9|      40,
  625|      9|      0x4000_0000_0000,
  626|      9|    ) - (TEMPORAL_DELIMITER.len() * 8) as i64;
  627|      9|    let reservoir_max = bits_per_tu * (reservoir_frame_delay as i64);
  628|      9|    // Start with a buffer fullness and fullness target of 50%.
  629|      9|    let reservoir_target = (reservoir_max + 1) >> 1;
  630|      9|    // Pick exponents and initial scales for quantizer selection.
  631|      9|    let ibpp = npixels / bits_per_tu;
  632|       |    // These have been derived by encoding many clips at every quantizer
  633|       |    // and running a piecewise-linear regression in binary log space.
  634|      9|    let (i_exp, i_log_scale) = if ibpp < 1 {
  635|      2|      (48u8, blog64(36) - q57(QSCALE))
  636|      7|    } else if ibpp < 4 {
  637|      0|      (61u8, blog64(55) - q57(QSCALE))
  638|       |    } else {
  639|      7|      (77u8, blog64(129) - q57(QSCALE))
  640|       |    };
  641|      9|    let (p_exp, p_log_scale) = if ibpp < 2 {
  642|      2|      (69u8, blog64(32) - q57(QSCALE))
  643|      7|    } else if ibpp < 139 {
  644|      5|      (104u8, blog64(84) - q57(QSCALE))
  645|       |    } else {
  646|      2|      (83u8, blog64(19) - q57(QSCALE))
  647|       |    };
  648|      9|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
  649|      2|      (84u8, blog64(30) - q57(QSCALE))
  650|      7|    } else if ibpp < 92 {
  651|      5|      (120u8, blog64(68) - q57(QSCALE))
  652|       |    } else {
  653|      2|      (68u8, blog64(4) - q57(QSCALE))
  654|       |    };
  655|      9|    let (b1_exp, b1_log_scale) = if ibpp < 2 {
  656|      2|      (87u8, blog64(27) - q57(QSCALE))
  657|      7|    } else if ibpp < 126 {
  658|      5|      (139u8, blog64(84) - q57(QSCALE))
  659|       |    } else {
  660|      2|      (61u8, blog64(1) - q57(QSCALE))
  661|       |    };
  662|       |
  663|       |    // TODO: Add support for "golden" P frames.
  664|      9|    RCState {
  665|      9|      target_bitrate,
  666|      9|      reservoir_frame_delay,
  667|      9|      reservoir_frame_delay_is_set: maybe_reservoir_frame_delay.is_some(),
  668|      9|      maybe_ac_qi_max,
  669|      9|      ac_qi_min,
  670|      9|      drop_frames: false,
  671|      9|      cap_overflow: true,
  672|      9|      cap_underflow: false,
  673|      9|      pass1_log_base_q: 0,
  674|      9|      twopass_state: PASS_SINGLE,
  675|      9|      log_npixels: blog64(npixels),
  676|      9|      bits_per_tu,
  677|      9|      reservoir_fullness: reservoir_target,
  678|      9|      reservoir_target,
  679|      9|      reservoir_max,
  680|      9|      log_scale: [i_log_scale, p_log_scale, b0_log_scale, b1_log_scale],
  681|      9|      exp: [i_exp, p_exp, b0_exp, b1_exp],
  682|      9|      scalefilter: [
  683|      9|        IIRBessel2::new(4, q57_to_q24(i_log_scale)),
  684|      9|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(p_log_scale)),
  685|      9|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b0_log_scale)),
  686|      9|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b1_log_scale)),
  687|      9|      ],
  688|      9|      // TODO VFR
  689|      9|      nframes: [0; FRAME_NSUBTYPES + 1],
  690|      9|      inter_delay: [INTER_DELAY_TARGET_MIN; FRAME_NSUBTYPES - 1],
  691|      9|      inter_delay_target: reservoir_frame_delay >> 1,
  692|      9|      rate_bias: 0,
  693|      9|      nencoded_frames: 0,
  694|      9|      nsef_frames: 0,
  695|      9|      pass1_buffer: [0; TWOPASS_HEADER_SZ],
  696|      9|      pass1_data_retrieved: true,
  697|      9|      pass1_summary_retrieved: false,
  698|      9|      pass2_data_ready: false,
  699|      9|      prev_metrics: RCFrameMetrics::new(),
  700|      9|      cur_metrics: RCFrameMetrics::new(),
  701|      9|      frame_metrics: Vec::new(),
  702|      9|      nframe_metrics: 0,
  703|      9|      frame_metrics_head: 0,
  704|      9|      ntus: 0,
  705|      9|      ntus_total: 0,
  706|      9|      ntus_left: 0,
  707|      9|      nframes_total: [0; FRAME_NSUBTYPES + 1],
  708|      9|      nframes_total_total: 0,
  709|      9|      nframes_left: [0; FRAME_NSUBTYPES + 1],
  710|      9|      scale_sum: [0; FRAME_NSUBTYPES],
  711|      9|      scale_window_ntus: 0,
  712|      9|      scale_window_nframes: [0; FRAME_NSUBTYPES + 1],
  713|      9|      scale_window_sum: [0; FRAME_NSUBTYPES],
  714|      9|      des: RCDeserialize::default(),
  715|      9|    }
  716|      9|  }
_RNvMs3_NtCsgzd1EjkjF4V_5rav1e4rateNtB5_7RCState18needs_trial_encode:
 1246|     19|  pub const fn needs_trial_encode(&self, fti: usize) -> bool {
