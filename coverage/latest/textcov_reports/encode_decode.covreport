  773|  6.61k|pub(crate) const fn pos_to_lvl(pos: u64, pyramid_depth: u64) -> u64 {
  774|  6.61k|  // Derive level within pyramid for a frame with a given coding order position
  775|  6.61k|  // For example, with a pyramid of depth 2, the 2 least significant bits of the
  776|  6.61k|  // position determine the level:
  777|  6.61k|  // 00 -> 0
  778|  6.61k|  // 01 -> 2
  779|  6.61k|  // 10 -> 1
  780|  6.61k|  // 11 -> 2
  781|  6.61k|  pyramid_depth - (pos | (1 << pyramid_depth)).trailing_zeros() as u64
  782|  6.61k|}
