 1304|    272|fn subpel_diamond_search<T: Pixel>(
 1305|    272|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|    272|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|    272|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|    272|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|    272|  ref_frame: RefType,
 1310|    272|) {
 1311|    272|  use crate::util::Aligned;
 1312|    272|
 1313|    272|  // Motion compensation assembly has special requirements for edges
 1314|    272|  let mc_w = w.next_power_of_two();
 1315|    272|  let mc_h = (h + 1) & !1;
 1316|    272|
 1317|    272|  // Metadata for subpel scratch pad.
 1318|    272|  let cfg = PlaneConfig::new(mc_w, mc_h, 0, 0, 0, 0, std::mem::size_of::<T>());
 1319|    272|  // Stack allocation for subpel scratch pad.
 1320|    272|  // SAFETY: We write to the array below before reading from it.
 1321|    272|  let mut buf: Aligned<[T; 128 * 128]> = unsafe { Aligned::uninitialized() };
 1322|    272|  let mut tmp_region = PlaneRegionMut::from_slice(
 1323|    272|    &mut buf.data,
 1324|    272|    &cfg,
 1325|    272|    Rect { x: 0, y: 0, width: cfg.width, height: cfg.height },
 1326|    272|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|    272|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|    272|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|  1.14k|  loop {
 1333|  1.14k|    // Find the best candidate from the diamond pattern.
 1334|  1.14k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  5.73k|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  4.58k|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  4.58k|
 1338|  4.58k|      let rd = get_subpel_mv_rd(
 1339|  4.58k|        fi,
 1340|  4.58k|        po,
 1341|  4.58k|        org_region,
 1342|  4.58k|        bit_depth,
 1343|  4.58k|        pmv,
 1344|  4.58k|        lambda,
 1345|  4.58k|        use_satd,
 1346|  4.58k|        mvx_min,
 1347|  4.58k|        mvx_max,
 1348|  4.58k|        mvy_min,
 1349|  4.58k|        mvy_max,
 1350|  4.58k|        w,
 1351|  4.58k|        h,
 1352|  4.58k|        cand_mv,
 1353|  4.58k|        &mut tmp_region,
 1354|  4.58k|        ref_frame,
 1355|  4.58k|      );
 1356|  4.58k|
 1357|  4.58k|      if rd.cost < best_cand.rd.cost {
 1358|  2.32k|        best_cand.mv = cand_mv;
 1359|  2.32k|        best_cand.rd = rd;
 1360|  2.32k|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|  1.14k|    if current.rd.cost <= best_cand.rd.cost {
 1365|    544|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|    272|        break;
 1367|    272|      } else {
 1368|    272|        diamond_radius_log2 -= 1;
 1369|    272|      }
 1370|    603|    } else {
 1371|    603|      *current = best_cand;
 1372|    603|    }
 1373|       |  }
 1374|       |
 1375|    272|  assert!(!current.is_empty());
 1376|    272|}
_RINvNtCsgzd1EjkjF4V_5rav1e2me20estimate_tile_motionhEB4_:
  152|      5|pub fn estimate_tile_motion<T: Pixel>(
  153|      5|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>,
  154|      5|  inter_cfg: &InterConfig,
  155|      5|) {
  156|      5|  let init_size = MIB_SIZE_LOG2;
  157|      5|
  158|      5|  let mut prev_ssdec: Option<u8> = None;
  159|     15|  for mv_size_in_b_log2 in (2..=init_size).rev() {
  160|     15|    let init = mv_size_in_b_log2 == init_size;
  161|       |
