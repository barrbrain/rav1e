   35|   974k|  static DC_Q: [&[i16; 256]; 3] =
   36|   974k|    [&dc_qlookup_Q3, &dc_qlookup_10_Q3, &dc_qlookup_12_Q3];
   37|   974k|  let bd = ((bit_depth ^ 8) >> 1).min(2);
