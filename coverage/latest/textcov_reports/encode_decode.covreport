  192|  18.3M|
  193|  18.3M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  18.3M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  18.3M|
  196|  18.3M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  18.3M|  // passed directly. To do this, we would need different versions of the
  198|  18.3M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  18.3M|  // eliminating use of unbiased sse.
  200|  18.3M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  18.3M|
  202|  18.3M|  // Copy biases into a buffer.
  203|  18.3M|  let mut buf_storage = Aligned::new(
