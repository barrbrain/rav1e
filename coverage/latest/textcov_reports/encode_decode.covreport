 1480|  13.9k|fn sse_plane<T: Pixel>(
 1481|  13.9k|  rec: &PlaneRegion<T>, src: &PlaneRegion<T>,
 1482|  13.9k|  v_sse: &mut [i64; MAX_LOOP_FILTER + 2],
 1483|  13.9k|  h_sse: &mut [i64; MAX_LOOP_FILTER + 2], pli: usize, blocks: &TileBlocks,
 1484|  13.9k|  crop_w: usize, crop_h: usize, bd: usize,
 1485|  13.9k|) {
 1486|  13.9k|  let xdec = rec.plane_cfg.xdec;
 1487|  13.9k|  let ydec = rec.plane_cfg.ydec;
 1488|  13.9k|  assert!(xdec <= 1 && ydec <= 1);
 1489|  13.9k|  let rect = rec.rect();
 1490|  13.9k|  let cols = (cmp::min(
 1491|  13.9k|    blocks.cols(),
 1492|  13.9k|    (crop_w - rect.x as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1493|  13.9k|  ) + (1 << xdec >> 1))
 1494|  13.9k|    >> xdec
 1495|  13.9k|    << xdec; // Clippy can go suck an egg
 1496|  13.9k|  let rows = (cmp::min(
 1497|  13.9k|    blocks.rows(),
 1498|  13.9k|    (crop_h - rect.y as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1499|  13.9k|  ) + (1 << ydec >> 1))
 1500|  13.9k|    >> ydec
 1501|  13.9k|    << ydec; // Clippy can go suck an egg
 1502|       |
 1503|       |  // No horizontal edge filtering along top of frame
 1504|   231k|  for x in (1 << xdec..cols).step_by(1 << xdec) {
 1505|   231k|    sse_v_edge(
 1506|   231k|      blocks,
 1507|   231k|      TileBlockOffset(BlockOffset { x, y: 0 }),
 1508|   231k|      rec,
 1509|   231k|      src,
 1510|   231k|      v_sse,
 1511|   231k|      pli,
 1512|   231k|      bd,
 1513|   231k|      xdec,
 1514|   231k|      ydec,
 1515|   231k|    );
 1516|   231k|  }
