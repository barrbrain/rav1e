  366|   530k|$($s)* fn daala_fdct_ii_4<T: TxOperations>(
  367|   530k|  q0: T, q1: T, q2: T, q3: T, output: &mut [T],
  368|   530k|) {
  369|   530k|  // +/- Butterflies with asymmetric output.
  370|   530k|  let (q0h, q3) = butterfly_neg(q0, q3);
