  195|  58.9M|  pub fn update(
  196|  58.9M|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|  58.9M|    dc_delta_q: i8, ac_delta_q: i8,
  198|  58.9M|  ) {
  199|  58.9M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|  58.9M|
  201|  58.9M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|  58.9M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|  58.9M|
  204|  58.9M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|  58.9M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|  58.9M|
  207|  58.9M|    // All of these biases were derived by measuring the cost of coding
  208|  58.9M|    // a zero vs coding a one on any given coefficient position, or, in
  209|  58.9M|    // the case of the EOB bias, the cost of coding the block with
  210|  58.9M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|  58.9M|    // to choose a new EOB. This was done over several clips, with the
  212|  58.9M|    // average of the bit costs taken over all blocks in the set, and a new
  213|  58.9M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|  58.9M|    // Journal of Dubious Theoretical Results[1], aka:
  215|  58.9M|    //
