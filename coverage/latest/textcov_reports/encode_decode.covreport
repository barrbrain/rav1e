   33|      9|pub(crate) fn sad_plane_internal<T: Pixel>(
   34|      9|  src: &Plane<T>, dst: &Plane<T>, cpu: CpuFeatureLevel,
   35|      9|) -> u64 {
   36|      0|  debug_assert!(src.cfg.width == dst.cfg.width);
   37|      0|  debug_assert!(src.cfg.stride == dst.cfg.stride);
   38|      0|  debug_assert!(src.cfg.height == dst.cfg.height);
   39|      0|  debug_assert!(src.cfg.width <= src.cfg.stride);
   40|       |
   41|      9|  match T::type_enum() {
   42|       |    PixelType::U8 => {
   43|       |      // helper macro to reduce boilerplate
   44|       |      macro_rules! call_asm {
   45|       |        ($func:ident, $src:expr, $dst:expr, $cpu:expr) => {
   46|       |          // SAFETY: Calls Assembly code.
   47|       |          //
   48|       |          // FIXME: Remove `allow` once https://github.com/rust-lang/rust-clippy/issues/8264 fixed
   49|       |          #[allow(clippy::undocumented_unsafe_blocks)]
   50|       |          unsafe {
   51|       |            let result = $func(
