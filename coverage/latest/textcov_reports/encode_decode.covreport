_RNvMs2_NtCsgLNdNkfkEgK_5rav1e4rateNtB5_19QuantizerParameters14new_from_log_q:
  525|    612|  fn new_from_log_q(
  526|    612|    log_base_q: i64, log_target_q: i64, bit_depth: usize,
  527|    612|    chroma_sampling: ChromaSampling, is_intra: bool,
  528|    612|    log_isqrt_mean_scale: i64,
  529|    612|  ) -> QuantizerParameters {
  530|    612|    let scale = log_isqrt_mean_scale + q57(QSCALE + bit_depth as i32 - 8);
  531|    612|
  532|    612|    let mut log_q_y = log_target_q;
  533|    612|    if !is_intra && bit_depth == 8 {
  534|    237|      log_q_y = log_target_q
  535|    237|        + (log_target_q >> 32) * Q_MODEL_MUL[chroma_sampling as usize]
  536|    237|        + Q_MODEL_ADD[chroma_sampling as usize];
  537|    375|    }
  538|       |
  539|    612|    let quantizer = bexp64(log_q_y + scale);
  540|    612|    let (offset_u, offset_v) =
  541|    612|      chroma_offset(log_q_y + log_isqrt_mean_scale, chroma_sampling);
  542|    612|    let mono = chroma_sampling == ChromaSampling::Cs400;
  543|    612|    let log_q_u = log_q_y + offset_u;
  544|    612|    let log_q_v = log_q_y + offset_v;
  545|    612|    let quantizer_u = bexp64(log_q_u + scale);
  546|    612|    let quantizer_v = bexp64(log_q_v + scale);
  547|    612|    let lambda = (::std::f64::consts::LN_2 / 6.0)
  548|    612|      * (((log_target_q + log_isqrt_mean_scale) as f64)
  549|    612|        * Q57_SQUARE_EXP_SCALE)
  550|    612|        .exp();
  551|    612|
  552|    612|    let scale = |q| bexp64((log_target_q - q) * 2 + q57(16)) as f64 / 65536.;
  553|    612|    let dist_scale = [scale(log_q_y), scale(log_q_u), scale(log_q_v)];
  554|    612|
  555|    612|    let base_q_idx = select_ac_qi(quantizer, bit_depth).max(1);
  556|    612|
  557|    612|    // delta_q only gets 6 bits + a sign bit, so it can differ by 63 at most.
  558|    612|    let min_qi = base_q_idx.saturating_sub(63).max(1);
  559|    612|    let max_qi = base_q_idx.saturating_add(63).min(255);
  560|    612|    let clamp_qi = |qi: u8| qi.max(min_qi).min(max_qi);
  561|       |
  562|       |    QuantizerParameters {
  563|    612|      log_base_q,
  564|    612|      log_target_q,
  565|    612|      // TODO: Allow lossless mode; i.e. qi == 0.
  566|    612|      dc_qi: [
  567|    612|        clamp_qi(select_dc_qi(quantizer, bit_depth)),
  568|    612|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_u, bit_depth)) },
  569|    612|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_v, bit_depth)) },
  570|       |      ],
  571|       |      ac_qi: [
  572|    612|        base_q_idx,
  573|    612|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_u, bit_depth)) },
  574|    612|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_v, bit_depth)) },
  575|       |      ],
  576|    612|      lambda,
  577|    612|      dist_scale,
  578|    612|    }
  579|    612|  }
_RNvNtCsgLNdNkfkEgK_5rav1e4rate10warp_alpha:
  130|    500|fn warp_alpha(alpha: i32) -> i32 {
