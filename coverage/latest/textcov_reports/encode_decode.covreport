_RNvNtCs5T1csxkeGwJ_5rav1e4rate13chroma_offset:
  509|  2.18k|fn chroma_offset(
  510|  2.18k|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|  2.18k|) -> (i64, i64) {
  512|  2.18k|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|  2.18k|  let y = match chroma_sampling {
  515|    418|    ChromaSampling::Cs400 => 0,
  516|    363|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|    264|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|  1.14k|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|  2.18k|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|  2.18k|}
_RNvNtCs5T1csxkeGwJ_5rav1e4rate26iir_bessel2_get_parameters:
  140|  1.82k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  1.82k|  // This borrows some code from an unreleased version of Postfish.
  142|  1.82k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  1.82k|  //  on deriving the filter coefficients.
  144|  1.82k|  // alpha is Q24
  145|  1.82k|  let alpha = (1 << 24) / delay;
  146|  1.82k|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|  1.82k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  1.82k|  // k1 is 9.12 (6.12?)
  149|  1.82k|  let k1 = 3 * warp;
  150|  1.82k|  // k2 is 16.24 (11.24?)
  151|  1.82k|  let k2 = k1 * warp;
  152|  1.82k|  // d is 16.15 (10.15?)
  153|  1.82k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  1.82k|  // a is 0.32, since d is larger than both 1.0 and k2
  155|  1.82k|  let a = (k2 << 23) / d;
  156|  1.82k|  // ik2 is 25.24
  157|  1.82k|  let ik2 = (1i64 << 48) / k2;
  158|  1.82k|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|  1.82k|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|  1.82k|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|  1.82k|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|  1.82k|  // All of the filter parameters are Q24.
  163|  1.82k|  (
  164|  1.82k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  1.82k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  1.82k|    ((a + 128) >> 8) as i32,
  167|  1.82k|  )
  168|  1.82k|}
_RNvMs3_NtCs5T1csxkeGwJ_5rav1e4rateNtB5_7RCState3new:
  597|    457|  pub fn new(
  598|    457|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    457|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    457|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    457|    maybe_reservoir_frame_delay: Option<i32>,
  602|    457|  ) -> RCState {
  603|    457|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    457|    //  frames; whichever is smaller, with a minimum of 12.
  605|    457|    // For user set values, we enforce a minimum of 12.
  606|    457|    // The interval is short enough to allow reaction, but long enough to allow
  607|    457|    //  looking into the next GOP (avoiding the case where the last frames
  608|    457|    //  before an I-frame get starved), in most cases.
  609|    457|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    457|    //  errors in the worst case.
  611|    457|    let reservoir_frame_delay = maybe_reservoir_frame_delay
  612|    457|      .unwrap_or_else(|| ((max_key_frame_interval * 3) >> 1).min(240))
  613|    457|      .max(12);
  614|    457|    // TODO: What are the limits on these?
  615|    457|    let npixels = (frame_width as i64) * (frame_height as i64);
  616|    457|    // Insane framerates or frame sizes mean insane bitrates.
  617|    457|    // Let's not get carried away.
  618|    457|    // We also subtract 16 bits from each temporal unit to account for the
  619|    457|    //  temporal delimiter, whose bits are not included in the frame sizes
  620|    457|    //  reported to update_state().
  621|    457|    // TODO: Support constraints imposed by levels.
  622|    457|    let bits_per_tu = clamp(
  623|    457|      (target_bitrate as i64) * framerate_den / framerate_num,
  624|    457|      40,
  625|    457|      0x4000_0000_0000,
  626|    457|    ) - (TEMPORAL_DELIMITER.len() * 8) as i64;
  627|    457|    let reservoir_max = bits_per_tu * (reservoir_frame_delay as i64);
  628|    457|    // Start with a buffer fullness and fullness target of 50%.
  629|    457|    let reservoir_target = (reservoir_max + 1) >> 1;
  630|    457|    // Pick exponents and initial scales for quantizer selection.
  631|    457|    let ibpp = npixels / bits_per_tu;
  632|       |    // These have been derived by encoding many clips at every quantizer
  633|       |    // and running a piecewise-linear regression in binary log space.
  634|    457|    let (i_exp, i_log_scale) = if ibpp < 1 {
  635|     19|      (48u8, blog64(36) - q57(QSCALE))
  636|    438|    } else if ibpp < 4 {
  637|     53|      (61u8, blog64(55) - q57(QSCALE))
  638|       |    } else {
  639|    385|      (77u8, blog64(129) - q57(QSCALE))
  640|       |    };
  641|    457|    let (p_exp, p_log_scale) = if ibpp < 2 {
  642|     27|      (69u8, blog64(32) - q57(QSCALE))
  643|    430|    } else if ibpp < 139 {
  644|    373|      (104u8, blog64(84) - q57(QSCALE))
  645|       |    } else {
  646|     57|      (83u8, blog64(19) - q57(QSCALE))
  647|       |    };
  648|    457|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
