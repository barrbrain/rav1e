  263|  2.06M|  pub(crate) fn sgrproj_box_f_r1_internal<T: Pixel>(
  264|  2.06M|    af: &[&[u32]; 3], bf: &[&[u32]; 3], f: &mut [u32], start_x: usize,
  265|  2.06M|    y: usize, w: usize, cdeffed: &PlaneSlice<T>,
