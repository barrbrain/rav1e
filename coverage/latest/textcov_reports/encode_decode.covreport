 1601|   445k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   438k|      v_tally[i] += v_tally[i - 1];
 1603|   438k|      h_tally[i] += h_tally[i - 1];
 1604|   438k|    }
 1605|       |
 1606|  6.96k|    match pli {
 1607|       |      0 => {
 1608|  2.71k|        let mut best_v = 999;
 1609|  2.71k|        let mut best_h = 999;
 1610|   176k|        for i in 0..=MAX_LOOP_FILTER {
 1611|   173k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  4.66k|            best_v = i;
 1613|   168k|          };
