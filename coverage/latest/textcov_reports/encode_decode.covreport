 1504|  15.1M|fn get_mv_rate(
 1505|  15.1M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  15.1M|) -> u32 {
 1507|  15.1M|  #[inline(always)]
