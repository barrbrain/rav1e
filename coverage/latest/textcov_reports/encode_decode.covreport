 1614|   419k|  let mut ac: Aligned<[i16; 32 * 32]> = unsafe { Aligned::uninitialized() };
 1615|   419k|  luma_ac(&mut ac.data, ts, tile_bo, bsize, luma_tx_size, fi);
 1616|   419k|  let best_alpha: ArrayVec<i16, 2> = (1..3)
