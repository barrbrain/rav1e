 1636|      0|      } else if !above_uni_comp || !left_uni_comp {
 1637|      0|        2
 1638|       |      } else {
 1639|      0|        3 + ((above0 == BWDREF_FRAME) == (left0 == BWDREF_FRAME)) as usize
 1640|       |      }
 1641|   422k|    } else if avail_up && avail_left {
