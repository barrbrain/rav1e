  323|   174M|        let d: u32 = u32::cast_from(*d);
  324|   174M|        sum_s += s;
  325|   174M|        sum_d += d;
  326|   174M|
  327|   174M|        sum_s2 += s * s;
  328|   174M|        sum_d2 += d * d;
  329|   174M|        sum_sd += s * d;
