  331|  1.48k|  for mi_y in tile_bo.0.y..tile_bo_y_end {
  332|  10.1k|    for a in tile_me_stats[mi_y][tile_bo.0.x..tile_bo_x_end].iter_mut() {
  333|  10.1k|      *a = stats;
