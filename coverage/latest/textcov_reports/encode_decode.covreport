  208|   145M|  pub const fn temporal_rdo(&self) -> bool {
  209|   145M|    // Note: This function is called frequently, unlike most other functions here.
  210|   145M|
  211|   145M|    // `compute_distortion_scale` computes a scaling factor for the distortion
