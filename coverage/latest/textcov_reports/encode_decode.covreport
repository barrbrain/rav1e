  989|  7.11M|  //   1489/1024 = (Sin[27*Pi/64] - Cos[27*Pi/64])*2 = 1.4541021465825602
  990|  7.11M|  //   3981/8192 = Cos[27*Pi/64]*2                   = 0.4859603598065277
