_RNvMs3_NtCs5T1csxkeGwJ_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|  1.98k|  fn calc_flat_quantizer(
 1061|  1.98k|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|  1.98k|  ) -> (i64, i64) {
 1063|  1.98k|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|  1.98k|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|  1.98k|    //  parameterize a "quality" configuration parameter).
 1066|  1.98k|
 1067|  1.98k|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|  1.98k|    //  tables have unique entries, while the DC tables do not.
 1069|  1.98k|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|  1.98k|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|  1.98k|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|  1.98k|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|  1.98k|    // Get the log quantizers as Q57.
 1074|  1.98k|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|  1.98k|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|  1.98k|    // Target the midpoint of the chosen entries.
 1077|  1.98k|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|  1.98k|    // Adjust the quantizer for the frame type, result is Q57:
 1079|  1.98k|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|  1.98k|      + DQP_Q57[fti];
 1081|  1.98k|    (log_base_q, log_q)
 1082|  1.98k|  }
_RNvMNtCs5T1csxkeGwJ_5rav1e4rateNtB2_10IIRBessel23new:
  171|  1.82k|  pub fn new(delay: i32, value: i32) -> IIRBessel2 {
  172|  1.82k|    let (c0, c1, g) = iir_bessel2_get_parameters(delay);
