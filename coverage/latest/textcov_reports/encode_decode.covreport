   33|     52|pub(crate) fn sad_plane_internal<T: Pixel>(
   34|     52|  src: &Plane<T>, dst: &Plane<T>, cpu: CpuFeatureLevel,
   35|     52|) -> u64 {
   36|      0|  debug_assert!(src.cfg.width == dst.cfg.width);
   37|      0|  debug_assert!(src.cfg.stride == dst.cfg.stride);
   38|      0|  debug_assert!(src.cfg.height == dst.cfg.height);
   39|      0|  debug_assert!(src.cfg.width <= src.cfg.stride);
   40|       |
   41|     52|  match T::type_enum() {
   42|       |    PixelType::U8 => {
   43|       |      // helper macro to reduce boilerplate
   44|       |      macro_rules! call_asm {
   45|       |        ($func:ident, $src:expr, $dst:expr, $cpu:expr) => {
   46|       |          // SAFETY: Calls Assembly code.
   47|       |          //
   48|       |          // FIXME: Remove `allow` once https://github.com/rust-lang/rust-clippy/issues/8264 fixed
   49|       |          #[allow(clippy::undocumented_unsafe_blocks)]
   50|       |          unsafe {
   51|       |            let result = $func(
   52|       |              mem::transmute(src.data_origin().as_ptr()),
   53|       |              mem::transmute(dst.data_origin().as_ptr()),
   54|       |              src.cfg.stride,
   55|       |              src.cfg.width,
   56|       |              src.cfg.height,
   57|       |            );
   58|       |
   59|       |            #[cfg(feature = "check_asm")]
   60|       |            assert_eq!(result, rust::sad_plane_internal($src, $dst, $cpu));
   61|       |
   62|       |            result
   63|       |          }
   64|       |        };
   65|       |      }
   66|       |
   67|     52|      if cpu >= CpuFeatureLevel::AVX2 {
   68|     52|        call_asm!(rav1e_sad_plane_8bpc_avx2, src, dst, cpu)
   69|      0|      } else if cpu >= CpuFeatureLevel::SSE2 {
   70|      0|        call_asm!(rav1e_sad_plane_8bpc_sse2, src, dst, cpu)
   71|       |      } else {
   72|      0|        rust::sad_plane_internal(src, dst, cpu)
   73|       |      }
   74|       |    }
   75|      0|    PixelType::U16 => rust::sad_plane_internal(src, dst, cpu),
   76|       |  }
