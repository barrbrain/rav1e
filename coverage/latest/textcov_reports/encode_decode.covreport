  178|  9.77M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  9.77M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  9.77M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  9.77M|) -> Distortion {
  182|  9.77M|  // See get_weighted_sse in src/dist.rs.
  183|  9.77M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  9.77M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  9.77M|
  186|  9.77M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  9.77M|  // importance block size in a non-subsampled plane.
  188|  9.77M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  9.77M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  9.77M|
  191|  9.77M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  9.77M|
  193|  9.77M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  9.77M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  9.77M|
  196|  9.77M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  9.77M|  // passed directly. To do this, we would need different versions of the
  198|  9.77M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  9.77M|  // eliminating use of unbiased sse.
  200|  9.77M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  9.77M|
  202|  9.77M|  // Copy biases into a buffer.
  203|  9.77M|  let mut buf_storage = Aligned::new(
  204|  9.77M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  9.77M|  );
  206|  9.77M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  9.77M|  let buf = init_slice_repeat_mut(
  208|  9.77M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  9.77M|    0,
  210|  9.77M|  );
  211|       |
  212|  15.4M|  for block_y in 0..n_imp_blocks_h {
  213|  24.5M|    for block_x in 0..n_imp_blocks_w {
  214|  24.5M|      let block = Area::StartingAt {
  215|  24.5M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  24.5M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  24.5M|      };
  218|  24.5M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  24.5M|    }
  220|       |  }
  221|       |
  222|  9.77M|  Distortion(get_weighted_sse(
  223|  9.77M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  9.77M|  ))
  225|  9.77M|}
