  393|  22.5M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  22.5M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  22.5M|  let q0 = coeffs[0];
  397|  22.5M|  let q1 = coeffs[1];
  398|  22.5M|  let q2 = coeffs[2];
  399|  22.5M|  let q3 = coeffs[3];
  400|  22.5M|  let t0 = q1.add(q3);
  401|  22.5M|  // t1 = (q0 + q1 - q3)/2
  402|  22.5M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  22.5M|  let t2 = q0.sub(q1);
  404|  22.5M|  let t3 = q2;
  405|  22.5M|  let t4 = q0.add(q3);
  406|  22.5M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  22.5M|  let t0 = t0.tx_mul((7021, 14));
  408|  22.5M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  22.5M|  let t1 = t1.tx_mul((37837, 15));
  410|  22.5M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  22.5M|  let t2 = t2.tx_mul((21513, 15));
  412|  22.5M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  22.5M|  let t3 = t3.tx_mul((37837, 15));
  414|  22.5M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  22.5M|  let t4 = t4.tx_mul((467, 11));
  416|  22.5M|  let t3h = t3.rshift1();
  417|  22.5M|  let u4 = t4.add(t3h);
  418|  22.5M|  coeffs[0] = t0.add(u4);
  419|  22.5M|  coeffs[1] = t1;
  420|  22.5M|  coeffs[2] = t0.add(t2.sub(t3h));
  421|  22.5M|  coeffs[3] = t2.add(t3.sub(u4));
  422|  22.5M|}
