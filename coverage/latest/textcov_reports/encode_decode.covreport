   33|  1.23M|  pub fn get_sad<T: Pixel>(
   34|  1.23M|    plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>, w: usize,
   35|  1.23M|    h: usize, _bit_depth: usize, _cpu: CpuFeatureLevel,
   36|  1.23M|  ) -> u32 {
   37|  1.23M|    assert!(w <= 128 && h <= 128);
   38|  1.23M|    assert!(plane_org.rect().width >= w && plane_org.rect().height >= h);
   39|  1.23M|    assert!(plane_ref.rect().width >= w && plane_ref.rect().height >= h);
   40|       |
   41|  1.23M|    let mut sum: u32 = 0;
   42|       |
   43|  13.6M|    for (slice_org, slice_ref) in
   44|  1.23M|      plane_org.rows_iter().take(h).zip(plane_ref.rows_iter())
   45|  13.6M|    {
   46|  13.6M|      sum += slice_org
   47|  13.6M|        .iter()
   48|  13.6M|        .take(w)
   49|  13.6M|        .zip(slice_ref)
