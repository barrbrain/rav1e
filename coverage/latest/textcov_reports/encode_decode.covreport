  223|  63.0M|    let out0 = b.add(c);
  224|  63.0M|    let shifted = Self::SHIFT(c);
  225|  63.0M|    let out1 = Self::SUB(a, shifted);
  226|  63.0M|    (out0, out1)
  227|  63.0M|  }
