  267|  83.7M|      let eob_minus_two =
  268|  83.7M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|  83.7M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|  83.7M|      })
  276|  83.7M|    };
