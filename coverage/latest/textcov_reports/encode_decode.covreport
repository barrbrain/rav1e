 1460|  28.9k|) -> MotionSearchResult {
 1461|  28.9k|  let search_region = p_ref.region(Area::Rect {
 1462|  28.9k|    x: x_lo,
 1463|  28.9k|    y: y_lo,
 1464|  28.9k|    width: (x_hi - x_lo) as usize + w,
 1465|  28.9k|    height: (y_hi - y_lo) as usize + h,
 1466|  28.9k|  });
 1467|  28.9k|
 1468|  28.9k|  let mut best: MotionSearchResult = MotionSearchResult::empty();
