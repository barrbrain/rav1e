  190|     40|  pub fn update(&mut self, x: i32) -> i32 {
  191|     40|    let c0 = self.c[0] as i64;
  192|     40|    let c1 = self.c[1] as i64;
  193|     40|    let g = self.g as i64;
  194|     40|    let x0 = self.x[0] as i64;
  195|     40|    let x1 = self.x[1] as i64;
  196|     40|    let y0 = self.y[0] as i64;
  197|     40|    let y1 = self.y[1] as i64;
