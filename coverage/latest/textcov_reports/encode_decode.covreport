  143|      9|        pub extern "C" fn rust_fuzzer_test_input(bytes: &[u8]) {
  144|      9|            use libfuzzer_sys::arbitrary::{Arbitrary, Unstructured};
  145|      9|
  146|      9|            // Early exit if we don't have enough bytes for the `Arbitrary`
  147|      9|            // implementation. This helps the fuzzer avoid exploring all the
  148|      9|            // different not-enough-input-bytes paths inside the `Arbitrary`
  149|      9|            // implementation. Additionally, it exits faster, letting the fuzzer
  150|      9|            // get to longer inputs that actually lead to interesting executions
  151|      9|            // quicker.
  152|      9|            if bytes.len() < <$dty as Arbitrary>::size_hint(0).0 {
  153|      0|                return;
  154|      9|            }
  155|      9|
  156|      9|            let mut u = Unstructured::new(bytes);
  157|      9|            let data = <$dty as Arbitrary>::arbitrary_take_rest(u);
  158|       |
  159|       |            // When `RUST_LIBFUZZER_DEBUG_PATH` is set, write the debug
  160|       |            // formatting of the input to that file. This is only intended for
  161|       |            // `cargo fuzz`'s use!
  162|      9|            if let Ok(path) = std::env::var("RUST_LIBFUZZER_DEBUG_PATH") {
  163|       |                use std::io::Write;
  164|      0|                let mut file = std::fs::File::create(path)
  165|      0|                    .expect("failed to create `RUST_LIBFUZZER_DEBUG_PATH` file");
  166|      0|                (match data {
  167|      0|                    Ok(data) => writeln!(&mut file, "{:#?}", data),
  168|      0|                    Err(err) => writeln!(&mut file, "Arbitrary Error: {}", err),
  169|       |                })
  170|      0|                .expect("failed to write to `RUST_LIBFUZZER_DEBUG_PATH` file");
  171|      0|                return;
  172|      9|            }
  173|       |
  174|      9|            let $data = match data {
  175|      9|                Ok(d) => d,
  176|      0|                Err(_) => return,
  177|       |            };
  178|       |
  179|       |            $body
  180|      9|        }
