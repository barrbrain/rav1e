  966|  7.61M|}
_RINvNvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|  13.2M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  13.2M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  13.2M|    ) {
 1598|  13.2M|      let j = i * 2;
 1599|  13.2M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  13.2M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  13.2M|      half[i] = ah;
 1602|  13.2M|      half[31 - i] = dh;
 1603|  13.2M|      asym[i] = b;
 1604|  13.2M|      asym[31 - i] = c;
 1605|  13.2M|    }
