 3353|    973|  ti: &TilingInfo, raw_tiles: &[Vec<u8>], max_tile_size_bytes: u32,
 3354|    973|) -> Vec<u8> {
 3355|    973|  // <https://aomediacodec.github.io/av1-spec/#general-tile-group-obu-syntax>
 3356|    973|  let mut raw = Vec::new();
 3357|    973|  let mut bw = BitWriter::endian(&mut raw, BigEndian);
 3358|    973|  if ti.cols * ti.rows > 1 {
 3359|    650|    // tile_start_and_end_present_flag
 3360|    650|    bw.write_bit(false).unwrap();
 3361|    650|  }
 3362|    973|  bw.byte_align().unwrap();
 3363|  3.23k|  for (i, raw_tile) in raw_tiles.iter().enumerate() {
 3364|  3.23k|    let last = raw_tiles.len() - 1;
 3365|  3.23k|    if i != last {
 3366|  2.25k|      let tile_size_minus_1 = raw_tile.len() - 1;
 3367|  2.25k|      bw.write_le(max_tile_size_bytes, tile_size_minus_1 as u64).unwrap();
 3368|  2.25k|    }
 3369|  3.23k|    bw.write_bytes(raw_tile).unwrap();
 3370|       |  }
 3371|    973|  raw
 3372|    973|}
