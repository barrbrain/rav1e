  457|  3.02k|  } else if subset_b.len() != 3 {
  458|  3.02k|    None
  459|       |  } else {
  460|      0|    let mut rows: ArrayVec<i16, 3> = subset_b.iter().map(|&a| a.row).collect();
  461|      0|    let mut cols: ArrayVec<i16, 3> = subset_b.iter().map(|&a| a.col).collect();
  462|      0|    rows.as_mut_slice().sort_unstable();
  463|      0|    cols.as_mut_slice().sort_unstable();
  464|      0|    Some(MotionVector { row: rows[1], col: cols[1] })
  465|       |  };
  466|       |
  467|       |  // Zero motion vector, don't use add_cand since it skips zero vectors.
  468|   135k|  subset_b.push(MotionVector::default());
