  218|   167M|  $($s)* fn half_kernel(
  219|   167M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   167M|  ) -> (T, T) {
  221|   167M|    let t = Self::ADD(p1, p0.0);
  222|   167M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   167M|    let out0 = b.add(c);
  224|   167M|    let shifted = Self::SHIFT(c);
  225|   167M|    let out1 = Self::SUB(a, shifted);
  226|   167M|    (out0, out1)
  227|   167M|  }
