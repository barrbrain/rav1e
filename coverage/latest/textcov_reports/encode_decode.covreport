 1480|  13.8k|fn sse_plane<T: Pixel>(
 1481|  13.8k|  rec: &PlaneRegion<T>, src: &PlaneRegion<T>,
 1482|  13.8k|  v_sse: &mut [i64; MAX_LOOP_FILTER + 2],
