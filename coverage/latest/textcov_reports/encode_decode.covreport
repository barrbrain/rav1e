 1326|  96.5k|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|  96.5k|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|  96.5k|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|   394k|  loop {
 1333|   394k|    // Find the best candidate from the diamond pattern.
 1334|   394k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  1.97M|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  1.57M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  1.57M|
