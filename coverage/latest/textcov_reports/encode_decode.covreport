  197|  65.6M|    dc_delta_q: i8, ac_delta_q: i8,
  198|  65.6M|  ) {
  199|  65.6M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|  65.6M|
  201|  65.6M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|  65.6M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|  65.6M|
  204|  65.6M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|  65.6M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|  65.6M|
  207|  65.6M|    // All of these biases were derived by measuring the cost of coding
  208|  65.6M|    // a zero vs coding a one on any given coefficient position, or, in
  209|  65.6M|    // the case of the EOB bias, the cost of coding the block with
  210|  65.6M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|  65.6M|    // to choose a new EOB. This was done over several clips, with the
  212|  65.6M|    // average of the bit costs taken over all blocks in the set, and a new
  213|  65.6M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|  65.6M|    // Journal of Dubious Theoretical Results[1], aka:
  215|  65.6M|    //
