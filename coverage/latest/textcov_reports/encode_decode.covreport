_RNvYNtNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward12RotateSubAvgINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  31.4M|  $($s)* fn half_kernel(
  219|  31.4M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  31.4M|  ) -> (T, T) {
  221|  31.4M|    let t = Self::ADD(p1, p0.0);
  222|  31.4M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  31.4M|    let out0 = b.add(c);
  224|  31.4M|    let shifted = Self::SHIFT(c);
  225|  31.4M|    let out1 = Self::SUB(a, shifted);
  226|  31.4M|    (out0, out1)
  227|  31.4M|  }
