   65|       |        } else {
   66|  4.96k|          qi as u8
   67|       |        }
   68|       |      }
   69|       |    }
   70|       |  }
   71|  16.7k|}
_RNvNtCs5T1csxkeGwJ_5rav1e8quantize9divu_pairB3_:
  125|  9.74G|const fn divu_pair(x: u32, d: (u32, u32, u32)) -> u32 {
  126|  9.74G|  let x = x as u64;
  127|  9.74G|  let (a, b, shift) = d;
  128|  9.74G|  let shift = shift as u64;
  129|  9.74G|  let a = a as u64;
  130|  9.74G|  let b = b as u64;
  131|  9.74G|
  132|  9.74G|  (((a * x + b) >> 32) >> shift) as u32
  133|  9.74G|}
