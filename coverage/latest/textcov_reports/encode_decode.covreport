  178|  8.24M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  8.24M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  8.24M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  8.24M|) -> Distortion {
  182|  8.24M|  // See get_weighted_sse in src/dist.rs.
  183|  8.24M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  8.24M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  8.24M|
  186|  8.24M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  8.24M|  // importance block size in a non-subsampled plane.
  188|  8.24M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  8.24M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  8.24M|
  191|  8.24M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  8.24M|
  193|  8.24M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  8.24M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  8.24M|
  196|  8.24M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  8.24M|  // passed directly. To do this, we would need different versions of the
  198|  8.24M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  8.24M|  // eliminating use of unbiased sse.
  200|  8.24M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  8.24M|
  202|  8.24M|  // Copy biases into a buffer.
  203|  8.24M|  let mut buf_storage = Aligned::new(
  204|  8.24M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  8.24M|  );
  206|  8.24M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  8.24M|  let buf = init_slice_repeat_mut(
  208|  8.24M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  8.24M|    0,
  210|  8.24M|  );
  211|       |
  212|  17.2M|  for block_y in 0..n_imp_blocks_h {
  213|  61.6M|    for block_x in 0..n_imp_blocks_w {
  214|  61.6M|      let block = Area::StartingAt {
  215|  61.6M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  61.6M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  61.6M|      };
  218|  61.6M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  61.6M|    }
  220|       |  }
  221|       |
  222|  8.24M|  Distortion(get_weighted_sse(
  223|  8.24M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  8.24M|  ))
  225|  8.24M|}
