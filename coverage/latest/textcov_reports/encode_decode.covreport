 1147|      0|            self.scale_window_sum[ftj] -=
 1148|      0|              bexp_q24(self.prev_metrics.log_scale_q24);
 1149|      0|          }
 1150|      0|          if self.prev_metrics.show_frame {
 1151|      0|            self.ntus_left -= 1;
 1152|      0|            self.scale_window_ntus -= 1;
 1153|      0|          }
 1154|       |          // Free the corresponding entry in the circular buffer.
 1155|      0|          if !self.frame_metrics.is_empty() {
 1156|      0|            self.nframe_metrics -= 1;
 1157|      0|            self.frame_metrics_head += 1;
 1158|      0|            if self.frame_metrics_head >= self.frame_metrics.len() {
 1159|      0|              self.frame_metrics_head = 0;
 1160|      0|            }
 1161|      0|          }
 1162|       |          // Mark us ready for the next 2-pass packet.
 1163|      0|          self.pass2_data_ready = false;
 1164|      0|          // Update state, so the user doesn't have to keep calling
 1165|      0|          //  twopass_in() after they've fed in all the data when we're using
 1166|      0|          //  a finite buffer.
 1167|      0|          self.twopass_in(None).unwrap_or(0);
 1168|      0|        }
 1169|     16|      }
 1170|     16|      if self.twopass_state == PASS_1 || self.twopass_state == PASS_2_PLUS_1 {
 1171|      0|        // Pass 1 mode: save the metrics for this frame.
 1172|      0|        self.prev_metrics.log_scale_q24 = log_scale_q24;
