   89|   310M|        height: (parent_height as isize - y) as usize,
   90|   310M|      },
   91|  2.47M|      Area::BlockRect { bo, width, height } => Rect {
   92|  2.47M|        x: (bo.x >> xdec << BLOCK_TO_PLANE_SHIFT) as isize,
   93|  2.47M|        y: (bo.y >> ydec << BLOCK_TO_PLANE_SHIFT) as isize,
   94|  2.47M|        width,
   95|  2.47M|        height,
   96|  2.47M|      },
   97|   511M|      Area::BlockStartingAt { bo } => {
   98|   511M|        let x = (bo.x >> xdec << BLOCK_TO_PLANE_SHIFT) as isize;
   99|   511M|        let y = (bo.y >> ydec << BLOCK_TO_PLANE_SHIFT) as isize;
  100|   511M|        Rect {
  101|   511M|          x,
  102|   511M|          y,
  103|   511M|          width: (parent_width as isize - x) as usize,
  104|   511M|          height: (parent_height as isize - y) as usize,
  105|   511M|        }
  106|       |      }
  107|       |    }
  108|   827M|  }
