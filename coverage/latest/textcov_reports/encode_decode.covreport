  177|    319|fn setup_encoder<T: Pixel>(
  178|    319|  w: usize, h: usize, speed: u8, quantizer: usize, bit_depth: usize,
  179|    319|  chroma_sampling: ChromaSampling, min_keyint: u64, max_keyint: u64,
  180|    319|  switch_frame_interval: u64, low_latency: bool, error_resilient: bool,
  181|    319|  bitrate: i32, tile_cols_log2: usize, tile_rows_log2: usize,
  182|    319|  still_picture: bool, grain_table: Option<Vec<GrainTableSegment>>,
  183|    319|) -> Context<T> {
  184|    319|  assert!(bit_depth == 8 || std::mem::size_of::<T>() > 1);
  185|    319|  let mut enc = EncoderConfig::with_speed_preset(speed);
  186|    319|  enc.quantizer = quantizer;
  187|    319|  enc.min_key_frame_interval = min_keyint;
  188|    319|  enc.max_key_frame_interval = max_keyint;
  189|    319|  enc.switch_frame_interval = switch_frame_interval;
  190|    319|  enc.low_latency = low_latency;
  191|    319|  enc.error_resilient = error_resilient;
  192|    319|  enc.width = w;
  193|    319|  enc.height = h;
  194|    319|  enc.bit_depth = bit_depth;
  195|    319|  enc.chroma_sampling = chroma_sampling;
  196|    319|  enc.bitrate = bitrate;
  197|    319|  enc.tile_cols = 1 << tile_cols_log2;
  198|    319|  enc.tile_rows = 1 << tile_rows_log2;
  199|    319|  enc.still_picture = still_picture;
  200|    319|  enc.film_grain_params = grain_table;
  201|       |
  202|    319|  let threads = if cfg!(fuzzing) { 1 } else { 2 };
  203|       |
  204|    319|  let cfg = Config::new().with_encoder_config(enc).with_threads(threads);
  205|    319|
  206|    319|  cfg.new_context().unwrap()
  207|    319|}
