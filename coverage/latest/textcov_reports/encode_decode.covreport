 1207|     16|        if droppable && self.reservoir_fullness + self.bits_per_tu < bits {
 1208|      0|          // TODO: Adjust VFR rate based on drop count.
 1209|      0|          bits = 0;
 1210|      0|          dropped = true;
 1211|     16|        } else {
 1212|     16|          // TODO: Update a low-pass filter to estimate the "real" frame rate
 1213|     16|          //  taking timestamps and drops into account.
 1214|     16|          // This is only done if the frame is coded, as it needs the final
 1215|     16|          //  count of dropped frames.
 1216|     16|        }
 1217|      0|      }
 1218|     16|      if !trial {
 1219|       |        // Increment the frame count for filter adaptation purposes.
 1220|      8|        if !trial && self.nframes[fti] < ::std::i32::MAX {
 1221|      8|          self.nframes[fti] += 1;
 1222|      8|        }
 1223|      8|        self.reservoir_fullness -= bits;
 1224|      8|        if show_frame {
 1225|      8|          self.reservoir_fullness += self.bits_per_tu;
 1226|      8|          // TODO: Properly account for temporal delimiter bits.
 1227|      8|        }
 1228|       |        // If we're too quick filling the buffer and overflow is capped, that
 1229|       |        //  rate is lost forever.
 1230|      8|        if self.cap_overflow {
