  100|   146M|    quants_ac,
  101|   146M|    dc_q(qindex, dc_delta_q, bit_depth) as i32,
  102|   146M|    0,
  103|   146M|  );
  104|   146M|
  105|   146M|  let area: usize = av1_get_coded_tx_size(tx_size).area();
  106|   146M|  // Step by 16 (256/16) coefficients for each iteration
  107|   146M|  let step: usize = 16;
  108|   146M|  assert!(area >= step);
  109|       |
  110|       |  // Increase the pointers as we iterate
  111|   146M|  let mut coeffs_ptr: *const i16 = coeffs_ptr;
  112|   146M|  let mut rcoeffs_ptr: *mut i16 = rcoeffs_ptr;
  113|   534M|  for _i in (0..area).step_by(step) {
