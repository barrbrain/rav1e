  660|  11.6M|$($s)* fn daala_fdst_iv_8_asym<T: TxOperations>(
  661|  11.6M|  r0: (T, T), r1h: T, r2: (T, T), r3h: T, r4: (T, T), r5h: T, r6: (T, T),
  662|  11.6M|  r7h: T, output: &mut [T],
  663|  11.6M|) {
  664|  11.6M|  // Stage 0
  665|  11.6M|  // 12665/16384 = (Sin[15*Pi/32] + Cos[15*Pi/32])/Sqrt[2] = 0.77301045336274
  666|  11.6M|  //   5197/4096 = (Sin[15*Pi/32] - Cos[15*Pi/32])*Sqrt[2] = 1.26878656832729
  667|  11.6M|  //  2271/16384 = Cos[15*Pi/32]*Sqrt[2]                   = 0.13861716919909
  668|  11.6M|  let (r0, r7) =
  669|  11.6M|    RotateAdd::half_kernel(r0, r7h, ((12665, 14), (5197, 12), (2271, 14)));
  670|  11.6M|  // 14449/16384 = Sin[13*Pi/32] + Cos[13*Pi/32])/Sqrt[2] = 0.881921264348355
  671|  11.6M|  // 30893/32768 = Sin[13*Pi/32] - Cos[13*Pi/32])*Sqrt[2] = 0.942793473651995
  672|  11.6M|  //   3363/8192 = Cos[13*Pi/32]*Sqrt[2]                  = 0.410524527522357
  673|  11.6M|  let (r6, r1) =
