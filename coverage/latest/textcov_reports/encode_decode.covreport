  688|  11.6M|  let (r2, r1h) = butterfly_sub(r2, r1);
  689|  11.6M|  let (r5, r6h) = butterfly_add(r5, r6);
  690|  11.6M|  let (r7, r4h) = butterfly_sub(r7, r4);
  691|  11.6M|
  692|  11.6M|  // Stage 2
  693|  11.6M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  694|  11.6M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  695|  11.6M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  696|  11.6M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  697|  11.6M|
