_RNvMsj_NtNtCsgLNdNkfkEgK_5rav1e6tiling22tile_restoration_stateNtB5_23TileRestorationStateMut16get_units_region:
  362|  8.20k|      fn get_units_region(
  363|  8.20k|        rs: &RestorationState,
  364|  8.20k|        sbo: PlaneSuperBlockOffset,
  365|  8.20k|        sb_width: usize,
  366|  8.20k|        sb_height: usize,
  367|  8.20k|        pli: usize,
  368|  8.20k|      ) -> (usize, usize, usize, usize) {
  369|  8.20k|        let sb_h_shift = rs.planes[pli].cfg.sb_h_shift;
  370|  8.20k|        let sb_v_shift = rs.planes[pli].cfg.sb_v_shift;
  371|       |        // there may be several super-blocks per restoration unit
  372|       |        // the given super-block offset must match the start of a restoration unit
  373|      0|        debug_assert!(sbo.0.x % (1 << sb_h_shift) == 0);
  374|      0|        debug_assert!(sbo.0.y % (1 << sb_v_shift) == 0);
  375|       |
  376|  8.20k|        let units_x = sbo.0.x >> sb_h_shift;
  377|  8.20k|        let units_y = sbo.0.y >> sb_v_shift;
  378|  8.20k|        let units_cols = sb_width + (1 << sb_h_shift) - 1 >> sb_h_shift;
  379|  8.20k|        let units_rows = sb_height + (1 << sb_v_shift) - 1 >> sb_v_shift;
  380|  8.20k|
  381|  8.20k|        let FrameRestorationUnits { cols: rs_cols, rows: rs_rows, .. } = rs.planes[pli].units;
  382|       |        // +1 because the last super-block may use the "stretched" restoration unit
