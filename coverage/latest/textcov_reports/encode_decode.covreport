_RNvNtCsixsdkNzQ5tW_5rav1e7deblock20deblock_size14_innerB3_:
  864|  1.15M|fn deblock_size14_inner(
  865|  1.15M|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|  1.15M|  level: usize, bd: usize,
  867|  1.15M|) -> Option<[i32; 12]> {
  868|  1.15M|  // 'mask' test
  869|  1.15M|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|  96.0k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
  872|  96.0k|    let x = if flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat {
  873|       |      // outer flatness test
  874|  4.45k|      if flat14_outer(p6, p5, p4, p0, q0, q4, q5, q6) <= flat {
  875|       |        // sufficient flatness across 14 pixel width; run full-width filter
  876|  3.73k|        filter_wide14_12(
  877|  3.73k|          p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6,
  878|  3.73k|        )
  879|       |      } else {
  880|       |        // only flat in inner area, run 8-tap
  881|    720|        filter_wide8_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5)
  882|       |      }
  883|  91.6k|    } else if nhev4(p1, p0, q0, q1, bd - 8) <= level {
  884|       |      // not flat, run narrow filter
  885|  2.52k|      filter_narrow4_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  886|       |    } else {
  887|  89.1k|      filter_narrow2_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  888|       |    };
  889|  96.0k|    Some(x)
  890|       |  } else {
  891|  1.06M|    None
  892|       |  }
  893|  1.15M|}
_RNvNtCsixsdkNzQ5tW_5rav1e7deblock22deblock_adjusted_level:
   25|   745k|fn deblock_adjusted_level(
   26|   745k|  deblock: &DeblockState, block: &Block, pli: usize, vertical: bool,
   27|   745k|) -> usize {
   28|   745k|  let idx = if pli == 0 {
   29|   403k|    if vertical {
   30|   199k|      0
   31|       |    } else {
   32|   203k|      1
   33|       |    }
   34|       |  } else {
   35|   342k|    pli + 1
   36|       |  };
   37|       |
   38|   745k|  let level = if deblock.block_deltas_enabled {
   39|       |    // By-block filter strength delta, if the feature is active.
   40|      0|    let block_delta = if deblock.block_delta_multi {
   41|      0|      block.deblock_deltas[idx] << deblock.block_delta_shift
   42|       |    } else {
   43|      0|      block.deblock_deltas[0] << deblock.block_delta_shift
   44|       |    };
   45|       |
   46|       |    // Add to frame-specified filter strength (Y-vertical, Y-horizontal, U, V)
   47|      0|    clamp(block_delta + deblock.levels[idx] as i8, 0, MAX_LOOP_FILTER as i8)
   48|      0|      as u8
   49|       |  } else {
   50|   745k|    deblock.levels[idx]
   51|       |  };
   52|       |
