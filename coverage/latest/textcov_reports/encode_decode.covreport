  242|   150M|  pub fn quantize<T: Coefficient>(
  243|   150M|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|   150M|  ) -> usize {
  245|   150M|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|   150M|
  247|   150M|    qcoeffs[0] = {
  248|   150M|      let coeff: i32 =
  249|   150M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|   150M|      let abs_coeff = coeff.unsigned_abs();
  251|   150M|      T::cast_from(copysign(
  252|   150M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|   150M|        coeff,
  254|   150M|      ))
  255|   150M|    };
  256|   150M|
  257|   150M|    // Find the last non-zero coefficient using our smaller biases and
  258|   150M|    // zero everything else.
  259|   150M|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|   150M|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|   150M|    let deadzone = T::cast_from(
  262|   150M|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|   150M|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|   150M|    );
  265|   150M|    let eob = {
  266|   150M|      // We skip the DC coefficient since it has its own quantizer index.
  267|   150M|      let eob_minus_two =
  268|   150M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|   150M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|   150M|      })
