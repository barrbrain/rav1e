  179|  29.5M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  29.5M|    let t = Self::ADD(p1, p0);
  181|  29.5M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  29.5M|    let out1 = Self::SUB(a, out0);
  183|  29.5M|    (out0, out1)
  184|  29.5M|  }
