  548|  1.46k|      * (((log_target_q + log_isqrt_mean_scale) as f64)
  549|  1.46k|        * Q57_SQUARE_EXP_SCALE)
  550|  1.46k|        .exp();
  551|  1.46k|
  552|  1.46k|    let scale = |q| bexp64((log_target_q - q) * 2 + q57(16)) as f64 / 65536.;
