   29|  8.45G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  8.45G|  let nsymbs = 4;
   31|  8.45G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  8.45G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  8.45G|
   34|  8.45G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  8.45G|  // implementation:
   36|  8.45G|  //
   37|  8.45G|  // ```
   38|  8.45G|  // if i as u32 >= val {
   39|  8.45G|  //   *v -= *v >> rate;
   40|  8.45G|  // } else {
   41|  8.45G|  //   *v += (32768 - *v) >> rate;
   42|  8.45G|  // }
   43|  8.45G|  // ```
   44|  8.45G|  //
   45|  8.45G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  8.45G|  // transform in something like:
   47|  8.45G|  //
   48|  8.45G|  // ```
   49|  8.45G|  // if i as u32 >= val {
   50|  8.45G|  //   *v -= *v >> rate;
   51|  8.45G|  // } else {
   52|  8.45G|  //   *v -= -((32768 - *v) >> rate);
   53|  8.45G|  // }
   54|  8.45G|  // ```
   55|  8.45G|  //
   56|  8.45G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  8.45G|  // using the following rule:
   58|  8.45G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  8.45G|  // So we obtain
   60|  8.45G|  //
   61|  8.45G|  // ```
   62|  8.45G|  // if i as u32 >= val {
   63|  8.45G|  //   *v -= *v >> rate;
   64|  8.45G|  // } else {
   65|  8.45G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  8.45G|  // }
   67|  8.45G|  // ```
   68|  8.45G|  //
   69|  8.45G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  8.45G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  8.45G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  8.45G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  8.45G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  8.45G|  //
   75|  8.45G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  8.45G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  8.45G|
   78|  8.45G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  8.45G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  8.45G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  8.45G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  8.45G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  8.45G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  8.45G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  8.45G|  let shifted =
   86|  8.45G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  8.45G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  8.45G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  8.45G|
   90|  8.45G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  8.45G|  cdf[nsymbs - 1] = count;
   92|  8.45G|}

