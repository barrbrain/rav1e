_RINvNtCsixsdkNzQ5tW_5rav1e2me22fullpel_diamond_searchhEB4_:
  951|   147k|fn fullpel_diamond_search<T: Pixel>(
  952|   147k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   147k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   147k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   147k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   147k|) {
  957|   147k|  // Define the initial and the final scale (log2) of the diamond.
  958|   147k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|   425k|  loop {
  961|   425k|    // Find the best candidate from the diamond pattern.
  962|   425k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  2.12M|    for &offset in &DIAMOND_R1_PATTERN {
  964|  1.70M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  1.70M|      let rd = get_fullpel_mv_rd(
  966|  1.70M|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  1.70M|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  1.70M|      );
  969|  1.70M|
  970|  1.70M|      if rd.cost < best_cand.rd.cost {
  971|   857k|        best_cand.mv = cand_mv;
  972|   857k|        best_cand.rd = rd;
  973|   857k|      }
  974|       |    }
  975|       |
  976|       |    // Continue the search at this scale until the can't find a better candidate
  977|       |    // to use.
  978|   425k|    if current.rd.cost <= best_cand.rd.cost {
  979|   294k|      if diamond_radius_log2 == diamond_radius_end_log2 {
  980|   147k|        break;
  981|   147k|      } else {
  982|   147k|        diamond_radius_log2 -= 1;
  983|   147k|      }
  984|   130k|    } else {
  985|   130k|      *current = best_cand;
  986|   130k|    }
  987|       |  }
  988|       |
  989|   147k|  assert!(!current.is_empty());
  990|   147k|}
