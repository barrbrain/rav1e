 1393|   275k|        blocks,
 1394|   275k|        TileBlockOffset(BlockOffset { x: 1 << xdec, y }),
 1395|   275k|        p,
 1396|   275k|        pli,
 1397|   275k|        bd,
 1398|   275k|        xdec,
 1399|   275k|        ydec,
