  283|  11.2k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  11.2k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  11.2k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
