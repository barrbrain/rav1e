  483|   344k|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  484|   344k|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  485|   344k|
