 1164|  4.73k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  4.73k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  4.73k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  4.73k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  4.73k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  4.73k|) {
 1170|  4.73k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  4.73k|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|  56.8k|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|   170k|    for &offset in &HORIZONTAL_LINE {
 1196|   113k|      let cand_mv = center + offset * i;
 1197|   113k|      let rd = get_fullpel_mv_rd(
 1198|   113k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|   113k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|   113k|      );
 1201|   113k|
 1202|   113k|      if rd.cost < current.rd.cost {
 1203|  4.82k|        current.mv = cand_mv;
 1204|  4.82k|        current.rd = rd;
 1205|   108k|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|  28.4k|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|  85.2k|    for &offset in &VERTICAL_LINE {
 1217|  56.8k|      let cand_mv = center + offset * i;
 1218|  56.8k|      let rd = get_fullpel_mv_rd(
 1219|  56.8k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|  56.8k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|  56.8k|      );
 1222|  56.8k|
 1223|  56.8k|      if rd.cost < current.rd.cost {
 1224|  1.18k|        current.mv = cand_mv;
 1225|  1.18k|        current.rd = rd;
 1226|  55.6k|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|  4.73k|  let center = current.mv;
 1232|  28.4k|  for row in -2..=2 {
 1233|   142k|    for col in -2..=2 {
 1234|   118k|      if row == 0 && col == 0 {
 1235|  4.73k|        continue;
 1236|   113k|      }
 1237|   113k|      let cand_mv = center + MotionVector { row, col };
 1238|   113k|      let rd = get_fullpel_mv_rd(
 1239|   113k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|   113k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|   113k|      );
 1242|   113k|
 1243|   113k|      if rd.cost < current.rd.cost {
 1244|    890|        current.mv = cand_mv;
 1245|    890|        current.rd = rd;
 1246|   112k|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|  4.73k|  let center = current.mv;
 1274|  4.73k|
 1275|  4.73k|  // Divide by 4, the radius of the UMH's hexagon.
 1276|  4.73k|  let iterations = me_range >> 2;
 1277|  28.4k|  for i in 1..=iterations {
 1278|   482k|    for &offset in &UMH_PATTERN {
 1279|   454k|      let cand_mv = center + offset * i;
 1280|   454k|      let rd = get_fullpel_mv_rd(
 1281|   454k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|   454k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|   454k|      );
 1284|   454k|
 1285|   454k|      if rd.cost < current.rd.cost {
 1286|  8.79k|        current.mv = cand_mv;
 1287|  8.79k|        current.rd = rd;
 1288|   445k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|  4.73k|  hexagon_search(
 1294|  4.73k|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|  4.73k|    mvx_max, mvy_min, mvy_max, w, h,
 1296|  4.73k|  );
 1297|  4.73k|}
