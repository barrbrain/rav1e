 1445|       |  } else {
 1446|  5.85M|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  7.57M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  7.57M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  7.57M|  let rate = rate1.min(rate2 + 1);
 1452|  7.57M|
 1453|  7.57M|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
 1454|  7.57M|}
