  230|  99.0M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  231|  99.0M|    Self::half_kernel((p0, p0), p1, m)
  232|  99.0M|  }
_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward15RotatePi4SubAvgINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|  84.3M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  84.3M|    let t = Self::ADD(p1, p0);
  181|  84.3M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  84.3M|    let out1 = Self::SUB(a, out0);
  183|  84.3M|    (out0, out1)
  184|  84.3M|  }
