_RNvYNtNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward12RotateSubAvgINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   335k|  $($s)* fn half_kernel(
  219|   335k|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   335k|  ) -> (T, T) {
  221|   335k|    let t = Self::ADD(p1, p0.0);
  222|   335k|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   335k|    let out0 = b.add(c);
  224|   335k|    let shifted = Self::SHIFT(c);
  225|   335k|    let out1 = Self::SUB(a, shifted);
  226|   335k|    (out0, out1)
  227|   335k|  }
_RNvYNtNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward12RotatePi4AddINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|   434k|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|   434k|    let t = Self::ADD(p1, p0);
  181|   434k|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|   434k|    let out1 = Self::SUB(a, out0);
  183|   434k|    (out0, out1)
  184|   434k|  }
