  230|  31.4M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  231|  31.4M|    Self::half_kernel((p0, p0), p1, m)
  232|  31.4M|  }
_RNvYNtNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward15RotatePi4AddAvgINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|  61.1M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  61.1M|    let t = Self::ADD(p1, p0);
  181|  61.1M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  61.1M|    let out1 = Self::SUB(a, out0);
  183|  61.1M|    (out0, out1)
  184|  61.1M|  }
_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward13butterfly_negNtB2_5I32X8EBa_:
  321|   264M|$($s)* fn butterfly_neg<T: TxOperations>(p0: T, p1: T) -> (T, (T, T)) {
  322|   264M|  let p1 = p0.sub(p1);
  323|   264M|  let p1h = p1.rshift1();
  324|   264M|  let p0h = p0.sub(p1h);
  325|   264M|  (p0h, (p1h, p1))
  326|   264M|}
_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward18butterfly_sub_asymNtB2_5I32X8EBa_:
  338|   320M|$($s)* fn butterfly_sub_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  339|   320M|  let p1 = p1h.sub(p0.0);
  340|   320M|  let p0 = p0.1.add(p1);
  341|   320M|  (p0, p1)
  342|   320M|}
