 1572|     36|fn sse_optimize<T: Pixel>(
 1573|     36|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|     36|  crop_h: usize, bd: usize, monochrome: bool,
 1575|     36|) -> [u8; 4] {
 1576|     36|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|     36|  assert!(
 1578|     36|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|     36|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|     36|      < 35
 1581|     36|  );
 1582|     36|  let mut level = [0; 4];
 1583|     36|  let planes = if monochrome { 1 } else { MAX_PLANES };
 1584|       |
 1585|    108|  for pli in 0..planes {
 1586|    108|    let mut v_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1587|    108|    let mut h_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1588|    108|
 1589|    108|    sse_plane(
 1590|    108|      &rec.planes[pli],
 1591|    108|      &input.planes[pli],
 1592|    108|      &mut v_tally,
 1593|    108|      &mut h_tally,
 1594|    108|      pli,
 1595|    108|      blocks,
 1596|    108|      crop_w,
 1597|    108|      crop_h,
 1598|    108|      bd,
 1599|    108|    );
 1600|       |
 1601|  6.91k|    for i in 1..=MAX_LOOP_FILTER {
 1602|  6.80k|      v_tally[i] += v_tally[i - 1];
 1603|  6.80k|      h_tally[i] += h_tally[i - 1];
 1604|  6.80k|    }
 1605|       |
 1606|    108|    match pli {
 1607|       |      0 => {
 1608|     36|        let mut best_v = 999;
 1609|     36|        let mut best_h = 999;
 1610|  2.34k|        for i in 0..=MAX_LOOP_FILTER {
 1611|  2.30k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|     44|            best_v = i;
 1613|  2.26k|          };
 1614|  2.30k|          if best_h == 999 || h_tally[best_h] > h_tally[i] {
 1615|     64|            best_h = i;
 1616|  2.24k|          };
 1617|       |        }
 1618|     36|        level[0] = best_v as u8;
 1619|     36|        level[1] = best_h as u8;
 1620|       |      }
 1621|       |      1 | 2 => {
 1622|     72|        let mut best = 999;
 1623|  4.68k|        for i in 0..=MAX_LOOP_FILTER {
 1624|  4.60k|          if best == 999
 1625|  4.53k|            || v_tally[best] + h_tally[best] > v_tally[i] + h_tally[i]
 1626|     92|          {
 1627|     92|            best = i;
 1628|  4.51k|          };
 1629|       |        }
 1630|     72|        level[pli + 1] = best as u8;
 1631|       |      }
 1632|      0|      _ => unreachable!(),
 1633|       |    }
 1634|       |  }
 1635|     36|  level
 1636|     36|}
