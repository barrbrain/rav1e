  120|    313|    cmp::min(sequence.max_frame_height, sequence.max_frame_width) as usize;
  121|    313|  let scale_func = if speed_mode == SceneDetectionSpeed::Fast {
  122|    161|    match small_edge {
  123|    161|      0..=240 => None,
  124|     22|      241..=480 => Some(ScaleFunction::from_scale::<2>()),
