   42|   160k|      for x in 0..w_in_imp_b {
   43|   160k|        let block_rect = Area::Rect {
   44|   160k|          x: (x << 3) as isize,
   45|   160k|          y: (y << 3) as isize,
   46|   160k|          width: 8,
   47|   160k|          height: 8,
   48|   160k|        };
   49|   160k|
   50|   160k|        let block = luma.subregion(block_rect);
   51|   160k|        let variance = variance_8x8(&block);
   52|   160k|        variances.push(variance);
   53|   160k|      }
   54|       |    }
   55|    524|    ActivityMask { variances: variances.into_boxed_slice() }
   56|    524|  }
