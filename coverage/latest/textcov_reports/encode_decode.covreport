  381|   109M|$($s)* fn daala_fdct4<T: TxOperations>(coeffs: &mut [T]) {
  382|   109M|  assert!(coeffs.len() >= 4);
  383|   109M|  let mut temp_out: [T; 4] = [T::zero(); 4];
  384|   109M|  daala_fdct_ii_4(coeffs[0], coeffs[1], coeffs[2], coeffs[3], &mut temp_out);
  385|   109M|
  386|   109M|  coeffs[0] = temp_out[0];
  387|   109M|  coeffs[1] = temp_out[2];
  388|   109M|  coeffs[2] = temp_out[1];
  389|   109M|  coeffs[3] = temp_out[3];
  390|   109M|}
