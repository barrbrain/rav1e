  381|  59.4M|$($s)* fn daala_fdct4<T: TxOperations>(coeffs: &mut [T]) {
  382|  59.4M|  assert!(coeffs.len() >= 4);
  383|  59.4M|  let mut temp_out: [T; 4] = [T::zero(); 4];
  384|  59.4M|  daala_fdct_ii_4(coeffs[0], coeffs[1], coeffs[2], coeffs[3], &mut temp_out);
