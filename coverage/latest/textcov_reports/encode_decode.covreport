  497|  34.0M|  let (r3, r4h) = butterfly_add(r3, r4);
  498|  34.0M|
  499|  34.0M|  // Embedded 4-point transforms with asymmetric input.
  500|  34.0M|  daala_fdct_ii_4_asym(r0h, r1, r2h, r3, &mut output[0..4]);
  501|  34.0M|  daala_fdst_iv_4_asym(r7, r6h, r5, r4h, &mut output[4..8]);
  502|  34.0M|  output[4..8].reverse();
  503|  34.0M|}
