_RNvNtCs5T1csxkeGwJ_5rav1e8quantize9select_qi:
   49|  16.7k|fn select_qi(quantizer: i64, qlookup: &[i16; QINDEX_RANGE]) -> u8 {
   50|  16.7k|  if quantizer < qlookup[MINQ] as i64 {
   51|    144|    MINQ as u8
   52|  16.5k|  } else if quantizer >= qlookup[MAXQ] as i64 {
   53|    629|    MAXQ as u8
   54|       |  } else {
   55|  15.9k|    match qlookup.binary_search(&(quantizer as i16)) {
   56|  8.80k|      Ok(qi) => qi as u8,
   57|  7.16k|      Err(qi) => {
   58|      0|        debug_assert!(qi > MINQ);
   59|      0|        debug_assert!(qi <= MAXQ);
