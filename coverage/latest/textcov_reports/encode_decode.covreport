  180|  24.8k|        for &ref_frame in inter_cfg.allowed_ref_frames() {
  181|  24.8k|          let frame_flag = 1 << fi.ref_frames[ref_frame.to_index()];
  182|  24.8k|          if tested_frames_flags & frame_flag == frame_flag {
  183|  15.1k|            continue;
  184|  9.67k|          }
