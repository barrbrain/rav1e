  456|  34.0M|$($s)* fn daala_fdst_iv_4_asym<T: TxOperations>(
  457|  34.0M|  q0: (T, T), q1h: T, q2: (T, T), q3h: T, output: &mut [T],
  458|  34.0M|) {
  459|  34.0M|  // Stage 0
  460|  34.0M|  //  9633/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/2 = 0.5879378012096793
  461|  34.0M|  //  12873/8192 = (Sin[7*Pi/16] - Cos[7*Pi/16])*2 = 1.5713899167742045
  462|  34.0M|  // 12785/32768 = Cos[7*Pi/16]*2                  = 0.3901806440322565
  463|  34.0M|  let (q0, q3) = RotateAddShift::half_kernel(
  464|  34.0M|    q0,
  465|  34.0M|    q3h,
  466|  34.0M|    ((9633, 14), (12873, 13), (12785, 15)),
  467|  34.0M|  );
  468|  34.0M|  // 11363/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/2 = 0.6935199226610738
  469|  34.0M|  // 18081/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*2 = 0.5517987585658861
  470|  34.0M|  //  4551/4096 = Cos[5*Pi/16]*2                  = 1.1111404660392044
  471|  34.0M|  let (q2, q1) = RotateSubShift::half_kernel(
  472|  34.0M|    q2,
  473|  34.0M|    q1h,
  474|  34.0M|    ((11363, 14), (18081, 15), (4551, 12)),
  475|  34.0M|  );
  476|  34.0M|
  477|  34.0M|  // Stage 1
  478|  34.0M|  let (q2, q3) = butterfly_sub_asym((q2.rshift1(), q2), q3);
  479|  34.0M|  let (q0, q1) = butterfly_sub_asym((q0.rshift1(), q0), q1);
  480|  34.0M|
  481|  34.0M|  // Stage 2
  482|  34.0M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  483|  34.0M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  484|  34.0M|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  485|  34.0M|
  486|  34.0M|  store_coeffs!(output, q0, q1, q2, q3);
  487|  34.0M|}
