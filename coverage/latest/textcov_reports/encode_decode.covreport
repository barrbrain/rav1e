_RNvNtCs5T1csxkeGwJ_5rav1e2me12get_mv_range:
  338|   244k|fn get_mv_range(
  339|   244k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   244k|  blk_h: usize,
  341|   244k|) -> (isize, isize, isize, isize) {
  342|   244k|  let border_w = 128 + blk_w as isize * 8;
  343|   244k|  let border_h = 128 + blk_h as isize * 8;
  344|   244k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   244k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   244k|    * (8 * MI_SIZE) as isize
  347|   244k|    + border_w;
  348|   244k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   244k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   244k|    * (8 * MI_SIZE) as isize
  351|   244k|    + border_h;
  352|   244k|
  353|   244k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   244k|  use crate::context::{MV_LOW, MV_UPP};
  355|   244k|  (
  356|   244k|    mvx_min.max(MV_LOW as isize + 1),
  357|   244k|    mvx_max.min(MV_UPP as isize - 1),
  358|   244k|    mvy_min.max(MV_LOW as isize + 1),
  359|   244k|    mvy_max.min(MV_UPP as isize - 1),
  360|   244k|  )
  361|   244k|}
