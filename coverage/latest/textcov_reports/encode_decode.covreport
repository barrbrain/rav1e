  125|  13.2G|const fn divu_pair(x: u32, d: (u32, u32, u32)) -> u32 {
  126|  13.2G|  let x = x as u64;
  127|  13.2G|  let (a, b, shift) = d;
  128|  13.2G|  let shift = shift as u64;
  129|  13.2G|  let a = a as u64;
  130|  13.2G|  let b = b as u64;
  131|  13.2G|
  132|  13.2G|  (((a * x + b) >> 32) >> shift) as u32
  133|  13.2G|}
