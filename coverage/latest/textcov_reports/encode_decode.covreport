  218|  28.9M|  $($s)* fn half_kernel(
  219|  28.9M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  28.9M|  ) -> (T, T) {
  221|  28.9M|    let t = Self::ADD(p1, p0.0);
  222|  28.9M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  28.9M|    let out0 = b.add(c);
  224|  28.9M|    let shifted = Self::SHIFT(c);
  225|  28.9M|    let out1 = Self::SUB(a, shifted);
  226|  28.9M|    (out0, out1)
  227|  28.9M|  }
