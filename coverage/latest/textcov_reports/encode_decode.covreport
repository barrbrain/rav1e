  486|    479|    if frame_bo.0.x > 0 {
  487|    396|      subset_c.push(process_cand(
  488|    396|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x - 1],
  489|    396|      ));
  490|    396|    }
  491|       |    // top
  492|    479|    if frame_bo.0.y > 0 {
  493|    396|      subset_c.push(process_cand(
  494|    396|        prev_frame[frame_bo.0.y - 1][frame_bo.0.x + clipped_half_w],
  495|    396|      ));
  496|    396|    }
  497|       |    // right
  498|    479|    if frame_bo.0.x + w < prev_frame.cols {
  499|    320|      subset_c.push(process_cand(
  500|    320|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + w],
  501|    320|      ));
  502|    320|    }
  503|       |    // bottom
  504|    479|    if frame_bo.0.y + h < prev_frame.rows {
  505|    320|      subset_c.push(process_cand(
  506|    320|        prev_frame[frame_bo.0.y + h][frame_bo.0.x + clipped_half_w],
  507|    320|      ));
  508|    320|    }
  509|       |
  510|    479|    subset_c.push(process_cand(
  511|    479|      prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + clipped_half_w],
  512|    479|    ));
  513|      0|  }
  514|       |
