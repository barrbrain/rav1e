 1572|  4.95k|fn sse_optimize<T: Pixel>(
 1573|  4.95k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  4.95k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  4.95k|) -> [u8; 4] {
 1576|  4.95k|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|  4.95k|  assert!(
 1578|  4.95k|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|  4.95k|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|  4.95k|      < 35
 1581|  4.95k|  );
