  394|  21.7k|  fn new(
  395|  21.7k|    cdeffed: &PlaneSlice<'a, T>, deblocked: &PlaneSlice<'a, T>,
  396|  21.7k|    stripe_h: usize, crop: usize,
  397|  21.7k|  ) -> VertPaddedIter<'a, T> {
  398|  21.7k|    // cdeffed and deblocked must start at the same coordinates from their
  399|  21.7k|    // underlying planes. Since cropping is provided via a separate params, the
  400|  21.7k|    // height of the underlying planes do not need to match.
  401|  21.7k|    assert_eq!(cdeffed.x, deblocked.x);
  402|  21.7k|    assert_eq!(cdeffed.y, deblocked.y);
  403|       |
