 1438|  11.5M|fn compute_mv_rd<T: Pixel>(
 1439|  11.5M|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  11.5M|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  11.5M|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  11.5M|) -> MVCandidateRD {
 1443|  11.5M|  let sad = if use_satd {
 1444|  2.69M|    get_satd(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1445|       |  } else {
 1446|  8.86M|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  11.5M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  11.5M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  11.5M|  let rate = rate1.min(rate2 + 1);
 1452|  11.5M|
