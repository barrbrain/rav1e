  303|   178M|$($s)* fn butterfly_add<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  304|   178M|  let p0 = p0.add(p1);
  305|   178M|  let p0h = p0.rshift1();
  306|   178M|  let p1h = p1.sub(p0h);
  307|   178M|  ((p0h, p0), p1h)
  308|   178M|}
