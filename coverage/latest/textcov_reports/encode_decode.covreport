  256|  77.6k|        fi,
  257|  77.6k|        ts,
  258|  77.6k|        w,
  259|  77.6k|        h,
  260|  77.6k|        sub_bo,
  261|  77.6k|        ref_frame,
  262|  77.6k|        None,
  263|  77.6k|        corner,
  264|  77.6k|        init,
  265|  77.6k|        ssdec,
  266|  77.6k|        Some(lambda),
  267|  77.6k|      ) {
  268|  68.0k|        // normalize sad to 128x128 block
  269|  68.0k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  68.0k|          / (w * h) as u64) as u32;
  271|  68.0k|        save_me_stats(
  272|  68.0k|          ts,
  273|  68.0k|          mv_size_in_b_log2,
  274|  68.0k|          sub_bo,
  275|  68.0k|          ref_frame,
  276|  68.0k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  68.0k|        );
  278|  68.0k|      }
  279|       |    }
  280|       |  }
