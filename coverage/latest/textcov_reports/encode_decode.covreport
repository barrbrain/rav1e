  430|   143M|    // Write out the coefficients using the correct method for transforms of
  431|   143M|    // this size.
  432|   143M|    match row_class {
  433|       |      SizeClass1D::X8UP => {
  434|       |        // Store output in at most 32x32 chunks. See rust code for details.
  435|       |
  436|       |        // Output is grouped into 32x32 chunks so a stride of at most 32 is
  437|       |        // used for each chunk
  438|  63.6M|        let output_stride = txfm_size_row.min(32);
  439|  63.6M|
  440|  63.6M|        // Split the first 32 rows from the last 32 rows and offset by rg % 32
  441|  63.6M|        let output = &mut output[(rg & 31)
  442|  63.6M|          + (rg >= 32) as usize * output_stride * txfm_size_col.min(32)..];
  443|       |
  444|  64.4M|        for cg in (0..txfm_size_col).step_by(32) {
  445|       |          // Offset by zero or half of output
  446|  64.4M|          let output = &mut output[txfm_size_row * cg..];
  447|       |
  448|   790M|          for c in 0..txfm_size_col.min(32) {
  449|   790M|            match T::Pixel::type_enum() {
  450|   790M|              PixelType::U8 => {
  451|   790M|                let vec = row_coeffs[c + cg].vec();
  452|   790M|                let lo = _mm256_castsi256_si128(vec);
  453|   790M|                let hi = _mm256_extracti128_si256(vec, 1);
  454|   790M|                _mm_storeu_si128(
  455|   790M|                  output[c * output_stride..].as_mut_ptr() as *mut _,
  456|   790M|                  _mm_packs_epi32(lo, hi),
  457|   790M|                );
  458|   790M|              }
  459|      0|              PixelType::U16 => {
  460|      0|                _mm256_storeu_si256(
  461|      0|                  output[c * output_stride..].as_mut_ptr() as *mut _,
  462|      0|                  row_coeffs[c + cg].vec(),
  463|      0|                );
  464|      0|              }
  465|       |            }
  466|       |          }
  467|       |        }
  468|       |      }
  469|       |      SizeClass1D::X4 => {
  470|       |        // Write out coefficients in normal order - it isn't possible to have
  471|       |        // more than 32 rows.
  472|   381M|        for c in 0..txfm_size_col {
  473|   381M|          match T::Pixel::type_enum() {
  474|   381M|            PixelType::U8 => {
  475|   381M|              let lo = _mm256_castsi256_si128(row_coeffs[c].vec());
  476|   381M|              _mm_storel_epi64(
  477|   381M|                output[c * txfm_size_row + rg..].as_mut_ptr() as *mut _,
  478|   381M|                _mm_packs_epi32(lo, lo),
  479|   381M|              );
  480|   381M|            }
  481|      0|            PixelType::U16 => {
  482|      0|              _mm256_storeu_si256(
  483|      0|                output[c * txfm_size_row + rg..].as_mut_ptr() as *mut _,
  484|      0|                row_coeffs[c].vec(),
  485|      0|              );
  486|      0|            }
  487|       |          }
  488|       |        }
  489|       |      }
  490|       |    }
  491|       |  }
  492|   128M|}
