  239|  54.0M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  240|  54.0M|    let t = Self::ADD(p0, p1);
  241|  54.0M|    let (a, b, c) = (p0.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  242|  54.0M|    let out0 = b.sub(c);
  243|  54.0M|    let out1 = c.sub(a);
  244|  54.0M|    (out0, out1)
  245|  54.0M|  }
