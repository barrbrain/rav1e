_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward20daala_fdct_ii_8_asymNtB2_5I32X8EBa_:
  643|  24.8M|$($s)* fn daala_fdct_ii_8_asym<T: TxOperations>(
  644|  24.8M|  r0h: T, r1: (T, T), r2h: T, r3: (T, T), r4h: T, r5: (T, T), r6h: T,
  645|  24.8M|  r7: (T, T), output: &mut [T],
  646|  24.8M|) {
  647|  24.8M|  // +/- Butterflies with asymmetric input.
  648|  24.8M|  let (r0, r7) = butterfly_neg_asym(r0h, r7);
  649|  24.8M|  let (r1, r6) = butterfly_sub_asym(r1, r6h);
  650|  24.8M|  let (r2, r5) = butterfly_neg_asym(r2h, r5);
  651|  24.8M|  let (r3, r4) = butterfly_sub_asym(r3, r4h);
  652|  24.8M|
  653|  24.8M|  // Embedded 4-point orthonormal transforms.
  654|  24.8M|  daala_fdct_ii_4(r0, r1, r2, r3, &mut output[0..4]);
  655|  24.8M|  daala_fdst_iv_4(r7, r6, r5, r4, &mut output[4..8]);
  656|  24.8M|  output[4..8].reverse();
  657|  24.8M|}
