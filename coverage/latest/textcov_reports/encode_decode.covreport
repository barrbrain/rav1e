   59|    125|    is_422_p: bool,
   60|    125|  ) -> Self {
   61|    125|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    125|
   63|    125|    // Frame::new() aligns to the next multiple of 8
   64|    125|    let frame_width = frame_width.align_power_of_two(3);
   65|    125|    let frame_height = frame_height.align_power_of_two(3);
   66|    125|    let frame_width_sb =
   67|    125|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    125|    let frame_height_sb =
   69|    125|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    125|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    125|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    125|
   73|    125|    // these are bitstream-defined values and must not be changed
   74|    125|    let max_tile_width_sb = MAX_TILE_WIDTH >> sb_size_log2;
   75|    125|    let max_tile_area_sb = MAX_TILE_AREA >> (2 * sb_size_log2);
   76|    125|    let min_tile_cols_log2 =
   77|    125|      Self::tile_log2(max_tile_width_sb, sb_cols).unwrap();
   78|    125|    let max_tile_cols_log2 =
   79|    125|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    125|    let max_tile_rows_log2 =
   81|    125|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    125|    let min_tiles_log2 = min_tile_cols_log2
   83|    125|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    125|
   85|    125|    // Implements restriction in Annex A of the spec.
   86|    125|    // Unlike the other restrictions, this one does not change
   87|    125|    // the header coding of the tile rows/cols.
   88|    125|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    125|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    125|        .ceil()
   91|    125|        .log2()
   92|    125|        .ceil() as usize,
   93|    125|    );
   94|    125|
   95|    125|    let tile_cols_log2 =
   96|    125|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    125|    let tile_width_sb_pre =
   98|    125|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
  100|       |    // If this is 4:2:2, our UV horizontal is subsampled but not our
  101|       |    // vertical.  Loop Restoration Units must be square, so they
  102|       |    // will always have an even number of horizontal superblocks. For
  103|       |    // tiles and LRUs to align, tile_width_sb must be even in 4:2:2
  104|       |    // video.
  105|       |
  106|       |    // This is only relevant when doing loop restoration RDO inline
  107|       |    // with block/superblock encoding, that is, where tiles are
  108|       |    // relevant.  If (when) we introduce optionally delaying loop-filter
  109|       |    // encode to after the partitioning loop, we won't need to make
  110|       |    // any 4:2:2 adjustment.
  111|       |
  112|    125|    let tile_width_sb = if is_422_p {
  113|     16|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    109|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    125|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    125|
  120|    125|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    125|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    125|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    125|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    125|      0
  128|       |    };
  129|    125|    let min_tile_rows_ratelimit_log2 =
  130|    125|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    125|        0
  134|       |      };
  135|    125|    let tile_rows_log2 = tile_rows_log2
  136|    125|      .max(min_tile_rows_log2)
  137|    125|      .max(min_tile_rows_ratelimit_log2)
  138|    125|      .min(max_tile_rows_log2);
  139|    125|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    125|
  141|    125|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    125|
  143|    125|    Self {
  144|    125|      frame_width,
  145|    125|      frame_height,
  146|    125|      tile_width_sb,
  147|    125|      tile_height_sb,
  148|    125|      cols,
  149|    125|      rows,
  150|    125|      tile_cols_log2,
  151|    125|      tile_rows_log2,
  152|    125|      min_tile_cols_log2,
  153|    125|      max_tile_cols_log2,
  154|    125|      min_tile_rows_log2,
  155|    125|      max_tile_rows_log2,
  156|    125|      sb_size_log2,
  157|    125|      min_tiles_log2,
  158|    125|    }
  159|    125|  }
