  242|   128M|  pub fn quantize<T: Coefficient>(
  243|   128M|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|   128M|  ) -> usize {
  245|   128M|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|   128M|
  247|   128M|    qcoeffs[0] = {
  248|   128M|      let coeff: i32 =
  249|   128M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|   128M|      let abs_coeff = coeff.unsigned_abs();
  251|   128M|      T::cast_from(copysign(
  252|   128M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|   128M|        coeff,
  254|   128M|      ))
  255|   128M|    };
  256|   128M|
  257|   128M|    // Find the last non-zero coefficient using our smaller biases and
  258|   128M|    // zero everything else.
  259|   128M|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|   128M|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|   128M|    let deadzone = T::cast_from(
  262|   128M|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|   128M|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|   128M|    );
  265|   128M|    let eob = {
  266|   128M|      // We skip the DC coefficient since it has its own quantizer index.
  267|   128M|      let eob_minus_two =
  268|   128M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|   128M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|   128M|      })
  276|   128M|    };
  277|   128M|
  278|   128M|    // Here we use different rounding biases depending on whether we've
  279|   128M|    // had recent coefficients that are larger than one, or less than
  280|   128M|    // one. The reason for this is that a block usually has a chunk of
  281|   128M|    // large coefficients and a tail of zeroes and ones, and the tradeoffs
  282|   128M|    // for coding these two are different. In the tail of zeroes and ones,
  283|   128M|    // you'll likely end up spending most bits just saying where that
  284|   128M|    // coefficient is in the block, whereas in the chunk of larger
  285|   128M|    // coefficients, most bits will be spent on coding its magnitude.
  286|   128M|    // To that end, we want to bias more toward rounding to zero for
  287|   128M|    // that tail of zeroes and ones than we do for the larger coefficients.
  288|   128M|    let mut level_mode = 1;
  289|  6.55G|    for &pos in scan.iter().take(eob).skip(1) {
  290|  6.55G|      let coeff = i32::cast_from(coeffs[pos as usize]) << self.log_tx_scale;
  291|  6.55G|      let abs_coeff = coeff.unsigned_abs();
  292|  6.55G|
  293|  6.55G|      let level0 = divu_pair(abs_coeff, self.ac_mul_add);
  294|  6.55G|      let offset = if level0 > 1 - level_mode {
  295|  2.83G|        self.ac_offset1
  296|       |      } else {
  297|  3.71G|        self.ac_offset0
  298|       |      };
  299|       |
  300|  6.55G|      let abs_qcoeff: u32 = divu_pair(abs_coeff + offset, self.ac_mul_add);
  301|  6.55G|      if level_mode != 0 && abs_qcoeff == 0 {
  302|   426M|        level_mode = 0;
  303|  6.12G|      } else if abs_qcoeff > 1 {
  304|  2.63G|        level_mode = 1;
  305|  3.48G|      }
  306|       |
  307|  6.55G|      qcoeffs[pos as usize] = T::cast_from(copysign(abs_qcoeff, coeff));
  308|       |    }
  309|       |
  310|       |    // Rather than zeroing the tail in scan order, assume that qcoeffs is
  311|       |    // pre-filled with zeros.
  312|       |
  313|       |    // Check the eob is correct
  314|       |    debug_assert_eq!(
  315|       |      eob,
  316|      0|      scan
  317|      0|        .iter()
  318|      0|        .rposition(|&i| qcoeffs[i as usize] != T::cast_from(0))
  319|      0|        .map(|n| n + 1)
  320|      0|        .unwrap_or(0)
  321|       |    );
  322|       |
  323|   128M|    eob
  324|   128M|  }
