 1339|  1.57M|        fi,
 1340|  1.57M|        po,
 1341|  1.57M|        org_region,
 1342|  1.57M|        bit_depth,
 1343|  1.57M|        pmv,
 1344|  1.57M|        lambda,
 1345|  1.57M|        use_satd,
 1346|  1.57M|        mvx_min,
 1347|  1.57M|        mvx_max,
 1348|  1.57M|        mvy_min,
 1349|  1.57M|        mvy_max,
 1350|  1.57M|        w,
 1351|  1.57M|        h,
 1352|  1.57M|        cand_mv,
 1353|  1.57M|        &mut tmp_region,
 1354|  1.57M|        ref_frame,
 1355|  1.57M|      );
 1356|  1.57M|
 1357|  1.57M|      if rd.cost < best_cand.rd.cost {
 1358|   796k|        best_cand.mv = cand_mv;
 1359|   796k|        best_cand.rd = rd;
 1360|   796k|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|   394k|    if current.rd.cost <= best_cand.rd.cost {
 1365|   193k|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|  96.5k|        break;
 1367|  96.5k|      } else {
 1368|  96.5k|        diamond_radius_log2 -= 1;
 1369|  96.5k|      }
 1370|   201k|    } else {
