  723|  57.5M|pub fn compute_rd_cost<T: Pixel>(
  724|  57.5M|  fi: &FrameInvariants<T>, rate: u32, distortion: ScaledDistortion,
  725|  57.5M|) -> f64 {
  726|  57.5M|  let rate_in_bits = (rate as f64) / ((1 << OD_BITRES) as f64);
  727|  57.5M|  fi.lambda.mul_add(rate_in_bits, distortion.0 as f64)
  728|  57.5M|}
