  455|   140k|        [tile_bo.0.x + clipped_half_w],
  456|   140k|    ))
  457|  3.27k|  } else if subset_b.len() != 3 {
  458|  3.27k|    None
  459|       |  } else {
  460|      0|    let mut rows: ArrayVec<i16, 3> = subset_b.iter().map(|&a| a.row).collect();
  461|      0|    let mut cols: ArrayVec<i16, 3> = subset_b.iter().map(|&a| a.col).collect();
  462|      0|    rows.as_mut_slice().sort_unstable();
  463|      0|    cols.as_mut_slice().sort_unstable();
  464|      0|    Some(MotionVector { row: rows[1], col: cols[1] })
  465|       |  };
  466|       |
  467|       |  // Zero motion vector, don't use add_cand since it skips zero vectors.
  468|   144k|  subset_b.push(MotionVector::default());
  469|       |
  470|       |  // EPZS subset C predictors.
  471|       |  // Sample the middle of bordering side of the left, right, top and bottom
  472|       |  // blocks of the previous frame.
  473|       |  // Sample the middle of this block in the previous frame.
  474|       |
  475|   144k|  if let Some(frame_me_stats) = frame_ref_opt {
  476|   144k|    let prev_frame = &frame_me_stats[ref_frame_id];
  477|   144k|
  478|   144k|    let frame_bo = PlaneBlockOffset(BlockOffset {
  479|   144k|      x: tile_me_stats.x() + tile_bo.0.x,
  480|   144k|      y: tile_me_stats.y() + tile_bo.0.y,
  481|   144k|    });
  482|   144k|    let clipped_half_w = (w >> 1).min(prev_frame.cols - 1 - frame_bo.0.x);
  483|   144k|    let clipped_half_h = (h >> 1).min(prev_frame.rows - 1 - frame_bo.0.y);
  484|   144k|
  485|   144k|    // left
  486|   144k|    if frame_bo.0.x > 0 {
  487|   124k|      subset_c.push(process_cand(
  488|   124k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x - 1],
  489|   124k|      ));
  490|   124k|    }
  491|       |    // top
  492|   144k|    if frame_bo.0.y > 0 {
  493|   123k|      subset_c.push(process_cand(
  494|   123k|        prev_frame[frame_bo.0.y - 1][frame_bo.0.x + clipped_half_w],
  495|   123k|      ));
  496|   123k|    }
  497|       |    // right
  498|   144k|    if frame_bo.0.x + w < prev_frame.cols {
  499|   121k|      subset_c.push(process_cand(
  500|   121k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + w],
  501|   121k|      ));
  502|   121k|    }
  503|       |    // bottom
  504|   144k|    if frame_bo.0.y + h < prev_frame.rows {
  505|   121k|      subset_c.push(process_cand(
  506|   121k|        prev_frame[frame_bo.0.y + h][frame_bo.0.x + clipped_half_w],
  507|   121k|      ));
  508|   121k|    }
  509|       |
  510|   144k|    subset_c.push(process_cand(
  511|   144k|      prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + clipped_half_w],
  512|   144k|    ));
  513|      0|  }
  514|       |
  515|       |  // Undo normalization to 128x128 block size
  516|   144k|  let min_sad = ((min_sad as u64 * (pix_w * pix_h) as u64)
  517|   144k|    >> (MAX_SB_SIZE_LOG2 * 2)) as u32;
  518|   144k|
  519|   144k|  let dec_mv = |mv: MotionVector| MotionVector {
  520|       |    col: mv.col >> ssdec,
  521|       |    row: mv.row >> ssdec,
  522|       |  };
  523|   144k|  let median = median.map(dec_mv);
  524|   521k|  for mv in subset_b.iter_mut() {
  525|   521k|    *mv = dec_mv(*mv);
  526|   521k|  }
  527|   634k|  for mv in subset_c.iter_mut() {
  528|   634k|    *mv = dec_mv(*mv);
  529|   634k|  }
  530|       |
  531|   144k|  MotionEstimationSubsets { min_sad, median, subset_b, subset_c }
  532|   144k|}
