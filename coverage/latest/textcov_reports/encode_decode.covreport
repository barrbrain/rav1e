  660|   144k|$($s)* fn daala_fdst_iv_8_asym<T: TxOperations>(
  661|   144k|  r0: (T, T), r1h: T, r2: (T, T), r3h: T, r4: (T, T), r5h: T, r6: (T, T),
  662|   144k|  r7h: T, output: &mut [T],
  663|   144k|) {
  664|   144k|  // Stage 0
  665|   144k|  // 12665/16384 = (Sin[15*Pi/32] + Cos[15*Pi/32])/Sqrt[2] = 0.77301045336274
  666|   144k|  //   5197/4096 = (Sin[15*Pi/32] - Cos[15*Pi/32])*Sqrt[2] = 1.26878656832729
  667|   144k|  //  2271/16384 = Cos[15*Pi/32]*Sqrt[2]                   = 0.13861716919909
  668|   144k|  let (r0, r7) =
  669|   144k|    RotateAdd::half_kernel(r0, r7h, ((12665, 14), (5197, 12), (2271, 14)));
  670|   144k|  // 14449/16384 = Sin[13*Pi/32] + Cos[13*Pi/32])/Sqrt[2] = 0.881921264348355
  671|   144k|  // 30893/32768 = Sin[13*Pi/32] - Cos[13*Pi/32])*Sqrt[2] = 0.942793473651995
  672|   144k|  //   3363/8192 = Cos[13*Pi/32]*Sqrt[2]                  = 0.410524527522357
  673|   144k|  let (r6, r1) =
  674|   144k|    RotateSub::half_kernel(r6, r1h, ((14449, 14), (30893, 15), (3363, 13)));
  675|   144k|  // 15679/16384 = Sin[11*Pi/32] + Cos[11*Pi/32])/Sqrt[2] = 0.956940335732209
  676|   144k|  //   1189/2048 = Sin[11*Pi/32] - Cos[11*Pi/32])*Sqrt[2] = 0.580569354508925
  677|   144k|  //   5461/8192 = Cos[11*Pi/32]*Sqrt[2]                  = 0.666655658477747
  678|   144k|  let (r2, r5) =
  679|   144k|    RotateAdd::half_kernel(r2, r5h, ((15679, 14), (1189, 11), (5461, 13)));
  680|   144k|  // 16305/16384 = (Sin[9*Pi/32] + Cos[9*Pi/32])/Sqrt[2] = 0.9951847266721969
  681|   144k|  //    803/4096 = (Sin[9*Pi/32] - Cos[9*Pi/32])*Sqrt[2] = 0.1960342806591213
  682|   144k|  // 14699/16384 = Cos[9*Pi/32]*Sqrt[2]                  = 0.8971675863426364
  683|   144k|  let (r4, r3) =
  684|   144k|    RotateSub::half_kernel(r4, r3h, ((16305, 14), (803, 12), (14699, 14)));
  685|   144k|
  686|   144k|  // Stage 1
  687|   144k|  let (r0, r3h) = butterfly_add(r0, r3);
  688|   144k|  let (r2, r1h) = butterfly_sub(r2, r1);
  689|   144k|  let (r5, r6h) = butterfly_add(r5, r6);
  690|   144k|  let (r7, r4h) = butterfly_sub(r7, r4);
  691|   144k|
  692|   144k|  // Stage 2
  693|   144k|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  694|   144k|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  695|   144k|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  696|   144k|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  697|   144k|
  698|   144k|  // Stage 3
  699|   144k|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  700|   144k|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  701|   144k|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  702|   144k|  let (r3, r4) =
  703|   144k|    RotateSubAvg::kernel(r3, r4, ((669, 9), (8867, 14), (3135, 12)));
  704|   144k|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  705|   144k|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  706|   144k|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  707|   144k|  let (r2, r5) =
  708|   144k|    RotateNegAvg::kernel(r2, r5, ((669, 9), (8867, 14), (3135, 12)));
  709|   144k|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  710|   144k|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  711|   144k|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((5793, 12), (11585, 13)));
  712|   144k|
  713|   144k|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  714|   144k|}
_RNvYNtNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward9RotateAddINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  1.85M|  $($s)* fn half_kernel(
  219|  1.85M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  1.85M|  ) -> (T, T) {
  221|  1.85M|    let t = Self::ADD(p1, p0.0);
  222|  1.85M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  1.85M|    let out0 = b.add(c);
  224|  1.85M|    let shifted = Self::SHIFT(c);
  225|  1.85M|    let out1 = Self::SUB(a, shifted);
  226|  1.85M|    (out0, out1)
  227|  1.85M|  }
