 1304|   157k|fn subpel_diamond_search<T: Pixel>(
 1305|   157k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|   157k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|   157k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|   157k|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|   157k|  ref_frame: RefType,
 1310|   157k|) {
 1311|   157k|  use crate::util::Aligned;
 1312|   157k|
 1313|   157k|  // Motion compensation assembly has special requirements for edges
 1314|   157k|  let mc_w = w.next_power_of_two();
 1315|   157k|  let mc_h = (h + 1) & !1;
 1316|   157k|
