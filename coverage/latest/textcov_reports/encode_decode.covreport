  425|  43.2M|$($s)* fn daala_fdct_ii_2<T: TxOperations>(p0: T, p1: T) -> (T, T) {
  426|  43.2M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4]  = 1.4142135623730951
  427|  43.2M|  // 11585/8192 = 2*Cos[Pi/4]            = 1.4142135623730951
  428|  43.2M|  let (p1, p0) = RotatePi4SubAvg::kernel(p1, p0, ((11585, 13), (11585, 13)));
