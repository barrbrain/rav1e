  360|  6.48M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  6.48M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  6.48M|    svar =
  363|  6.48M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
