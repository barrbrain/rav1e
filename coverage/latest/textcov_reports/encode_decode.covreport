 1304|  96.5k|fn subpel_diamond_search<T: Pixel>(
 1305|  96.5k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|  96.5k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
