_RNvMNtCs5T1csxkeGwJ_5rav1e8quantizeNtB2_19QuantizationContext6update:
  195|  76.3M|  pub fn update(
  196|  76.3M|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|  76.3M|    dc_delta_q: i8, ac_delta_q: i8,
  198|  76.3M|  ) {
  199|  76.3M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|  76.3M|
  201|  76.3M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|  76.3M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|  76.3M|
  204|  76.3M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|  76.3M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|  76.3M|
  207|  76.3M|    // All of these biases were derived by measuring the cost of coding
  208|  76.3M|    // a zero vs coding a one on any given coefficient position, or, in
  209|  76.3M|    // the case of the EOB bias, the cost of coding the block with
  210|  76.3M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|  76.3M|    // to choose a new EOB. This was done over several clips, with the
  212|  76.3M|    // average of the bit costs taken over all blocks in the set, and a new
  213|  76.3M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|  76.3M|    // Journal of Dubious Theoretical Results[1], aka:
  215|  76.3M|    //
  216|  76.3M|    // lambda = ln(2) / 6.0
  217|  76.3M|    // threshold = 0.5 + (lambda * avg_rate_diff) / 2.0
  218|  76.3M|    // bias = 1 - threshold
  219|  76.3M|    //
  220|  76.3M|    // lambda is a constant since our offsets are already adjusted for the
  221|  76.3M|    // quantizer.
  222|  76.3M|    //
  223|  76.3M|    // Biases were then updated, and cost collection was re-run, until
  224|  76.3M|    // the calculated biases started to converge after 2-4 iterations.
  225|  76.3M|    //
  226|  76.3M|    // In theory, the rounding biases for inter should be somewhat smaller
  227|  76.3M|    // than the biases for intra, but this turns out to only be the case
  228|  76.3M|    // for EOB optimization, or at least, is covered by EOB optimization.
  229|  76.3M|    // The RD-optimal rounding biases for the actual coefficients seem
  230|  76.3M|    // to be quite close (+/- 1/256), for both inter and intra,
  231|  76.3M|    // post-deadzoning.
  232|  76.3M|    //
  233|  76.3M|    // [1] https://jmvalin.ca/notes/theoretical_results.pdf
  234|  76.3M|    self.dc_offset = self.dc_quant * (if is_intra { 109 } else { 108 }) / 256;
  235|  76.3M|    self.ac_offset0 = self.ac_quant * (if is_intra { 98 } else { 97 }) / 256;
  236|  76.3M|    self.ac_offset1 = self.ac_quant * (if is_intra { 109 } else { 108 }) / 256;
  237|       |    self.ac_offset_eob =
  238|  76.3M|      self.ac_quant * (if is_intra { 88 } else { 44 }) / 256;
  239|  76.3M|  }
