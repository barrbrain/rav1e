  224|  27.5k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  27.5k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  27.5k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  27.5k|
