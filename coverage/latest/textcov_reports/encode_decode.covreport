  218|   347M|  $($s)* fn half_kernel(
  219|   347M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   347M|  ) -> (T, T) {
  221|   347M|    let t = Self::ADD(p1, p0.0);
  222|   347M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   347M|    let out0 = b.add(c);
  224|   347M|    let shifted = Self::SHIFT(c);
  225|   347M|    let out1 = Self::SUB(a, shifted);
  226|   347M|    (out0, out1)
  227|   347M|  }
