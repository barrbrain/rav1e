  463|  5.74M|pub fn spatiotemporal_scale<T: Pixel>(
  464|  5.74M|  fi: &FrameInvariants<T>, frame_bo: PlaneBlockOffset, bsize: BlockSize,
  465|  5.74M|) -> DistortionScale {
  466|  5.74M|  if !fi.config.temporal_rdo() && fi.config.tune != Tune::Psychovisual {
  467|      0|    return DistortionScale::default();
  468|  5.74M|  }
  469|  5.74M|
  470|  5.74M|  let coded_data = fi.coded_frame_data.as_ref().unwrap();
  471|  5.74M|
  472|  5.74M|  let x0 = frame_bo.0.x >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  473|  5.74M|  let y0 = frame_bo.0.y >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  474|  5.74M|  let x1 = (x0 + bsize.width_imp_b()).min(coded_data.w_in_imp_b);
  475|  5.74M|  let y1 = (y0 + bsize.height_imp_b()).min(coded_data.h_in_imp_b);
  476|  5.74M|  let den = (((x1 - x0) * (y1 - y0)) as u64) << DistortionScale::SHIFT;
  477|  5.74M|
  478|  5.74M|  // calling this on each slice individually improves autovectorization
  479|  5.74M|  // compared to using `Iterator::take`
  480|  5.74M|  #[inline(always)]
  481|  5.74M|  fn take_slice<T>(slice: &[T], n: usize) -> &[T] {
  482|  5.74M|    if n >= slice.len() {
  483|  5.74M|      slice
  484|  5.74M|    } else {
  485|  5.74M|      &slice[..n]
  486|  5.74M|    }
  487|  5.74M|  }
  488|  5.74M|
  489|  5.74M|  let mut sum = 0;
  490|  6.95M|  for y in y0..y1 {
  491|  6.95M|    sum += take_slice(
  492|  6.95M|      &coded_data.distortion_scales[y * coded_data.w_in_imp_b..][x0..x1],
  493|  6.95M|      MAX_SB_IN_IMP_B,
  494|  6.95M|    )
  495|  6.95M|    .iter()
  496|  6.95M|    .zip(
  497|  6.95M|      take_slice(
  498|  6.95M|        &coded_data.activity_scales[y * coded_data.w_in_imp_b..][x0..x1],
  499|  6.95M|        MAX_SB_IN_IMP_B,
  500|  6.95M|      )
  501|  6.95M|      .iter(),
  502|  6.95M|    )
  503|  6.95M|    .map(|(d, a)| d.0 as u64 * a.0 as u64)
  504|  6.95M|    .sum::<u64>();
  505|  6.95M|  }
  506|  5.74M|  DistortionScale(((sum + (den >> 1)) / den) as u32)
  507|  5.74M|}
