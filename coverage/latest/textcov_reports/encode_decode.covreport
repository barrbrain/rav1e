  218|  41.1M|  $($s)* fn half_kernel(
  219|  41.1M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  41.1M|  ) -> (T, T) {
  221|  41.1M|    let t = Self::ADD(p1, p0.0);
  222|  41.1M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  41.1M|    let out0 = b.add(c);
  224|  41.1M|    let shifted = Self::SHIFT(c);
  225|  41.1M|    let out1 = Self::SUB(a, shifted);
  226|  41.1M|    (out0, out1)
  227|  41.1M|  }
