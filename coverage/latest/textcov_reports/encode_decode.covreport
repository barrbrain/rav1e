 1176|  2.69k|  fn pick_strength_from_q(&mut self, qps: &QuantizerParameters) {
 1177|  2.69k|    self.cdef_damping = 3 + (self.base_q_idx >> 6);
 1178|  2.69k|    let q = bexp64(qps.log_target_q as i64 + q57(QSCALE)) as f32;
 1179|       |    /* These coefficients were trained on libaom. */
 1180|  2.69k|    let (y_f1, y_f2, uv_f1, uv_f2) = if !self.intra_only {
 1181|  1.13k|      (
 1182|  1.13k|        poly2(q, -0.0000023593946_f32, 0.0068615186_f32, 0.02709886_f32, 15),
 1183|  1.13k|        poly2(q, -0.00000057629734_f32, 0.0013993345_f32, 0.03831067_f32, 3),
 1184|  1.13k|        poly2(q, -0.0000007095069_f32, 0.0034628846_f32, 0.00887099_f32, 15),
 1185|  1.13k|        poly2(q, 0.00000023874085_f32, 0.00028223585_f32, 0.05576307_f32, 3),
 1186|  1.13k|      )
 1187|       |    } else {
 1188|  1.56k|      (
 1189|  1.56k|        poly2(q, 0.0000033731974_f32, 0.008070594_f32, 0.0187634_f32, 15),
 1190|  1.56k|        poly2(q, 0.0000029167343_f32, 0.0027798624_f32, 0.0079405_f32, 3),
 1191|  1.56k|        poly2(q, -0.0000130790995_f32, 0.012892405_f32, -0.00748388_f32, 15),
 1192|  1.56k|        poly2(q, 0.0000032651783_f32, 0.00035520183_f32, 0.00228092_f32, 3),
 1193|  1.56k|      )
 1194|       |    };
 1195|  2.69k|    self.cdef_y_strengths[0] = (y_f1 * CDEF_SEC_STRENGTHS as i32 + y_f2) as u8;
 1196|  2.69k|    self.cdef_uv_strengths[0] =
 1197|  2.69k|      (uv_f1 * CDEF_SEC_STRENGTHS as i32 + uv_f2) as u8;
