 1701|  13.2M|  $($s)* fn reorder_4<T: TxOperations>(
 1702|  13.2M|    output: &mut [T], i: usize, tmp: [T; 64], j: usize
 1703|  13.2M|  ) {
 1704|  13.2M|    output[0 + i * 4] = tmp[0 + j];
 1705|  13.2M|    output[1 + i * 4] = tmp[32 + j];
 1706|  13.2M|    output[2 + i * 4] = tmp[16 + j];
 1707|  13.2M|    output[3 + i * 4] = tmp[48 + j];
 1708|  13.2M|  }
