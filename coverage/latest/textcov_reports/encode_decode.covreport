  393|  39.2M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  39.2M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  39.2M|  let q0 = coeffs[0];
  397|  39.2M|  let q1 = coeffs[1];
  398|  39.2M|  let q2 = coeffs[2];
  399|  39.2M|  let q3 = coeffs[3];
  400|  39.2M|  let t0 = q1.add(q3);
  401|  39.2M|  // t1 = (q0 + q1 - q3)/2
  402|  39.2M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  39.2M|  let t2 = q0.sub(q1);
  404|  39.2M|  let t3 = q2;
  405|  39.2M|  let t4 = q0.add(q3);
  406|  39.2M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  39.2M|  let t0 = t0.tx_mul((7021, 14));
  408|  39.2M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  39.2M|  let t1 = t1.tx_mul((37837, 15));
  410|  39.2M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  39.2M|  let t2 = t2.tx_mul((21513, 15));
  412|  39.2M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  39.2M|  let t3 = t3.tx_mul((37837, 15));
  414|  39.2M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  39.2M|  let t4 = t4.tx_mul((467, 11));
  416|  39.2M|  let t3h = t3.rshift1();
  417|  39.2M|  let u4 = t4.add(t3h);
  418|  39.2M|  coeffs[0] = t0.add(u4);
  419|  39.2M|  coeffs[1] = t1;
  420|  39.2M|  coeffs[2] = t0.add(t2.sub(t3h));
  421|  39.2M|  coeffs[3] = t2.add(t3.sub(u4));
  422|  39.2M|}
