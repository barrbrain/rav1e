  339|  2.96M|    let sum_d = sum_d as u64;
  340|  2.96M|
  341|  2.96M|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  2.96M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  2.96M|    //    (n = # samples i.e. area)
  344|  2.96M|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  2.96M|    // When w and h are powers of two, this can be done via shifting.
  346|  2.96M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  2.96M|    let div_shift = AREA_DIVISOR_BITS;
  348|  2.96M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  2.96M|    // two. Saturate to avoid underflow.
  350|  2.96M|    let mut svar = sum_s2.saturating_sub(
  351|  2.96M|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  2.96M|    );
  353|  2.96M|    let mut dvar = sum_d2.saturating_sub(
  354|  2.96M|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  2.96M|    );
  356|  2.96M|
  357|  2.96M|    // Scale variances up to 8x8 size.
  358|  2.96M|    //   scaled variance = var * (8x8) / wxh
  359|  2.96M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  2.96M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  2.96M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  2.96M|    svar =
  363|  2.96M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  2.96M|    dvar =
  365|  2.96M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  2.96M|
  367|  2.96M|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  2.96M|  }
