 1460|  33.5k|) -> MotionSearchResult {
 1461|  33.5k|  let search_region = p_ref.region(Area::Rect {
 1462|  33.5k|    x: x_lo,
 1463|  33.5k|    y: y_lo,
 1464|  33.5k|    width: (x_hi - x_lo) as usize + w,
 1465|  33.5k|    height: (y_hi - y_lo) as usize + h,
 1466|  33.5k|  });
 1467|  33.5k|
 1468|  33.5k|  let mut best: MotionSearchResult = MotionSearchResult::empty();
