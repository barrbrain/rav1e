   79|  98.9M|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  98.9M|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  98.9M|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
