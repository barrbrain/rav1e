  242|  83.7M|  pub fn quantize<T: Coefficient>(
  243|  83.7M|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|  83.7M|  ) -> usize {
  245|  83.7M|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|  83.7M|
  247|  83.7M|    qcoeffs[0] = {
  248|  83.7M|      let coeff: i32 =
  249|  83.7M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|  83.7M|      let abs_coeff = coeff.unsigned_abs();
  251|  83.7M|      T::cast_from(copysign(
  252|  83.7M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
