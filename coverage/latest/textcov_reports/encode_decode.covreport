  246|  11.1k|      pub fn restoration_unit_last_sb_for_rdo<T: Pixel>(
  247|  11.1k|        &self,
  248|  11.1k|        fi: &FrameInvariants<T>,
  249|  11.1k|        global_sbo: PlaneSuperBlockOffset,
  250|  11.1k|        tile_sbo: TileSuperBlockOffset,
  251|  11.1k|      ) -> bool {
  252|  11.1k|        // there is 1 restoration unit for (1 << sb_shift) super-blocks
  253|  11.1k|        let h_mask = (1 << self.rp_cfg.sb_h_shift) - 1;
  254|  11.1k|        let v_mask = (1 << self.rp_cfg.sb_v_shift) - 1;
  255|  11.1k|        // is this a stretch block?
  256|  11.1k|        let x_stretch = tile_sbo.0.x >> self.rp_cfg.sb_h_shift >= self.units.cols;
  257|  11.1k|        let y_stretch = tile_sbo.0.y >> self.rp_cfg.sb_v_shift >= self.units.rows;
  258|  11.1k|        // Need absolute superblock offsets for edge check, not local to the tile.
  259|  11.1k|        let sbx = global_sbo.0.x + tile_sbo.0.x;
  260|  11.1k|        let sby = global_sbo.0.y + tile_sbo.0.y;
  261|       |        // edge-of-tile check + edge-of-frame check
  262|  11.1k|        let last_x = (tile_sbo.0.x & h_mask == h_mask && !x_stretch) || sbx == fi.sb_width-1;
  263|  11.1k|        let last_y = (tile_sbo.0.y & v_mask == v_mask && !y_stretch) || sby == fi.sb_height-1;
  264|  11.1k|        last_x && last_y
  265|  11.1k|      }
