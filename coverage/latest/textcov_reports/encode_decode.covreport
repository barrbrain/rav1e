  134|  1.27k|  let d = alpha * 36 - (i << 24);
  135|  1.27k|  ((((t0 as i64) << 32) + (((t1 - t0) << 8) as i64) * (d as i64)) >> 32) as i32
  136|  1.27k|}
_RNvMs3_NtCsixsdkNzQ5tW_5rav1e4rateNtB5_7RCState12update_state:
 1084|    973|  pub fn update_state(
 1085|    973|    &mut self, bits: i64, fti: usize, show_frame: bool, log_target_q: i64,
 1086|    973|    trial: bool, droppable: bool,
 1087|    973|  ) -> bool {
 1088|    973|    if trial {
 1089|    434|      assert!(self.needs_trial_encode(fti));
 1090|    434|      assert!(bits > 0);
 1091|    539|    }
 1092|    973|    let mut dropped = false;
 1093|    973|    // Update rate control only if rate control is active.
 1094|    973|    if self.target_bitrate > 0 {
 1095|    906|      let mut estimated_bits = 0;
 1096|    906|      let mut bits = bits;
