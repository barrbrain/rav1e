_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward15daala_fdct_ii_8NtB2_5I32X8EBa_:
  490|  34.0M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  34.0M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  34.0M|) {
