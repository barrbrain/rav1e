  237|  4.27M|  pub fn get_weighted_sse<T: Pixel>(
  238|  4.27M|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|  4.27M|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|  4.27M|    _cpu: CpuFeatureLevel,
  241|  4.27M|  ) -> u64 {
  242|  4.27M|    // Always chunk and apply scaling on the sse of squares the size of
  243|  4.27M|    // decimated/sub-sampled importance block sizes.
  244|  4.27M|    // Warning: Changing this will require changing/disabling assembly.
  245|  4.27M|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|  4.27M|
  247|  4.27M|    let mut sse: u64 = 0;
  248|       |
  249|  11.3M|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|  42.0M|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|  42.0M|        let mut block_sse: u32 = 0;
  252|       |
  253|   153M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|   153M|          let s1 = &src1[block_y * chunk_size + j]
  255|   153M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|   153M|          let s2 = &src2[block_y * chunk_size + j]
  257|   153M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|   153M|
  259|   153M|          block_sse += s1
  260|   153M|            .iter()
  261|   153M|            .zip(s2)
  262|   153M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|   153M|            })
  266|   153M|            .sum::<u32>();
  267|   153M|        }
  268|       |
  269|  42.0M|        sse += (block_sse as u64
  270|  42.0M|          * scale[block_y * scale_stride + block_x] as u64
  271|  42.0M|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|  42.0M|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|  4.27M|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|  4.27M|    (sse + (den >> 1)) / den
  277|  4.27M|  }
_RINvNtNtCsgGiEFdpFC8m_5rav1e4dist4rust16cdef_dist_kernelhEB6_:
  296|  11.9M|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  11.9M|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  11.9M|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  11.9M|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  11.9M|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  11.9M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  11.9M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  11.9M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  11.9M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|  65.2M|    for j in 0..h {
  319|  65.2M|      let row1 = &src[j][0..w];
  320|  65.2M|      let row2 = &dst[j][0..w];
  321|   338M|      for (s, d) in row1.iter().zip(row2) {
  322|   338M|        let s: u32 = u32::cast_from(*s);
  323|   338M|        let d: u32 = u32::cast_from(*d);
  324|   338M|        sum_s += s;
  325|   338M|        sum_d += d;
  326|   338M|
  327|   338M|        sum_s2 += s * s;
  328|   338M|        sum_d2 += d * d;
  329|   338M|        sum_sd += s * d;
  330|   338M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  11.9M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  11.9M|
  337|  11.9M|    // Convert to 64-bits to avoid overflow when squaring
  338|  11.9M|    let sum_s = sum_s as u64;
  339|  11.9M|    let sum_d = sum_d as u64;
  340|  11.9M|
  341|  11.9M|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  11.9M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  11.9M|    //    (n = # samples i.e. area)
  344|  11.9M|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  11.9M|    // When w and h are powers of two, this can be done via shifting.
  346|  11.9M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  11.9M|    let div_shift = AREA_DIVISOR_BITS;
  348|  11.9M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  11.9M|    // two. Saturate to avoid underflow.
  350|  11.9M|    let mut svar = sum_s2.saturating_sub(
  351|  11.9M|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  11.9M|    );
  353|  11.9M|    let mut dvar = sum_d2.saturating_sub(
  354|  11.9M|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  11.9M|    );
  356|  11.9M|
  357|  11.9M|    // Scale variances up to 8x8 size.
  358|  11.9M|    //   scaled variance = var * (8x8) / wxh
  359|  11.9M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  11.9M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  11.9M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  11.9M|    svar =
  363|  11.9M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  11.9M|    dvar =
  365|  11.9M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  11.9M|
  367|  11.9M|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  11.9M|  }
