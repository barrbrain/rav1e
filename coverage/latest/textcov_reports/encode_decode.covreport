   80|  13.1G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  13.1G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  13.1G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  13.1G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  13.1G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  13.1G|  let shifted =
   86|  13.1G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  13.1G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  13.1G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  13.1G|
   90|  13.1G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  13.1G|  cdf[nsymbs - 1] = count;
   92|  13.1G|}

