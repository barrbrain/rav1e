  320|  32.9M|      let row2 = &dst[j][0..w];
  321|   152M|      for (s, d) in row1.iter().zip(row2) {
  322|   152M|        let s: u32 = u32::cast_from(*s);
  323|   152M|        let d: u32 = u32::cast_from(*d);
  324|   152M|        sum_s += s;
  325|   152M|        sum_d += d;
  326|   152M|
  327|   152M|        sum_s2 += s * s;
  328|   152M|        sum_d2 += d * d;
  329|   152M|        sum_sd += s * d;
  330|   152M|      }
  331|       |    }
