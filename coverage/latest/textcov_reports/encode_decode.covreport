  198|   825k|    static BLOCK_LUT: [[Result<BlockSize, InvalidBlockSize>; 6]; 6] = [
  199|   825k|      [
  200|   825k|        Ok(BLOCK_4X4),
  201|   825k|        Ok(BLOCK_4X8),
  202|   825k|        Ok(BLOCK_4X16),
  203|   825k|        Err(InvalidBlockSize), // X32
  204|   825k|        Err(InvalidBlockSize), // X64
  205|   825k|        Err(InvalidBlockSize), // X128
  206|   825k|      ],
  207|   825k|      [
  208|   825k|        Ok(BLOCK_8X4),
  209|   825k|        Ok(BLOCK_8X8),
  210|   825k|        Ok(BLOCK_8X16),
  211|   825k|        Ok(BLOCK_8X32),
  212|   825k|        Err(InvalidBlockSize), // X64
  213|   825k|        Err(InvalidBlockSize), // X128
  214|   825k|      ],
  215|   825k|      [
  216|   825k|        Ok(BLOCK_16X4),
  217|   825k|        Ok(BLOCK_16X8),
  218|   825k|        Ok(BLOCK_16X16),
  219|   825k|        Ok(BLOCK_16X32),
  220|   825k|        Ok(BLOCK_16X64),
  221|   825k|        Err(InvalidBlockSize), // X128
  222|   825k|      ],
  223|   825k|      [
  224|   825k|        Err(InvalidBlockSize), // X4
  225|   825k|        Ok(BLOCK_32X8),
  226|   825k|        Ok(BLOCK_32X16),
  227|   825k|        Ok(BLOCK_32X32),
  228|   825k|        Ok(BLOCK_32X64),
  229|   825k|        Err(InvalidBlockSize), // X128
  230|   825k|      ],
  231|   825k|      [
  232|   825k|        Err(InvalidBlockSize), // X4
  233|   825k|        Err(InvalidBlockSize), // X8
  234|   825k|        Ok(BLOCK_64X16),
  235|   825k|        Ok(BLOCK_64X32),
  236|   825k|        Ok(BLOCK_64X64),
  237|   825k|        Ok(BLOCK_64X128),
  238|   825k|      ],
  239|   825k|      [
  240|   825k|        Err(InvalidBlockSize), // X4
  241|   825k|        Err(InvalidBlockSize), // X8
  242|   825k|        Err(InvalidBlockSize), // X16
  243|   825k|        Err(InvalidBlockSize), // X32
  244|   825k|        Ok(BLOCK_128X64),
  245|   825k|        Ok(BLOCK_128X128),
  246|   825k|      ],
  247|   825k|    ];
  248|   825k|
  249|   825k|    if (4..=128).contains(&w) && (4..=128).contains(&h) {
  250|       |      // Check if w and h are both powers of 2; writing
  251|       |      // it this way allows us to reuse the tzcnt result later on.
  252|       |      //
  253|       |      // SAFETY: w/h are always nonzero due to previous range checks.
  254|   780k|      let w_tz = unsafe { NonZeroUsize::new_unchecked(w).trailing_zeros() };
  255|   780k|      if 1 << w_tz != w {
  256|  11.8k|        return Err(InvalidBlockSize);
  257|   768k|      }
  258|   768k|      let h_tz = unsafe { NonZeroUsize::new_unchecked(h).trailing_zeros() };
