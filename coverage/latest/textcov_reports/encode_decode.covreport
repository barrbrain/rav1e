   29|  12.9G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  12.9G|  let nsymbs = 4;
   31|  12.9G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  12.9G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  12.9G|
   34|  12.9G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  12.9G|  // implementation:
   36|  12.9G|  //
   37|  12.9G|  // ```
   38|  12.9G|  // if i as u32 >= val {
   39|  12.9G|  //   *v -= *v >> rate;
   40|  12.9G|  // } else {
   41|  12.9G|  //   *v += (32768 - *v) >> rate;
   42|  12.9G|  // }
   43|  12.9G|  // ```
   44|  12.9G|  //
   45|  12.9G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  12.9G|  // transform in something like:
   47|  12.9G|  //
   48|  12.9G|  // ```
   49|  12.9G|  // if i as u32 >= val {
   50|  12.9G|  //   *v -= *v >> rate;
   51|  12.9G|  // } else {
   52|  12.9G|  //   *v -= -((32768 - *v) >> rate);
   53|  12.9G|  // }
   54|  12.9G|  // ```
   55|  12.9G|  //
   56|  12.9G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  12.9G|  // using the following rule:
   58|  12.9G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  12.9G|  // So we obtain
   60|  12.9G|  //
   61|  12.9G|  // ```
   62|  12.9G|  // if i as u32 >= val {
   63|  12.9G|  //   *v -= *v >> rate;
   64|  12.9G|  // } else {
   65|  12.9G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  12.9G|  // }
   67|  12.9G|  // ```
   68|  12.9G|  //
   69|  12.9G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  12.9G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  12.9G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  12.9G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  12.9G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  12.9G|  //
   75|  12.9G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  12.9G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  12.9G|
   78|  12.9G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  12.9G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  12.9G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  12.9G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  12.9G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  12.9G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  12.9G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  12.9G|  let shifted =
   86|  12.9G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  12.9G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  12.9G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  12.9G|
   90|  12.9G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  12.9G|  cdf[nsymbs - 1] = count;
   92|  12.9G|}

