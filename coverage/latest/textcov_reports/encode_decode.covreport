  776|  5.27k|  // position determine the level:
  777|  5.27k|  // 00 -> 0
  778|  5.27k|  // 01 -> 2
  779|  5.27k|  // 10 -> 1
  780|  5.27k|  // 11 -> 2
  781|  5.27k|  pyramid_depth - (pos | (1 << pyramid_depth)).trailing_zeros() as u64
  782|  5.27k|}
