   59|    457|    is_422_p: bool,
   60|    457|  ) -> Self {
   61|    457|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    457|
   63|    457|    // Frame::new() aligns to the next multiple of 8
   64|    457|    let frame_width = frame_width.align_power_of_two(3);
   65|    457|    let frame_height = frame_height.align_power_of_two(3);
   66|    457|    let frame_width_sb =
   67|    457|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    457|    let frame_height_sb =
   69|    457|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    457|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    457|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
