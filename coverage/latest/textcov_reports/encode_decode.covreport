  115|  2.63M|    let coeffs_abs = _mm256_abs_epi16(coeffs);
  116|  2.63M|
  117|  2.63M|    // TODO: Since log_tx_scale is at most 2 and we gain an extra bit by taking
  118|  2.63M|    // the abs value (unless the range is [-(2^15), 2^15 + 1]), it might be
  119|  2.63M|    // possible to perform a 16-bit multiply and get the highest bit by
  120|  2.63M|    // comparing coeffs to (1<<16) / quant. The would cost 1 compare, 1 blend,
  121|  2.63M|    // and 1 add, but would get rid of 1 pack, 2 unpacks, 1 shift, and 1
  122|  2.63M|    // multiply.
  123|  2.63M|
  124|  2.63M|    let rcoeffs = _mm256_sign_epi16(
