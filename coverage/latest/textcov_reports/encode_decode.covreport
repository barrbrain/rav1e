  513|   170k|      let ctx_offset = if num_pels_log2_lookup[plane_bsize as usize]
  514|   170k|        > num_pels_log2_lookup[tx_size.block_size() as usize]
  515|       |      {
  516|  5.68k|        10
  517|       |      } else {
  518|   164k|        7
  519|       |      };
  520|   170k|      txb_ctx.txb_skip_ctx = ctx_base + ctx_offset;
  521|       |    }
  522|       |
  523|   535k|    txb_ctx
