  219|  16.8k|fn estimate_sb_motion<T: Pixel>(
  220|  16.8k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  16.8k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  16.8k|  lambda: u32,
  223|  16.8k|) {
  224|  16.8k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  16.8k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  16.8k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  16.8k|
  228|  16.8k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  32.8k|  for y in (0..sb_h).step_by(mv_size) {
  232|  77.6k|    for x in (0..sb_w).step_by(mv_size) {
  233|  77.6k|      let corner: MVSamplingMode = if init {
  234|  5.61k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  72.0k|        MVSamplingMode::CORNER {
  239|  72.0k|          right: x as usize & mv_size == mv_size,
  240|  72.0k|          bottom: y as usize & mv_size == mv_size,
  241|  72.0k|        }
  242|       |      };
  243|       |
  244|  77.6k|      let sub_bo = tile_bo
  245|  77.6k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|  77.6k|
  247|  77.6k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|  77.6k|      // The rounding makes some assumptions about how subsampling is done.
  249|  77.6k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|  77.6k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
