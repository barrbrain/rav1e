 2201|  91.8k|    let txw_log2 = tx_size.width_log2();
 2202|  91.8k|    ((frame_clipped_bw + (1 << txw_log2) - 1) >> txw_log2) << txw_log2
 2203|       |  } else {
 2204|   374k|    bsize.width()
 2205|       |  };
 2206|   465k|  let max_luma_h = if bsize.height() > BlockSize::BLOCK_8X8.height() {
 2207|  87.3k|    let txh_log2 = tx_size.height_log2();
 2208|  87.3k|    ((frame_clipped_bh + (1 << txh_log2) - 1) >> txh_log2) << txh_log2
 2209|       |  } else {
 2210|   378k|    bsize.height()
 2211|       |  };
 2212|       |
 2213|   465k|  let max_luma_x: usize = max_luma_w.max(8) - (1 << xdec);
