_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward15daala_fdct_ii_8NtB2_5I32X8EBa_:
  490|  15.4M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  15.4M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  15.4M|) {
  493|  15.4M|  // +/- Butterflies with asymmetric output.
  494|  15.4M|  let (r0h, r7) = butterfly_neg(r0, r7);
  495|  15.4M|  let (r1, r6h) = butterfly_add(r1, r6);
  496|  15.4M|  let (r2h, r5) = butterfly_neg(r2, r5);
  497|  15.4M|  let (r3, r4h) = butterfly_add(r3, r4);
  498|  15.4M|
  499|  15.4M|  // Embedded 4-point transforms with asymmetric input.
  500|  15.4M|  daala_fdct_ii_4_asym(r0h, r1, r2h, r3, &mut output[0..4]);
  501|  15.4M|  daala_fdst_iv_4_asym(r7, r6h, r5, r4h, &mut output[4..8]);
  502|  15.4M|  output[4..8].reverse();
  503|  15.4M|}
