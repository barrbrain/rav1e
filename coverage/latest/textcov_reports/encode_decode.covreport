  577|   505k|        rec[1][i].as_(),
  578|   505k|        rec[2][i].as_(),
  579|   505k|        rec[3][i].as_(),
  580|   505k|        rec[4][i].as_(),
  581|   505k|        rec[5][i].as_(),
