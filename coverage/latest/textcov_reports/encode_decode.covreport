 1055|  7.43k|) {
 1056|  7.43k|  // The first iteration of hexagon search is implemented separate from
 1057|  7.43k|  // subsequent iterations, which overlap with previous iterations.
 1058|  7.43k|
 1059|  7.43k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  7.43k|  // candidates have already been tested in a previous iteration and can be
 1061|  7.43k|  // skipped.
 1062|  7.43k|  let mut best_cand_idx: usize = 0;
 1063|  7.43k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  52.0k|  for i in 0..6 {
 1067|  44.6k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  44.6k|    let rd = get_fullpel_mv_rd(
 1069|  44.6k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  44.6k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  44.6k|    );
 1072|  44.6k|
 1073|  44.6k|    if rd.cost < best_cand.rd.cost {
 1074|  15.7k|      best_cand_idx = i;
 1075|  15.7k|      best_cand.mv = cand_mv;
 1076|  15.7k|      best_cand.rd = rd;
 1077|  28.8k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  10.0k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|  2.62k|    *current = best_cand;
 1085|  2.62k|    best_cand = MotionSearchResult::empty();
 1086|  2.62k|
 1087|  2.62k|    // Save the index/direction taken in the previous iteration to the current
 1088|  2.62k|    // search location.
 1089|  2.62k|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
