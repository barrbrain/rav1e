   68|    708|    let frame_height_sb =
   69|    708|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    708|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    708|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    708|
