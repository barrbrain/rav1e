  471|  11.3M|
  472|  11.3M|  let x0 = frame_bo.0.x >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  473|  11.3M|  let y0 = frame_bo.0.y >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  474|  11.3M|  let x1 = (x0 + bsize.width_imp_b()).min(coded_data.w_in_imp_b);
  475|  11.3M|  let y1 = (y0 + bsize.height_imp_b()).min(coded_data.h_in_imp_b);
