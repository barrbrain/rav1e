_RINvNtCsixsdkNzQ5tW_5rav1e2me23uneven_multi_hex_searchhEB4_:
 1164|  3.16k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  3.16k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  3.16k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  3.16k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  3.16k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  3.16k|) {
 1170|  3.16k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  3.16k|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|  37.9k|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|   113k|    for &offset in &HORIZONTAL_LINE {
 1196|  75.9k|      let cand_mv = center + offset * i;
 1197|  75.9k|      let rd = get_fullpel_mv_rd(
 1198|  75.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|  75.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|  75.9k|      );
 1201|  75.9k|
 1202|  75.9k|      if rd.cost < current.rd.cost {
 1203|  3.27k|        current.mv = cand_mv;
 1204|  3.27k|        current.rd = rd;
 1205|  72.6k|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|  18.9k|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|  56.9k|    for &offset in &VERTICAL_LINE {
 1217|  37.9k|      let cand_mv = center + offset * i;
 1218|  37.9k|      let rd = get_fullpel_mv_rd(
 1219|  37.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|  37.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|  37.9k|      );
 1222|  37.9k|
 1223|  37.9k|      if rd.cost < current.rd.cost {
 1224|    787|        current.mv = cand_mv;
 1225|    787|        current.rd = rd;
 1226|  37.1k|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|  3.16k|  let center = current.mv;
 1232|  18.9k|  for row in -2..=2 {
 1233|  94.8k|    for col in -2..=2 {
 1234|  79.0k|      if row == 0 && col == 0 {
 1235|  3.16k|        continue;
 1236|  75.9k|      }
 1237|  75.9k|      let cand_mv = center + MotionVector { row, col };
 1238|  75.9k|      let rd = get_fullpel_mv_rd(
 1239|  75.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|  75.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|  75.9k|      );
 1242|  75.9k|
 1243|  75.9k|      if rd.cost < current.rd.cost {
 1244|    556|        current.mv = cand_mv;
 1245|    556|        current.rd = rd;
 1246|  75.3k|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|  3.16k|  let center = current.mv;
 1274|  3.16k|
 1275|  3.16k|  // Divide by 4, the radius of the UMH's hexagon.
 1276|  3.16k|  let iterations = me_range >> 2;
 1277|  18.9k|  for i in 1..=iterations {
 1278|   322k|    for &offset in &UMH_PATTERN {
 1279|   303k|      let cand_mv = center + offset * i;
 1280|   303k|      let rd = get_fullpel_mv_rd(
 1281|   303k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|   303k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|   303k|      );
 1284|   303k|
 1285|   303k|      if rd.cost < current.rd.cost {
 1286|  6.14k|        current.mv = cand_mv;
 1287|  6.14k|        current.rd = rd;
 1288|   297k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|  3.16k|  hexagon_search(
 1294|  3.16k|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|  3.16k|    mvx_max, mvy_min, mvy_max, w, h,
 1296|  3.16k|  );
 1297|  3.16k|}
