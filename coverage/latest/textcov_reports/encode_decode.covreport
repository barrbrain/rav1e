_RNvMNtNtCs3tIhnEwGhQF_5rav1e6tiling5tilerNtB2_10TilingInfo17from_target_tiles:
   56|    283|  pub fn from_target_tiles(
   57|    283|    sb_size_log2: usize, frame_width: usize, frame_height: usize,
   58|    283|    frame_rate: f64, tile_cols_log2: usize, tile_rows_log2: usize,
   59|    283|    is_422_p: bool,
   60|    283|  ) -> Self {
   61|    283|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    283|
   63|    283|    // Frame::new() aligns to the next multiple of 8
   64|    283|    let frame_width = frame_width.align_power_of_two(3);
   65|    283|    let frame_height = frame_height.align_power_of_two(3);
   66|    283|    let frame_width_sb =
   67|    283|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    283|    let frame_height_sb =
   69|    283|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    283|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    283|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    283|
   73|    283|    // these are bitstream-defined values and must not be changed
   74|    283|    let max_tile_width_sb = MAX_TILE_WIDTH >> sb_size_log2;
   75|    283|    let max_tile_area_sb = MAX_TILE_AREA >> (2 * sb_size_log2);
   76|    283|    let min_tile_cols_log2 =
   77|    283|      Self::tile_log2(max_tile_width_sb, sb_cols).unwrap();
   78|    283|    let max_tile_cols_log2 =
   79|    283|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    283|    let max_tile_rows_log2 =
   81|    283|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    283|    let min_tiles_log2 = min_tile_cols_log2
   83|    283|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    283|
   85|    283|    // Implements restriction in Annex A of the spec.
   86|    283|    // Unlike the other restrictions, this one does not change
   87|    283|    // the header coding of the tile rows/cols.
   88|    283|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    283|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    283|        .ceil()
   91|    283|        .log2()
   92|    283|        .ceil() as usize,
   93|    283|    );
   94|    283|
   95|    283|    let tile_cols_log2 =
   96|    283|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    283|    let tile_width_sb_pre =
   98|    283|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
  100|       |    // If this is 4:2:2, our UV horizontal is subsampled but not our
  101|       |    // vertical.  Loop Restoration Units must be square, so they
  102|       |    // will always have an even number of horizontal superblocks. For
  103|       |    // tiles and LRUs to align, tile_width_sb must be even in 4:2:2
  104|       |    // video.
  105|       |
  106|       |    // This is only relevant when doing loop restoration RDO inline
  107|       |    // with block/superblock encoding, that is, where tiles are
  108|       |    // relevant.  If (when) we introduce optionally delaying loop-filter
  109|       |    // encode to after the partitioning loop, we won't need to make
  110|       |    // any 4:2:2 adjustment.
  111|       |
  112|    283|    let tile_width_sb = if is_422_p {
  113|     37|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    246|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    283|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    283|
  120|    283|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    283|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    283|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    283|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    283|      0
  128|       |    };
  129|    283|    let min_tile_rows_ratelimit_log2 =
  130|    283|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    283|        0
  134|       |      };
  135|    283|    let tile_rows_log2 = tile_rows_log2
  136|    283|      .max(min_tile_rows_log2)
  137|    283|      .max(min_tile_rows_ratelimit_log2)
  138|    283|      .min(max_tile_rows_log2);
  139|    283|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    283|
  141|    283|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    283|
  143|    283|    Self {
  144|    283|      frame_width,
  145|    283|      frame_height,
  146|    283|      tile_width_sb,
  147|    283|      tile_height_sb,
  148|    283|      cols,
  149|    283|      rows,
  150|    283|      tile_cols_log2,
  151|    283|      tile_rows_log2,
  152|    283|      min_tile_cols_log2,
  153|    283|      max_tile_cols_log2,
  154|    283|      min_tile_rows_log2,
  155|    283|      max_tile_rows_log2,
  156|    283|      sb_size_log2,
  157|    283|      min_tiles_log2,
  158|    283|    }
  159|    283|  }
