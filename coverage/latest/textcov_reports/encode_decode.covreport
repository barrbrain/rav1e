 1246|  1.81M|  t0h: T, t1: (T, T), t2h: T, t3: (T, T), t4h: T, t5: (T, T), t6h: T,
 1247|  1.81M|  t7: (T, T), t8h: T, t9: (T, T), tah: T, tb: (T, T), tch: T, td: (T, T),
 1248|  1.81M|  teh: T, tf: (T, T), tgh: T, th: (T, T), tih: T, tj: (T, T), tkh: T,
 1249|  1.81M|  tl: (T, T), tmh: T, tn: (T, T), toh: T, tp: (T, T), tqh: T, tr: (T, T),
 1250|  1.81M|  tsh: T, tt: (T, T), tuh: T, tv: (T, T), output: &mut [T],
 1251|  1.81M|) {
 1252|  1.81M|  // +/- Butterflies with asymmetric input.
 1253|  1.81M|  let (t0, tv) = butterfly_neg_asym(t0h, tv);
 1254|  1.81M|  let (t1, tu) = butterfly_sub_asym(t1, tuh);
