 1304|  95.2k|fn subpel_diamond_search<T: Pixel>(
 1305|  95.2k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|  95.2k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|  95.2k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|  95.2k|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|  95.2k|  ref_frame: RefType,
 1310|  95.2k|) {
 1311|  95.2k|  use crate::util::Aligned;
 1312|  95.2k|
 1313|  95.2k|  // Motion compensation assembly has special requirements for edges
 1314|  95.2k|  let mc_w = w.next_power_of_two();
 1315|  95.2k|  let mc_h = (h + 1) & !1;
 1316|  95.2k|
 1317|  95.2k|  // Metadata for subpel scratch pad.
 1318|  95.2k|  let cfg = PlaneConfig::new(mc_w, mc_h, 0, 0, 0, 0, std::mem::size_of::<T>());
 1319|  95.2k|  // Stack allocation for subpel scratch pad.
 1320|  95.2k|  // SAFETY: We write to the array below before reading from it.
 1321|  95.2k|  let mut buf: Aligned<[T; 128 * 128]> = unsafe { Aligned::uninitialized() };
 1322|  95.2k|  let mut tmp_region = PlaneRegionMut::from_slice(
 1323|  95.2k|    &mut buf.data,
 1324|  95.2k|    &cfg,
 1325|  95.2k|    Rect { x: 0, y: 0, width: cfg.width, height: cfg.height },
 1326|  95.2k|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|  95.2k|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|  95.2k|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|   388k|  loop {
 1333|   388k|    // Find the best candidate from the diamond pattern.
 1334|   388k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  1.94M|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  1.55M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  1.55M|
 1338|  1.55M|      let rd = get_subpel_mv_rd(
 1339|  1.55M|        fi,
 1340|  1.55M|        po,
 1341|  1.55M|        org_region,
 1342|  1.55M|        bit_depth,
 1343|  1.55M|        pmv,
 1344|  1.55M|        lambda,
 1345|  1.55M|        use_satd,
 1346|  1.55M|        mvx_min,
 1347|  1.55M|        mvx_max,
 1348|  1.55M|        mvy_min,
 1349|  1.55M|        mvy_max,
 1350|  1.55M|        w,
 1351|  1.55M|        h,
 1352|  1.55M|        cand_mv,
 1353|  1.55M|        &mut tmp_region,
 1354|  1.55M|        ref_frame,
 1355|  1.55M|      );
 1356|  1.55M|
 1357|  1.55M|      if rd.cost < best_cand.rd.cost {
 1358|   782k|        best_cand.mv = cand_mv;
 1359|   782k|        best_cand.rd = rd;
 1360|   782k|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|   388k|    if current.rd.cost <= best_cand.rd.cost {
 1365|   190k|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|  95.2k|        break;
 1367|  95.2k|      } else {
 1368|  95.2k|        diamond_radius_log2 -= 1;
 1369|  95.2k|      }
 1370|   197k|    } else {
 1371|   197k|      *current = best_cand;
 1372|   197k|    }
 1373|       |  }
 1374|       |
 1375|  95.2k|  assert!(!current.is_empty());
 1376|  95.2k|}
