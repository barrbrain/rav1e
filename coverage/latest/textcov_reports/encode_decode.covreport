   25|  14.5k|fn deblock_adjusted_level(
   26|  14.5k|  deblock: &DeblockState, block: &Block, pli: usize, vertical: bool,
   27|  14.5k|) -> usize {
   28|  14.5k|  let idx = if pli == 0 {
   29|  5.49k|    if vertical {
   30|  2.72k|      0
   31|       |    } else {
   32|  2.77k|      1
   33|       |    }
   34|       |  } else {
   35|  9.07k|    pli + 1
   36|       |  };
   37|       |
   38|  14.5k|  let level = if deblock.block_deltas_enabled {
   39|       |    // By-block filter strength delta, if the feature is active.
   40|      0|    let block_delta = if deblock.block_delta_multi {
   41|      0|      block.deblock_deltas[idx] << deblock.block_delta_shift
   42|       |    } else {
   43|      0|      block.deblock_deltas[0] << deblock.block_delta_shift
   44|       |    };
   45|       |
   46|       |    // Add to frame-specified filter strength (Y-vertical, Y-horizontal, U, V)
   47|      0|    clamp(block_delta + deblock.levels[idx] as i8, 0, MAX_LOOP_FILTER as i8)
   48|      0|      as u8
   49|       |  } else {
   50|  14.5k|    deblock.levels[idx]
   51|       |  };
   52|       |
   53|       |  // if fi.seg_feaure_active {
   54|       |  // rav1e does not yet support segments or segment features
   55|       |  // }
   56|       |
   57|       |  // Are delta modifiers for specific references and modes active?  If so, add them too.
   58|  14.5k|  if deblock.deltas_enabled {
   59|      0|    let mode = block.mode;
   60|      0|    let reference = block.ref_frames[0];
   61|      0|    let mode_type =
   62|      0|      if mode >= NEARESTMV && mode != GLOBALMV && mode != GLOBAL_GLOBALMV {
   63|      0|        1
   64|       |      } else {
   65|      0|        0
   66|       |      };
   67|      0|    let l5 = level >> 5;
   68|      0|    clamp(
   69|      0|      level as i32
   70|      0|        + ((deblock.ref_deltas[reference.to_index()] as i32) << l5)
   71|      0|        + if reference == INTRA_FRAME {
   72|      0|          0
   73|       |        } else {
   74|      0|          (deblock.mode_deltas[mode_type] as i32) << l5
   75|       |        },
   76|       |      0,
   77|      0|      MAX_LOOP_FILTER as i32,
   78|       |    ) as usize
   79|       |  } else {
   80|  14.5k|    level as usize
   81|       |  }
   82|  14.5k|}
