  218|   178M|  $($s)* fn half_kernel(
  219|   178M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   178M|  ) -> (T, T) {
  221|   178M|    let t = Self::ADD(p1, p0.0);
  222|   178M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   178M|    let out0 = b.add(c);
  224|   178M|    let shifted = Self::SHIFT(c);
  225|   178M|    let out1 = Self::SUB(a, shifted);
  226|   178M|    (out0, out1)
  227|   178M|  }
