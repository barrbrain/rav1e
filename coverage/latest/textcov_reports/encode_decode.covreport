  632|  35.1k|fn refine_subsampled_motion_estimate<T: Pixel>(
  633|  35.1k|  fi: &FrameInvariants<T>, ts: &TileStateMut<'_, T>, w: usize, h: usize,
  634|  35.1k|  tile_bo: TileBlockOffset, ref_frame: RefType, ssdec: u8, lambda: u32,
  635|  35.1k|) -> Option<MotionSearchResult> {
  636|  30.7k|  if let Some(ref rec) =
  637|  35.1k|    fi.rec_buffer.frames[fi.ref_frames[ref_frame.to_index()] as usize]
  638|       |  {
  639|  30.7k|    let frame_bo = ts.to_frame_block_offset(tile_bo);
  640|  30.7k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  641|  30.7k|      get_mv_range(fi.w_in_b, fi.h_in_b, frame_bo, w << ssdec, h << ssdec);
  642|  30.7k|
  643|  30.7k|    let pmv = [MotionVector { row: 0, col: 0 }; 2];
  644|  30.7k|
  645|  30.7k|    let po = frame_bo.to_luma_plane_offset();
  646|  30.7k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  647|  30.7k|      (mvx_min >> ssdec, mvx_max >> ssdec, mvy_min >> ssdec, mvy_max >> ssdec);
  648|  30.7k|    let po = PlaneOffset { x: po.x >> ssdec, y: po.y >> ssdec };
  649|  30.7k|    let p_ref = match ssdec {
  650|  22.8k|      0 => &rec.frame.planes[0],
  651|  7.87k|      1 => &rec.input_hres,
  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|  30.7k|    let org_region = &match ssdec {
  657|  22.8k|      0 => ts.input_tile.planes[0]
  658|  22.8k|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|  7.87k|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|  30.7k|    let mv =
  665|  30.7k|      ts.me_stats[ref_frame.to_index()][tile_bo.0.y][tile_bo.0.x].mv >> ssdec;
  666|  30.7k|
  667|  30.7k|    // Given a motion vector at 0 at higher subsampling:
  668|  30.7k|    // |  -1   |   0   |   1   |
  669|  30.7k|    // then the vectors at -1 to 2 should be tested at the current subsampling.
  670|  30.7k|    //      |-------------|
  671|  30.7k|    // | -2 -1 |  0  1 |  2  3 |
  672|  30.7k|    // This corresponds to a 4x4 full search.
  673|  30.7k|    let x_lo = po.x + (mv.col as isize / 8 - 1).max(mvx_min / 8);
  674|  30.7k|    let x_hi = po.x + (mv.col as isize / 8 + 2).min(mvx_max / 8);
