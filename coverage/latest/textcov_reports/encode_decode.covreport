  159|  2.36k|  for mv_size_in_b_log2 in (2..=init_size).rev() {
  160|  2.36k|    let init = mv_size_in_b_log2 == init_size;
  161|       |
  162|       |    // Choose subsampling. Pass one is quarter res and pass two is at half res.
  163|  2.36k|    let ssdec = match init_size - mv_size_in_b_log2 {
  164|    789|      0 => 2,
  165|    789|      1 => 1,
  166|    789|      _ => 0,
  167|       |    };
  168|       |
  169|  2.36k|    let new_subsampling =
  170|  2.36k|      if let Some(prev) = prev_ssdec { prev != ssdec } else { false };
  171|  2.36k|    prev_ssdec = Some(ssdec);
  172|       |
