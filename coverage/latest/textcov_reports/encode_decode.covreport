 1313|  1.76M|$($s)* fn daala_fdst_iv_32_asym<T: TxOperations>(
 1314|  1.76M|  t0: (T, T), t1h: T, t2: (T, T), t3h: T, t4: (T, T), t5h: T, t6: (T, T),
 1315|  1.76M|  t7h: T, t8: (T, T), t9h: T, ta: (T, T), tbh: T, tc: (T, T), tdh: T,
 1316|  1.76M|  te: (T, T), tfh: T, tg: (T, T), thh: T, ti: (T, T), tjh: T, tk: (T, T),
 1317|  1.76M|  tlh: T, tm: (T, T), tnh: T, to: (T, T), tph: T, tq: (T, T), trh: T,
 1318|  1.76M|  ts: (T, T), tth: T, tu: (T, T), tvh: T, output: &mut [T],
 1319|  1.76M|) {
 1320|  1.76M|  // Stage 0
 1321|  1.76M|  //   5933/8192 = (Sin[63*Pi/128] + Cos[63*Pi/128])/Sqrt[2] = 0.72424708295147
 1322|  1.76M|  // 22595/16384 = (Sin[63*Pi/128] - Cos[63*Pi/128])*Sqrt[2] = 1.37908108947413
