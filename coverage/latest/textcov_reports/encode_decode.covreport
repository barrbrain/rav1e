 1472|  2.23M|    for ref_window in vert_window.horz_windows(w).step_by(step) {
 1473|  2.23M|      let &Rect { x, y, .. } = ref_window.rect();
 1474|  2.23M|
 1475|  2.23M|      let mv = MotionVector {
 1476|  2.23M|        row: 8 * (y as i16 - po.y as i16),
 1477|  2.23M|        col: 8 * (x as i16 - po.x as i16),
 1478|  2.23M|      };
 1479|  2.23M|
 1480|  2.23M|      let rd = compute_mv_rd(
 1481|  2.23M|        fi,
 1482|  2.23M|        pmv,
 1483|  2.23M|        lambda,
 1484|  2.23M|        false,
 1485|  2.23M|        fi.sequence.bit_depth,
