   63|    457|  pub(crate) fn new(enc_config: &EncoderConfig) -> InterConfig {
   64|    457|    let reorder = !enc_config.low_latency;
   65|       |    // A group always starts with (group_output_len - group_input_len) hidden
   66|       |    //  frames, followed by group_input_len shown frames.
   67|       |    // The shown frames iterate over the input frames in order, with frames
   68|       |    //  already encoded as hidden frames now displayed with Show Existing
   69|       |    //  Frame.
   70|       |    // For example, for a pyramid depth of 2, the group is as follows:
   71|       |    //                      |TU         |TU |TU |TU
   72|       |    // idx_in_group_output:   0   1   2   3   4   5
   73|       |    // input_frameno:         4   2   1  SEF  3  SEF
   74|       |    // output_frameno:        1   2   3   4   5   6
   75|       |    // level:                 0   1   2   1   2   0
   76|       |    //                        ^^^^^   ^^^^^^^^^^^^^
   77|       |    //                        hidden      shown
   78|       |    // TODO: This only works for pyramid_depth <= 2 --- after that we need
   79|       |    //  more hidden frames in the middle of the group.
   80|    457|    let pyramid_depth = if reorder { 2 } else { 0 };
   81|    457|    let group_input_len = 1 << pyramid_depth;
   82|    457|    let group_output_len = group_input_len + pyramid_depth;
   83|    457|    let switch_frame_interval = enc_config.switch_frame_interval;
   84|    457|    assert!(switch_frame_interval % group_input_len == 0);
   85|       |    InterConfig {
   86|    457|      reorder,
   87|    457|      multiref: reorder || enc_config.speed_settings.multiref,
   88|    457|      pyramid_depth,
   89|    457|      group_input_len,
   90|    457|      group_output_len,
   91|    457|      switch_frame_interval,
   92|    457|    }
   93|    457|  }
