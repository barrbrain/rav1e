 1705|   260k|    output[1 + i * 4] = tmp[32 + j];
 1706|   260k|    output[2 + i * 4] = tmp[16 + j];
 1707|   260k|    output[3 + i * 4] = tmp[48 + j];
 1708|   260k|  }
