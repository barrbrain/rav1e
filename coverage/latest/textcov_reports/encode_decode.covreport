 1530|  4.32k|              }
 1531|  4.32k|
 1532|  4.32k|              setup_integral_image(
 1533|  4.32k|                &mut stripe_filter_buffer,
 1534|  4.32k|                STRIPE_IMAGE_STRIDE,
 1535|  4.32k|                crop_w - x,
 1536|  4.32k|                (crop_h as isize - stripe_start_y) as usize,
 1537|  4.32k|                size,
 1538|  4.32k|                stripe_size,
 1539|  4.32k|                &cdeffed.planes[pli]
 1540|  4.32k|                  .slice(PlaneOffset { x: x as isize, y: stripe_start_y }),
 1541|  4.32k|                &pre_cdef.planes[pli]
 1542|  4.32k|                  .slice(PlaneOffset { x: x as isize, y: stripe_start_y }),
