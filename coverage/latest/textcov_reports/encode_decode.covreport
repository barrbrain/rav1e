  632|     74|fn refine_subsampled_motion_estimate<T: Pixel>(
  633|     74|  fi: &FrameInvariants<T>, ts: &TileStateMut<'_, T>, w: usize, h: usize,
  634|     74|  tile_bo: TileBlockOffset, ref_frame: RefType, ssdec: u8, lambda: u32,
  635|     74|) -> Option<MotionSearchResult> {
  636|     60|  if let Some(ref rec) =
  637|     74|    fi.rec_buffer.frames[fi.ref_frames[ref_frame.to_index()] as usize]
  638|       |  {
  639|     60|    let frame_bo = ts.to_frame_block_offset(tile_bo);
  640|     60|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  641|     60|      get_mv_range(fi.w_in_b, fi.h_in_b, frame_bo, w << ssdec, h << ssdec);
  642|     60|
  643|     60|    let pmv = [MotionVector { row: 0, col: 0 }; 2];
  644|     60|
  645|     60|    let po = frame_bo.to_luma_plane_offset();
  646|     60|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  647|     60|      (mvx_min >> ssdec, mvx_max >> ssdec, mvy_min >> ssdec, mvy_max >> ssdec);
  648|     60|    let po = PlaneOffset { x: po.x >> ssdec, y: po.y >> ssdec };
  649|     60|    let p_ref = match ssdec {
  650|     48|      0 => &rec.frame.planes[0],
  651|     12|      1 => &rec.input_hres,
  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|     60|    let org_region = &match ssdec {
  657|     48|      0 => ts.input_tile.planes[0]
  658|     48|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|     12|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|     60|    let mv =
  665|     60|      ts.me_stats[ref_frame.to_index()][tile_bo.0.y][tile_bo.0.x].mv >> ssdec;
  666|     60|
  667|     60|    // Given a motion vector at 0 at higher subsampling:
  668|     60|    // |  -1   |   0   |   1   |
  669|     60|    // then the vectors at -1 to 2 should be tested at the current subsampling.
  670|     60|    //      |-------------|
  671|     60|    // | -2 -1 |  0  1 |  2  3 |
  672|     60|    // This corresponds to a 4x4 full search.
  673|     60|    let x_lo = po.x + (mv.col as isize / 8 - 1).max(mvx_min / 8);
  674|     60|    let x_hi = po.x + (mv.col as isize / 8 + 2).min(mvx_max / 8);
  675|     60|    let y_lo = po.y + (mv.row as isize / 8 - 1).max(mvy_min / 8);
  676|     60|    let y_hi = po.y + (mv.row as isize / 8 + 2).min(mvy_max / 8);
  677|     60|    let mut results = full_search(
  678|     60|      fi, x_lo, x_hi, y_lo, y_hi, w, h, org_region, p_ref, po, 1, lambda, pmv,
  679|     60|    );
  680|     60|
  681|     60|    // Scale motion vectors to full res size
  682|     60|    results.mv = results.mv << ssdec;
  683|     60|
  684|     60|    Some(results)
  685|       |  } else {
  686|     14|    None
  687|       |  }
  688|     74|}
