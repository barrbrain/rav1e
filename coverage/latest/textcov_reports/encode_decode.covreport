  543|  6.19k|  let start_index_x = if cdeffed.x == 0 { -(left_w as isize) } else { 0 };
  544|       |
  545|  6.19k|  let mut rows_iter = VertPaddedIter::new(
  546|  6.19k|    // Move left to encompass all the used data
  547|  6.19k|    &cdeffed.go_left(left_uniques),
  548|  6.19k|    &deblocked.go_left(left_uniques),
