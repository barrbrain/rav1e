  312|   119M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|   119M|  let p0 = p0.sub(p1);
  314|   119M|  let p0h = p0.rshift1();
  315|   119M|  let p1h = p1.add(p0h);
  316|   119M|  ((p0h, p0), p1h)
  317|   119M|}
