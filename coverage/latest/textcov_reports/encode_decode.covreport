  543|  12.5k|  let start_index_x = if cdeffed.x == 0 { -(left_w as isize) } else { 0 };
  544|       |
  545|  12.5k|  let mut rows_iter = VertPaddedIter::new(
  546|  12.5k|    // Move left to encompass all the used data
  547|  12.5k|    &cdeffed.go_left(left_uniques),
  548|  12.5k|    &deblocked.go_left(left_uniques),
