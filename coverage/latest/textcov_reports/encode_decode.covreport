  137|      9|      .max(min_tile_rows_ratelimit_log2)
  138|      9|      .min(max_tile_rows_log2);
  139|      9|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|      9|
  141|      9|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|      9|
  143|      9|    Self {
  144|      9|      frame_width,
  145|      9|      frame_height,
  146|      9|      tile_width_sb,
  147|      9|      tile_height_sb,
  148|      9|      cols,
  149|      9|      rows,
  150|      9|      tile_cols_log2,
  151|      9|      tile_rows_log2,
  152|      9|      min_tile_cols_log2,
  153|      9|      max_tile_cols_log2,
  154|      9|      min_tile_rows_log2,
  155|      9|      max_tile_rows_log2,
  156|      9|      sb_size_log2,
  157|      9|      min_tiles_log2,
  158|      9|    }
  159|      9|  }
