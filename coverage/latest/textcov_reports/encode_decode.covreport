  807|  10.2M|  //  9907/16384 = Cos[23*Pi/64]*Sqrt[2]                   = 0.60465421179080
  808|  10.2M|  let (s4, sb) =
  809|  10.2M|    RotateAddShift::kernel(s4, sb, ((30853, 15), (11039, 14), (9907, 14)));
  810|  10.2M|  // 15893/16384 = (Sin[21*Pi/64] + Cos[21*Pi/64])/Sqrt[2] = 0.97003125319454
  811|  10.2M|  //   3981/8192 = (Sin[21*Pi/64] - Cos[21*Pi/64])*Sqrt[2] = 0.89716758634264
  812|  10.2M|  //   1489/2048 = Cos[21*Pi/64]*Sqrt[2]                   = 0.72705107329128
  813|  10.2M|  let (sa, s5) =
  814|  10.2M|    RotateSubShift::kernel(sa, s5, ((15893, 14), (3981, 13), (1489, 11)));
  815|  10.2M|  // 32413/32768 = (Sin[19*Pi/64] + Cos[19*Pi/64])/Sqrt[2] = 0.98917650996478
  816|  10.2M|  //    601/2048 = (Sin[19*Pi/64] - Cos[19*Pi/64])*Sqrt[2] = 0.29346094891072
  817|  10.2M|  // 13803/16384 = Cos[19*Pi/64]*Sqrt[2]                   = 0.84244603550942
  818|  10.2M|  let (s6, s9) =
  819|  10.2M|    RotateAddShift::kernel(s6, s9, ((32413, 15), (601, 11), (13803, 14)));
  820|  10.2M|  // 32729/32768 = (Sin[17*Pi/64] + Cos[17*Pi/64])/Sqrt[2] = 0.99879545620517
  821|  10.2M|  //    201/2048 = (Sin[17*Pi/64] - Cos[17*Pi/64])*Sqrt[2] = 0.09813534865484
  822|  10.2M|  //   1945/2048 = Cos[17*Pi/64]*Sqrt[2]                   = 0.94972778187775
  823|  10.2M|  let (s8, s7) =
  824|  10.2M|    RotateSubShift::kernel(s8, s7, ((32729, 15), (201, 11), (1945, 11)));
  825|  10.2M|
  826|  10.2M|  // Stage 1
  827|  10.2M|  let (s0, s7) = butterfly_sub_asym((s0.rshift1(), s0), s7);
  828|  10.2M|  let (s8, sf) = butterfly_sub_asym((s8.rshift1(), s8), sf);
  829|  10.2M|  let (s4, s3) = butterfly_add_asym((s4.rshift1(), s4), s3);
  830|  10.2M|  let (sc, sb) = butterfly_add_asym((sc.rshift1(), sc), sb);
  831|  10.2M|  let (s2, s5) = butterfly_sub_asym((s2.rshift1(), s2), s5);
  832|  10.2M|  let (sa, sd) = butterfly_sub_asym((sa.rshift1(), sa), sd);
  833|  10.2M|  let (s6, s1) = butterfly_add_asym((s6.rshift1(), s6), s1);
