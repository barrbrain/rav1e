 1456|  13.2k|fn full_search<T: Pixel>(
 1457|  13.2k|  fi: &FrameInvariants<T>, x_lo: isize, x_hi: isize, y_lo: isize, y_hi: isize,
 1458|  13.2k|  w: usize, h: usize, org_region: &PlaneRegion<T>, p_ref: &Plane<T>,
