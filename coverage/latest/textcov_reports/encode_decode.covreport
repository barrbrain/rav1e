_RNvNtCsgGiEFdpFC8m_5rav1e4rate26iir_bessel2_get_parameters:
  140|  2.82k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  2.82k|  // This borrows some code from an unreleased version of Postfish.
  142|  2.82k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  2.82k|  //  on deriving the filter coefficients.
  144|  2.82k|  // alpha is Q24
  145|  2.82k|  let alpha = (1 << 24) / delay;
  146|  2.82k|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|  2.82k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  2.82k|  // k1 is 9.12 (6.12?)
  149|  2.82k|  let k1 = 3 * warp;
  150|  2.82k|  // k2 is 16.24 (11.24?)
  151|  2.82k|  let k2 = k1 * warp;
  152|  2.82k|  // d is 16.15 (10.15?)
  153|  2.82k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  2.82k|  // a is 0.32, since d is larger than both 1.0 and k2
  155|  2.82k|  let a = (k2 << 23) / d;
  156|  2.82k|  // ik2 is 25.24
  157|  2.82k|  let ik2 = (1i64 << 48) / k2;
  158|  2.82k|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|  2.82k|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|  2.82k|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|  2.82k|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|  2.82k|  // All of the filter parameters are Q24.
  163|  2.82k|  (
  164|  2.82k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  2.82k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  2.82k|    ((a + 128) >> 8) as i32,
  167|  2.82k|  )
  168|  2.82k|}
