  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  53.7k|  for y in (0..sb_h).step_by(mv_size) {
  232|   128k|    for x in (0..sb_w).step_by(mv_size) {
  233|   128k|      let corner: MVSamplingMode = if init {
  234|  9.17k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
