  232|  1.77k|          let tile_height = self.ti.tile_height_sb << self.ti.sb_size_log2;
  233|  1.77k|          let width = tile_width.min(self.ti.frame_width - x);
  234|  1.77k|          let height = tile_height.min(self.ti.frame_height - y);
