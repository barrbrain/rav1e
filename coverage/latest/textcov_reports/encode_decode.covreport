  801|       |    // Four possibilities: no filter, wide8, narrow2 and narrow4
  802|   622k|    let none: [_; 6] = [p2, p1, p0, q0, q1, q2];
  803|   622k|    let wide8: [_; 6] = filter_wide8_6(p3, p2, p1, p0, q0, q1, q2, q3);
  804|   622k|    let narrow2: [_; 6] = filter_narrow2_6(p2, p1, p0, q0, q1, q2, bd - 8);
  805|   622k|    let narrow4: [_; 6] = filter_narrow4_6(p2, p1, p0, q0, q1, q2, bd - 8);
  806|   622k|
  807|   622k|    // mask8 sets the dividing line for filter vs no filter
  808|   622k|    // flat8 decides between wide and narrow filters (unrelated to level)
  809|   622k|    // nhev4 sets the dividing line between narrow2 and narrow4
  810|   622k|    let mask = clamp(
  811|   622k|      mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8),
  812|   622k|      1,
  813|   622k|      MAX_LOOP_FILTER + 1,
  814|   622k|    ) as usize;
  815|   622k|    let flatp = flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat;
  816|   622k|    let nhev =
  817|   622k|      clamp(nhev4(p1, p0, q0, q1, bd - 8), mask, MAX_LOOP_FILTER + 1) as usize;
  818|   622k|
  819|   622k|    // sse for each; short-circuit the 'special' no-op cases.
  820|   622k|    let sse_none = stride_sse(&a, &none);
  821|   622k|    let sse_wide8 = if flatp && mask <= MAX_LOOP_FILTER {
  822|  68.1k|      stride_sse(&a, &wide8)
  823|       |    } else {
  824|   554k|      sse_none
  825|       |    };
  826|   622k|    let sse_narrow2 =
  827|   622k|      if !flatp && nhev != mask { stride_sse(&a, &narrow2) } else { sse_none };
  828|   622k|    let sse_narrow4 = if !flatp && nhev <= MAX_LOOP_FILTER {
  829|  2.73k|      stride_sse(&a, &narrow4)
  830|       |    } else {
  831|   620k|      sse_none
  832|       |    };
  833|       |
  834|       |    // accumulate possible filter values into the tally
  835|   622k|    tally[0] += sse_none;
  836|   622k|    tally[mask] -= sse_none;
  837|   622k|    if flatp {
  838|  68.1k|      tally[mask] += sse_wide8;
  839|   554k|    } else {
  840|   554k|      tally[mask] += sse_narrow2;
  841|   554k|      tally[nhev] -= sse_narrow2;
  842|   554k|      tally[nhev] += sse_narrow4;
  843|   554k|    }
  844|       |  }
  845|   155k|}
