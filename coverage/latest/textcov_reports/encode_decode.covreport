 1313|  15.7k|pub fn deblock_plane<T: Pixel>(
 1314|  15.7k|  deblock: &DeblockState, p: &mut PlaneRegionMut<T>, pli: usize,
 1315|  15.7k|  blocks: &TileBlocks, crop_w: usize, crop_h: usize, bd: usize,
 1316|  15.7k|) {
 1317|  15.7k|  let xdec = p.plane_cfg.xdec;
 1318|  15.7k|  let ydec = p.plane_cfg.ydec;
 1319|  15.7k|  assert!(xdec <= 1 && ydec <= 1);
