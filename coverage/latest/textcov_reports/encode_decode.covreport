  268|   761k|      return unsafe { *BLOCK_LUT.get_unchecked(x).get_unchecked(y) };
  269|  44.9k|    }
  270|  44.9k|
  271|  44.9k|    Err(InvalidBlockSize)
  272|   825k|  }
