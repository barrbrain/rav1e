  342|  5.75M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  5.75M|    //    (n = # samples i.e. area)
  344|  5.75M|    // var * n = sum(X^2) - sum(X)^2 / n
