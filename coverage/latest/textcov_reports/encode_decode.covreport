  951|   229k|fn fullpel_diamond_search<T: Pixel>(
  952|   229k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   229k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   229k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   229k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   229k|) {
  957|   229k|  // Define the initial and the final scale (log2) of the diamond.
  958|   229k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|   661k|  loop {
  961|   661k|    // Find the best candidate from the diamond pattern.
  962|   661k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  3.30M|    for &offset in &DIAMOND_R1_PATTERN {
  964|  2.64M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  2.64M|      let rd = get_fullpel_mv_rd(
  966|  2.64M|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  2.64M|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  2.64M|      );
  969|  2.64M|
  970|  2.64M|      if rd.cost < best_cand.rd.cost {
  971|  1.33M|        best_cand.mv = cand_mv;
  972|  1.33M|        best_cand.rd = rd;
  973|  1.33M|      }
  974|       |    }
  975|       |
  976|       |    // Continue the search at this scale until the can't find a better candidate
  977|       |    // to use.
  978|   661k|    if current.rd.cost <= best_cand.rd.cost {
  979|   459k|      if diamond_radius_log2 == diamond_radius_end_log2 {
  980|   229k|        break;
  981|   229k|      } else {
  982|   229k|        diamond_radius_log2 -= 1;
  983|   229k|      }
  984|   201k|    } else {
  985|   201k|      *current = best_cand;
  986|   201k|    }
  987|       |  }
  988|       |
