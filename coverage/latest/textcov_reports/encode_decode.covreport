 1698|  35.5k|pub fn rdo_tx_type_decision<T: Pixel>(
 1699|  35.5k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>,
 1700|  35.5k|  cw: &mut ContextWriter, cw_checkpoint: &mut Option<ContextWriterCheckpoint>,
 1701|  35.5k|  mode: PredictionMode, ref_frames: [RefType; 2], mvs: [MotionVector; 2],
 1702|  35.5k|  bsize: BlockSize, tile_bo: TileBlockOffset, tx_size: TxSize, tx_set: TxSet,
 1703|  35.5k|  tx_types: &[TxType], cur_best_rd: f64,
 1704|  35.5k|) -> (TxType, f64) {
 1705|  35.5k|  let mut best_type = TxType::DCT_DCT;
 1706|  35.5k|  let mut best_rd = std::f64::MAX;
 1707|  35.5k|
 1708|  35.5k|  let PlaneConfig { xdec, ydec, .. } = ts.input.planes[1].cfg;
 1709|  35.5k|  let is_chroma_block =
 1710|  35.5k|    has_chroma(tile_bo, bsize, xdec, ydec, fi.sequence.chroma_sampling);
 1711|  35.5k|
 1712|  35.5k|  let is_inter = !mode.is_intra();
 1713|  35.5k|
 1714|  35.5k|  if cw_checkpoint.is_none() {
 1715|  20.2k|    // Only run the first call
 1716|  20.2k|    // Prevents creating multiple checkpoints for own version of cw
 1717|  20.2k|    *cw_checkpoint =
 1718|  20.2k|      Some(cw.checkpoint(&tile_bo, fi.sequence.chroma_sampling));
 1719|  20.2k|  }
 1720|       |
 1721|  35.5k|  let rdo_type = if fi.use_tx_domain_distortion {
 1722|      0|    RDOType::TxDistRealRate
 1723|       |  } else {
 1724|  35.5k|    RDOType::PixelDistRealRate
 1725|       |  };
 1726|  35.5k|  let need_recon_pixel = tx_size.block_size() != bsize && !is_inter;
 1727|       |
 1728|  35.5k|  let mut first_iteration = true;
