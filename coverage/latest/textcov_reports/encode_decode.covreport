  508|  1.07M|    (p1 - p0).abs(),
  509|  1.07M|    cmp::max((q1 - q0).abs(), cmp::max((p2 - p0).abs(), (q2 - q0).abs())),
  510|  1.07M|  ) as usize
  511|  1.07M|}
