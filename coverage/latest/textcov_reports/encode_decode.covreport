  319|  31.3M|      let row1 = &src[j][0..w];
  320|  31.3M|      let row2 = &dst[j][0..w];
  321|   158M|      for (s, d) in row1.iter().zip(row2) {
  322|   158M|        let s: u32 = u32::cast_from(*s);
  323|   158M|        let d: u32 = u32::cast_from(*d);
  324|   158M|        sum_s += s;
  325|   158M|        sum_d += d;
  326|   158M|
  327|   158M|        sum_s2 += s * s;
  328|   158M|        sum_d2 += d * d;
  329|   158M|        sum_sd += s * d;
  330|   158M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  5.75M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
