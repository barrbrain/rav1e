 1565|       |      } else {
 1566|  54.0k|        4
 1567|       |      }
 1568|   491k|    } else if avail_up {
 1569|   188k|      if above_single {
 1570|   172k|        above_backward as usize
 1571|       |      } else {
 1572|  15.8k|        3
 1573|       |      }
 1574|   302k|    } else if avail_left {
 1575|   198k|      if left_single {
 1576|   182k|        left_backward as usize
 1577|       |      } else {
 1578|  16.0k|        3
 1579|       |      }
 1580|       |    } else {
 1581|   103k|      1
 1582|       |    }
 1583|  1.04M|  }

