  178|  8.50M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  8.50M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  8.50M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  8.50M|) -> Distortion {
  182|  8.50M|  // See get_weighted_sse in src/dist.rs.
  183|  8.50M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  8.50M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  8.50M|
  186|  8.50M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  8.50M|  // importance block size in a non-subsampled plane.
  188|  8.50M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  8.50M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  8.50M|
  191|  8.50M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  8.50M|
  193|  8.50M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  8.50M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  8.50M|
  196|  8.50M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  8.50M|  // passed directly. To do this, we would need different versions of the
  198|  8.50M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  8.50M|  // eliminating use of unbiased sse.
  200|  8.50M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  8.50M|
  202|  8.50M|  // Copy biases into a buffer.
  203|  8.50M|  let mut buf_storage = Aligned::new(
  204|  8.50M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  8.50M|  );
