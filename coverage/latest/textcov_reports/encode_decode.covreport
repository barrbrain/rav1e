_RNvMs2_NtCsgzd1EjkjF4V_5rav1e4rateNtB5_19QuantizerParameters14new_from_log_q:
  525|     30|  fn new_from_log_q(
  526|     30|    log_base_q: i64, log_target_q: i64, bit_depth: usize,
  527|     30|    chroma_sampling: ChromaSampling, is_intra: bool,
  528|     30|    log_isqrt_mean_scale: i64,
  529|     30|  ) -> QuantizerParameters {
  530|     30|    let scale = log_isqrt_mean_scale + q57(QSCALE + bit_depth as i32 - 8);
  531|     30|
  532|     30|    let mut log_q_y = log_target_q;
  533|     30|    if !is_intra && bit_depth == 8 {
  534|      3|      log_q_y = log_target_q
  535|      3|        + (log_target_q >> 32) * Q_MODEL_MUL[chroma_sampling as usize]
  536|      3|        + Q_MODEL_ADD[chroma_sampling as usize];
  537|     27|    }
  538|       |
  539|     30|    let quantizer = bexp64(log_q_y + scale);
  540|     30|    let (offset_u, offset_v) =
  541|     30|      chroma_offset(log_q_y + log_isqrt_mean_scale, chroma_sampling);
  542|     30|    let mono = chroma_sampling == ChromaSampling::Cs400;
  543|     30|    let log_q_u = log_q_y + offset_u;
  544|     30|    let log_q_v = log_q_y + offset_v;
  545|     30|    let quantizer_u = bexp64(log_q_u + scale);
  546|     30|    let quantizer_v = bexp64(log_q_v + scale);
  547|     30|    let lambda = (::std::f64::consts::LN_2 / 6.0)
  548|     30|      * (((log_target_q + log_isqrt_mean_scale) as f64)
  549|     30|        * Q57_SQUARE_EXP_SCALE)
  550|     30|        .exp();
  551|     30|
  552|     30|    let scale = |q| bexp64((log_target_q - q) * 2 + q57(16)) as f64 / 65536.;
  553|     30|    let dist_scale = [scale(log_q_y), scale(log_q_u), scale(log_q_v)];
  554|     30|
  555|     30|    let base_q_idx = select_ac_qi(quantizer, bit_depth).max(1);
  556|     30|
  557|     30|    // delta_q only gets 6 bits + a sign bit, so it can differ by 63 at most.
  558|     30|    let min_qi = base_q_idx.saturating_sub(63).max(1);
  559|     30|    let max_qi = base_q_idx.saturating_add(63).min(255);
  560|     30|    let clamp_qi = |qi: u8| qi.max(min_qi).min(max_qi);
  561|       |
  562|       |    QuantizerParameters {
  563|     30|      log_base_q,
  564|     30|      log_target_q,
  565|     30|      // TODO: Allow lossless mode; i.e. qi == 0.
  566|     30|      dc_qi: [
  567|     30|        clamp_qi(select_dc_qi(quantizer, bit_depth)),
  568|     30|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_u, bit_depth)) },
  569|     30|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_v, bit_depth)) },
  570|       |      ],
  571|       |      ac_qi: [
  572|     30|        base_q_idx,
  573|     30|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_u, bit_depth)) },
  574|     30|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_v, bit_depth)) },
  575|       |      ],
  576|     30|      lambda,
  577|     30|      dist_scale,
  578|     30|    }
  579|     30|  }
_RNvNtCsgzd1EjkjF4V_5rav1e4rate10warp_alpha:
  130|     36|fn warp_alpha(alpha: i32) -> i32 {
  131|     36|  let i = ((alpha * 36) >> 24).min(16);
  132|     36|  let t0 = ROUGH_TAN_LOOKUP[i as usize];
  133|     36|  let t1 = ROUGH_TAN_LOOKUP[i as usize + 1];
  134|     36|  let d = alpha * 36 - (i << 24);
  135|     36|  ((((t0 as i64) << 32) + (((t1 - t0) << 8) as i64) * (d as i64)) >> 32) as i32
  136|     36|}
_RNvMs3_NtCsgzd1EjkjF4V_5rav1e4rateNtB5_7RCState12update_state:
 1084|     19|  pub fn update_state(
 1085|     19|    &mut self, bits: i64, fti: usize, show_frame: bool, log_target_q: i64,
 1086|     19|    trial: bool, droppable: bool,
 1087|     19|  ) -> bool {
 1088|     19|    if trial {
 1089|      8|      assert!(self.needs_trial_encode(fti));
 1090|      8|      assert!(bits > 0);
 1091|     11|    }
 1092|     19|    let mut dropped = false;
 1093|     19|    // Update rate control only if rate control is active.
 1094|     19|    if self.target_bitrate > 0 {
 1095|     16|      let mut estimated_bits = 0;
 1096|     16|      let mut bits = bits;
 1097|     16|      let mut droppable = droppable;
 1098|     16|      let mut log_scale = q57(-64);
 1099|     16|      // Drop frames is also disabled for now in the case of infinite-buffer
 1100|     16|      //  two-pass mode.
 1101|     16|      if !self.drop_frames
 1102|      0|        || fti == FRAME_SUBTYPE_SEF
 1103|      0|        || (self.twopass_state == PASS_2
 1104|      0|          || self.twopass_state == PASS_2_PLUS_1)
 1105|      0|          && !self.frame_metrics.is_empty()
 1106|     16|      {
 1107|     16|        droppable = false;
 1108|     16|      }
 1109|     16|      if fti == FRAME_SUBTYPE_SEF {
 1110|      0|        debug_assert!(bits == SEF_BITS);
 1111|      0|        debug_assert!(show_frame);
 1112|       |        // Please don't make trial encodes of a SEF.
 1113|      0|        debug_assert!(!trial);
 1114|      0|        estimated_bits = SEF_BITS;
 1115|      0|        self.nsef_frames += 1;
 1116|       |      } else {
 1117|     16|        let log_q_exp = ((log_target_q + 32) >> 6) * (self.exp[fti] as i64);
 1118|     16|        let prev_log_scale = self.log_scale[fti];
 1119|     16|        if bits <= 0 {
 1120|      0|          // We didn't code any blocks in this frame.
 1121|      0|          bits = 0;
 1122|      0|          dropped = true;
 1123|      0|        // TODO: Adjust VFR rate based on drop count.
 1124|      0|        } else {
 1125|       |          // Compute the estimated scale factor for this frame type.
 1126|     16|          let log_bits = blog64(bits);
 1127|     16|          log_scale = (log_bits - self.log_npixels + log_q_exp).min(q57(16));
 1128|     16|          estimated_bits =
