  508|   139k|      }
  509|       |    } else {
  510|   170k|      let top: u8 = above_ctxs.iter().fold(0, |acc, ctx| acc | *ctx);
  511|   170k|      let left: u8 = left_ctxs.iter().fold(0, |acc, ctx| acc | *ctx);
