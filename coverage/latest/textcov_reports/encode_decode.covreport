  572|  1.46k|        base_q_idx,
  573|  1.46k|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_u, bit_depth)) },
  574|  1.46k|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_v, bit_depth)) },
  575|       |      ],
  576|  1.46k|      lambda,
  577|  1.46k|      dist_scale,
