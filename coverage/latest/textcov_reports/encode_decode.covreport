  140|  2.83k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  2.83k|  // This borrows some code from an unreleased version of Postfish.
  142|  2.83k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  2.83k|  //  on deriving the filter coefficients.
