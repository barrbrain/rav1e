   78|    677|) {
   79|    677|  use crate::quantize::{ac_q, select_ac_qi};
   80|    677|  use crate::util::kmeans;
   81|    677|  use arrayvec::ArrayVec;
   82|    677|
   83|    677|  // Minimize the total distance from a small set of values to all scales.
   84|    677|  // Find k-means of log(spatiotemporal scale), k in 3..=8
   85|    677|  let c: ([_; 8], [_; 7], [_; 6], [_; 5], [_; 4], [_; 3]) = {
   86|    677|    let spatiotemporal_scores =
   87|    677|      &fi.coded_frame_data.as_ref().unwrap().spatiotemporal_scores;
   88|    677|    let mut log2_scale_q11 = Vec::with_capacity(spatiotemporal_scores.len());
   89|    677|    log2_scale_q11.extend(spatiotemporal_scores.iter().map(|&s| s.blog16()));
   90|    677|    log2_scale_q11.sort_unstable();
   91|    677|    let l = &log2_scale_q11;
   92|    677|    (kmeans(l), kmeans(l), kmeans(l), kmeans(l), kmeans(l), kmeans(l))
   93|    677|  };
   94|    677|
