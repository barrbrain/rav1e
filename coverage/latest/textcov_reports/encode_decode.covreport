  208|   146M|  pub const fn temporal_rdo(&self) -> bool {
  209|   146M|    // Note: This function is called frequently, unlike most other functions here.
  210|   146M|
  211|   146M|    // `compute_distortion_scale` computes a scaling factor for the distortion
  212|   146M|    // of an 8x8 block (4x4 blocks simply use the scaling of the enclosing 8x8
  213|   146M|    // block). As long as distortion is always computed on <= 8x8 blocks, this
  214|   146M|    // has the property that the scaled distortion of a 2Nx2N block is always
  215|   146M|    // equal to the sum of the scaled distortions of the NxN sub-blocks it's
  216|   146M|    // made of, this is a necessary property to be able to do RDO between
  217|   146M|    // multiple partition sizes properly. Unfortunately, when tx domain
  218|   146M|    // distortion is used, distortion is only known at the tx block level which
  219|   146M|    // might be bigger than 8x8. So temporal RDO is always disabled in that case.
  220|   146M|    !self.speed_settings.transform.tx_domain_distortion
  221|   146M|  }
