_RINvNtCs5T1csxkeGwJ_5rav1e2me23uneven_multi_hex_searchhEB4_:
 1164|  6.32k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  6.32k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  6.32k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  6.32k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  6.32k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  6.32k|) {
 1170|  6.32k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  6.32k|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|  75.9k|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|   227k|    for &offset in &HORIZONTAL_LINE {
 1196|   151k|      let cand_mv = center + offset * i;
 1197|   151k|      let rd = get_fullpel_mv_rd(
 1198|   151k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|   151k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|   151k|      );
 1201|   151k|
 1202|   151k|      if rd.cost < current.rd.cost {
 1203|  6.48k|        current.mv = cand_mv;
 1204|  6.48k|        current.rd = rd;
 1205|   145k|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|  37.9k|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|   113k|    for &offset in &VERTICAL_LINE {
 1217|  75.9k|      let cand_mv = center + offset * i;
 1218|  75.9k|      let rd = get_fullpel_mv_rd(
 1219|  75.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|  75.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|  75.9k|      );
 1222|  75.9k|
 1223|  75.9k|      if rd.cost < current.rd.cost {
 1224|  1.67k|        current.mv = cand_mv;
 1225|  1.67k|        current.rd = rd;
 1226|  74.2k|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|  6.32k|  let center = current.mv;
 1232|  37.9k|  for row in -2..=2 {
 1233|   189k|    for col in -2..=2 {
 1234|   158k|      if row == 0 && col == 0 {
 1235|  6.32k|        continue;
 1236|   151k|      }
 1237|   151k|      let cand_mv = center + MotionVector { row, col };
 1238|   151k|      let rd = get_fullpel_mv_rd(
 1239|   151k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|   151k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|   151k|      );
 1242|   151k|
 1243|   151k|      if rd.cost < current.rd.cost {
 1244|  1.24k|        current.mv = cand_mv;
 1245|  1.24k|        current.rd = rd;
 1246|   150k|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|  6.32k|  let center = current.mv;
 1274|  6.32k|
 1275|  6.32k|  // Divide by 4, the radius of the UMH's hexagon.
 1276|  6.32k|  let iterations = me_range >> 2;
 1277|  37.9k|  for i in 1..=iterations {
 1278|   645k|    for &offset in &UMH_PATTERN {
 1279|   607k|      let cand_mv = center + offset * i;
 1280|   607k|      let rd = get_fullpel_mv_rd(
 1281|   607k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|   607k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|   607k|      );
 1284|   607k|
 1285|   607k|      if rd.cost < current.rd.cost {
 1286|  11.6k|        current.mv = cand_mv;
 1287|  11.6k|        current.rd = rd;
 1288|   595k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|  6.32k|  hexagon_search(
 1294|  6.32k|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|  6.32k|    mvx_max, mvy_min, mvy_max, w, h,
 1296|  6.32k|  );
 1297|  6.32k|}
