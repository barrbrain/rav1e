_RNvNtCsgzd1EjkjF4V_5rav1e2me12get_mv_range:
  338|    539|fn get_mv_range(
  339|    539|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|    539|  blk_h: usize,
  341|    539|) -> (isize, isize, isize, isize) {
  342|    539|  let border_w = 128 + blk_w as isize * 8;
  343|    539|  let border_h = 128 + blk_h as isize * 8;
  344|    539|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|    539|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|    539|    * (8 * MI_SIZE) as isize
  347|    539|    + border_w;
  348|    539|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|    539|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|    539|    * (8 * MI_SIZE) as isize
  351|    539|    + border_h;
  352|    539|
  353|    539|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|    539|  use crate::context::{MV_LOW, MV_UPP};
  355|    539|  (
  356|    539|    mvx_min.max(MV_LOW as isize + 1),
  357|    539|    mvx_max.min(MV_UPP as isize - 1),
  358|    539|    mvy_min.max(MV_LOW as isize + 1),
  359|    539|    mvy_max.min(MV_UPP as isize - 1),
  360|    539|  )
  361|    539|}
