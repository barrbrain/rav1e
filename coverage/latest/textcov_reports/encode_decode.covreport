_RNvMs3_NtCs5T1csxkeGwJ_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|  2.65k|  fn calc_flat_quantizer(
 1061|  2.65k|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|  2.65k|  ) -> (i64, i64) {
 1063|  2.65k|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|  2.65k|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|  2.65k|    //  parameterize a "quality" configuration parameter).
 1066|  2.65k|
 1067|  2.65k|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|  2.65k|    //  tables have unique entries, while the DC tables do not.
 1069|  2.65k|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|  2.65k|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|  2.65k|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|  2.65k|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|  2.65k|    // Get the log quantizers as Q57.
 1074|  2.65k|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|  2.65k|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|  2.65k|    // Target the midpoint of the chosen entries.
 1077|  2.65k|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|  2.65k|    // Adjust the quantizer for the frame type, result is Q57:
 1079|  2.65k|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|  2.65k|      + DQP_Q57[fti];
 1081|  2.65k|    (log_base_q, log_q)
 1082|  2.65k|  }
