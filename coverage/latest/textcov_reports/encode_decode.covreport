_RNvNtCs3tIhnEwGhQF_5rav1e7deblock20deblock_size14_innerB3_:
  864|  1.00M|fn deblock_size14_inner(
  865|  1.00M|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|  1.00M|  level: usize, bd: usize,
  867|  1.00M|) -> Option<[i32; 12]> {
  868|  1.00M|  // 'mask' test
  869|  1.00M|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|  73.8k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
  872|  73.8k|    let x = if flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat {
  873|       |      // outer flatness test
  874|  3.66k|      if flat14_outer(p6, p5, p4, p0, q0, q4, q5, q6) <= flat {
  875|       |        // sufficient flatness across 14 pixel width; run full-width filter
  876|  3.00k|        filter_wide14_12(
  877|  3.00k|          p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6,
  878|  3.00k|        )
  879|       |      } else {
  880|       |        // only flat in inner area, run 8-tap
  881|    658|        filter_wide8_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5)
  882|       |      }
  883|  70.1k|    } else if nhev4(p1, p0, q0, q1, bd - 8) <= level {
  884|       |      // not flat, run narrow filter
  885|  1.82k|      filter_narrow4_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  886|       |    } else {
  887|  68.3k|      filter_narrow2_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  888|       |    };
  889|  73.8k|    Some(x)
  890|       |  } else {
  891|   931k|    None
  892|       |  }
  893|  1.00M|}
_RNvNtCs3tIhnEwGhQF_5rav1e7deblock22deblock_adjusted_level:
   25|   653k|fn deblock_adjusted_level(
   26|   653k|  deblock: &DeblockState, block: &Block, pli: usize, vertical: bool,
   27|   653k|) -> usize {
   28|   653k|  let idx = if pli == 0 {
   29|   357k|    if vertical {
   30|   176k|      0
   31|       |    } else {
   32|   180k|      1
   33|       |    }
   34|       |  } else {
   35|   295k|    pli + 1
   36|       |  };
   37|       |
   38|   653k|  let level = if deblock.block_deltas_enabled {
