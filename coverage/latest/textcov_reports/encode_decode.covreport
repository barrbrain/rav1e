 1067|  7.11M|  // Stage 4
 1068|  7.11M|  let (s2, sc) = butterfly_add_asym(s2, sch);
 1069|  7.11M|  let (s0, s1) = butterfly_sub_asym(s0, s1h);
 1070|  7.11M|  let (sf, se) = butterfly_add_asym(sf, seh);
 1071|  7.11M|  let (sd, s3) = butterfly_add_asym(sd, s3h);
 1072|  7.11M|  let (s7, s6) = butterfly_add_asym((s7.rshift1(), s7), s6);
 1073|  7.11M|  let (s8, s9) = butterfly_sub_asym((s8.rshift1(), s8), s9);
 1074|  7.11M|  let (sa, sb) = butterfly_sub_asym((sa.rshift1(), sa), sb);
 1075|  7.11M|  let (s5, s4) = butterfly_add_asym((s5.rshift1(), s5), s4);
 1076|  7.11M|
 1077|  7.11M|  // Stage 5
 1078|  7.11M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
 1079|  7.11M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1080|  7.11M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1081|  7.11M|  let (sc, s3) =
 1082|  7.11M|    RotateAdd::kernel(sc, s3, ((10703, 13), (8867, 14), (3135, 13)));
 1083|  7.11M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3870398453221475
 1084|  7.11M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1085|  7.11M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1086|  7.11M|  let (s2, sd) =
 1087|  7.11M|    RotateNeg::kernel(s2, sd, ((10703, 13), (8867, 14), (3135, 13)));
 1088|  7.11M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1089|  7.11M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1090|  7.11M|  let (sa, s5) = RotatePi4Add::kernel(sa, s5, ((11585, 13), (5793, 13)));
 1091|  7.11M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1092|  7.11M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1093|  7.11M|  let (s6, s9) = RotatePi4Add::kernel(s6, s9, ((11585, 13), (5793, 13)));
 1094|  7.11M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1095|  7.11M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1096|  7.11M|  let (se, s1) = RotatePi4Add::kernel(se, s1, ((11585, 13), (5793, 13)));
 1097|  7.11M|
 1098|  7.11M|  store_coeffs!(
 1099|  7.11M|    output, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, sa, sb, sc, sd, se, sf
 1100|  7.11M|  );
 1101|  7.11M|}
