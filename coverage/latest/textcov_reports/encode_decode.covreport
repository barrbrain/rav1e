 1265|  1.81M|  let (tc, tj) = butterfly_neg_asym(tch, tj);
 1266|  1.81M|  let (td, ti) = butterfly_sub_asym(td, tih);
 1267|  1.81M|  let (te, th) = butterfly_neg_asym(teh, th);
 1268|  1.81M|  let (tf, tg) = butterfly_sub_asym(tf, tgh);
 1269|  1.81M|
 1270|  1.81M|  // Embedded 16-point orthonormal transforms.
