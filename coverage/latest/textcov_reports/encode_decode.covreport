  157|      6|            let data = <$dty as Arbitrary>::arbitrary_take_rest(u);
  158|       |
  159|       |            // When `RUST_LIBFUZZER_DEBUG_PATH` is set, write the debug
  160|       |            // formatting of the input to that file. This is only intended for
  161|       |            // `cargo fuzz`'s use!
