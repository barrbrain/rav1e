 1050|  3.01k|fn hexagon_search<T: Pixel>(
 1051|  3.01k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  3.01k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  3.01k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  3.01k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  3.01k|) {
 1056|  3.01k|  // The first iteration of hexagon search is implemented separate from
 1057|  3.01k|  // subsequent iterations, which overlap with previous iterations.
 1058|  3.01k|
 1059|  3.01k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  3.01k|  // candidates have already been tested in a previous iteration and can be
 1061|  3.01k|  // skipped.
 1062|  3.01k|  let mut best_cand_idx: usize = 0;
 1063|  3.01k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  21.0k|  for i in 0..6 {
 1067|  18.0k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  18.0k|    let rd = get_fullpel_mv_rd(
 1069|  18.0k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  18.0k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  18.0k|    );
 1072|  18.0k|
 1073|  18.0k|    if rd.cost < best_cand.rd.cost {
 1074|  6.30k|      best_cand_idx = i;
 1075|  6.30k|      best_cand.mv = cand_mv;
 1076|  6.30k|      best_cand.rd = rd;
 1077|  11.7k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  3.91k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|    901|    *current = best_cand;
 1085|    901|    best_cand = MotionSearchResult::empty();
 1086|    901|
 1087|    901|    // Save the index/direction taken in the previous iteration to the current
 1088|    901|    // search location.
 1089|    901|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|  3.60k|    for idx_offset_mod6 in 5..=7 {
 1097|  2.70k|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|  2.70k|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|  2.70k|
 1100|  2.70k|      let rd = get_fullpel_mv_rd(
 1101|  2.70k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|  2.70k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|  2.70k|      );
 1104|  2.70k|
 1105|  2.70k|      if rd.cost < best_cand.rd.cost {
 1106|  1.60k|        best_cand_idx = i;
 1107|  1.60k|        best_cand.mv = cand_mv;
 1108|  1.60k|        best_cand.rd = rd;
 1109|  1.60k|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  3.01k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  27.0k|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|  24.0k|    let cand_mv = current.mv + offset;
 1117|  24.0k|    let rd = get_fullpel_mv_rd(
 1118|  24.0k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|  24.0k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  24.0k|    );
 1121|  24.0k|
 1122|  24.0k|    if rd.cost < best_cand.rd.cost {
 1123|  8.01k|      best_cand.mv = cand_mv;
 1124|  8.01k|      best_cand.rd = rd;
 1125|  16.0k|    }
 1126|       |  }
 1127|  3.01k|  if best_cand.rd.cost < current.rd.cost {
 1128|    377|    *current = best_cand;
 1129|  2.63k|  }
 1130|       |
 1131|  3.01k|  assert!(!current.is_empty());
 1132|  3.01k|}
