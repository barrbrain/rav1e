  359|  5.75M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  5.75M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  5.75M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  5.75M|    svar =
  363|  5.75M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  5.75M|    dvar =
  365|  5.75M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
