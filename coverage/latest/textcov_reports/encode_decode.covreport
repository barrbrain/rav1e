  482|   137k|    let clipped_half_w = (w >> 1).min(prev_frame.cols - 1 - frame_bo.0.x);
  483|   137k|    let clipped_half_h = (h >> 1).min(prev_frame.rows - 1 - frame_bo.0.y);
  484|   137k|
  485|   137k|    // left
  486|   137k|    if frame_bo.0.x > 0 {
  487|   118k|      subset_c.push(process_cand(
  488|   118k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x - 1],
  489|   118k|      ));
  490|   118k|    }
  491|       |    // top
  492|   137k|    if frame_bo.0.y > 0 {
  493|   117k|      subset_c.push(process_cand(
  494|   117k|        prev_frame[frame_bo.0.y - 1][frame_bo.0.x + clipped_half_w],
  495|   117k|      ));
  496|   117k|    }
  497|       |    // right
  498|   137k|    if frame_bo.0.x + w < prev_frame.cols {
  499|   115k|      subset_c.push(process_cand(
  500|   115k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + w],
  501|   115k|      ));
  502|   115k|    }
  503|       |    // bottom
  504|   137k|    if frame_bo.0.y + h < prev_frame.rows {
  505|   115k|      subset_c.push(process_cand(
  506|   115k|        prev_frame[frame_bo.0.y + h][frame_bo.0.x + clipped_half_w],
  507|   115k|      ));
  508|   115k|    }
  509|       |
  510|   137k|    subset_c.push(process_cand(
  511|   137k|      prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + clipped_half_w],
  512|   137k|    ));
  513|      0|  }
  514|       |
  515|       |  // Undo normalization to 128x128 block size
  516|   137k|  let min_sad = ((min_sad as u64 * (pix_w * pix_h) as u64)
  517|   137k|    >> (MAX_SB_SIZE_LOG2 * 2)) as u32;
  518|   137k|
  519|   137k|  let dec_mv = |mv: MotionVector| MotionVector {
  520|       |    col: mv.col >> ssdec,
