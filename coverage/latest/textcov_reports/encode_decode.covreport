  211|  2.83M|fn filter_narrow4_4(
  212|  2.83M|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  213|  2.83M|) -> [i32; 4] {
  214|  2.83M|  let filter1 =
  215|  2.83M|    clamp(3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  216|       |  // be certain our optimization removing a clamp is sound
  217|       |  debug_assert!({
  218|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  219|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  220|      0|    filter1 == test
  221|       |  });
  222|  2.83M|  let filter2 =
  223|  2.83M|    clamp(3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  224|       |  // be certain our optimization removing a clamp is sound
