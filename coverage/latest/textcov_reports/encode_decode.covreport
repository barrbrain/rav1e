  951|  61.1k|fn fullpel_diamond_search<T: Pixel>(
  952|  61.1k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|  61.1k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|  61.1k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|  61.1k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
