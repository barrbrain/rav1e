  527|  13.8k|  let sq_integral_image = &mut integral_image_buffer.sq_integral_image;
  528|  13.8k|
  529|  13.8k|  // Number of elements outside the stripe
  530|  13.8k|  let left_w = 4; // max radius of 2 + 2 padding
  531|  13.8k|  let right_w = 3; // max radius of 2 + 1 padding
  532|  13.8k|
  533|  13.8k|  assert_eq!(cdeffed.x, deblocked.x);
  534|       |
  535|       |  // Find how many unique elements to use to the left and right
  536|  13.8k|  let left_uniques = if cdeffed.x == 0 { 0 } else { left_w };
