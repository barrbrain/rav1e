_RNvYNtNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward9RotateNegINtB4_15RotateKernelNegNtB4_5I32X8E6kernelBc_:
  239|  78.6M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  240|  78.6M|    let t = Self::ADD(p0, p1);
  241|  78.6M|    let (a, b, c) = (p0.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  242|  78.6M|    let out0 = b.sub(c);
  243|  78.6M|    let out1 = c.sub(a);
  244|  78.6M|    (out0, out1)
  245|  78.6M|  }
