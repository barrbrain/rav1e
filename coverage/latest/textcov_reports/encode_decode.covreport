  864|  1.18M|fn deblock_size14_inner(
  865|  1.18M|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|  1.18M|  level: usize, bd: usize,
  867|  1.18M|) -> Option<[i32; 12]> {
  868|  1.18M|  // 'mask' test
  869|  1.18M|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|  97.1k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
