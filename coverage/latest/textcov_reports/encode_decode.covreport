 1290|      0|      ObuMetaType::OBU_META_HDR_CLL,
 1291|      0|      &fi.sequence,
 1292|      0|    )?;
 1293|      0|    packet.write_all(&buf1).unwrap();
 1294|      0|    buf1.clear();
 1295|    244|  }
 1296|       |
 1297|    244|  if fi.sequence.mastering_display.is_some() {
 1298|      0|    let mut bw1 = BitWriter::endian(&mut buf1, BigEndian);
 1299|      0|    bw1.write_sequence_metadata_obu(
 1300|      0|      ObuMetaType::OBU_META_HDR_MDCV,
