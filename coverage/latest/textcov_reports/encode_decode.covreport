_RNvMNtNtCsgGiEFdpFC8m_5rav1e6tiling5tilerNtB2_10TilingInfo17from_target_tiles:
   56|    705|  pub fn from_target_tiles(
   57|    705|    sb_size_log2: usize, frame_width: usize, frame_height: usize,
   58|    705|    frame_rate: f64, tile_cols_log2: usize, tile_rows_log2: usize,
   59|    705|    is_422_p: bool,
   60|    705|  ) -> Self {
   61|    705|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    705|
   63|    705|    // Frame::new() aligns to the next multiple of 8
   64|    705|    let frame_width = frame_width.align_power_of_two(3);
   65|    705|    let frame_height = frame_height.align_power_of_two(3);
   66|    705|    let frame_width_sb =
   67|    705|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    705|    let frame_height_sb =
   69|    705|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    705|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    705|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    705|
   73|    705|    // these are bitstream-defined values and must not be changed
   74|    705|    let max_tile_width_sb = MAX_TILE_WIDTH >> sb_size_log2;
   75|    705|    let max_tile_area_sb = MAX_TILE_AREA >> (2 * sb_size_log2);
   76|    705|    let min_tile_cols_log2 =
   77|    705|      Self::tile_log2(max_tile_width_sb, sb_cols).unwrap();
   78|    705|    let max_tile_cols_log2 =
   79|    705|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    705|    let max_tile_rows_log2 =
   81|    705|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    705|    let min_tiles_log2 = min_tile_cols_log2
   83|    705|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    705|
   85|    705|    // Implements restriction in Annex A of the spec.
   86|    705|    // Unlike the other restrictions, this one does not change
   87|    705|    // the header coding of the tile rows/cols.
   88|    705|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    705|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    705|        .ceil()
   91|    705|        .log2()
   92|    705|        .ceil() as usize,
   93|    705|    );
   94|    705|
   95|    705|    let tile_cols_log2 =
   96|    705|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    705|    let tile_width_sb_pre =
   98|    705|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
  100|       |    // If this is 4:2:2, our UV horizontal is subsampled but not our
  101|       |    // vertical.  Loop Restoration Units must be square, so they
  102|       |    // will always have an even number of horizontal superblocks. For
  103|       |    // tiles and LRUs to align, tile_width_sb must be even in 4:2:2
  104|       |    // video.
  105|       |
  106|       |    // This is only relevant when doing loop restoration RDO inline
  107|       |    // with block/superblock encoding, that is, where tiles are
  108|       |    // relevant.  If (when) we introduce optionally delaying loop-filter
  109|       |    // encode to after the partitioning loop, we won't need to make
  110|       |    // any 4:2:2 adjustment.
  111|       |
  112|    705|    let tile_width_sb = if is_422_p {
  113|    121|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    584|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    705|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    705|
  120|    705|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    705|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    705|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    705|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    705|      0
  128|       |    };
  129|    705|    let min_tile_rows_ratelimit_log2 =
  130|    705|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    705|        0
  134|       |      };
  135|    705|    let tile_rows_log2 = tile_rows_log2
  136|    705|      .max(min_tile_rows_log2)
  137|    705|      .max(min_tile_rows_ratelimit_log2)
  138|    705|      .min(max_tile_rows_log2);
  139|    705|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    705|
  141|    705|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    705|
  143|    705|    Self {
  144|    705|      frame_width,
  145|    705|      frame_height,
  146|    705|      tile_width_sb,
  147|    705|      tile_height_sb,
  148|    705|      cols,
  149|    705|      rows,
  150|    705|      tile_cols_log2,
  151|    705|      tile_rows_log2,
  152|    705|      min_tile_cols_log2,
  153|    705|      max_tile_cols_log2,
  154|    705|      min_tile_rows_log2,
  155|    705|      max_tile_rows_log2,
  156|    705|      sb_size_log2,
  157|    705|      min_tiles_log2,
  158|    705|    }
  159|    705|  }
