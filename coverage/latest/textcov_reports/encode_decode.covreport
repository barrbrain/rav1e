 1302|    552|  pub fn new<T: Pixel>(fi: &FrameInvariants<T>, input: &Frame<T>) -> Self {
 1303|    552|    let PlaneConfig { xdec, ydec, .. } = input.planes[1].cfg;
 1304|       |    // stripe size is decimated in 4:2:0 (and only 4:2:0)
 1305|    552|    let stripe_uv_decimate = if xdec > 0 && ydec > 0 { 1 } else { 0 };
 1306|    552|    let y_sb_log2 = if fi.sequence.use_128x128_superblock { 7 } else { 6 };
 1307|    552|    let uv_sb_h_log2 = y_sb_log2 - xdec;
 1308|    552|    let uv_sb_v_log2 = y_sb_log2 - ydec;
 1309|       |
 1310|    552|    let (lrf_y_shift, lrf_uv_shift) = if fi.sequence.enable_large_lru
 1311|    552|      && fi.sequence.enable_restoration
 1312|       |    {
 1313|    410|      assert!(
 1314|    410|        fi.width > 1 && fi.height > 1,
 1315|      0|        "Width and height must be higher than 1 for LRF setup"
 1316|       |      );
 1317|       |
 1318|       |      // Specific content does affect optimal LRU size choice, but the
 1319|       |      // quantizer in use is a surprisingly strong selector.
 1320|    410|      let lrf_base_shift = if fi.base_q_idx > 200 {
 1321|     80|        0 // big
 1322|    330|      } else if fi.base_q_idx > 160 {
 1323|      8|        1
 1324|       |      } else {
 1325|    322|        2 // small
 1326|       |      };
 1327|    410|      let lrf_chroma_shift = if stripe_uv_decimate > 0 {
 1328|       |        // 4:2:0 only
 1329|     33|        if lrf_base_shift == 2 {
