 1304|   329k|fn subpel_diamond_search<T: Pixel>(
 1305|   329k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|   329k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|   329k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|   329k|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|   329k|  ref_frame: RefType,
 1310|   329k|) {
 1311|   329k|  use crate::util::Aligned;
 1312|   329k|
 1313|   329k|  // Motion compensation assembly has special requirements for edges
 1314|   329k|  let mc_w = w.next_power_of_two();
 1315|   329k|  let mc_h = (h + 1) & !1;
 1316|   329k|
 1317|   329k|  // Metadata for subpel scratch pad.
 1318|   329k|  let cfg = PlaneConfig::new(mc_w, mc_h, 0, 0, 0, 0, std::mem::size_of::<T>());
 1319|   329k|  // Stack allocation for subpel scratch pad.
 1320|   329k|  // SAFETY: We write to the array below before reading from it.
 1321|   329k|  let mut buf: Aligned<[T; 128 * 128]> = unsafe { Aligned::uninitialized() };
 1322|   329k|  let mut tmp_region = PlaneRegionMut::from_slice(
 1323|   329k|    &mut buf.data,
 1324|   329k|    &cfg,
 1325|   329k|    Rect { x: 0, y: 0, width: cfg.width, height: cfg.height },
 1326|   329k|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|   329k|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|   329k|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|  1.20M|  loop {
 1333|  1.20M|    // Find the best candidate from the diamond pattern.
 1334|  1.20M|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  6.00M|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  4.80M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  4.80M|
 1338|  4.80M|      let rd = get_subpel_mv_rd(
 1339|  4.80M|        fi,
 1340|  4.80M|        po,
 1341|  4.80M|        org_region,
 1342|  4.80M|        bit_depth,
 1343|  4.80M|        pmv,
 1344|  4.80M|        lambda,
 1345|  4.80M|        use_satd,
 1346|  4.80M|        mvx_min,
 1347|  4.80M|        mvx_max,
 1348|  4.80M|        mvy_min,
 1349|  4.80M|        mvy_max,
 1350|  4.80M|        w,
 1351|  4.80M|        h,
 1352|  4.80M|        cand_mv,
 1353|  4.80M|        &mut tmp_region,
 1354|  4.80M|        ref_frame,
 1355|  4.80M|      );
 1356|  4.80M|
 1357|  4.80M|      if rd.cost < best_cand.rd.cost {
 1358|  2.41M|        best_cand.mv = cand_mv;
 1359|  2.41M|        best_cand.rd = rd;
 1360|  2.41M|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|  1.20M|    if current.rd.cost <= best_cand.rd.cost {
 1365|   659k|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|   329k|        break;
 1367|   329k|      } else {
 1368|   329k|        diamond_radius_log2 -= 1;
 1369|   329k|      }
 1370|   541k|    } else {
 1371|   541k|      *current = best_cand;
 1372|   541k|    }
 1373|       |  }
 1374|       |
 1375|   329k|  assert!(!current.is_empty());
 1376|   329k|}
