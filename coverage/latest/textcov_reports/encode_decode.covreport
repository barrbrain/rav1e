 1512|      0|            RestorationFilter::Wiener { coeffs } => {
 1513|      0|              wiener_stripe_filter(
 1514|      0|                coeffs,
 1515|      0|                fi,
 1516|      0|                crop_w,
 1517|      0|                crop_h,
 1518|      0|                size,
 1519|      0|                stripe_size,
 1520|      0|                x,
 1521|      0|                stripe_start_y,
 1522|      0|                &cdeffed.planes[pli],
 1523|      0|                &pre_cdef.planes[pli],
 1524|      0|                &mut out.planes[pli],
 1525|      0|              );
 1526|      0|            }
 1527|  7.22k|            RestorationFilter::Sgrproj { set, xqd } => {
 1528|  7.22k|              if !fi.sequence.enable_cdef {
