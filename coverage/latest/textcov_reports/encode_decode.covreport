  218|  55.7M|  $($s)* fn half_kernel(
  219|  55.7M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  55.7M|  ) -> (T, T) {
  221|  55.7M|    let t = Self::ADD(p1, p0.0);
