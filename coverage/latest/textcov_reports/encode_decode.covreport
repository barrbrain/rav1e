  704|  77.7M|      needs_top = (!dc_or_cfl || y != 0) || (p_angle != 90 && p_angle < 180);
  705|  77.7M|      needs_topright = mode.is_directional() && p_angle < 90;
  706|  77.7M|      needs_bottomleft = mode.is_directional() && p_angle > 180;
  707|       |      needs_topleft_filter =
