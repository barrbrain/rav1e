_RNvMNtCs3tIhnEwGhQF_5rav1e8quantizeNtB2_19QuantizationContext6update:
  195|  61.0M|  pub fn update(
  196|  61.0M|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|  61.0M|    dc_delta_q: i8, ac_delta_q: i8,
  198|  61.0M|  ) {
  199|  61.0M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|  61.0M|
  201|  61.0M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|  61.0M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|  61.0M|
  204|  61.0M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|  61.0M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|  61.0M|
  207|  61.0M|    // All of these biases were derived by measuring the cost of coding
  208|  61.0M|    // a zero vs coding a one on any given coefficient position, or, in
  209|  61.0M|    // the case of the EOB bias, the cost of coding the block with
  210|  61.0M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|  61.0M|    // to choose a new EOB. This was done over several clips, with the
  212|  61.0M|    // average of the bit costs taken over all blocks in the set, and a new
  213|  61.0M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|  61.0M|    // Journal of Dubious Theoretical Results[1], aka:
  215|  61.0M|    //
  216|  61.0M|    // lambda = ln(2) / 6.0
  217|  61.0M|    // threshold = 0.5 + (lambda * avg_rate_diff) / 2.0
  218|  61.0M|    // bias = 1 - threshold
  219|  61.0M|    //
  220|  61.0M|    // lambda is a constant since our offsets are already adjusted for the
  221|  61.0M|    // quantizer.
  222|  61.0M|    //
  223|  61.0M|    // Biases were then updated, and cost collection was re-run, until
  224|  61.0M|    // the calculated biases started to converge after 2-4 iterations.
  225|  61.0M|    //
  226|  61.0M|    // In theory, the rounding biases for inter should be somewhat smaller
  227|  61.0M|    // than the biases for intra, but this turns out to only be the case
  228|  61.0M|    // for EOB optimization, or at least, is covered by EOB optimization.
  229|  61.0M|    // The RD-optimal rounding biases for the actual coefficients seem
  230|  61.0M|    // to be quite close (+/- 1/256), for both inter and intra,
  231|  61.0M|    // post-deadzoning.
  232|  61.0M|    //
  233|  61.0M|    // [1] https://jmvalin.ca/notes/theoretical_results.pdf
  234|  61.0M|    self.dc_offset = self.dc_quant * (if is_intra { 109 } else { 108 }) / 256;
  235|  61.0M|    self.ac_offset0 = self.ac_quant * (if is_intra { 98 } else { 97 }) / 256;
  236|  61.0M|    self.ac_offset1 = self.ac_quant * (if is_intra { 109 } else { 108 }) / 256;
  237|       |    self.ac_offset_eob =
  238|  61.0M|      self.ac_quant * (if is_intra { 88 } else { 44 }) / 256;
  239|  61.0M|  }
