  195|   104M|  pub fn from_width_and_height_opt(
  196|   104M|    w: usize, h: usize,
  197|   104M|  ) -> Result<BlockSize, InvalidBlockSize> {
  198|   104M|    static BLOCK_LUT: [[Result<BlockSize, InvalidBlockSize>; 6]; 6] = [
  199|   104M|      [
  200|   104M|        Ok(BLOCK_4X4),
  201|   104M|        Ok(BLOCK_4X8),
  202|   104M|        Ok(BLOCK_4X16),
  203|   104M|        Err(InvalidBlockSize), // X32
  204|   104M|        Err(InvalidBlockSize), // X64
  205|   104M|        Err(InvalidBlockSize), // X128
  206|   104M|      ],
  207|   104M|      [
  208|   104M|        Ok(BLOCK_8X4),
  209|   104M|        Ok(BLOCK_8X8),
  210|   104M|        Ok(BLOCK_8X16),
  211|   104M|        Ok(BLOCK_8X32),
  212|   104M|        Err(InvalidBlockSize), // X64
  213|   104M|        Err(InvalidBlockSize), // X128
  214|   104M|      ],
  215|   104M|      [
  216|   104M|        Ok(BLOCK_16X4),
  217|   104M|        Ok(BLOCK_16X8),
  218|   104M|        Ok(BLOCK_16X16),
  219|   104M|        Ok(BLOCK_16X32),
  220|   104M|        Ok(BLOCK_16X64),
  221|   104M|        Err(InvalidBlockSize), // X128
  222|   104M|      ],
  223|   104M|      [
  224|   104M|        Err(InvalidBlockSize), // X4
  225|   104M|        Ok(BLOCK_32X8),
  226|   104M|        Ok(BLOCK_32X16),
  227|   104M|        Ok(BLOCK_32X32),
  228|   104M|        Ok(BLOCK_32X64),
  229|   104M|        Err(InvalidBlockSize), // X128
  230|   104M|      ],
  231|   104M|      [
  232|   104M|        Err(InvalidBlockSize), // X4
  233|   104M|        Err(InvalidBlockSize), // X8
  234|   104M|        Ok(BLOCK_64X16),
  235|   104M|        Ok(BLOCK_64X32),
  236|   104M|        Ok(BLOCK_64X64),
  237|   104M|        Ok(BLOCK_64X128),
  238|   104M|      ],
  239|   104M|      [
  240|   104M|        Err(InvalidBlockSize), // X4
  241|   104M|        Err(InvalidBlockSize), // X8
  242|   104M|        Err(InvalidBlockSize), // X16
  243|   104M|        Err(InvalidBlockSize), // X32
  244|   104M|        Ok(BLOCK_128X64),
  245|   104M|        Ok(BLOCK_128X128),
  246|   104M|      ],
  247|   104M|    ];
  248|   104M|
  249|   104M|    if (4..=128).contains(&w) && (4..=128).contains(&h) {
  250|       |      // Check if w and h are both powers of 2; writing
  251|       |      // it this way allows us to reuse the tzcnt result later on.
  252|       |      //
  253|       |      // SAFETY: w/h are always nonzero due to previous range checks.
  254|   102M|      let w_tz = unsafe { NonZeroUsize::new_unchecked(w).trailing_zeros() };
  255|   102M|      if 1 << w_tz != w {
  256|  1.53M|        return Err(InvalidBlockSize);
  257|   100M|      }
  258|   100M|      let h_tz = unsafe { NonZeroUsize::new_unchecked(h).trailing_zeros() };
  259|   100M|      if 1 << h_tz != h {
  260|  1.15M|        return Err(InvalidBlockSize);
  261|  99.7M|      }
  262|  99.7M|
  263|  99.7M|      let x = w_tz as usize - 2;
  264|  99.7M|      let y = h_tz as usize - 2;
  265|  99.7M|
  266|  99.7M|      // SAFETY: Because all the statements in the if condition are true,
  267|  99.7M|      // indexing BLOCK_LUT with x and y will never be out-of-bounds.
  268|  99.7M|      return unsafe { *BLOCK_LUT.get_unchecked(x).get_unchecked(y) };
  269|  2.17M|    }
  270|  2.17M|
  271|  2.17M|    Err(InvalidBlockSize)
  272|   104M|  }
