  521|  12.5k|pub fn setup_integral_image<T: Pixel>(
  522|  12.5k|  integral_image_buffer: &mut IntegralImageBuffer,
  523|  12.5k|  integral_image_stride: usize, crop_w: usize, crop_h: usize, stripe_w: usize,
  524|  12.5k|  stripe_h: usize, cdeffed: &PlaneSlice<T>, deblocked: &PlaneSlice<T>,
  525|  12.5k|) {
  526|  12.5k|  let integral_image = &mut integral_image_buffer.integral_image;
  527|  12.5k|  let sq_integral_image = &mut integral_image_buffer.sq_integral_image;
  528|  12.5k|
  529|  12.5k|  // Number of elements outside the stripe
  530|  12.5k|  let left_w = 4; // max radius of 2 + 2 padding
  531|  12.5k|  let right_w = 3; // max radius of 2 + 1 padding
  532|  12.5k|
  533|  12.5k|  assert_eq!(cdeffed.x, deblocked.x);
  534|       |
  535|       |  // Find how many unique elements to use to the left and right
