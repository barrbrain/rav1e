  118|       |    // Subtract 1 because the first frame in the gop is always a keyframe.
  119|  49.0k|    let group_idx = (output_frameno_in_gop - 1) / self.group_output_len;
  120|       |    // Get the offset to the corresponding input frame.
  121|       |    // TODO: This only works with pyramid_depth <= 2.
  122|  49.0k|    let offset = if idx_in_group_output < self.pyramid_depth {
