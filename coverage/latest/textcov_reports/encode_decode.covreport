 1384|  7.85M|) -> MVCandidateRD {
 1385|  7.85M|  if (cand_mv.col as isize) < mvx_min
 1386|  7.83M|    || (cand_mv.col as isize) > mvx_max
 1387|  7.79M|    || (cand_mv.row as isize) < mvy_min
 1388|  7.72M|    || (cand_mv.row as isize) > mvy_max
 1389|       |  {
