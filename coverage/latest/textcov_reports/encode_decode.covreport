  100|   535k|    quants_ac,
  101|   535k|    dc_q(qindex, dc_delta_q, bit_depth) as i32,
  102|   535k|    0,
  103|   535k|  );
  104|   535k|
  105|   535k|  let area: usize = av1_get_coded_tx_size(tx_size).area();
  106|   535k|  // Step by 16 (256/16) coefficients for each iteration
  107|   535k|  let step: usize = 16;
  108|   535k|  assert!(area >= step);
  109|       |
  110|       |  // Increase the pointers as we iterate
  111|   535k|  let mut coeffs_ptr: *const i16 = coeffs_ptr;
  112|   535k|  let mut rcoeffs_ptr: *mut i16 = rcoeffs_ptr;
  113|  2.63M|  for _i in (0..area).step_by(step) {
