   32|    940|    fs.segmentation.update_data = fi.primary_ref_frame == PRIMARY_REF_NONE;
   33|    940|
   34|    940|    // Avoid going into lossless mode by never bringing qidx below 1.
   35|    940|    // Because base_q_idx changes more frequently than the segmentation
   36|    940|    // data, it is still possible for a segment to enter lossless, so
   37|    940|    // enforcement elsewhere is needed.
   38|    940|    let offset_lower_limit = 1 - fi.base_q_idx as i16;
   39|    940|
