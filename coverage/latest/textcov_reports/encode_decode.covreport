_RNvNtCsgzd1EjkjF4V_5rav1e8quantize8divu_gen:
  107|   879k|fn divu_gen(d: u32) -> (u32, u32, u32) {
  108|   879k|  let nbits = (mem::size_of_val(&d) as u64) * 8;
  109|   879k|  let m = nbits - d.leading_zeros() as u64 - 1;
  110|   879k|  if (d & (d - 1)) == 0 {
  111|   350k|    (0xFFFF_FFFF, 0xFFFF_FFFF, m as u32)
  112|       |  } else {
  113|   528k|    let d = d as u64;
  114|   528k|    let t = (1u64 << (m + nbits)) / d;
  115|   528k|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|   528k|    if r <= 1u64 << m {
  117|   384k|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|   143k|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
  122|   879k|}
