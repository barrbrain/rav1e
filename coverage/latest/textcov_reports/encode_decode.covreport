  226|   143M|    (out0, out1)
  227|   143M|  }
_RINvNtNtNtNtCs19TYAUSqLvI_5rav1e3asm3x869transform7forward21daala_fdct_ii_16_asymNtB2_5I32X8EBa_:
  947|  16.9M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  16.9M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  16.9M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|  16.9M|  seh: T, sf: (T, T), output: &mut [T],
  951|  16.9M|) {
  952|  16.9M|  // +/- Butterflies with asymmetric input.
  953|  16.9M|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|  16.9M|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|  16.9M|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|  16.9M|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|  16.9M|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|  16.9M|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|  16.9M|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|  16.9M|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|  16.9M|
  962|  16.9M|  // Embedded 8-point orthonormal transforms.
  963|  16.9M|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|  16.9M|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
  965|  16.9M|  output[8..16].reverse();
  966|  16.9M|}
_RINvNvNtNtNtNtCs19TYAUSqLvI_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|  28.2M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  28.2M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  28.2M|    ) {
 1598|  28.2M|      let j = i * 2;
 1599|  28.2M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  28.2M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  28.2M|      half[i] = ah;
 1602|  28.2M|      half[31 - i] = dh;
 1603|  28.2M|      asym[i] = b;
 1604|  28.2M|      asym[31 - i] = c;
 1605|  28.2M|    }
_RNvYNtNtNtNtNtCs19TYAUSqLvI_5rav1e3asm3x869transform7forward9RotateNegINtB4_15RotateKernelNegNtB4_5I32X8E6kernelBc_:
  239|  76.5M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  240|  76.5M|    let t = Self::ADD(p0, p1);
  241|  76.5M|    let (a, b, c) = (p0.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  242|  76.5M|    let out0 = b.sub(c);
  243|  76.5M|    let out1 = c.sub(a);
  244|  76.5M|    (out0, out1)
  245|  76.5M|  }
_RINvNtNtNtNtCs19TYAUSqLvI_5rav1e3asm3x869transform7forward13butterfly_negNtB2_5I32X8EBa_:
  321|   527M|$($s)* fn butterfly_neg<T: TxOperations>(p0: T, p1: T) -> (T, (T, T)) {
  322|   527M|  let p1 = p0.sub(p1);
  323|   527M|  let p1h = p1.rshift1();
  324|   527M|  let p0h = p0.sub(p1h);
  325|   527M|  (p0h, (p1h, p1))
  326|   527M|}
