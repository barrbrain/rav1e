  294|  20.6k|  for y in (0..sb_h).step_by(mv_size) {
  295|  30.1k|    for x in (0..sb_w).step_by(mv_size) {
  296|  30.1k|      let sub_bo = tile_bo
  297|  30.1k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  298|  30.1k|
  299|  30.1k|      // Clamp to frame edge, rounding up in the case of subsampling.
  300|  30.1k|      // The rounding makes some assumptions about how subsampling is done.
  301|  30.1k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  302|  30.1k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  303|       |
  304|       |      // Refine the existing motion estimate
  305|  30.1k|      if let Some(results) = refine_subsampled_motion_estimate(
  306|  30.1k|        fi, ts, w, h, sub_bo, ref_frame, ssdec, lambda,
  307|  30.1k|      ) {
  308|  26.4k|        // normalize sad to 128x128 block
  309|  26.4k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  310|  26.4k|          / (w * h) as u64) as u32;
  311|  26.4k|        save_me_stats(
  312|  26.4k|          ts,
  313|  26.4k|          mv_size_in_b_log2,
  314|  26.4k|          sub_bo,
  315|  26.4k|          ref_frame,
  316|  26.4k|          MEStats { mv: results.mv, normalized_sad: sad },
  317|  26.4k|        );
  318|  26.4k|      }
  319|       |    }
  320|       |  }
