   64|  2.49M|      w += ((w >> (i + 1)) + mask) ^ mask;
   65|  2.49M|      z -= (ATANH_LOG2[i as usize] + mask) ^ mask;
   66|  2.49M|      // Repeat iteration 4.
   67|  2.49M|      if i >= 3 {
   68|   623k|        break;
   69|  1.87M|      }
   70|  1.87M|      z *= 2;
   71|  1.87M|      i += 1;
   72|       |    }
   73|       |    loop {
   74|  6.23M|      let mask = -((z < 0) as i64);
   75|  6.23M|      w += ((w >> (i + 1)) + mask) ^ mask;
   76|  6.23M|      z -= (ATANH_LOG2[i as usize] + mask) ^ mask;
   77|  6.23M|      // Repeat iteration 13.
