_RNvNtCs5T1csxkeGwJ_5rav1e4rate13chroma_offset:
  509|  2.92k|fn chroma_offset(
  510|  2.92k|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|  2.92k|) -> (i64, i64) {
  512|  2.92k|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|  2.92k|  let y = match chroma_sampling {
  515|    556|    ChromaSampling::Cs400 => 0,
  516|    520|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|    394|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|  1.45k|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|  2.92k|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|  2.92k|}
_RNvNtCs5T1csxkeGwJ_5rav1e4rate26iir_bessel2_get_parameters:
  140|  2.44k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  2.44k|  // This borrows some code from an unreleased version of Postfish.
  142|  2.44k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  2.44k|  //  on deriving the filter coefficients.
  144|  2.44k|  // alpha is Q24
  145|  2.44k|  let alpha = (1 << 24) / delay;
  146|  2.44k|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|  2.44k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  2.44k|  // k1 is 9.12 (6.12?)
  149|  2.44k|  let k1 = 3 * warp;
  150|  2.44k|  // k2 is 16.24 (11.24?)
  151|  2.44k|  let k2 = k1 * warp;
  152|  2.44k|  // d is 16.15 (10.15?)
  153|  2.44k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  2.44k|  // a is 0.32, since d is larger than both 1.0 and k2
  155|  2.44k|  let a = (k2 << 23) / d;
  156|  2.44k|  // ik2 is 25.24
  157|  2.44k|  let ik2 = (1i64 << 48) / k2;
  158|  2.44k|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|  2.44k|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|  2.44k|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|  2.44k|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|  2.44k|  // All of the filter parameters are Q24.
  163|  2.44k|  (
  164|  2.44k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  2.44k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  2.44k|    ((a + 128) >> 8) as i32,
  167|  2.44k|  )
  168|  2.44k|}
_RNvMs3_NtCs5T1csxkeGwJ_5rav1e4rateNtB5_7RCState3new:
  597|    611|  pub fn new(
  598|    611|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    611|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    611|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    611|    maybe_reservoir_frame_delay: Option<i32>,
  602|    611|  ) -> RCState {
  603|    611|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    611|    //  frames; whichever is smaller, with a minimum of 12.
  605|    611|    // For user set values, we enforce a minimum of 12.
  606|    611|    // The interval is short enough to allow reaction, but long enough to allow
  607|    611|    //  looking into the next GOP (avoiding the case where the last frames
  608|    611|    //  before an I-frame get starved), in most cases.
  609|    611|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    611|    //  errors in the worst case.
  611|    611|    let reservoir_frame_delay = maybe_reservoir_frame_delay
