 3352|    887|fn build_raw_tile_group(
 3353|    887|  ti: &TilingInfo, raw_tiles: &[Vec<u8>], max_tile_size_bytes: u32,
 3354|    887|) -> Vec<u8> {
 3355|    887|  // <https://aomediacodec.github.io/av1-spec/#general-tile-group-obu-syntax>
 3356|    887|  let mut raw = Vec::new();
 3357|    887|  let mut bw = BitWriter::endian(&mut raw, BigEndian);
 3358|    887|  if ti.cols * ti.rows > 1 {
 3359|    605|    // tile_start_and_end_present_flag
 3360|    605|    bw.write_bit(false).unwrap();
 3361|    605|  }
 3362|    887|  bw.byte_align().unwrap();
 3363|  3.05k|  for (i, raw_tile) in raw_tiles.iter().enumerate() {
 3364|  3.05k|    let last = raw_tiles.len() - 1;
 3365|  3.05k|    if i != last {
 3366|  2.17k|      let tile_size_minus_1 = raw_tile.len() - 1;
 3367|  2.17k|      bw.write_le(max_tile_size_bytes, tile_size_minus_1 as u64).unwrap();
 3368|  2.17k|    }
 3369|  3.05k|    bw.write_bytes(raw_tile).unwrap();
 3370|       |  }
 3371|    887|  raw
 3372|    887|}
