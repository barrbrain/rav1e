 1550|  7.22k|                STRIPE_IMAGE_STRIDE,
 1551|  7.22k|                &cdeffed.planes[pli]
 1552|  7.22k|                  .slice(PlaneOffset { x: x as isize, y: stripe_start_y }),
 1553|  7.22k|                &mut out.planes[pli].region_mut(Area::Rect {
