  312|  57.2M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|  57.2M|  let p0 = p0.sub(p1);
  314|  57.2M|  let p0h = p0.rshift1();
  315|  57.2M|  let p1h = p1.add(p0h);
  316|  57.2M|  ((p0h, p0), p1h)
  317|  57.2M|}
_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward16daala_fdst_vii_4NtB2_5I32X8EBa_:
  393|  11.6M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  11.6M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  11.6M|  let q0 = coeffs[0];
  397|  11.6M|  let q1 = coeffs[1];
  398|  11.6M|  let q2 = coeffs[2];
  399|  11.6M|  let q3 = coeffs[3];
  400|  11.6M|  let t0 = q1.add(q3);
  401|  11.6M|  // t1 = (q0 + q1 - q3)/2
  402|  11.6M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  11.6M|  let t2 = q0.sub(q1);
  404|  11.6M|  let t3 = q2;
  405|  11.6M|  let t4 = q0.add(q3);
  406|  11.6M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  11.6M|  let t0 = t0.tx_mul((7021, 14));
  408|  11.6M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  11.6M|  let t1 = t1.tx_mul((37837, 15));
  410|  11.6M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  11.6M|  let t2 = t2.tx_mul((21513, 15));
  412|  11.6M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  11.6M|  let t3 = t3.tx_mul((37837, 15));
  414|  11.6M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  11.6M|  let t4 = t4.tx_mul((467, 11));
  416|  11.6M|  let t3h = t3.rshift1();
  417|  11.6M|  let u4 = t4.add(t3h);
  418|  11.6M|  coeffs[0] = t0.add(u4);
  419|  11.6M|  coeffs[1] = t1;
  420|  11.6M|  coeffs[2] = t0.add(t2.sub(t3h));
  421|  11.6M|  coeffs[3] = t2.add(t3.sub(u4));
  422|  11.6M|}
_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward21daala_fdst_iv_32_asymNtB2_5I32X8EBa_:
