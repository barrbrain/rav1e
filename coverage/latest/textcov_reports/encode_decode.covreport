  563|  1.51k|      log_base_q,
  564|  1.51k|      log_target_q,
  565|  1.51k|      // TODO: Allow lossless mode; i.e. qi == 0.
  566|  1.51k|      dc_qi: [
  567|  1.51k|        clamp_qi(select_dc_qi(quantizer, bit_depth)),
  568|  1.51k|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_u, bit_depth)) },
  569|  1.51k|        if mono { 0 } else { clamp_qi(select_dc_qi(quantizer_v, bit_depth)) },
  570|       |      ],
  571|       |      ac_qi: [
  572|  1.51k|        base_q_idx,
  573|  1.51k|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_u, bit_depth)) },
  574|  1.51k|        if mono { 0 } else { clamp_qi(select_ac_qi(quantizer_v, bit_depth)) },
  575|       |      ],
  576|  1.51k|      lambda,
  577|  1.51k|      dist_scale,
  578|  1.51k|    }
  579|  1.51k|  }
_RNvNtCsixsdkNzQ5tW_5rav1e4rate10warp_alpha:
  130|  1.27k|fn warp_alpha(alpha: i32) -> i32 {
  131|  1.27k|  let i = ((alpha * 36) >> 24).min(16);
  132|  1.27k|  let t0 = ROUGH_TAN_LOOKUP[i as usize];
