 1438|   275k|        p,
 1439|   275k|        pli,
 1440|   275k|        bd,
 1441|   275k|        xdec,
 1442|   275k|        ydec,
 1443|   275k|      );
 1444|   275k|    }
 1445|   276k|    if cols >= 1 << xdec {
 1446|   276k|      filter_h_edge(
 1447|   276k|        deblock,
 1448|   276k|        blocks,
 1449|   276k|        TileBlockOffset(BlockOffset {
 1450|   276k|          x: cols - (1 << xdec),
 1451|   276k|          y: y - (1 << ydec),
 1452|   276k|        }),
 1453|   276k|        p,
 1454|   276k|        pli,
 1455|   276k|        bd,
 1456|   276k|        xdec,
 1457|   276k|        ydec,
 1458|   276k|      );
 1459|   276k|    }
 1460|       |  }
 1461|       |
 1462|       |  // Last horizontal row, vertical is already complete
