  219|  22.8k|fn estimate_sb_motion<T: Pixel>(
  220|  22.8k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  22.8k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  22.8k|  lambda: u32,
  223|  22.8k|) {
  224|  22.8k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  22.8k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  22.8k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  22.8k|
  228|  22.8k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  44.6k|  for y in (0..sb_h).step_by(mv_size) {
  232|   106k|    for x in (0..sb_w).step_by(mv_size) {
  233|   106k|      let corner: MVSamplingMode = if init {
  234|  7.61k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  98.9k|        MVSamplingMode::CORNER {
  239|  98.9k|          right: x as usize & mv_size == mv_size,
  240|  98.9k|          bottom: y as usize & mv_size == mv_size,
  241|  98.9k|        }
  242|       |      };
  243|       |
  244|   106k|      let sub_bo = tile_bo
  245|   106k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|   106k|
  247|   106k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|   106k|      // The rounding makes some assumptions about how subsampling is done.
  249|   106k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|   106k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|   106k|      if let Some(results) = estimate_motion(
  256|   106k|        fi,
  257|   106k|        ts,
  258|   106k|        w,
  259|   106k|        h,
  260|   106k|        sub_bo,
  261|   106k|        ref_frame,
  262|   106k|        None,
  263|   106k|        corner,
  264|   106k|        init,
  265|   106k|        ssdec,
  266|   106k|        Some(lambda),
  267|   106k|      ) {
  268|  93.0k|        // normalize sad to 128x128 block
  269|  93.0k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  93.0k|          / (w * h) as u64) as u32;
  271|  93.0k|        save_me_stats(
  272|  93.0k|          ts,
  273|  93.0k|          mv_size_in_b_log2,
  274|  93.0k|          sub_bo,
  275|  93.0k|          ref_frame,
  276|  93.0k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  93.0k|        );
  278|  93.0k|      }
  279|       |    }
  280|       |  }
  281|  22.8k|}
