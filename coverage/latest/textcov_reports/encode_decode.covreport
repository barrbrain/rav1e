 1050|  4.73k|fn hexagon_search<T: Pixel>(
 1051|  4.73k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  4.73k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  4.73k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  4.73k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  4.73k|) {
 1056|  4.73k|  // The first iteration of hexagon search is implemented separate from
 1057|  4.73k|  // subsequent iterations, which overlap with previous iterations.
 1058|  4.73k|
 1059|  4.73k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  4.73k|  // candidates have already been tested in a previous iteration and can be
 1061|  4.73k|  // skipped.
 1062|  4.73k|  let mut best_cand_idx: usize = 0;
 1063|  4.73k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  33.1k|  for i in 0..6 {
 1067|  28.4k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  28.4k|    let rd = get_fullpel_mv_rd(
 1069|  28.4k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  28.4k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  28.4k|    );
 1072|  28.4k|
 1073|  28.4k|    if rd.cost < best_cand.rd.cost {
 1074|  10.0k|      best_cand_idx = i;
 1075|  10.0k|      best_cand.mv = cand_mv;
 1076|  10.0k|      best_cand.rd = rd;
 1077|  18.3k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  6.16k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|  1.42k|    *current = best_cand;
 1085|  1.42k|    best_cand = MotionSearchResult::empty();
 1086|  1.42k|
 1087|  1.42k|    // Save the index/direction taken in the previous iteration to the current
 1088|  1.42k|    // search location.
