  237|  4.17M|  pub fn get_weighted_sse<T: Pixel>(
  238|  4.17M|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|  4.17M|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|  4.17M|    _cpu: CpuFeatureLevel,
  241|  4.17M|  ) -> u64 {
  242|  4.17M|    // Always chunk and apply scaling on the sse of squares the size of
  243|  4.17M|    // decimated/sub-sampled importance block sizes.
  244|  4.17M|    // Warning: Changing this will require changing/disabling assembly.
  245|  4.17M|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|  4.17M|
  247|  4.17M|    let mut sse: u64 = 0;
  248|       |
  249|  11.0M|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|  41.1M|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|  41.1M|        let mut block_sse: u32 = 0;
  252|       |
  253|   150M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|   150M|          let s1 = &src1[block_y * chunk_size + j]
  255|   150M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|   150M|          let s2 = &src2[block_y * chunk_size + j]
  257|   150M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|   150M|
  259|   150M|          block_sse += s1
  260|   150M|            .iter()
  261|   150M|            .zip(s2)
  262|   150M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|   150M|            })
  266|   150M|            .sum::<u32>();
  267|   150M|        }
  268|       |
  269|  41.1M|        sse += (block_sse as u64
  270|  41.1M|          * scale[block_y * scale_stride + block_x] as u64
  271|  41.1M|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|  41.1M|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|  4.17M|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|  4.17M|    (sse + (den >> 1)) / den
  277|  4.17M|  }
_RINvNtNtCs19TYAUSqLvI_5rav1e4dist4rust16cdef_dist_kernelhEB6_:
  296|  11.2M|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  11.2M|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  11.2M|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  11.2M|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  11.2M|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  11.2M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  11.2M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  11.2M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  11.2M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|  62.8M|    for j in 0..h {
  319|  62.8M|      let row1 = &src[j][0..w];
  320|  62.8M|      let row2 = &dst[j][0..w];
  321|   322M|      for (s, d) in row1.iter().zip(row2) {
  322|   322M|        let s: u32 = u32::cast_from(*s);
  323|   322M|        let d: u32 = u32::cast_from(*d);
  324|   322M|        sum_s += s;
  325|   322M|        sum_d += d;
  326|   322M|
  327|   322M|        sum_s2 += s * s;
  328|   322M|        sum_d2 += d * d;
  329|   322M|        sum_sd += s * d;
  330|   322M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  11.2M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  11.2M|
  337|  11.2M|    // Convert to 64-bits to avoid overflow when squaring
  338|  11.2M|    let sum_s = sum_s as u64;
  339|  11.2M|    let sum_d = sum_d as u64;
  340|  11.2M|
  341|  11.2M|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  11.2M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  11.2M|    //    (n = # samples i.e. area)
  344|  11.2M|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  11.2M|    // When w and h are powers of two, this can be done via shifting.
  346|  11.2M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  11.2M|    let div_shift = AREA_DIVISOR_BITS;
  348|  11.2M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  11.2M|    // two. Saturate to avoid underflow.
  350|  11.2M|    let mut svar = sum_s2.saturating_sub(
  351|  11.2M|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  11.2M|    );
  353|  11.2M|    let mut dvar = sum_d2.saturating_sub(
  354|  11.2M|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  11.2M|    );
  356|  11.2M|
  357|  11.2M|    // Scale variances up to 8x8 size.
  358|  11.2M|    //   scaled variance = var * (8x8) / wxh
  359|  11.2M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  11.2M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  11.2M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  11.2M|    svar =
  363|  11.2M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  11.2M|    dvar =
  365|  11.2M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  11.2M|
  367|  11.2M|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  11.2M|  }

