  755|       |
  756|  22.1M|    let do_rdo_tx_type = tx_set > TxSet::TX_SET_DCTONLY
  757|  21.5M|      && fi.config.speed_settings.transform.rdo_tx_decision
  758|  19.6M|      && !is_inter
  759|  18.0M|      && !skip;
  760|       |
  761|  22.1M|    if !do_rdo_tx_size && !do_rdo_tx_type {
  762|  3.86M|      return (best_tx_size, best_tx_type);
  763|  18.3M|    };
  764|       |
  765|  18.3M|    let tx_types =
  766|  18.3M|      if do_rdo_tx_type { RAV1E_TX_TYPES } else { &[TxType::DCT_DCT] };
  767|       |
