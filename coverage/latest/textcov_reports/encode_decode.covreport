 1050|  1.27k|fn hexagon_search<T: Pixel>(
 1051|  1.27k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  1.27k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  1.27k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  1.27k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  1.27k|) {
 1056|  1.27k|  // The first iteration of hexagon search is implemented separate from
 1057|  1.27k|  // subsequent iterations, which overlap with previous iterations.
 1058|  1.27k|
 1059|  1.27k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  1.27k|  // candidates have already been tested in a previous iteration and can be
 1061|  1.27k|  // skipped.
 1062|  1.27k|  let mut best_cand_idx: usize = 0;
 1063|  1.27k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  8.94k|  for i in 0..6 {
 1067|  7.66k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  7.66k|    let rd = get_fullpel_mv_rd(
 1069|  7.66k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  7.66k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  7.66k|    );
 1072|  7.66k|
 1073|  7.66k|    if rd.cost < best_cand.rd.cost {
 1074|  2.59k|      best_cand_idx = i;
 1075|  2.59k|      best_cand.mv = cand_mv;
 1076|  2.59k|      best_cand.rd = rd;
 1077|  5.07k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  1.54k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|    270|    *current = best_cand;
 1085|    270|    best_cand = MotionSearchResult::empty();
 1086|    270|
 1087|    270|    // Save the index/direction taken in the previous iteration to the current
 1088|    270|    // search location.
 1089|    270|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|  1.08k|    for idx_offset_mod6 in 5..=7 {
 1097|    810|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|    810|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|    810|
 1100|    810|      let rd = get_fullpel_mv_rd(
 1101|    810|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|    810|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|    810|      );
 1104|    810|
 1105|    810|      if rd.cost < best_cand.rd.cost {
 1106|    484|        best_cand_idx = i;
 1107|    484|        best_cand.mv = cand_mv;
 1108|    484|        best_cand.rd = rd;
 1109|    484|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  1.27k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  11.5k|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|  10.2k|    let cand_mv = current.mv + offset;
 1117|  10.2k|    let rd = get_fullpel_mv_rd(
 1118|  10.2k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|  10.2k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  10.2k|    );
 1121|  10.2k|
 1122|  10.2k|    if rd.cost < best_cand.rd.cost {
 1123|  3.39k|      best_cand.mv = cand_mv;
 1124|  3.39k|      best_cand.rd = rd;
 1125|  6.83k|    }
 1126|       |  }
 1127|  1.27k|  if best_cand.rd.cost < current.rd.cost {
 1128|     91|    *current = best_cand;
 1129|  1.18k|  }
 1130|       |
 1131|  1.27k|  assert!(!current.is_empty());
 1132|  1.27k|}
