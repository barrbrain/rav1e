 1336|      9|          let unshifted_stretch = ((fi.width >> xdec) - 1) % lrf_unit_size
 1337|      9|            <= lrf_unit_size / 2
 1338|      6|            || ((fi.height >> ydec) - 1) % lrf_unit_size <= lrf_unit_size / 2;
 1339|      9|          let shifted_stretch = ((fi.width >> xdec) - 1)
