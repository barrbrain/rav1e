   94|    313|      tile_rows_log2,
   95|    313|      still_picture,
   96|    313|      grain_table,
   97|    313|    );
   98|    313|
   99|    313|    debug!(
  100|      0|      "Encoding {}x{} speed {} quantizer {} bit-depth {} bitrate {}",
  101|       |      w, h, speed, quantizer, bit_depth, bitrate
  102|       |    );
  103|       |    #[cfg(feature = "dump_ivf")]
  104|       |    let mut out = std::fs::File::create(&format!(
  105|       |      "out-{}x{}-s{}-q{}-r{}-{:?}.ivf",
  106|       |      w, h, speed, quantizer, bitrate, chroma_sampling
  107|       |    ))
  108|       |    .unwrap();
  109|       |    #[cfg(feature = "dump_ivf")]
  110|       |    ivf::write_ivf_header(&mut out, w, h, 30, 1);
  111|       |
