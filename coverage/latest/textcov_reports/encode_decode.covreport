 1465|    661|  pub fn lrf_filter_frame<T: Pixel>(
 1466|    661|    &mut self, out: &mut Frame<T>, pre_cdef: &Frame<T>,
 1467|    661|    fi: &FrameInvariants<T>,
 1468|    661|  ) {
 1469|    661|    let cdeffed = out.clone();
 1470|    661|    let planes =
 1471|    661|      if fi.sequence.chroma_sampling == Cs400 { 1 } else { MAX_PLANES };
 1472|       |
 1473|       |    // unlike the other loop filters that operate over the padded
 1474|       |    // frame dimensions, restoration filtering and source pixel
 1475|       |    // accesses are clipped to the original frame dimensions
 1476|       |    // that's why we use fi.width and fi.height instead of PlaneConfig fields
 1477|       |
 1478|       |    // number of stripes (counted according to colocated Y luma position)
 1479|    661|    let stripe_n = (fi.height + 7) / 64 + 1;
 1480|    661|
 1481|    661|    // Buffers for the stripe filter.
 1482|    661|    let mut stripe_filter_buffer =
 1483|    661|      IntegralImageBuffer::zeroed(STRIPE_IMAGE_SIZE);
 1484|       |
 1485|  1.72k|    for pli in 0..planes {
 1486|  1.72k|      let rp = &self.planes[pli];
 1487|  1.72k|      let xdec = out.planes[pli].cfg.xdec;
 1488|  1.72k|      let ydec = out.planes[pli].cfg.ydec;
 1489|  1.72k|      let crop_w = (fi.width + (1 << xdec >> 1)) >> xdec;
 1490|  1.72k|      let crop_h = (fi.height + (1 << ydec >> 1)) >> ydec;
