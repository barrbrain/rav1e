 1504|  14.1M|fn get_mv_rate(
 1505|  14.1M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  14.1M|) -> u32 {
 1507|  14.1M|  #[inline(always)]
