  107|   152M|fn divu_gen(d: u32) -> (u32, u32, u32) {
  108|   152M|  let nbits = (mem::size_of_val(&d) as u64) * 8;
  109|   152M|  let m = nbits - d.leading_zeros() as u64 - 1;
  110|   152M|  if (d & (d - 1)) == 0 {
  111|  10.7M|    (0xFFFF_FFFF, 0xFFFF_FFFF, m as u32)
  112|       |  } else {
  113|   142M|    let d = d as u64;
  114|   142M|    let t = (1u64 << (m + nbits)) / d;
  115|   142M|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|   142M|    if r <= 1u64 << m {
  117|   104M|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|  37.6M|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
  122|   152M|}
