 1164|  1.27k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  1.27k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  1.27k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  1.27k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  1.27k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  1.27k|) {
 1170|  1.27k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  1.27k|  let center = current.mv;
 1187|       |
