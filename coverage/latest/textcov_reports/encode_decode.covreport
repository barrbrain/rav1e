 1649|    603|            (q * 17563 - 421_574 + (1 << 18 >> 1)) >> 18
 1650|       |          } else {
 1651|    691|            (q * 6017 + 650_707 + (1 << 18 >> 1)) >> 18
 1652|       |          }
 1653|       |        }
 1654|       |        10 => {
 1655|      0|          if fi.frame_type == FrameType::KEY {
 1656|      0|            ((q * 20723 + 4_060_632 + (1 << 20 >> 1)) >> 20) - 4
