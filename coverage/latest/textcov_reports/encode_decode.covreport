  113|    313|    read_frame_batch(&mut ctx, &mut ra, limit);
  114|    313|
  115|    313|    for _ in 0..limit {
  116|    524|      let mut corrupted_count = 0;
  117|    524|      loop {
  118|    524|        let res = ctx.receive_packet();
  119|    524|        if let Ok(pkt) = res {
  120|    465|          debug!("Encoded packet {}", pkt.input_frameno);
  121|       |
  122|       |          #[cfg(feature = "dump_ivf")]
  123|       |          ivf::write_ivf_frame(&mut out, pkt.input_frameno, &pkt.data);
  124|       |
  125|    465|          if let Some(pkt_rec) = pkt.rec {
  126|    465|            rec_fifo.push_back((*pkt_rec).clone());
  127|    465|          }
  128|    465|          let packet = pkt.data;
  129|    465|          debug!("Decoding frame {}", pkt.input_frameno);
  130|    465|          match self.decode_packet(
  131|    465|            &packet,
  132|    465|            &mut rec_fifo,
  133|    465|            w,
  134|    465|            h,
  135|    465|            chroma_sampling,
  136|    465|            bit_depth,
  137|    465|            verify,
  138|    465|          ) {
  139|       |            DecodeResult::Done => {
  140|    465|              break;
  141|       |            }
  142|      0|            DecodeResult::NotDone => {}
  143|      0|            DecodeResult::Corrupted(corrupted) => {
  144|      0|              corrupted_count += corrupted;
  145|      0|            }
  146|       |          }
  147|       |        } else {
  148|     59|          break;
  149|       |        }
  150|       |      }
  151|    524|      assert_eq!(corrupted_count, 0);
  152|       |    }
  153|    313|  }
