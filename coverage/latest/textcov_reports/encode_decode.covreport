  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|  4.78k|    let org_region = &match ssdec {
  657|  3.47k|      0 => ts.input_tile.planes[0]
  658|  3.47k|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|  1.30k|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|  4.78k|    let mv =
