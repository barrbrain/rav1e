  181|  28.0k|          let frame_flag = 1 << fi.ref_frames[ref_frame.to_index()];
  182|  28.0k|          if tested_frames_flags & frame_flag == frame_flag {
  183|  17.3k|            continue;
  184|  10.6k|          }
  185|  10.6k|          tested_frames_flags |= frame_flag;
  186|  10.6k|
  187|  10.6k|          let tile_bo =
  188|  10.6k|            TileSuperBlockOffset(SuperBlockOffset { x: sbx, y: sby })
  189|  10.6k|              .block_offset(0, 0);
  190|  10.6k|
  191|  10.6k|          if new_subsampling {
  192|  7.11k|            refine_subsampled_sb_motion(
  193|  7.11k|              fi,
  194|  7.11k|              ts,
  195|  7.11k|              ref_frame,
  196|  7.11k|              mv_size_in_b_log2 + 1,
  197|  7.11k|              tile_bo,
  198|  7.11k|              ssdec,
  199|  7.11k|              lambda,
  200|  7.11k|            );
  201|  7.11k|          }
  202|       |
  203|  10.6k|          estimate_sb_motion(
  204|  10.6k|            fi,
  205|  10.6k|            ts,
  206|  10.6k|            ref_frame,
  207|  10.6k|            mv_size_in_b_log2,
  208|  10.6k|            tile_bo,
  209|  10.6k|            init,
  210|  10.6k|            ssdec,
  211|  10.6k|            lambda,
  212|  10.6k|          );
  213|       |        }
  214|       |      }
  215|       |    }
  216|       |  }
  217|    830|}
_RINvNtCsixsdkNzQ5tW_5rav1e2me18estimate_sb_motionhEB4_:
  219|  10.6k|fn estimate_sb_motion<T: Pixel>(
  220|  10.6k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  10.6k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  10.6k|  lambda: u32,
  223|  10.6k|) {
  224|  10.6k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  10.6k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  10.6k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  10.6k|
  228|  10.6k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  20.3k|  for y in (0..sb_h).step_by(mv_size) {
  232|  47.1k|    for x in (0..sb_w).step_by(mv_size) {
  233|  47.1k|      let corner: MVSamplingMode = if init {
  234|  3.55k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  43.5k|        MVSamplingMode::CORNER {
  239|  43.5k|          right: x as usize & mv_size == mv_size,
  240|  43.5k|          bottom: y as usize & mv_size == mv_size,
  241|  43.5k|        }
  242|       |      };
  243|       |
  244|  47.1k|      let sub_bo = tile_bo
  245|  47.1k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|  47.1k|
  247|  47.1k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|  47.1k|      // The rounding makes some assumptions about how subsampling is done.
  249|  47.1k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|  47.1k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|  47.1k|      if let Some(results) = estimate_motion(
  256|  47.1k|        fi,
  257|  47.1k|        ts,
  258|  47.1k|        w,
  259|  47.1k|        h,
  260|  47.1k|        sub_bo,
  261|  47.1k|        ref_frame,
  262|  47.1k|        None,
  263|  47.1k|        corner,
  264|  47.1k|        init,
  265|  47.1k|        ssdec,
  266|  47.1k|        Some(lambda),
  267|  47.1k|      ) {
  268|  43.0k|        // normalize sad to 128x128 block
  269|  43.0k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  43.0k|          / (w * h) as u64) as u32;
  271|  43.0k|        save_me_stats(
  272|  43.0k|          ts,
  273|  43.0k|          mv_size_in_b_log2,
  274|  43.0k|          sub_bo,
  275|  43.0k|          ref_frame,
  276|  43.0k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  43.0k|        );
  278|  43.0k|      }
  279|       |    }
  280|       |  }
  281|  10.6k|}
_RINvNtCsixsdkNzQ5tW_5rav1e2me11full_searchhEB4_:
 1456|  13.7k|fn full_search<T: Pixel>(
 1457|  13.7k|  fi: &FrameInvariants<T>, x_lo: isize, x_hi: isize, y_lo: isize, y_hi: isize,
 1458|  13.7k|  w: usize, h: usize, org_region: &PlaneRegion<T>, p_ref: &Plane<T>,
 1459|  13.7k|  po: PlaneOffset, step: usize, lambda: u32, pmv: [MotionVector; 2],
 1460|  13.7k|) -> MotionSearchResult {
 1461|  13.7k|  let search_region = p_ref.region(Area::Rect {
 1462|  13.7k|    x: x_lo,
 1463|  13.7k|    y: y_lo,
 1464|  13.7k|    width: (x_hi - x_lo) as usize + w,
 1465|  13.7k|    height: (y_hi - y_lo) as usize + h,
 1466|  13.7k|  });
 1467|  13.7k|
 1468|  13.7k|  let mut best: MotionSearchResult = MotionSearchResult::empty();
 1469|       |
 1470|       |  // Select rectangular regions within search region with vert+horz windows
 1471|  93.3k|  for vert_window in search_region.vert_windows(h).step_by(step) {
 1472|  2.39M|    for ref_window in vert_window.horz_windows(w).step_by(step) {
 1473|  2.39M|      let &Rect { x, y, .. } = ref_window.rect();
 1474|  2.39M|
 1475|  2.39M|      let mv = MotionVector {
 1476|  2.39M|        row: 8 * (y as i16 - po.y as i16),
 1477|  2.39M|        col: 8 * (x as i16 - po.x as i16),
 1478|  2.39M|      };
 1479|  2.39M|
 1480|  2.39M|      let rd = compute_mv_rd(
 1481|  2.39M|        fi,
 1482|  2.39M|        pmv,
 1483|  2.39M|        lambda,
 1484|  2.39M|        false,
 1485|  2.39M|        fi.sequence.bit_depth,
 1486|  2.39M|        w,
 1487|  2.39M|        h,
 1488|  2.39M|        mv,
 1489|  2.39M|        org_region,
 1490|  2.39M|        &ref_window,
 1491|  2.39M|      );
 1492|  2.39M|
 1493|  2.39M|      if rd.cost < best.rd.cost {
 1494|  55.4k|        best.rd = rd;
