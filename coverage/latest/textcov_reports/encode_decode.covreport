  384|   135k|fn get_subset_predictors(
  385|   135k|  tile_bo: TileBlockOffset, tile_me_stats: &TileMEStats<'_>,
  386|   135k|  frame_ref_opt: Option<ReadGuardMEStats<'_>>, ref_frame_id: usize,
  387|   135k|  pix_w: usize, pix_h: usize, mvx_min: isize, mvx_max: isize, mvy_min: isize,
  388|   135k|  mvy_max: isize, corner: MVSamplingMode, ssdec: u8,
