_RNvNtCs3tIhnEwGhQF_5rav1e4rate13chroma_offset:
  509|  1.37k|fn chroma_offset(
  510|  1.37k|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|  1.37k|) -> (i64, i64) {
  512|  1.37k|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|  1.37k|  let y = match chroma_sampling {
  515|    240|    ChromaSampling::Cs400 => 0,
  516|    183|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|    128|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|    823|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|  1.37k|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|  1.37k|}
_RNvNtCs3tIhnEwGhQF_5rav1e4rate26iir_bessel2_get_parameters:
  140|  1.13k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  1.13k|  // This borrows some code from an unreleased version of Postfish.
  142|  1.13k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  1.13k|  //  on deriving the filter coefficients.
  144|  1.13k|  // alpha is Q24
  145|  1.13k|  let alpha = (1 << 24) / delay;
  146|  1.13k|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|  1.13k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  1.13k|  // k1 is 9.12 (6.12?)
  149|  1.13k|  let k1 = 3 * warp;
  150|  1.13k|  // k2 is 16.24 (11.24?)
  151|  1.13k|  let k2 = k1 * warp;
  152|  1.13k|  // d is 16.15 (10.15?)
  153|  1.13k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  1.13k|  // a is 0.32, since d is larger than both 1.0 and k2
  155|  1.13k|  let a = (k2 << 23) / d;
  156|  1.13k|  // ik2 is 25.24
  157|  1.13k|  let ik2 = (1i64 << 48) / k2;
  158|  1.13k|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|  1.13k|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|  1.13k|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|  1.13k|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|  1.13k|  // All of the filter parameters are Q24.
  163|  1.13k|  (
  164|  1.13k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  1.13k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  1.13k|    ((a + 128) >> 8) as i32,
  167|  1.13k|  )
  168|  1.13k|}
_RNvMs3_NtCs3tIhnEwGhQF_5rav1e4rateNtB5_7RCState3new:
  597|    283|  pub fn new(
  598|    283|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    283|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    283|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    283|    maybe_reservoir_frame_delay: Option<i32>,
  602|    283|  ) -> RCState {
  603|    283|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    283|    //  frames; whichever is smaller, with a minimum of 12.
  605|    283|    // For user set values, we enforce a minimum of 12.
  606|    283|    // The interval is short enough to allow reaction, but long enough to allow
  607|    283|    //  looking into the next GOP (avoiding the case where the last frames
  608|    283|    //  before an I-frame get starved), in most cases.
  609|    283|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    283|    //  errors in the worst case.
  611|    283|    let reservoir_frame_delay = maybe_reservoir_frame_delay
  612|    283|      .unwrap_or_else(|| ((max_key_frame_interval * 3) >> 1).min(240))
  613|    283|      .max(12);
  614|    283|    // TODO: What are the limits on these?
  615|    283|    let npixels = (frame_width as i64) * (frame_height as i64);
  616|    283|    // Insane framerates or frame sizes mean insane bitrates.
  617|    283|    // Let's not get carried away.
  618|    283|    // We also subtract 16 bits from each temporal unit to account for the
  619|    283|    //  temporal delimiter, whose bits are not included in the frame sizes
  620|    283|    //  reported to update_state().
  621|    283|    // TODO: Support constraints imposed by levels.
  622|    283|    let bits_per_tu = clamp(
  623|    283|      (target_bitrate as i64) * framerate_den / framerate_num,
  624|    283|      40,
  625|    283|      0x4000_0000_0000,
  626|    283|    ) - (TEMPORAL_DELIMITER.len() * 8) as i64;
  627|    283|    let reservoir_max = bits_per_tu * (reservoir_frame_delay as i64);
  628|    283|    // Start with a buffer fullness and fullness target of 50%.
  629|    283|    let reservoir_target = (reservoir_max + 1) >> 1;
  630|    283|    // Pick exponents and initial scales for quantizer selection.
  631|    283|    let ibpp = npixels / bits_per_tu;
  632|       |    // These have been derived by encoding many clips at every quantizer
  633|       |    // and running a piecewise-linear regression in binary log space.
  634|    283|    let (i_exp, i_log_scale) = if ibpp < 1 {
  635|     11|      (48u8, blog64(36) - q57(QSCALE))
  636|    272|    } else if ibpp < 4 {
  637|     29|      (61u8, blog64(55) - q57(QSCALE))
  638|       |    } else {
  639|    243|      (77u8, blog64(129) - q57(QSCALE))
  640|       |    };
  641|    283|    let (p_exp, p_log_scale) = if ibpp < 2 {
  642|     13|      (69u8, blog64(32) - q57(QSCALE))
  643|    270|    } else if ibpp < 139 {
  644|    239|      (104u8, blog64(84) - q57(QSCALE))
  645|       |    } else {
  646|     31|      (83u8, blog64(19) - q57(QSCALE))
  647|       |    };
  648|    283|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
  649|     13|      (84u8, blog64(30) - q57(QSCALE))
  650|    270|    } else if ibpp < 92 {
  651|    234|      (120u8, blog64(68) - q57(QSCALE))
  652|       |    } else {
  653|     36|      (68u8, blog64(4) - q57(QSCALE))
  654|       |    };
  655|    283|    let (b1_exp, b1_log_scale) = if ibpp < 2 {
  656|     13|      (87u8, blog64(27) - q57(QSCALE))
  657|    270|    } else if ibpp < 126 {
  658|    239|      (139u8, blog64(84) - q57(QSCALE))
  659|       |    } else {
  660|     31|      (61u8, blog64(1) - q57(QSCALE))
  661|       |    };
  662|       |
  663|       |    // TODO: Add support for "golden" P frames.
  664|    283|    RCState {
  665|    283|      target_bitrate,
  666|    283|      reservoir_frame_delay,
  667|    283|      reservoir_frame_delay_is_set: maybe_reservoir_frame_delay.is_some(),
  668|    283|      maybe_ac_qi_max,
  669|    283|      ac_qi_min,
  670|    283|      drop_frames: false,
  671|    283|      cap_overflow: true,
  672|    283|      cap_underflow: false,
  673|    283|      pass1_log_base_q: 0,
  674|    283|      twopass_state: PASS_SINGLE,
  675|    283|      log_npixels: blog64(npixels),
  676|    283|      bits_per_tu,
  677|    283|      reservoir_fullness: reservoir_target,
  678|    283|      reservoir_target,
  679|    283|      reservoir_max,
  680|    283|      log_scale: [i_log_scale, p_log_scale, b0_log_scale, b1_log_scale],
  681|    283|      exp: [i_exp, p_exp, b0_exp, b1_exp],
  682|    283|      scalefilter: [
  683|    283|        IIRBessel2::new(4, q57_to_q24(i_log_scale)),
  684|    283|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(p_log_scale)),
  685|    283|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b0_log_scale)),
  686|    283|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b1_log_scale)),
  687|    283|      ],
  688|    283|      // TODO VFR
  689|    283|      nframes: [0; FRAME_NSUBTYPES + 1],
  690|    283|      inter_delay: [INTER_DELAY_TARGET_MIN; FRAME_NSUBTYPES - 1],
  691|    283|      inter_delay_target: reservoir_frame_delay >> 1,
  692|    283|      rate_bias: 0,
  693|    283|      nencoded_frames: 0,
  694|    283|      nsef_frames: 0,
  695|    283|      pass1_buffer: [0; TWOPASS_HEADER_SZ],
  696|    283|      pass1_data_retrieved: true,
  697|    283|      pass1_summary_retrieved: false,
  698|    283|      pass2_data_ready: false,
  699|    283|      prev_metrics: RCFrameMetrics::new(),
  700|    283|      cur_metrics: RCFrameMetrics::new(),
  701|    283|      frame_metrics: Vec::new(),
  702|    283|      nframe_metrics: 0,
  703|    283|      frame_metrics_head: 0,
  704|    283|      ntus: 0,
  705|    283|      ntus_total: 0,
  706|    283|      ntus_left: 0,
  707|    283|      nframes_total: [0; FRAME_NSUBTYPES + 1],
  708|    283|      nframes_total_total: 0,
  709|    283|      nframes_left: [0; FRAME_NSUBTYPES + 1],
  710|    283|      scale_sum: [0; FRAME_NSUBTYPES],
  711|    283|      scale_window_ntus: 0,
  712|    283|      scale_window_nframes: [0; FRAME_NSUBTYPES + 1],
  713|    283|      scale_window_sum: [0; FRAME_NSUBTYPES],
  714|    283|      des: RCDeserialize::default(),
  715|    283|    }
  716|    283|  }
