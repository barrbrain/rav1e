  195|   114M|  pub fn update(
  196|   114M|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|   114M|    dc_delta_q: i8, ac_delta_q: i8,
  198|   114M|  ) {
  199|   114M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|   114M|
  201|   114M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|   114M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|   114M|
  204|   114M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|   114M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|   114M|
  207|   114M|    // All of these biases were derived by measuring the cost of coding
  208|   114M|    // a zero vs coding a one on any given coefficient position, or, in
  209|   114M|    // the case of the EOB bias, the cost of coding the block with
  210|   114M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|   114M|    // to choose a new EOB. This was done over several clips, with the
  212|   114M|    // average of the bit costs taken over all blocks in the set, and a new
  213|   114M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|   114M|    // Journal of Dubious Theoretical Results[1], aka:
  215|   114M|    //
  216|   114M|    // lambda = ln(2) / 6.0
  217|   114M|    // threshold = 0.5 + (lambda * avg_rate_diff) / 2.0
  218|   114M|    // bias = 1 - threshold
  219|   114M|    //
  220|   114M|    // lambda is a constant since our offsets are already adjusted for the
  221|   114M|    // quantizer.
  222|   114M|    //
  223|   114M|    // Biases were then updated, and cost collection was re-run, until
  224|   114M|    // the calculated biases started to converge after 2-4 iterations.
  225|   114M|    //
  226|   114M|    // In theory, the rounding biases for inter should be somewhat smaller
  227|   114M|    // than the biases for intra, but this turns out to only be the case
  228|   114M|    // for EOB optimization, or at least, is covered by EOB optimization.
  229|   114M|    // The RD-optimal rounding biases for the actual coefficients seem
  230|   114M|    // to be quite close (+/- 1/256), for both inter and intra,
  231|   114M|    // post-deadzoning.
  232|   114M|    //
  233|   114M|    // [1] https://jmvalin.ca/notes/theoretical_results.pdf
  234|   114M|    self.dc_offset = self.dc_quant * (if is_intra { 109 } else { 108 }) / 256;
  235|   114M|    self.ac_offset0 = self.ac_quant * (if is_intra { 98 } else { 97 }) / 256;
  236|   114M|    self.ac_offset1 = self.ac_quant * (if is_intra { 109 } else { 108 }) / 256;
  237|       |    self.ac_offset_eob =
  238|   114M|      self.ac_quant * (if is_intra { 88 } else { 44 }) / 256;
  239|   114M|  }
