_RNvNtCsixsdkNzQ5tW_5rav1e2me12get_mv_range:
  338|   156k|fn get_mv_range(
  339|   156k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   156k|  blk_h: usize,
  341|   156k|) -> (isize, isize, isize, isize) {
  342|   156k|  let border_w = 128 + blk_w as isize * 8;
  343|   156k|  let border_h = 128 + blk_h as isize * 8;
  344|   156k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   156k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   156k|    * (8 * MI_SIZE) as isize
  347|   156k|    + border_w;
  348|   156k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   156k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   156k|    * (8 * MI_SIZE) as isize
  351|   156k|    + border_h;
  352|   156k|
  353|   156k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   156k|  use crate::context::{MV_LOW, MV_UPP};
  355|   156k|  (
  356|   156k|    mvx_min.max(MV_LOW as isize + 1),
  357|   156k|    mvx_max.min(MV_UPP as isize - 1),
  358|   156k|    mvy_min.max(MV_LOW as isize + 1),
  359|   156k|    mvy_max.min(MV_UPP as isize - 1),
  360|   156k|  )
  361|   156k|}
