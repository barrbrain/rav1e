  976|  16.9M|  // 62241/32768 = (Sin[31*Pi/64] - Cos[31*Pi/64])*2 = 1.8994555637555088
  977|  16.9M|  //   201/16384 = Cos[31*Pi/64]*2                   = 0.0981353486548360
  978|  16.9M|  let (s0, sf) =
  979|  16.9M|    RotateAddShift::half_kernel(s0, sfh, ((1073, 11), (62241, 15), (201, 11)));
  980|  16.9M|  // 18611/32768 = (Sin[29*Pi/64] + Cos[29*Pi/64])/2 = 0.5679534922100714
  981|  16.9M|  // 55211/32768 = (Sin[29*Pi/64] - Cos[29*Pi/64])*2 = 1.6848920710188384
  982|  16.9M|  //    601/2048 = Cos[29*Pi/64]*2                   = 0.2934609489107235
  983|  16.9M|  let (se, s1) = RotateSubShift::half_kernel(
  984|  16.9M|    se,
  985|  16.9M|    s1h,
  986|  16.9M|    ((18611, 15), (55211, 15), (601, 11)),
  987|  16.9M|  );
  988|  16.9M|  //  9937/16384 = (Sin[27*Pi/64] + Cos[27*Pi/64])/2 = 0.6065057165489039
  989|  16.9M|  //   1489/1024 = (Sin[27*Pi/64] - Cos[27*Pi/64])*2 = 1.4541021465825602
  990|  16.9M|  //   3981/8192 = Cos[27*Pi/64]*2                   = 0.4859603598065277
  991|  16.9M|  let (s2, sd) =
  992|  16.9M|    RotateAddShift::half_kernel(s2, sdh, ((9937, 14), (1489, 10), (3981, 13)));
  993|  16.9M|  // 10473/16384 = (Sin[25*Pi/64] + Cos[25*Pi/64])/2 = 0.6392169592876205
  994|  16.9M|  // 39627/32768 = (Sin[25*Pi/64] - Cos[25*Pi/64])*2 = 1.2093084235816014
  995|  16.9M|  // 11039/16384 = Cos[25*Pi/64]*2                   = 0.6737797067844401
  996|  16.9M|  let (sc, s3) = RotateSubShift::half_kernel(
  997|  16.9M|    sc,
  998|  16.9M|    s3h,
  999|  16.9M|    ((10473, 14), (39627, 15), (11039, 14)),
 1000|  16.9M|  );
 1001|  16.9M|  // 2727/4096 = (Sin[23*Pi/64] + Cos[23*Pi/64])/2 = 0.6657721932768628
 1002|  16.9M|  // 3903/4096 = (Sin[23*Pi/64] - Cos[23*Pi/64])*2 = 0.9528683993863225
 1003|  16.9M|  // 7005/8192 = Cos[23*Pi/64]*2                   = 0.8551101868605642
 1004|  16.9M|  let (s4, sb) =
 1005|  16.9M|    RotateAddShift::half_kernel(s4, sbh, ((2727, 12), (3903, 12), (7005, 13)));
 1006|  16.9M|  // 5619/8192 = (Sin[21*Pi/64] + Cos[21*Pi/64])/2 = 0.6859156770967569
 1007|  16.9M|  // 2815/4096 = (Sin[21*Pi/64] - Cos[21*Pi/64])*2 = 0.6872517316141069
 1008|  16.9M|  // 8423/8192 = Cos[21*Pi/64]*2                   = 1.0282054883864433
 1009|  16.9M|  let (sa, s5) =
 1010|  16.9M|    RotateSubShift::half_kernel(sa, s5h, ((5619, 13), (2815, 12), (8423, 13)));
 1011|  16.9M|  //   2865/4096 = (Sin[19*Pi/64] + Cos[19*Pi/64])/2 = 0.6994534179865391
 1012|  16.9M|  // 13588/32768 = (Sin[19*Pi/64] - Cos[19*Pi/64])*2 = 0.4150164539764232
 1013|  16.9M|  //     305/256 = Cos[19*Pi/64]*2                   = 1.1913986089848667
 1014|  16.9M|  let (s6, s9) =
 1015|  16.9M|    RotateAddShift::half_kernel(s6, s9h, ((2865, 12), (13599, 15), (305, 8)));
 1016|  16.9M|  // 23143/32768 = (Sin[17*Pi/64] + Cos[17*Pi/64])/2 = 0.7062550401009887
 1017|  16.9M|  //   1137/8192 = (Sin[17*Pi/64] - Cos[17*Pi/64])*2 = 0.1387843410158816
 1018|  16.9M|  //  11003/8192 = Cos[17*Pi/64]*2                   = 1.3431179096940367
 1019|  16.9M|  let (s8, s7) = RotateSubShift::half_kernel(
 1020|  16.9M|    s8,
 1021|  16.9M|    s7h,
 1022|  16.9M|    ((23143, 15), (1137, 13), (11003, 13)),
 1023|  16.9M|  );
 1024|  16.9M|
 1025|  16.9M|  // Stage 1
 1026|  16.9M|  let (s0, s7) = butterfly_sub_asym((s0.rshift1(), s0), s7);
 1027|  16.9M|  let (s8, sf) = butterfly_sub_asym((s8.rshift1(), s8), sf);
 1028|  16.9M|  let (s4, s3) = butterfly_add_asym((s4.rshift1(), s4), s3);
 1029|  16.9M|  let (sc, sb) = butterfly_add_asym((sc.rshift1(), sc), sb);
 1030|  16.9M|  let (s2, s5) = butterfly_sub_asym((s2.rshift1(), s2), s5);
 1031|  16.9M|  let (sa, sd) = butterfly_sub_asym((sa.rshift1(), sa), sd);
 1032|  16.9M|  let (s6, s1) = butterfly_add_asym((s6.rshift1(), s6), s1);
 1033|  16.9M|  let (se, s9) = butterfly_add_asym((se.rshift1(), se), s9);
 1034|  16.9M|
 1035|  16.9M|  // Stage 2
 1036|  16.9M|  let ((_s8h, s8), s4h) = butterfly_add(s8, s4);
 1037|  16.9M|  let ((_s7h, s7), sbh) = butterfly_add(s7, sb);
 1038|  16.9M|  let ((_sah, sa), s6h) = butterfly_sub(sa, s6);
 1039|  16.9M|  let ((_s5h, s5), s9h) = butterfly_sub(s5, s9);
 1040|  16.9M|  let (s0, s3h) = butterfly_add(s0, s3);
 1041|  16.9M|  let (sd, seh) = butterfly_add(sd, se);
 1042|  16.9M|  let (s2, s1h) = butterfly_sub(s2, s1);
 1043|  16.9M|  let (sf, sch) = butterfly_sub(sf, sc);
 1044|  16.9M|
 1045|  16.9M|  // Stage 3
 1046|  16.9M|  //   9633/8192 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1047|  16.9M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1048|  16.9M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1049|  16.9M|  let (s8, s7) =
 1050|  16.9M|    RotateAdd::kernel(s8, s7, ((9633, 13), (12873, 14), (6393, 15)));
 1051|  16.9M|  // 22725/16384 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1052|  16.9M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1053|  16.9M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1054|  16.9M|  let (s9, s6) =
 1055|  16.9M|    RotateAdd::kernel(s9h, s6h, ((22725, 14), (9041, 15), (4551, 13)));
 1056|  16.9M|  //  11363/8192 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1057|  16.9M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1058|  16.9M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1059|  16.9M|  let (s5, sa) =
 1060|  16.9M|    RotateNeg::kernel(s5, sa, ((11363, 13), (9041, 15), (4551, 13)));
 1061|  16.9M|  //  9633/32768 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1062|  16.9M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1063|  16.9M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1064|  16.9M|  let (s4, sb) =
 1065|  16.9M|    RotateNeg::kernel(s4h, sbh, ((9633, 13), (12873, 14), (6393, 15)));
 1066|  16.9M|
 1067|  16.9M|  // Stage 4
 1068|  16.9M|  let (s2, sc) = butterfly_add_asym(s2, sch);
 1069|  16.9M|  let (s0, s1) = butterfly_sub_asym(s0, s1h);
 1070|  16.9M|  let (sf, se) = butterfly_add_asym(sf, seh);
 1071|  16.9M|  let (sd, s3) = butterfly_add_asym(sd, s3h);
 1072|  16.9M|  let (s7, s6) = butterfly_add_asym((s7.rshift1(), s7), s6);
 1073|  16.9M|  let (s8, s9) = butterfly_sub_asym((s8.rshift1(), s8), s9);
 1074|  16.9M|  let (sa, sb) = butterfly_sub_asym((sa.rshift1(), sa), sb);
 1075|  16.9M|  let (s5, s4) = butterfly_add_asym((s5.rshift1(), s5), s4);
 1076|  16.9M|
 1077|  16.9M|  // Stage 5
 1078|  16.9M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
 1079|  16.9M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1080|  16.9M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1081|  16.9M|  let (sc, s3) =
 1082|  16.9M|    RotateAdd::kernel(sc, s3, ((10703, 13), (8867, 14), (3135, 13)));
 1083|  16.9M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3870398453221475
 1084|  16.9M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1085|  16.9M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1086|  16.9M|  let (s2, sd) =
 1087|  16.9M|    RotateNeg::kernel(s2, sd, ((10703, 13), (8867, 14), (3135, 13)));
