  138|  19.8M|    -(value as i32)
  139|       |  } else {
  140|  20.0M|    value as i32
  141|       |  }
  142|  39.8M|}
_RNvNtCsgzd1EjkjF4V_5rav1e8quantize4ac_q:
   41|   975k|pub fn ac_q(qindex: u8, delta_q: i8, bit_depth: usize) -> i16 {
   42|   975k|  static AC_Q: [&[i16; 256]; 3] =
   43|   975k|    [&ac_qlookup_Q3, &ac_qlookup_10_Q3, &ac_qlookup_12_Q3];
   44|   975k|  let bd = ((bit_depth ^ 8) >> 1).min(2);
   45|   975k|  AC_Q[bd][((qindex as isize + delta_q as isize).max(0) as usize).min(255)]
   46|   975k|}
_RNvNtCsgzd1EjkjF4V_5rav1e8quantize16get_log_tx_scale:
   27|   974k|pub fn get_log_tx_scale(tx_size: TxSize) -> usize {
   28|   974k|  let num_pixels = tx_size.area();
   29|   974k|
   30|   974k|  Into::<usize>::into(num_pixels > 256)
   31|   974k|    + Into::<usize>::into(num_pixels > 1024)
   32|   974k|}
