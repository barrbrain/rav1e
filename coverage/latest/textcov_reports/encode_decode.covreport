_RNvMs3_NtCsixsdkNzQ5tW_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|  1.35k|  fn calc_flat_quantizer(
 1061|  1.35k|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|  1.35k|  ) -> (i64, i64) {
 1063|  1.35k|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|  1.35k|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|  1.35k|    //  parameterize a "quality" configuration parameter).
 1066|  1.35k|
 1067|  1.35k|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|  1.35k|    //  tables have unique entries, while the DC tables do not.
 1069|  1.35k|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|  1.35k|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|  1.35k|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|  1.35k|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|  1.35k|    // Get the log quantizers as Q57.
 1074|  1.35k|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|  1.35k|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|  1.35k|    // Target the midpoint of the chosen entries.
 1077|  1.35k|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|  1.35k|    // Adjust the quantizer for the frame type, result is Q57:
 1079|  1.35k|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|  1.35k|      + DQP_Q57[fti];
 1081|  1.35k|    (log_base_q, log_q)
 1082|  1.35k|  }
