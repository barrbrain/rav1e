  947|  3.40M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  3.40M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  3.40M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|  3.40M|  seh: T, sf: (T, T), output: &mut [T],
  951|  3.40M|) {
  952|  3.40M|  // +/- Butterflies with asymmetric input.
  953|  3.40M|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|  3.40M|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|  3.40M|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|  3.40M|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|  3.40M|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|  3.40M|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|  3.40M|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|  3.40M|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|  3.40M|
  962|  3.40M|  // Embedded 8-point orthonormal transforms.
  963|  3.40M|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|  3.40M|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
  965|  3.40M|  output[8..16].reverse();
  966|  3.40M|}
_RINvNvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|  6.08M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  6.08M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  6.08M|    ) {
 1598|  6.08M|      let j = i * 2;
 1599|  6.08M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  6.08M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  6.08M|      half[i] = ah;
 1602|  6.08M|      half[31 - i] = dh;
 1603|  6.08M|      asym[i] = b;
 1604|  6.08M|      asym[31 - i] = c;
 1605|  6.08M|    }
_RNvYNtNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward14RotateAddShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  43.6M|  $($s)* fn half_kernel(
  219|  43.6M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  43.6M|  ) -> (T, T) {
  221|  43.6M|    let t = Self::ADD(p1, p0.0);
  222|  43.6M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  43.6M|    let out0 = b.add(c);
  224|  43.6M|    let shifted = Self::SHIFT(c);
  225|  43.6M|    let out1 = Self::SUB(a, shifted);
  226|  43.6M|    (out0, out1)
  227|  43.6M|  }
_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward13butterfly_negNtB2_5I32X8EBa_:
  321|   121M|$($s)* fn butterfly_neg<T: TxOperations>(p0: T, p1: T) -> (T, (T, T)) {
  322|   121M|  let p1 = p0.sub(p1);
  323|   121M|  let p1h = p1.rshift1();
  324|   121M|  let p0h = p0.sub(p1h);
  325|   121M|  (p0h, (p1h, p1))
  326|   121M|}
_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward18butterfly_sub_asymNtB2_5I32X8EBa_:
  338|   144M|$($s)* fn butterfly_sub_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  339|   144M|  let p1 = p1h.sub(p0.0);
  340|   144M|  let p0 = p0.1.add(p1);
  341|   144M|  (p0, p1)
  342|   144M|}
