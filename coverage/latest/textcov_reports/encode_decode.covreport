  211|  68.5k|fn filter_narrow4_4(
  212|  68.5k|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  213|  68.5k|) -> [i32; 4] {
  214|  68.5k|  let filter1 =
  215|  68.5k|    clamp(3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  216|       |  // be certain our optimization removing a clamp is sound
  217|       |  debug_assert!({
  218|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  219|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  220|      0|    filter1 == test
  221|       |  });
  222|  68.5k|  let filter2 =
  223|  68.5k|    clamp(3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  224|       |  // be certain our optimization removing a clamp is sound
  225|       |  debug_assert!({
  226|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  227|      0|    let test = clamp(base + 3, -128 << shift, (128 << shift) - 1) >> 3;
  228|      0|    filter2 == test
  229|       |  });
  230|  68.5k|  let filter3 = (filter1 + 1) >> 1;
  231|  68.5k|  [
  232|  68.5k|    clamp(p1 + filter3, 0, (256 << shift) - 1),
  233|  68.5k|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  234|  68.5k|    clamp(q0 - filter1, 0, (256 << shift) - 1),
  235|  68.5k|    clamp(q1 - filter3, 0, (256 << shift) - 1),
  236|  68.5k|  ]
  237|  68.5k|}
