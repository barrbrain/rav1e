   33|  1.07M|  pub fn get_sad<T: Pixel>(
   34|  1.07M|    plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>, w: usize,
   35|  1.07M|    h: usize, _bit_depth: usize, _cpu: CpuFeatureLevel,
   36|  1.07M|  ) -> u32 {
   37|  1.07M|    assert!(w <= 128 && h <= 128);
   38|  1.07M|    assert!(plane_org.rect().width >= w && plane_org.rect().height >= h);
   39|  1.07M|    assert!(plane_ref.rect().width >= w && plane_ref.rect().height >= h);
   40|       |
   41|  1.07M|    let mut sum: u32 = 0;
   42|       |
   43|  12.0M|    for (slice_org, slice_ref) in
   44|  1.07M|      plane_org.rows_iter().take(h).zip(plane_ref.rows_iter())
   45|  12.0M|    {
   46|  12.0M|      sum += slice_org
   47|  12.0M|        .iter()
   48|  12.0M|        .take(w)
   49|  12.0M|        .zip(slice_ref)
   50|  12.0M|        .map(|(&a, &b)| (i32::cast_from(a) - i32::cast_from(b)).unsigned_abs())
   51|  12.0M|        .sum::<u32>();
   52|  12.0M|    }
   53|       |
   54|  1.07M|    sum
   55|  1.07M|  }
