 1304|   101k|fn subpel_diamond_search<T: Pixel>(
 1305|   101k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|   101k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|   101k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|   101k|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|   101k|  ref_frame: RefType,
 1310|   101k|) {
 1311|   101k|  use crate::util::Aligned;
 1312|   101k|
 1313|   101k|  // Motion compensation assembly has special requirements for edges
 1314|   101k|  let mc_w = w.next_power_of_two();
 1315|   101k|  let mc_h = (h + 1) & !1;
 1316|   101k|
 1317|   101k|  // Metadata for subpel scratch pad.
 1318|   101k|  let cfg = PlaneConfig::new(mc_w, mc_h, 0, 0, 0, 0, std::mem::size_of::<T>());
 1319|   101k|  // Stack allocation for subpel scratch pad.
 1320|   101k|  // SAFETY: We write to the array below before reading from it.
 1321|   101k|  let mut buf: Aligned<[T; 128 * 128]> = unsafe { Aligned::uninitialized() };
 1322|   101k|  let mut tmp_region = PlaneRegionMut::from_slice(
 1323|   101k|    &mut buf.data,
 1324|   101k|    &cfg,
 1325|   101k|    Rect { x: 0, y: 0, width: cfg.width, height: cfg.height },
 1326|   101k|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|   101k|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|   101k|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|   412k|  loop {
 1333|   412k|    // Find the best candidate from the diamond pattern.
 1334|   412k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  2.06M|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  1.64M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  1.64M|
 1338|  1.64M|      let rd = get_subpel_mv_rd(
 1339|  1.64M|        fi,
 1340|  1.64M|        po,
 1341|  1.64M|        org_region,
 1342|  1.64M|        bit_depth,
 1343|  1.64M|        pmv,
 1344|  1.64M|        lambda,
 1345|  1.64M|        use_satd,
 1346|  1.64M|        mvx_min,
 1347|  1.64M|        mvx_max,
 1348|  1.64M|        mvy_min,
 1349|  1.64M|        mvy_max,
 1350|  1.64M|        w,
 1351|  1.64M|        h,
 1352|  1.64M|        cand_mv,
 1353|  1.64M|        &mut tmp_region,
 1354|  1.64M|        ref_frame,
 1355|  1.64M|      );
 1356|  1.64M|
 1357|  1.64M|      if rd.cost < best_cand.rd.cost {
 1358|   831k|        best_cand.mv = cand_mv;
 1359|   831k|        best_cand.rd = rd;
 1360|   831k|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|   412k|    if current.rd.cost <= best_cand.rd.cost {
 1365|   202k|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|   101k|        break;
 1367|   101k|      } else {
 1368|   101k|        diamond_radius_log2 -= 1;
 1369|   101k|      }
 1370|   209k|    } else {
 1371|   209k|      *current = best_cand;
 1372|   209k|    }
 1373|       |  }
 1374|       |
 1375|   101k|  assert!(!current.is_empty());
 1376|   101k|}
