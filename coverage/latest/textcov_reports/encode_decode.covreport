  283|  15.2k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  15.2k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  15.2k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
  286|  15.2k|) {
  287|  15.2k|  let pix_offset = tile_bo.to_luma_plane_offset();
  288|  15.2k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  289|  15.2k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  290|  15.2k|
