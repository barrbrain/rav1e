 1050|     12|fn hexagon_search<T: Pixel>(
 1051|     12|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|     12|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|     12|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|     12|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|     12|) {
 1056|     12|  // The first iteration of hexagon search is implemented separate from
 1057|     12|  // subsequent iterations, which overlap with previous iterations.
 1058|     12|
 1059|     12|  // Holds what candidate is used (if any). This is used to determine which
 1060|     12|  // candidates have already been tested in a previous iteration and can be
 1061|     12|  // skipped.
 1062|     12|  let mut best_cand_idx: usize = 0;
 1063|     12|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|     84|  for i in 0..6 {
 1067|     72|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|     72|    let rd = get_fullpel_mv_rd(
 1069|     72|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|     72|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|     72|    );
 1072|     72|
 1073|     72|    if rd.cost < best_cand.rd.cost {
 1074|     18|      best_cand_idx = i;
 1075|     18|      best_cand.mv = cand_mv;
 1076|     18|      best_cand.rd = rd;
 1077|     54|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|     18|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|      6|    *current = best_cand;
 1085|      6|    best_cand = MotionSearchResult::empty();
 1086|      6|
 1087|      6|    // Save the index/direction taken in the previous iteration to the current
 1088|      6|    // search location.
 1089|      6|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|     24|    for idx_offset_mod6 in 5..=7 {
 1097|     18|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|     18|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|     18|
 1100|     18|      let rd = get_fullpel_mv_rd(
 1101|     18|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|     18|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|     18|      );
 1104|     18|
 1105|     18|      if rd.cost < best_cand.rd.cost {
 1106|      9|        best_cand_idx = i;
 1107|      9|        best_cand.mv = cand_mv;
 1108|      9|        best_cand.rd = rd;
 1109|      9|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|     12|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|    108|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|     96|    let cand_mv = current.mv + offset;
 1117|     96|    let rd = get_fullpel_mv_rd(
 1118|     96|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|     96|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|     96|    );
 1121|     96|
 1122|     96|    if rd.cost < best_cand.rd.cost {
 1123|     30|      best_cand.mv = cand_mv;
 1124|     30|      best_cand.rd = rd;
 1125|     66|    }
 1126|       |  }
 1127|     12|  if best_cand.rd.cost < current.rd.cost {
 1128|      0|    *current = best_cand;
 1129|     12|  }
 1130|       |
 1131|     12|  assert!(!current.is_empty());
 1132|     12|}
_RNvNtCsgzd1EjkjF4V_5rav1e2me11get_mv_rate:
 1504|  35.7k|fn get_mv_rate(
 1505|  35.7k|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  35.7k|) -> u32 {
 1507|  35.7k|  #[inline(always)]
 1508|  35.7k|  fn diff_to_rate(diff: i16, allow_high_precision_mv: bool) -> u32 {
 1509|  35.7k|    let d = if allow_high_precision_mv { diff } else { diff >> 1 };
 1510|  35.7k|    2 * ILog::ilog(d.abs()) as u32
 1511|  35.7k|  }
 1512|  35.7k|
 1513|  35.7k|  diff_to_rate(a.row - b.row, allow_high_precision_mv)
 1514|  35.7k|    + diff_to_rate(a.col - b.col, allow_high_precision_mv)
 1515|  35.7k|}
