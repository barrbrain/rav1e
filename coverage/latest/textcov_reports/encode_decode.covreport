   49|    465|  fn decode_packet(
   50|    465|    &mut self, packet: &[u8], rec_fifo: &mut VecDeque<Frame<T>>, w: usize,
   51|    465|    h: usize, chroma_sampling: ChromaSampling, bit_depth: usize, verify: bool,
   52|    465|  ) -> DecodeResult {
   53|    465|    let mut corrupted_count = 0;
   54|    465|    let mut data = SafeDav1dData::new(packet);
   55|    465|    let ret = data.send(self.dec);
   56|    465|    debug!("Decoded. -> {}", ret);
   57|    465|    if ret != 0 {
   58|      0|      corrupted_count += 1;
   59|    465|    }
   60|       |
   61|    465|    if ret == 0 {
   62|    670|      loop {
   63|    670|        let mut pic = SafeDav1dPicture::default();
   64|    670|        debug!("Retrieving frame");
   65|    670|        let ret = pic.get(self.dec);
   66|    670|        debug!("Retrieved.");
   67|    670|        if ret == -(EAGAIN as i32) {
   68|    465|          return DecodeResult::Done;
   69|    205|        }
   70|    205|        if ret != 0 {
   71|      0|          panic!("Decode fail");
   72|    205|        }
   73|    205|
   74|    205|        if verify {
   75|    205|          let rec = rec_fifo.pop_front().unwrap();
   76|    205|          compare_pic(&pic.0, &rec, bit_depth, w, h, chroma_sampling);
   77|    205|        }
   78|       |      }
   79|      0|    }
   80|      0|    if corrupted_count > 0 {
   81|      0|      DecodeResult::Corrupted(corrupted_count)
   82|       |    } else {
   83|      0|      DecodeResult::NotDone
