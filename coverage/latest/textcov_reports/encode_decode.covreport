  330|   470M|$($s)* fn butterfly_add_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  331|   470M|  let p1 = p1h.add(p0.0);
  332|   470M|  let p0 = p0.1.sub(p1);
  333|   470M|  (p0, p1)
  334|   470M|}
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward15daala_fdst_iv_2NtB2_5I32X8EBa_:
  433|  68.2M|$($s)* fn daala_fdst_iv_2<T: TxOperations>(p0: T, p1: T) -> (T, T) {
  434|  68.2M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8]  = 1.3065629648763766
  435|  68.2M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8]  = 0.5411961001461971
  436|  68.2M|  //  3135/4096 = 2*Cos[3*Pi/8]              = 0.7653668647301796
  437|  68.2M|  RotateAddAvg::kernel(p0, p1, ((10703, 13), (8867, 14), (3135, 12)))
  438|  68.2M|}
