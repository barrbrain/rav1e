 1379|  7.85M|fn get_fullpel_mv_rd<T: Pixel>(
 1380|  7.85M|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1381|  7.85M|  p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1382|  7.85M|  use_satd: bool, mvx_min: isize, mvx_max: isize, mvy_min: isize,
