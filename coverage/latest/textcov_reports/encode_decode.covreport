 1646|    430|      match fi.sequence.bit_depth {
 1647|       |        8 => {
 1648|    430|          if fi.frame_type == FrameType::KEY {
 1649|    202|            (q * 17563 - 421_574 + (1 << 18 >> 1)) >> 18
 1650|       |          } else {
 1651|    228|            (q * 6017 + 650_707 + (1 << 18 >> 1)) >> 18
 1652|       |          }
 1653|       |        }
 1654|       |        10 => {
 1655|      0|          if fi.frame_type == FrameType::KEY {
 1656|      0|            ((q * 20723 + 4_060_632 + (1 << 20 >> 1)) >> 20) - 4
 1657|       |          } else {
