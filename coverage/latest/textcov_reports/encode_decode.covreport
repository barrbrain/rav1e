_RNvMs1_NtCs19TYAUSqLvI_5rav1e9partitionNtB5_9BlockSize25from_width_and_height_optB7_:
  195|   123M|  pub fn from_width_and_height_opt(
  196|   123M|    w: usize, h: usize,
  197|   123M|  ) -> Result<BlockSize, InvalidBlockSize> {
  198|   123M|    static BLOCK_LUT: [[Result<BlockSize, InvalidBlockSize>; 6]; 6] = [
  199|   123M|      [
  200|   123M|        Ok(BLOCK_4X4),
  201|   123M|        Ok(BLOCK_4X8),
  202|   123M|        Ok(BLOCK_4X16),
  203|   123M|        Err(InvalidBlockSize), // X32
  204|   123M|        Err(InvalidBlockSize), // X64
  205|   123M|        Err(InvalidBlockSize), // X128
  206|   123M|      ],
  207|   123M|      [
  208|   123M|        Ok(BLOCK_8X4),
  209|   123M|        Ok(BLOCK_8X8),
  210|   123M|        Ok(BLOCK_8X16),
  211|   123M|        Ok(BLOCK_8X32),
  212|   123M|        Err(InvalidBlockSize), // X64
  213|   123M|        Err(InvalidBlockSize), // X128
  214|   123M|      ],
  215|   123M|      [
  216|   123M|        Ok(BLOCK_16X4),
  217|   123M|        Ok(BLOCK_16X8),
  218|   123M|        Ok(BLOCK_16X16),
  219|   123M|        Ok(BLOCK_16X32),
  220|   123M|        Ok(BLOCK_16X64),
  221|   123M|        Err(InvalidBlockSize), // X128
  222|   123M|      ],
  223|   123M|      [
  224|   123M|        Err(InvalidBlockSize), // X4
  225|   123M|        Ok(BLOCK_32X8),
  226|   123M|        Ok(BLOCK_32X16),
  227|   123M|        Ok(BLOCK_32X32),
  228|   123M|        Ok(BLOCK_32X64),
  229|   123M|        Err(InvalidBlockSize), // X128
  230|   123M|      ],
  231|   123M|      [
  232|   123M|        Err(InvalidBlockSize), // X4
  233|   123M|        Err(InvalidBlockSize), // X8
  234|   123M|        Ok(BLOCK_64X16),
  235|   123M|        Ok(BLOCK_64X32),
  236|   123M|        Ok(BLOCK_64X64),
  237|   123M|        Ok(BLOCK_64X128),
  238|   123M|      ],
  239|   123M|      [
  240|   123M|        Err(InvalidBlockSize), // X4
  241|   123M|        Err(InvalidBlockSize), // X8
  242|   123M|        Err(InvalidBlockSize), // X16
  243|   123M|        Err(InvalidBlockSize), // X32
  244|   123M|        Ok(BLOCK_128X64),
  245|   123M|        Ok(BLOCK_128X128),
  246|   123M|      ],
  247|   123M|    ];
  248|   123M|
  249|   123M|    if (4..=128).contains(&w) && (4..=128).contains(&h) {
  250|       |      // Check if w and h are both powers of 2; writing
  251|       |      // it this way allows us to reuse the tzcnt result later on.
  252|       |      //
  253|       |      // SAFETY: w/h are always nonzero due to previous range checks.
  254|   121M|      let w_tz = unsafe { NonZeroUsize::new_unchecked(w).trailing_zeros() };
  255|   121M|      if 1 << w_tz != w {
  256|  1.75M|        return Err(InvalidBlockSize);
  257|   119M|      }
  258|   119M|      let h_tz = unsafe { NonZeroUsize::new_unchecked(h).trailing_zeros() };
  259|   119M|      if 1 << h_tz != h {
  260|  1.33M|        return Err(InvalidBlockSize);
  261|   118M|      }
  262|   118M|
  263|   118M|      let x = w_tz as usize - 2;
  264|   118M|      let y = h_tz as usize - 2;
  265|   118M|
  266|   118M|      // SAFETY: Because all the statements in the if condition are true,
  267|   118M|      // indexing BLOCK_LUT with x and y will never be out-of-bounds.
  268|   118M|      return unsafe { *BLOCK_LUT.get_unchecked(x).get_unchecked(y) };
  269|  2.28M|    }
  270|  2.28M|
  271|  2.28M|    Err(InvalidBlockSize)
  272|   123M|  }
