  218|  89.3M|  $($s)* fn half_kernel(
  219|  89.3M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  89.3M|  ) -> (T, T) {
  221|  89.3M|    let t = Self::ADD(p1, p0.0);
  222|  89.3M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  89.3M|    let out0 = b.add(c);
  224|  89.3M|    let shifted = Self::SHIFT(c);
  225|  89.3M|    let out1 = Self::SUB(a, shifted);
  226|  89.3M|    (out0, out1)
  227|  89.3M|  }
