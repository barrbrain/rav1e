  947|   123k|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|   123k|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|   123k|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|   123k|  seh: T, sf: (T, T), output: &mut [T],
  951|   123k|) {
  952|   123k|  // +/- Butterflies with asymmetric input.
  953|   123k|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|   123k|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|   123k|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|   123k|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|   123k|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|   123k|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|   123k|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|   123k|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|   123k|
  962|   123k|  // Embedded 8-point orthonormal transforms.
  963|   123k|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|   123k|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
  965|   123k|  output[8..16].reverse();
  966|   123k|}
_RINvNvNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|   260k|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|   260k|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|   260k|    ) {
 1598|   260k|      let j = i * 2;
 1599|   260k|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|   260k|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|   260k|      half[i] = ah;
 1602|   260k|      half[31 - i] = dh;
 1603|   260k|      asym[i] = b;
 1604|   260k|      asym[31 - i] = c;
 1605|   260k|    }
