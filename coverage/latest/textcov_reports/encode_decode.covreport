   56|    313|  pub fn from_target_tiles(
   57|    313|    sb_size_log2: usize, frame_width: usize, frame_height: usize,
   58|    313|    frame_rate: f64, tile_cols_log2: usize, tile_rows_log2: usize,
   59|    313|    is_422_p: bool,
   60|    313|  ) -> Self {
   61|    313|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    313|
   63|    313|    // Frame::new() aligns to the next multiple of 8
   64|    313|    let frame_width = frame_width.align_power_of_two(3);
   65|    313|    let frame_height = frame_height.align_power_of_two(3);
   66|    313|    let frame_width_sb =
   67|    313|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    313|    let frame_height_sb =
   69|    313|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    313|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    313|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    313|
   73|    313|    // these are bitstream-defined values and must not be changed
   74|    313|    let max_tile_width_sb = MAX_TILE_WIDTH >> sb_size_log2;
   75|    313|    let max_tile_area_sb = MAX_TILE_AREA >> (2 * sb_size_log2);
   76|    313|    let min_tile_cols_log2 =
   77|    313|      Self::tile_log2(max_tile_width_sb, sb_cols).unwrap();
   78|    313|    let max_tile_cols_log2 =
   79|    313|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    313|    let max_tile_rows_log2 =
   81|    313|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    313|    let min_tiles_log2 = min_tile_cols_log2
   83|    313|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    313|
   85|    313|    // Implements restriction in Annex A of the spec.
   86|    313|    // Unlike the other restrictions, this one does not change
   87|    313|    // the header coding of the tile rows/cols.
   88|    313|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    313|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    313|        .ceil()
   91|    313|        .log2()
   92|    313|        .ceil() as usize,
   93|    313|    );
   94|    313|
   95|    313|    let tile_cols_log2 =
   96|    313|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    313|    let tile_width_sb_pre =
   98|    313|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
  100|       |    // If this is 4:2:2, our UV horizontal is subsampled but not our
  101|       |    // vertical.  Loop Restoration Units must be square, so they
  102|       |    // will always have an even number of horizontal superblocks. For
  103|       |    // tiles and LRUs to align, tile_width_sb must be even in 4:2:2
  104|       |    // video.
  105|       |
  106|       |    // This is only relevant when doing loop restoration RDO inline
  107|       |    // with block/superblock encoding, that is, where tiles are
  108|       |    // relevant.  If (when) we introduce optionally delaying loop-filter
  109|       |    // encode to after the partitioning loop, we won't need to make
  110|       |    // any 4:2:2 adjustment.
  111|       |
  112|    313|    let tile_width_sb = if is_422_p {
  113|     48|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    265|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    313|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    313|
  120|    313|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    313|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    313|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    313|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    313|      0
  128|       |    };
  129|    313|    let min_tile_rows_ratelimit_log2 =
  130|    313|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    313|        0
  134|       |      };
  135|    313|    let tile_rows_log2 = tile_rows_log2
  136|    313|      .max(min_tile_rows_log2)
  137|    313|      .max(min_tile_rows_ratelimit_log2)
  138|    313|      .min(max_tile_rows_log2);
  139|    313|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    313|
  141|    313|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    313|
  143|    313|    Self {
  144|    313|      frame_width,
  145|    313|      frame_height,
  146|    313|      tile_width_sb,
  147|    313|      tile_height_sb,
  148|    313|      cols,
  149|    313|      rows,
  150|    313|      tile_cols_log2,
  151|    313|      tile_rows_log2,
  152|    313|      min_tile_cols_log2,
  153|    313|      max_tile_cols_log2,
  154|    313|      min_tile_rows_log2,
  155|    313|      max_tile_rows_log2,
  156|    313|      sb_size_log2,
  157|    313|      min_tiles_log2,
  158|    313|    }
  159|    313|  }

