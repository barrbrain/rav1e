  421|  21.7k|      deblocked: deblocked.plane,
  422|  21.7k|      cdeffed: cdeffed.plane,
  423|  21.7k|      x: deblocked.x,
  424|  21.7k|      y,
  425|  21.7k|      end: (rows_above + stripe_h + rows_below) as isize + y,
