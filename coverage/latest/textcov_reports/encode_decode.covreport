  882|    432|pub fn has_tr(bo: TileBlockOffset, bsize: BlockSize) -> bool {
  883|    432|  let sb_mi_size = BLOCK_64X64.width_mi(); /* Assume 64x64 for now */
  884|    432|  let mask_row = bo.0.y & LOCAL_BLOCK_MASK;
  885|    432|  let mask_col = bo.0.x & LOCAL_BLOCK_MASK;
  886|    432|  let target_n4_w = bsize.width_mi();
  887|    432|  let target_n4_h = bsize.height_mi();
  888|    432|
  889|    432|  let mut bs = target_n4_w.max(target_n4_h);
  890|    432|
  891|    432|  if bs > BLOCK_64X64.width_mi() {
  892|      0|    return false;
  893|    432|  }
  894|       |
  895|    432|  let mut has_tr = !((mask_row & bs) != 0 && (mask_col & bs) != 0);
  896|       |
  897|       |  /* TODO: assert its a power of two */
  898|       |
  899|    534|  while bs < sb_mi_size {
  900|    372|    if (mask_col & bs) != 0 {
  901|    114|      if (mask_col & (2 * bs) != 0) && (mask_row & (2 * bs) != 0) {
  902|     12|        has_tr = false;
  903|     12|        break;
  904|    102|      }
  905|       |    } else {
  906|    258|      break;
  907|       |    }
  908|    102|    bs <<= 1;
  909|       |  }
  910|       |
  911|       |  /* The left hand of two vertical rectangles always has a top right (as the
  912|       |   * block above will have been decoded) */
  913|    432|  if (target_n4_w < target_n4_h) && (bo.0.x & target_n4_w) == 0 {
  914|     78|    has_tr = true;
  915|    354|  }
  916|       |
  917|       |  /* The bottom of two horizontal rectangles never has a top right (as the block
  918|       |   * to the right won't have been decoded) */
  919|    432|  if (target_n4_w > target_n4_h) && (bo.0.y & target_n4_h) != 0 {
  920|     24|    has_tr = false;
