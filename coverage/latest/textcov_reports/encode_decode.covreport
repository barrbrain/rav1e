   29|  3.38G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  3.38G|  let nsymbs = 4;
   31|  3.38G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  3.38G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  3.38G|
   34|  3.38G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  3.38G|  // implementation:
   36|  3.38G|  //
   37|  3.38G|  // ```
   38|  3.38G|  // if i as u32 >= val {
   39|  3.38G|  //   *v -= *v >> rate;
   40|  3.38G|  // } else {
   41|  3.38G|  //   *v += (32768 - *v) >> rate;
   42|  3.38G|  // }
   43|  3.38G|  // ```
   44|  3.38G|  //
   45|  3.38G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  3.38G|  // transform in something like:
   47|  3.38G|  //
   48|  3.38G|  // ```
   49|  3.38G|  // if i as u32 >= val {
   50|  3.38G|  //   *v -= *v >> rate;
   51|  3.38G|  // } else {
   52|  3.38G|  //   *v -= -((32768 - *v) >> rate);
   53|  3.38G|  // }
   54|  3.38G|  // ```
   55|  3.38G|  //
   56|  3.38G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  3.38G|  // using the following rule:
   58|  3.38G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  3.38G|  // So we obtain
   60|  3.38G|  //
   61|  3.38G|  // ```
   62|  3.38G|  // if i as u32 >= val {
   63|  3.38G|  //   *v -= *v >> rate;
   64|  3.38G|  // } else {
   65|  3.38G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  3.38G|  // }
   67|  3.38G|  // ```
   68|  3.38G|  //
   69|  3.38G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  3.38G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  3.38G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  3.38G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  3.38G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  3.38G|  //
   75|  3.38G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  3.38G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  3.38G|
   78|  3.38G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  3.38G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  3.38G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  3.38G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  3.38G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  3.38G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  3.38G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  3.38G|  let shifted =
   86|  3.38G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  3.38G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  3.38G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  3.38G|
   90|  3.38G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  3.38G|  cdf[nsymbs - 1] = count;
   92|  3.38G|}
