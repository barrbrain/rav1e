  152|    789|pub fn estimate_tile_motion<T: Pixel>(
  153|    789|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>,
  154|    789|  inter_cfg: &InterConfig,
  155|    789|) {
  156|    789|  let init_size = MIB_SIZE_LOG2;
  157|    789|
