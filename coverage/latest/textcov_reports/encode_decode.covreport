 1326|   221k|  );
 1327|       |
 1328|       |  // start at 1/2 pel and end at 1/4 or 1/8 pel
 1329|   221k|  let (mut diamond_radius_log2, diamond_radius_end_log2) =
 1330|   221k|    (2u8, if fi.allow_high_precision_mv { 0u8 } else { 1u8 });
 1331|       |
 1332|   910k|  loop {
 1333|   910k|    // Find the best candidate from the diamond pattern.
 1334|   910k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1335|  4.55M|    for &offset in &DIAMOND_R1_PATTERN_SUBPEL {
 1336|  3.64M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
 1337|  3.64M|
 1338|  3.64M|      let rd = get_subpel_mv_rd(
 1339|  3.64M|        fi,
 1340|  3.64M|        po,
 1341|  3.64M|        org_region,
 1342|  3.64M|        bit_depth,
 1343|  3.64M|        pmv,
 1344|  3.64M|        lambda,
 1345|  3.64M|        use_satd,
 1346|  3.64M|        mvx_min,
 1347|  3.64M|        mvx_max,
 1348|  3.64M|        mvy_min,
 1349|  3.64M|        mvy_max,
 1350|  3.64M|        w,
 1351|  3.64M|        h,
 1352|  3.64M|        cand_mv,
 1353|  3.64M|        &mut tmp_region,
 1354|  3.64M|        ref_frame,
 1355|  3.64M|      );
 1356|  3.64M|
 1357|  3.64M|      if rd.cost < best_cand.rd.cost {
 1358|  1.83M|        best_cand.mv = cand_mv;
 1359|  1.83M|        best_cand.rd = rd;
 1360|  1.83M|      }
 1361|       |    }
 1362|       |
 1363|       |    // Continue the search at this scale until a better candidate isn't found.
 1364|   910k|    if current.rd.cost <= best_cand.rd.cost {
 1365|   443k|      if diamond_radius_log2 == diamond_radius_end_log2 {
 1366|   221k|        break;
 1367|   221k|      } else {
 1368|   221k|        diamond_radius_log2 -= 1;
 1369|   221k|      }
 1370|   466k|    } else {
