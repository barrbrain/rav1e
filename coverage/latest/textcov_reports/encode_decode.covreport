  951|   321k|fn fullpel_diamond_search<T: Pixel>(
  952|   321k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   321k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   321k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   321k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   321k|) {
  957|   321k|  // Define the initial and the final scale (log2) of the diamond.
  958|   321k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|   923k|  loop {
  961|   923k|    // Find the best candidate from the diamond pattern.
  962|   923k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  4.61M|    for &offset in &DIAMOND_R1_PATTERN {
  964|  3.69M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  3.69M|      let rd = get_fullpel_mv_rd(
  966|  3.69M|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  3.69M|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  3.69M|      );
  969|  3.69M|
