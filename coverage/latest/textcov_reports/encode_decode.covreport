  246|    260|      pub fn restoration_unit_last_sb_for_rdo<T: Pixel>(
  247|    260|        &self,
  248|    260|        fi: &FrameInvariants<T>,
  249|    260|        global_sbo: PlaneSuperBlockOffset,
  250|    260|        tile_sbo: TileSuperBlockOffset,
  251|    260|      ) -> bool {
  252|    260|        // there is 1 restoration unit for (1 << sb_shift) super-blocks
  253|    260|        let h_mask = (1 << self.rp_cfg.sb_h_shift) - 1;
  254|    260|        let v_mask = (1 << self.rp_cfg.sb_v_shift) - 1;
  255|    260|        // is this a stretch block?
  256|    260|        let x_stretch = tile_sbo.0.x >> self.rp_cfg.sb_h_shift >= self.units.cols;
  257|    260|        let y_stretch = tile_sbo.0.y >> self.rp_cfg.sb_v_shift >= self.units.rows;
  258|    260|        // Need absolute superblock offsets for edge check, not local to the tile.
  259|    260|        let sbx = global_sbo.0.x + tile_sbo.0.x;
  260|    260|        let sby = global_sbo.0.y + tile_sbo.0.y;
  261|       |        // edge-of-tile check + edge-of-frame check
  262|    260|        let last_x = (tile_sbo.0.x & h_mask == h_mask && !x_stretch) || sbx == fi.sb_width-1;
  263|    260|        let last_y = (tile_sbo.0.y & v_mask == v_mask && !y_stretch) || sby == fi.sb_height-1;
  264|    260|        last_x && last_y
  265|    260|      }
