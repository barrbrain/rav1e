  573|  27.6k|    let (p2, p1, p0, q0, q1, q2, a) = if horizontal_p {
  574|       |      // six taps
  575|  10.4k|      (
  576|  10.4k|        rec[0][i].as_(),
  577|  10.4k|        rec[1][i].as_(),
  578|  10.4k|        rec[2][i].as_(),
  579|  10.4k|        rec[3][i].as_(),
  580|  10.4k|        rec[4][i].as_(),
  581|  10.4k|        rec[5][i].as_(),
