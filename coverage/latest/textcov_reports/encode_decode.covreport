_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward18butterfly_add_asymNtB2_5I32X8EBa_:
  330|   299M|$($s)* fn butterfly_add_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  331|   299M|  let p1 = p1h.add(p0.0);
  332|   299M|  let p0 = p0.1.sub(p1);
  333|   299M|  (p0, p1)
  334|   299M|}
