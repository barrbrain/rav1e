  773|  7.68k|pub(crate) const fn pos_to_lvl(pos: u64, pyramid_depth: u64) -> u64 {
  774|  7.68k|  // Derive level within pyramid for a frame with a given coding order position
  775|  7.68k|  // For example, with a pyramid of depth 2, the 2 least significant bits of the
  776|  7.68k|  // position determine the level:
  777|  7.68k|  // 00 -> 0
  778|  7.68k|  // 01 -> 2
  779|  7.68k|  // 10 -> 1
  780|  7.68k|  // 11 -> 2
