   76|    668|fn segmentation_optimize_inner<T: Pixel>(
   77|    668|  fi: &FrameInvariants<T>, fs: &mut FrameState<T>, offset_lower_limit: i16,
   78|    668|) {
   79|    668|  use crate::quantize::{ac_q, select_ac_qi};
   80|    668|  use crate::util::kmeans;
   81|    668|  use arrayvec::ArrayVec;
   82|    668|
   83|    668|  // Minimize the total distance from a small set of values to all scales.
   84|    668|  // Find k-means of log(spatiotemporal scale), k in 3..=8
   85|    668|  let c: ([_; 8], [_; 7], [_; 6], [_; 5], [_; 4], [_; 3]) = {
   86|    668|    let spatiotemporal_scores =
   87|    668|      &fi.coded_frame_data.as_ref().unwrap().spatiotemporal_scores;
   88|    668|    let mut log2_scale_q11 = Vec::with_capacity(spatiotemporal_scores.len());
   89|    668|    log2_scale_q11.extend(spatiotemporal_scores.iter().map(|&s| s.blog16()));
   90|    668|    log2_scale_q11.sort_unstable();
   91|    668|    let l = &log2_scale_q11;
   92|    668|    (kmeans(l), kmeans(l), kmeans(l), kmeans(l), kmeans(l), kmeans(l))
   93|    668|  };
   94|    668|
   95|    668|  // Find variance in spacing between successive log(scale)
   96|    668|  let var = |c: &[i16]| {
   97|       |    let delta = ArrayVec::<_, MAX_SEGMENTS>::from_iter(
   98|       |      c.iter().skip(1).zip(c).map(|(&a, &b)| b as i64 - a as i64),
   99|       |    );
  100|       |    let mean = delta.iter().sum::<i64>() / delta.len() as i64;
  101|       |    delta.iter().map(|&d| (d - mean).pow(2)).sum::<i64>() as u64
  102|       |  };
  103|    668|  let variance =
  104|    668|    [var(&c.0), var(&c.1), var(&c.2), var(&c.3), var(&c.4), var(&c.5)];
  105|    668|
  106|    668|  // Choose the k value with minimal variance in spacing
  107|    668|  let min_variance = *variance.iter().min().unwrap();
  108|    668|  let position = variance.iter().rposition(|&v| v == min_variance).unwrap();
  109|    668|
  110|    668|  // For the selected centroids, derive a target quantizer:
  111|    668|  //   scale Q'^2 = Q^2
  112|    668|  // See `distortion_scale_for` for more information.
  113|    668|  let compute_delta = |centroids: &[i16]| {
  114|       |    use crate::util::{bexp64, blog64};
  115|       |    let log2_base_ac_q_q57 =
  116|       |      blog64(ac_q(fi.base_q_idx, 0, fi.config.bit_depth).into());
  117|       |    centroids
  118|       |      .iter()
  119|       |      .rev()
  120|       |      // Rewrite in log form and exponentiate:
  121|       |      //   scale Q'^2 = Q^2
  122|       |      //           Q' = Q / sqrt(scale)
  123|       |      //      log(Q') = log(Q) - 0.5 log(scale)
  124|       |      .map(|&log2_scale_q11| {
  125|       |        bexp64(log2_base_ac_q_q57 - ((log2_scale_q11 as i64) << (57 - 11 - 1)))
  126|       |      })
  127|       |      // Find the index of the nearest quantizer to the target,
  128|       |      // and take the delta from the base quantizer index.
  129|       |      .map(|q| {
  130|       |        // Avoid going into lossless mode by never bringing qidx below 1.
  131|       |        select_ac_qi(q, fi.config.bit_depth).max(1) as i16
  132|       |          - fi.base_q_idx as i16
  133|       |      })
  134|       |      .collect::<ArrayVec<_, MAX_SEGMENTS>>()
  135|       |  };
  136|       |
  137|       |  // Compute segment deltas for best value of k
  138|    668|  let seg_delta = match position {
  139|      5|    0 => compute_delta(&c.0),
  140|      0|    1 => compute_delta(&c.1),
  141|     11|    2 => compute_delta(&c.2),
  142|     65|    3 => compute_delta(&c.3),
  143|     11|    4 => compute_delta(&c.4),
  144|    576|    _ => compute_delta(&c.5),
  145|       |  };
  146|       |
  147|       |  // Update the segmentation data
  148|    668|  fs.segmentation.max_segment = seg_delta.len() as u8 - 1;
  149|  2.20k|  for (&delta, (features, data)) in seg_delta
  150|    668|    .iter()
  151|    668|    .zip(fs.segmentation.features.iter_mut().zip(&mut fs.segmentation.data))
  152|  2.20k|  {
  153|  2.20k|    features[SegLvl::SEG_LVL_ALT_Q as usize] = true;
  154|  2.20k|    data[SegLvl::SEG_LVL_ALT_Q as usize] = delta.max(offset_lower_limit);
  155|  2.20k|  }
  156|       |
  157|    668|  fs.segmentation.update_threshold(fi.base_q_idx, fi.config.bit_depth);
  158|    668|}
