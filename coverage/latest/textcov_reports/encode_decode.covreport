  385|      0|        debug_assert!(units_x < rs_cols + 1);
  386|      0|        debug_assert!(units_y < rs_rows + 1);
  387|      0|        debug_assert!(units_x + units_cols <= rs_cols + 1);
  388|      0|        debug_assert!(units_y + units_rows <= rs_rows + 1);
  389|       |
  390|  43.3k|        let units_x = units_x.min(rs_cols);
