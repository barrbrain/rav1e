 1639|     60|pub fn deblock_filter_optimize<T: Pixel, U: Pixel>(
 1640|     60|  fi: &FrameInvariants<T>, rec: &Tile<U>, input: &Tile<U>,
 1641|     60|  blocks: &TileBlocks, crop_w: usize, crop_h: usize,
 1642|     60|) -> [u8; 4] {
 1643|     60|  if fi.config.speed_settings.fast_deblock {
 1644|     24|    let q = ac_q(fi.base_q_idx, 0, fi.sequence.bit_depth) as i32;
 1645|     24|    let level = clamp(
 1646|     24|      match fi.sequence.bit_depth {
 1647|       |        8 => {
 1648|     24|          if fi.frame_type == FrameType::KEY {
 1649|     14|            (q * 17563 - 421_574 + (1 << 18 >> 1)) >> 18
 1650|       |          } else {
 1651|     10|            (q * 6017 + 650_707 + (1 << 18 >> 1)) >> 18
 1652|       |          }
 1653|       |        }
 1654|       |        10 => {
 1655|      0|          if fi.frame_type == FrameType::KEY {
 1656|      0|            ((q * 20723 + 4_060_632 + (1 << 20 >> 1)) >> 20) - 4
 1657|       |          } else {
 1658|      0|            (q * 20723 + 4_060_632 + (1 << 20 >> 1)) >> 20
 1659|       |          }
 1660|       |        }
 1661|       |        12 => {
 1662|      0|          if fi.frame_type == FrameType::KEY {
 1663|      0|            ((q * 20723 + 16_242_526 + (1 << 22 >> 1)) >> 22) - 4
 1664|       |          } else {
 1665|      0|            (q * 20723 + 16_242_526 + (1 << 22 >> 1)) >> 22
 1666|       |          }
 1667|       |        }
 1668|      0|        _ => unreachable!(),
 1669|       |      },
 1670|       |      0,
 1671|     24|      MAX_LOOP_FILTER as i32,
 1672|     24|    ) as u8;
 1673|     24|    [level; 4]
 1674|       |  } else {
