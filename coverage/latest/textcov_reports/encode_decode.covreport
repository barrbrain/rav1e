  178|  4.13M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  4.13M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  4.13M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  4.13M|) -> Distortion {
  182|  4.13M|  // See get_weighted_sse in src/dist.rs.
  183|  4.13M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  4.13M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  4.13M|
  186|  4.13M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  4.13M|  // importance block size in a non-subsampled plane.
  188|  4.13M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  4.13M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  4.13M|
  191|  4.13M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  4.13M|
  193|  4.13M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  4.13M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  4.13M|
  196|  4.13M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  4.13M|  // passed directly. To do this, we would need different versions of the
  198|  4.13M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  4.13M|  // eliminating use of unbiased sse.
  200|  4.13M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  4.13M|
  202|  4.13M|  // Copy biases into a buffer.
  203|  4.13M|  let mut buf_storage = Aligned::new(
  204|  4.13M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  4.13M|  );
