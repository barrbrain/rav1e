  114|  53.0M|    let t = (1u64 << (m + nbits)) / d;
  115|  53.0M|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|  53.0M|    if r <= 1u64 << m {
  117|  39.9M|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|  13.0M|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
