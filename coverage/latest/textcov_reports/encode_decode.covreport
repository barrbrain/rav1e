   29|  6.70G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  6.70G|  let nsymbs = 4;
   31|  6.70G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  6.70G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  6.70G|
   34|  6.70G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  6.70G|  // implementation:
   36|  6.70G|  //
   37|  6.70G|  // ```
   38|  6.70G|  // if i as u32 >= val {
   39|  6.70G|  //   *v -= *v >> rate;
   40|  6.70G|  // } else {
   41|  6.70G|  //   *v += (32768 - *v) >> rate;
   42|  6.70G|  // }
   43|  6.70G|  // ```
   44|  6.70G|  //
   45|  6.70G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  6.70G|  // transform in something like:
   47|  6.70G|  //
   48|  6.70G|  // ```
   49|  6.70G|  // if i as u32 >= val {
   50|  6.70G|  //   *v -= *v >> rate;
   51|  6.70G|  // } else {
   52|  6.70G|  //   *v -= -((32768 - *v) >> rate);
   53|  6.70G|  // }
   54|  6.70G|  // ```
   55|  6.70G|  //
   56|  6.70G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  6.70G|  // using the following rule:
   58|  6.70G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  6.70G|  // So we obtain
   60|  6.70G|  //
   61|  6.70G|  // ```
   62|  6.70G|  // if i as u32 >= val {
   63|  6.70G|  //   *v -= *v >> rate;
   64|  6.70G|  // } else {
   65|  6.70G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  6.70G|  // }
   67|  6.70G|  // ```
   68|  6.70G|  //
   69|  6.70G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  6.70G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  6.70G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  6.70G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  6.70G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  6.70G|  //
   75|  6.70G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  6.70G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  6.70G|
   78|  6.70G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  6.70G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  6.70G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  6.70G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  6.70G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  6.70G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  6.70G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  6.70G|  let shifted =
   86|  6.70G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  6.70G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  6.70G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  6.70G|
   90|  6.70G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  6.70G|  cdf[nsymbs - 1] = count;
   92|  6.70G|}
