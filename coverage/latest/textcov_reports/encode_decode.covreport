  394|  12.5k|  fn new(
  395|  12.5k|    cdeffed: &PlaneSlice<'a, T>, deblocked: &PlaneSlice<'a, T>,
  396|  12.5k|    stripe_h: usize, crop: usize,
  397|  12.5k|  ) -> VertPaddedIter<'a, T> {
  398|  12.5k|    // cdeffed and deblocked must start at the same coordinates from their
  399|  12.5k|    // underlying planes. Since cropping is provided via a separate params, the
  400|  12.5k|    // height of the underlying planes do not need to match.
  401|  12.5k|    assert_eq!(cdeffed.x, deblocked.x);
  402|  12.5k|    assert_eq!(cdeffed.y, deblocked.y);
  403|       |
  404|       |    // To share integral images, always use the max box filter radius of 2
  405|  12.5k|    let r = 2;
  406|  12.5k|
  407|  12.5k|    // The number of rows outside the stripe are needed
  408|  12.5k|    let rows_above = r + 2;
  409|  12.5k|    let rows_below = 2;
  410|  12.5k|
  411|  12.5k|    // Offset crop and stripe_h so they are relative to the underlying plane
  412|  12.5k|    // and not the plane slice.
  413|  12.5k|    let crop = crop as isize + deblocked.y;
  414|  12.5k|    let stripe_end = stripe_h as isize + deblocked.y;
  415|  12.5k|
  416|  12.5k|    // Move y up the number rows above.
  417|  12.5k|    // If y is negative we repeat the first row
  418|  12.5k|    let y = deblocked.y - rows_above as isize;
  419|  12.5k|
  420|  12.5k|    VertPaddedIter {
  421|  12.5k|      deblocked: deblocked.plane,
  422|  12.5k|      cdeffed: cdeffed.plane,
  423|  12.5k|      x: deblocked.x,
  424|  12.5k|      y,
  425|  12.5k|      end: (rows_above + stripe_h + rows_below) as isize + y,
  426|  12.5k|      stripe_begin: deblocked.y,
  427|  12.5k|      stripe_end,
  428|  12.5k|      crop,
  429|  12.5k|    }
  430|  12.5k|  }
