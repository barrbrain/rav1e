  394|  13.0k|  fn new(
  395|  13.0k|    cdeffed: &PlaneSlice<'a, T>, deblocked: &PlaneSlice<'a, T>,
  396|  13.0k|    stripe_h: usize, crop: usize,
  397|  13.0k|  ) -> VertPaddedIter<'a, T> {
  398|  13.0k|    // cdeffed and deblocked must start at the same coordinates from their
  399|  13.0k|    // underlying planes. Since cropping is provided via a separate params, the
  400|  13.0k|    // height of the underlying planes do not need to match.
  401|  13.0k|    assert_eq!(cdeffed.x, deblocked.x);
  402|  13.0k|    assert_eq!(cdeffed.y, deblocked.y);
  403|       |
  404|       |    // To share integral images, always use the max box filter radius of 2
  405|  13.0k|    let r = 2;
  406|  13.0k|
  407|  13.0k|    // The number of rows outside the stripe are needed
  408|  13.0k|    let rows_above = r + 2;
  409|  13.0k|    let rows_below = 2;
  410|  13.0k|
  411|  13.0k|    // Offset crop and stripe_h so they are relative to the underlying plane
  412|  13.0k|    // and not the plane slice.
  413|  13.0k|    let crop = crop as isize + deblocked.y;
  414|  13.0k|    let stripe_end = stripe_h as isize + deblocked.y;
  415|  13.0k|
  416|  13.0k|    // Move y up the number rows above.
  417|  13.0k|    // If y is negative we repeat the first row
  418|  13.0k|    let y = deblocked.y - rows_above as isize;
  419|  13.0k|
  420|  13.0k|    VertPaddedIter {
  421|  13.0k|      deblocked: deblocked.plane,
  422|  13.0k|      cdeffed: cdeffed.plane,
  423|  13.0k|      x: deblocked.x,
  424|  13.0k|      y,
  425|  13.0k|      end: (rows_above + stripe_h + rows_below) as isize + y,
  426|  13.0k|      stripe_begin: deblocked.y,
  427|  13.0k|      stripe_end,
  428|  13.0k|      crop,
  429|  13.0k|    }
  430|  13.0k|  }
