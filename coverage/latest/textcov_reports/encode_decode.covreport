  717|  24.2M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  24.2M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  24.2M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  24.2M|) {
  721|  24.2M|  // +/- Butterflies with asymmetric output.
  722|  24.2M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  24.2M|  let (s1, seh) = butterfly_add(s1, se);
  724|  24.2M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  24.2M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  24.2M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  24.2M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  24.2M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  24.2M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  24.2M|
