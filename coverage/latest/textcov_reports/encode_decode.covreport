  261|  74.2M|      }
  262|  74.2M|
  263|  74.2M|      let x = w_tz as usize - 2;
  264|  74.2M|      let y = h_tz as usize - 2;
  265|  74.2M|
  266|  74.2M|      // SAFETY: Because all the statements in the if condition are true,
  267|  74.2M|      // indexing BLOCK_LUT with x and y will never be out-of-bounds.
  268|  74.2M|      return unsafe { *BLOCK_LUT.get_unchecked(x).get_unchecked(y) };
  269|  1.56M|    }
  270|  1.56M|
  271|  1.56M|    Err(InvalidBlockSize)
  272|  77.7M|  }
