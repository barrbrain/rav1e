_RNvMNtNtCs19TYAUSqLvI_5rav1e3api8internalNtB2_11InterConfig3new:
   63|    708|  pub(crate) fn new(enc_config: &EncoderConfig) -> InterConfig {
   64|    708|    let reorder = !enc_config.low_latency;
   65|       |    // A group always starts with (group_output_len - group_input_len) hidden
   66|       |    //  frames, followed by group_input_len shown frames.
   67|       |    // The shown frames iterate over the input frames in order, with frames
   68|       |    //  already encoded as hidden frames now displayed with Show Existing
   69|       |    //  Frame.
   70|       |    // For example, for a pyramid depth of 2, the group is as follows:
   71|       |    //                      |TU         |TU |TU |TU
   72|       |    // idx_in_group_output:   0   1   2   3   4   5
   73|       |    // input_frameno:         4   2   1  SEF  3  SEF
   74|       |    // output_frameno:        1   2   3   4   5   6
   75|       |    // level:                 0   1   2   1   2   0
   76|       |    //                        ^^^^^   ^^^^^^^^^^^^^
   77|       |    //                        hidden      shown
   78|       |    // TODO: This only works for pyramid_depth <= 2 --- after that we need
   79|       |    //  more hidden frames in the middle of the group.
   80|    708|    let pyramid_depth = if reorder { 2 } else { 0 };
   81|    708|    let group_input_len = 1 << pyramid_depth;
   82|    708|    let group_output_len = group_input_len + pyramid_depth;
   83|    708|    let switch_frame_interval = enc_config.switch_frame_interval;
   84|    708|    assert!(switch_frame_interval % group_input_len == 0);
   85|       |    InterConfig {
   86|    708|      reorder,
   87|    708|      multiref: reorder || enc_config.speed_settings.multiref,
   88|    708|      pyramid_depth,
   89|    708|      group_input_len,
   90|    708|      group_output_len,
   91|    708|      switch_frame_interval,
   92|    708|    }
   93|    708|  }
