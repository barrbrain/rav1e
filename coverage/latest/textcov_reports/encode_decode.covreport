  179|   791k|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|   791k|    let t = Self::ADD(p1, p0);
  181|   791k|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|   791k|    let out1 = Self::SUB(a, out0);
  183|   791k|    (out0, out1)
