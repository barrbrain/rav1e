   53|       |              mem::transmute(dst.data_origin().as_ptr()),
   54|       |              src.cfg.stride,
   55|       |              src.cfg.width,
   56|       |              src.cfg.height,
   57|       |            );
   58|       |
   59|       |            #[cfg(feature = "check_asm")]
   60|       |            assert_eq!(result, rust::sad_plane_internal($src, $dst, $cpu));
   61|       |
   62|       |            result
   63|       |          }
   64|       |        };
   65|       |      }
   66|       |
   67|      9|      if cpu >= CpuFeatureLevel::AVX2 {
   68|      9|        call_asm!(rav1e_sad_plane_8bpc_avx2, src, dst, cpu)
   69|      0|      } else if cpu >= CpuFeatureLevel::SSE2 {
   70|      0|        call_asm!(rav1e_sad_plane_8bpc_sse2, src, dst, cpu)
