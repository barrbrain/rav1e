 1050|  3.16k|fn hexagon_search<T: Pixel>(
 1051|  3.16k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  3.16k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  3.16k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  3.16k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  3.16k|) {
 1056|  3.16k|  // The first iteration of hexagon search is implemented separate from
 1057|  3.16k|  // subsequent iterations, which overlap with previous iterations.
 1058|  3.16k|
 1059|  3.16k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  3.16k|  // candidates have already been tested in a previous iteration and can be
 1061|  3.16k|  // skipped.
 1062|  3.16k|  let mut best_cand_idx: usize = 0;
 1063|  3.16k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  22.1k|  for i in 0..6 {
 1067|  18.9k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  18.9k|    let rd = get_fullpel_mv_rd(
 1069|  18.9k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  18.9k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  18.9k|    );
 1072|  18.9k|
 1073|  18.9k|    if rd.cost < best_cand.rd.cost {
 1074|  6.54k|      best_cand_idx = i;
 1075|  6.54k|      best_cand.mv = cand_mv;
 1076|  6.54k|      best_cand.rd = rd;
 1077|  12.4k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  4.09k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|    930|    *current = best_cand;
 1085|    930|    best_cand = MotionSearchResult::empty();
 1086|    930|
 1087|    930|    // Save the index/direction taken in the previous iteration to the current
 1088|    930|    // search location.
 1089|    930|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|  3.72k|    for idx_offset_mod6 in 5..=7 {
 1097|  2.79k|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|  2.79k|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|  2.79k|
 1100|  2.79k|      let rd = get_fullpel_mv_rd(
 1101|  2.79k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|  2.79k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|  2.79k|      );
 1104|  2.79k|
 1105|  2.79k|      if rd.cost < best_cand.rd.cost {
 1106|  1.65k|        best_cand_idx = i;
 1107|  1.65k|        best_cand.mv = cand_mv;
 1108|  1.65k|        best_cand.rd = rd;
 1109|  1.65k|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  3.16k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  28.4k|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|  25.3k|    let cand_mv = current.mv + offset;
 1117|  25.3k|    let rd = get_fullpel_mv_rd(
 1118|  25.3k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|  25.3k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  25.3k|    );
 1121|  25.3k|
 1122|  25.3k|    if rd.cost < best_cand.rd.cost {
 1123|  8.38k|      best_cand.mv = cand_mv;
 1124|  8.38k|      best_cand.rd = rd;
 1125|  16.9k|    }
 1126|       |  }
 1127|  3.16k|  if best_cand.rd.cost < current.rd.cost {
 1128|    383|    *current = best_cand;
 1129|  2.78k|  }
 1130|       |
 1131|  3.16k|  assert!(!current.is_empty());
 1132|  3.16k|}
