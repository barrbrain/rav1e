_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward15RotatePi4AddAvgINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|  78.1M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  78.1M|    let t = Self::ADD(p1, p0);
  181|  78.1M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  78.1M|    let out1 = Self::SUB(a, out0);
  183|  78.1M|    (out0, out1)
  184|  78.1M|  }
_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward14RotateSubShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   129M|  $($s)* fn half_kernel(
  219|   129M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   129M|  ) -> (T, T) {
  221|   129M|    let t = Self::ADD(p1, p0.0);
  222|   129M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   129M|    let out0 = b.add(c);
  224|   129M|    let shifted = Self::SHIFT(c);
  225|   129M|    let out1 = Self::SUB(a, shifted);
  226|   129M|    (out0, out1)
  227|   129M|  }
