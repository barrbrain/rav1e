  684|  39.8k|          (0, 0) => PredictionMode::DC_PRED,
  685|   151k|          (0, _) => PredictionMode::V_PRED,
  686|   183k|          (_, 0) => PredictionMode::H_PRED,
  687|  1.81M|          _ => PredictionMode::PAETH_PRED,
