  191|     51|          if new_subsampling {
  192|     34|            refine_subsampled_sb_motion(
  193|     34|              fi,
  194|     34|              ts,
  195|     34|              ref_frame,
  196|     34|              mv_size_in_b_log2 + 1,
  197|     34|              tile_bo,
  198|     34|              ssdec,
  199|     34|              lambda,
  200|     34|            );
  201|     34|          }
  202|       |
  203|     51|          estimate_sb_motion(
  204|     51|            fi,
  205|     51|            ts,
  206|     51|            ref_frame,
  207|     51|            mv_size_in_b_log2,
  208|     51|            tile_bo,
  209|     51|            init,
  210|     51|            ssdec,
  211|     51|            lambda,
  212|     51|          );
  213|       |        }
  214|       |      }
  215|       |    }
  216|       |  }
  217|      5|}
_RINvNtCsgzd1EjkjF4V_5rav1e2me18estimate_sb_motionhEB4_:
  219|     51|fn estimate_sb_motion<T: Pixel>(
  220|     51|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|     51|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|     51|  lambda: u32,
  223|     51|) {
  224|     51|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|     51|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|     51|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|     51|
  228|     51|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|     93|  for y in (0..sb_h).step_by(mv_size) {
  232|    238|    for x in (0..sb_w).step_by(mv_size) {
  233|    238|      let corner: MVSamplingMode = if init {
  234|     17|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|    221|        MVSamplingMode::CORNER {
  239|    221|          right: x as usize & mv_size == mv_size,
  240|    221|          bottom: y as usize & mv_size == mv_size,
  241|    221|        }
  242|       |      };
  243|       |
  244|    238|      let sub_bo = tile_bo
  245|    238|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|    238|
  247|    238|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|    238|      // The rounding makes some assumptions about how subsampling is done.
  249|    238|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|    238|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|    238|      if let Some(results) = estimate_motion(
  256|    238|        fi,
  257|    238|        ts,
  258|    238|        w,
  259|    238|        h,
  260|    238|        sub_bo,
  261|    238|        ref_frame,
  262|    238|        None,
  263|    238|        corner,
  264|    238|        init,
  265|    238|        ssdec,
  266|    238|        Some(lambda),
  267|    238|      ) {
  268|    207|        // normalize sad to 128x128 block
  269|    207|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|    207|          / (w * h) as u64) as u32;
  271|    207|        save_me_stats(
  272|    207|          ts,
  273|    207|          mv_size_in_b_log2,
  274|    207|          sub_bo,
  275|    207|          ref_frame,
  276|    207|          MEStats { mv: results.mv, normalized_sad: sad },
  277|    207|        );
  278|    207|      }
  279|       |    }
  280|       |  }
  281|     51|}
_RINvNtCsgzd1EjkjF4V_5rav1e2me11full_searchhEB4_:
 1456|     60|fn full_search<T: Pixel>(
 1457|     60|  fi: &FrameInvariants<T>, x_lo: isize, x_hi: isize, y_lo: isize, y_hi: isize,
 1458|     60|  w: usize, h: usize, org_region: &PlaneRegion<T>, p_ref: &Plane<T>,
 1459|     60|  po: PlaneOffset, step: usize, lambda: u32, pmv: [MotionVector; 2],
 1460|     60|) -> MotionSearchResult {
 1461|     60|  let search_region = p_ref.region(Area::Rect {
 1462|     60|    x: x_lo,
 1463|     60|    y: y_lo,
 1464|     60|    width: (x_hi - x_lo) as usize + w,
 1465|     60|    height: (y_hi - y_lo) as usize + h,
 1466|     60|  });
 1467|     60|
 1468|     60|  let mut best: MotionSearchResult = MotionSearchResult::empty();
 1469|       |
 1470|       |  // Select rectangular regions within search region with vert+horz windows
 1471|    240|  for vert_window in search_region.vert_windows(h).step_by(step) {
 1472|    960|    for ref_window in vert_window.horz_windows(w).step_by(step) {
 1473|    960|      let &Rect { x, y, .. } = ref_window.rect();
 1474|    960|
 1475|    960|      let mv = MotionVector {
 1476|    960|        row: 8 * (y as i16 - po.y as i16),
 1477|    960|        col: 8 * (x as i16 - po.x as i16),
 1478|    960|      };
 1479|    960|
 1480|    960|      let rd = compute_mv_rd(
 1481|    960|        fi,
 1482|    960|        pmv,
 1483|    960|        lambda,
 1484|    960|        false,
 1485|    960|        fi.sequence.bit_depth,
 1486|    960|        w,
 1487|    960|        h,
 1488|    960|        mv,
 1489|    960|        org_region,
 1490|    960|        &ref_window,
 1491|    960|      );
 1492|    960|
 1493|    960|      if rd.cost < best.rd.cost {
 1494|    189|        best.rd = rd;
 1495|    189|        best.mv = mv;
 1496|    771|      }
 1497|       |    }
 1498|       |  }
 1499|       |
 1500|     60|  best
 1501|     60|}
_RINvNtCsgzd1EjkjF4V_5rav1e2me22fullpel_diamond_searchhEB4_:
  951|    491|fn fullpel_diamond_search<T: Pixel>(
  952|    491|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|    491|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|    491|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|    491|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|    491|) {
  957|    491|  // Define the initial and the final scale (log2) of the diamond.
  958|    491|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|  1.61k|  loop {
  961|  1.61k|    // Find the best candidate from the diamond pattern.
  962|  1.61k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  8.05k|    for &offset in &DIAMOND_R1_PATTERN {
  964|  6.44k|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  6.44k|      let rd = get_fullpel_mv_rd(
  966|  6.44k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  6.44k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  6.44k|      );
  969|  6.44k|
  970|  6.44k|      if rd.cost < best_cand.rd.cost {
  971|  3.31k|        best_cand.mv = cand_mv;
  972|  3.31k|        best_cand.rd = rd;
  973|  3.31k|      }
  974|       |    }
  975|       |
  976|       |    // Continue the search at this scale until the can't find a better candidate
  977|       |    // to use.
  978|  1.61k|    if current.rd.cost <= best_cand.rd.cost {
  979|    982|      if diamond_radius_log2 == diamond_radius_end_log2 {
  980|    491|        break;
  981|    491|      } else {
  982|    491|        diamond_radius_log2 -= 1;
  983|    491|      }
  984|    629|    } else {
  985|    629|      *current = best_cand;
  986|    629|    }
  987|       |  }
  988|       |
  989|    491|  assert!(!current.is_empty());
  990|    491|}

