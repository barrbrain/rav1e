_RNvMs2_NtCsixsdkNzQ5tW_5rav1e4rateNtB5_19QuantizerParameters14new_from_log_q:
  525|  1.51k|  fn new_from_log_q(
  526|  1.51k|    log_base_q: i64, log_target_q: i64, bit_depth: usize,
  527|  1.51k|    chroma_sampling: ChromaSampling, is_intra: bool,
  528|  1.51k|    log_isqrt_mean_scale: i64,
  529|  1.51k|  ) -> QuantizerParameters {
  530|  1.51k|    let scale = log_isqrt_mean_scale + q57(QSCALE + bit_depth as i32 - 8);
  531|  1.51k|
  532|  1.51k|    let mut log_q_y = log_target_q;
  533|  1.51k|    if !is_intra && bit_depth == 8 {
  534|    519|      log_q_y = log_target_q
  535|    519|        + (log_target_q >> 32) * Q_MODEL_MUL[chroma_sampling as usize]
  536|    519|        + Q_MODEL_ADD[chroma_sampling as usize];
  537|    993|    }
  538|       |
  539|  1.51k|    let quantizer = bexp64(log_q_y + scale);
  540|  1.51k|    let (offset_u, offset_v) =
  541|  1.51k|      chroma_offset(log_q_y + log_isqrt_mean_scale, chroma_sampling);
  542|  1.51k|    let mono = chroma_sampling == ChromaSampling::Cs400;
  543|  1.51k|    let log_q_u = log_q_y + offset_u;
  544|  1.51k|    let log_q_v = log_q_y + offset_v;
  545|  1.51k|    let quantizer_u = bexp64(log_q_u + scale);
  546|  1.51k|    let quantizer_v = bexp64(log_q_v + scale);
  547|  1.51k|    let lambda = (::std::f64::consts::LN_2 / 6.0)
  548|  1.51k|      * (((log_target_q + log_isqrt_mean_scale) as f64)
  549|  1.51k|        * Q57_SQUARE_EXP_SCALE)
  550|  1.51k|        .exp();
  551|  1.51k|
  552|  1.51k|    let scale = |q| bexp64((log_target_q - q) * 2 + q57(16)) as f64 / 65536.;
  553|  1.51k|    let dist_scale = [scale(log_q_y), scale(log_q_u), scale(log_q_v)];
