  643|  5.32M|$($s)* fn daala_fdct_ii_8_asym<T: TxOperations>(
  644|  5.32M|  r0h: T, r1: (T, T), r2h: T, r3: (T, T), r4h: T, r5: (T, T), r6h: T,
  645|  5.32M|  r7: (T, T), output: &mut [T],
  646|  5.32M|) {
  647|  5.32M|  // +/- Butterflies with asymmetric input.
  648|  5.32M|  let (r0, r7) = butterfly_neg_asym(r0h, r7);
  649|  5.32M|  let (r1, r6) = butterfly_sub_asym(r1, r6h);
  650|  5.32M|  let (r2, r5) = butterfly_neg_asym(r2h, r5);
  651|  5.32M|  let (r3, r4) = butterfly_sub_asym(r3, r4h);
  652|  5.32M|
  653|  5.32M|  // Embedded 4-point orthonormal transforms.
  654|  5.32M|  daala_fdct_ii_4(r0, r1, r2, r3, &mut output[0..4]);
  655|  5.32M|  daala_fdst_iv_4(r7, r6, r5, r4, &mut output[4..8]);
  656|  5.32M|  output[4..8].reverse();
  657|  5.32M|}
_RNvYNtNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward9RotateAddINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  82.4M|  $($s)* fn half_kernel(
  219|  82.4M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  82.4M|  ) -> (T, T) {
  221|  82.4M|    let t = Self::ADD(p1, p0.0);
  222|  82.4M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  82.4M|    let out0 = b.add(c);
  224|  82.4M|    let shifted = Self::SHIFT(c);
  225|  82.4M|    let out1 = Self::SUB(a, shifted);
  226|  82.4M|    (out0, out1)
  227|  82.4M|  }
_RNvYNtNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward12RotatePi4SubINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|   380k|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|   380k|    let t = Self::ADD(p1, p0);
  181|   380k|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|   380k|    let out1 = Self::SUB(a, out0);
  183|   380k|    (out0, out1)
  184|   380k|  }
