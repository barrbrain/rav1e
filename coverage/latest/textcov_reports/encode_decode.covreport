  242|   535k|  pub fn quantize<T: Coefficient>(
  243|   535k|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|   535k|  ) -> usize {
  245|   535k|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|   535k|
  247|   535k|    qcoeffs[0] = {
  248|   535k|      let coeff: i32 =
  249|   535k|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|   535k|      let abs_coeff = coeff.unsigned_abs();
  251|   535k|      T::cast_from(copysign(
  252|   535k|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|   535k|        coeff,
  254|   535k|      ))
  255|   535k|    };
  256|   535k|
  257|   535k|    // Find the last non-zero coefficient using our smaller biases and
  258|   535k|    // zero everything else.
  259|   535k|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|   535k|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|   535k|    let deadzone = T::cast_from(
  262|   535k|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|   535k|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|   535k|    );
  265|   535k|    let eob = {
  266|   535k|      // We skip the DC coefficient since it has its own quantizer index.
  267|   535k|      let eob_minus_two =
  268|   535k|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|   535k|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|   535k|      })
  276|   535k|    };
  277|   535k|
  278|   535k|    // Here we use different rounding biases depending on whether we've
  279|   535k|    // had recent coefficients that are larger than one, or less than
  280|   535k|    // one. The reason for this is that a block usually has a chunk of
  281|   535k|    // large coefficients and a tail of zeroes and ones, and the tradeoffs
  282|   535k|    // for coding these two are different. In the tail of zeroes and ones,
  283|   535k|    // you'll likely end up spending most bits just saying where that
  284|   535k|    // coefficient is in the block, whereas in the chunk of larger
  285|   535k|    // coefficients, most bits will be spent on coding its magnitude.
  286|   535k|    // To that end, we want to bias more toward rounding to zero for
  287|   535k|    // that tail of zeroes and ones than we do for the larger coefficients.
  288|   535k|    let mut level_mode = 1;
  289|  39.3M|    for &pos in scan.iter().take(eob).skip(1) {
  290|  39.3M|      let coeff = i32::cast_from(coeffs[pos as usize]) << self.log_tx_scale;
  291|  39.3M|      let abs_coeff = coeff.unsigned_abs();
  292|  39.3M|
  293|  39.3M|      let level0 = divu_pair(abs_coeff, self.ac_mul_add);
  294|  39.3M|      let offset = if level0 > 1 - level_mode {
  295|  20.2M|        self.ac_offset1
  296|       |      } else {
  297|  19.1M|        self.ac_offset0
  298|       |      };
  299|       |
  300|  39.3M|      let abs_qcoeff: u32 = divu_pair(abs_coeff + offset, self.ac_mul_add);
  301|  39.3M|      if level_mode != 0 && abs_qcoeff == 0 {
  302|  1.69M|        level_mode = 0;
  303|  37.6M|      } else if abs_qcoeff > 1 {
  304|  19.6M|        level_mode = 1;
  305|  19.6M|      }
  306|       |
  307|  39.3M|      qcoeffs[pos as usize] = T::cast_from(copysign(abs_qcoeff, coeff));
  308|       |    }
  309|       |
  310|       |    // Rather than zeroing the tail in scan order, assume that qcoeffs is
  311|       |    // pre-filled with zeros.
  312|       |
  313|       |    // Check the eob is correct
  314|       |    debug_assert_eq!(
  315|       |      eob,
  316|      0|      scan
  317|      0|        .iter()
  318|      0|        .rposition(|&i| qcoeffs[i as usize] != T::cast_from(0))
  319|      0|        .map(|n| n + 1)
  320|      0|        .unwrap_or(0)
  321|       |    );
  322|       |
  323|   535k|    eob
  324|   535k|  }
