  346|   330M|$($s)* fn butterfly_neg_asym<T: TxOperations>(p0h: T, p1: (T, T)) -> (T, T) {
  347|   330M|  let p0 = p0h.add(p1.0);
  348|   330M|  let p1 = p0.sub(p1.1);
  349|   330M|  (p0, p1)
  350|   330M|}
