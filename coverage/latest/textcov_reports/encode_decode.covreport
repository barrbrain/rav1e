  144|   128M|  const fn get_flip_cfg(tx_type: TxType) -> (bool, bool) {
  145|   128M|    use self::TxType::*;
  146|   128M|    match tx_type {
  147|       |      DCT_DCT | ADST_DCT | DCT_ADST | ADST_ADST | IDTX | V_DCT | H_DCT
  148|   128M|      | V_ADST | H_ADST => (false, false),
  149|      0|      FLIPADST_DCT | FLIPADST_ADST | V_FLIPADST => (true, false),
  150|      0|      DCT_FLIPADST | ADST_FLIPADST | H_FLIPADST => (false, true),
  151|      0|      FLIPADST_FLIPADST => (true, true),
  152|       |    }
  153|   128M|  }
