  280|  1.37M|    (p3*2 + p2   + p1*2 + p0   + q0   + q1   + (1<<2)) >> 3,
  281|  1.37M|    (p3   + p2   + p1   + p0*2 + q0   + q1   + q2   +(1<<2)) >> 3,
  282|  1.37M|           (p2   + p1   + p0   + q0*2 + q1   + q2   + q3   + (1<<2)) >> 3,
