  550|  18.5M|    RotateAdd::kernel(r2, r5, ((22173, 14), (3363, 13), (15447, 15)));
  551|  18.5M|  // 23059/16384 = Sin[9*Pi/32] + Cos[9*Pi/32] = 1.4074037375263826
