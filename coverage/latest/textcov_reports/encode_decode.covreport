  717|  11.6M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  11.6M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  11.6M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  11.6M|) {
  721|  11.6M|  // +/- Butterflies with asymmetric output.
  722|  11.6M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  11.6M|  let (s1, seh) = butterfly_add(s1, se);
  724|  11.6M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  11.6M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  11.6M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  11.6M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  11.6M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  11.6M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  11.6M|
  731|  11.6M|  // Embedded 8-point transforms with asymmetric input.
  732|  11.6M|  daala_fdct_ii_8_asym(s0h, s1, s2h, s3, s4h, s5, s6h, s7, &mut output[0..8]);
  733|  11.6M|  daala_fdst_iv_8_asym(sf, seh, sd, sch, sb, sah, s9, s8h, &mut output[8..16]);
  734|  11.6M|  output[8..16].reverse();
  735|  11.6M|}
