  218|   175M|  $($s)* fn half_kernel(
  219|   175M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   175M|  ) -> (T, T) {
  221|   175M|    let t = Self::ADD(p1, p0.0);
  222|   175M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   175M|    let out0 = b.add(c);
  224|   175M|    let shifted = Self::SHIFT(c);
  225|   175M|    let out1 = Self::SUB(a, shifted);
  226|   175M|    (out0, out1)
  227|   175M|  }
