   28|    524|    let w_in_imp_b = width.align_power_of_two_and_shift(3);
   29|    524|    let h_in_imp_b = height.align_power_of_two_and_shift(3);
   30|    524|
   31|    524|    let aligned_luma = Rect {
   32|    524|      x: 0_isize,
   33|    524|      y: 0_isize,
   34|    524|      width: w_in_imp_b << 3,
   35|    524|      height: h_in_imp_b << 3,
   36|    524|    };
   37|    524|    let luma = PlaneRegion::new(luma_plane, aligned_luma);
   38|    524|
   39|    524|    let mut variances = Vec::with_capacity(w_in_imp_b * h_in_imp_b);
