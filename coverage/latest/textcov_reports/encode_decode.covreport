 1627|       |        0,
 1628|       |        bsize,
 1629|       |        po,
 1630|       |        uv_tx_size,
 1631|       |        fi.sequence.bit_depth,
 1632|       |        Some(PredictionMode::UV_CFL_PRED),
 1633|       |        fi.sequence.enable_intra_edge_filter,
 1634|       |        IntraParam::None,
 1635|       |      );
 1636|       |      let mut alpha_cost = |alpha: i16| -> u64 {
 1637|       |        let mut rec_region =
 1638|       |          rec.subregion_mut(Area::BlockStartingAt { bo: tile_bo.0 });
 1639|       |        PredictionMode::UV_CFL_PRED.predict_intra(
 1640|       |          tile_rect,
 1641|       |          &mut rec_region,
 1642|       |          uv_tx_size,
 1643|       |          fi.sequence.bit_depth,
 1644|       |          &ac.data,
 1645|       |          IntraParam::Alpha(alpha),
 1646|       |          None,
 1647|       |          &edge_buf,
 1648|       |          fi.cpu_feature_level,
 1649|       |        );
 1650|       |        sse_wxh(
 1651|       |          &input.subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
 1652|       |          &rec_region.as_const(),
 1653|       |          visible_tx_w,
 1654|       |          visible_tx_h,
 1655|       |          |_, _| DistortionScale::default(), // We're not doing RDO here.
 1656|       |          fi.sequence.bit_depth,
 1657|       |          fi.cpu_feature_level,
 1658|       |        )
 1659|       |        .0
 1660|       |      };
 1661|       |      let mut best = (alpha_cost(0), 0);
 1662|       |      let mut count = 2;
 1663|       |      for alpha in 1i16..=16i16 {
 1664|       |        let cost = (alpha_cost(alpha), alpha_cost(-alpha));
 1665|       |        if cost.0 < best.0 {
 1666|       |          best = (cost.0, alpha);
 1667|       |          count += 2;
 1668|       |        }
 1669|       |        if cost.1 < best.0 {
 1670|       |          best = (cost.1, -alpha);
 1671|       |          count += 2;
 1672|       |        }
 1673|       |        if count < alpha {
 1674|       |          break;
 1675|       |        }
 1676|       |      }
 1677|       |      best.1
 1678|   419k|    })
 1679|   419k|    .collect();
 1680|   419k|
 1681|   419k|  if best_alpha[0] == 0 && best_alpha[1] == 0 {
 1682|  48.7k|    None
 1683|       |  } else {
 1684|   370k|    Some(CFLParams::from_alpha(best_alpha[0], best_alpha[1]))
 1685|       |  }
