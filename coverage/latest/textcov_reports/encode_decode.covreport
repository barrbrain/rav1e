  366|  88.5M|$($s)* fn daala_fdct_ii_4<T: TxOperations>(
  367|  88.5M|  q0: T, q1: T, q2: T, q3: T, output: &mut [T],
  368|  88.5M|) {
  369|  88.5M|  // +/- Butterflies with asymmetric output.
  370|  88.5M|  let (q0h, q3) = butterfly_neg(q0, q3);
  371|  88.5M|  let (q1, q2h) = butterfly_add(q1, q2);
  372|  88.5M|
  373|  88.5M|  // Embedded 2-point transforms with asymmetric input.
  374|  88.5M|  let (q0, q1) = daala_fdct_ii_2_asym(q0h, q1);
  375|  88.5M|  let (q3, q2) = daala_fdst_iv_2_asym(q3, q2h);
  376|  88.5M|
  377|  88.5M|  store_coeffs!(output, q0, q1, q2, q3);
  378|  88.5M|}
