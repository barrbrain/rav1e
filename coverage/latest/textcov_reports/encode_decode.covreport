  218|   126M|  $($s)* fn half_kernel(
  219|   126M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   126M|  ) -> (T, T) {
  221|   126M|    let t = Self::ADD(p1, p0.0);
  222|   126M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   126M|    let out0 = b.add(c);
  224|   126M|    let shifted = Self::SHIFT(c);
  225|   126M|    let out1 = Self::SUB(a, shifted);
  226|   126M|    (out0, out1)
  227|   126M|  }
