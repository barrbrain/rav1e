_RINvNtCs3tIhnEwGhQF_5rav1e2me13compute_mv_rdhEB4_:
 1438|  7.09M|fn compute_mv_rd<T: Pixel>(
 1439|  7.09M|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  7.09M|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  7.09M|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  7.09M|) -> MVCandidateRD {
 1443|  7.09M|  let sad = if use_satd {
 1444|  1.64M|    get_satd(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1445|       |  } else {
 1446|  5.45M|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  7.09M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  7.09M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  7.09M|  let rate = rate1.min(rate2 + 1);
 1452|  7.09M|
 1453|  7.09M|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
 1454|  7.09M|}
