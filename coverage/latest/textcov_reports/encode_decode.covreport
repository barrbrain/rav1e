  219|  4.06k|fn estimate_sb_motion<T: Pixel>(
  220|  4.06k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  4.06k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  4.06k|  lambda: u32,
  223|  4.06k|) {
  224|  4.06k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  4.06k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  4.06k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  4.06k|
  228|  4.06k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  7.41k|  for y in (0..sb_h).step_by(mv_size) {
  232|  16.4k|    for x in (0..sb_w).step_by(mv_size) {
  233|  16.4k|      let corner: MVSamplingMode = if init {
  234|  1.35k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  15.1k|        MVSamplingMode::CORNER {
  239|  15.1k|          right: x as usize & mv_size == mv_size,
  240|  15.1k|          bottom: y as usize & mv_size == mv_size,
  241|  15.1k|        }
  242|       |      };
  243|       |
  244|  16.4k|      let sub_bo = tile_bo
  245|  16.4k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|  16.4k|
  247|  16.4k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|  16.4k|      // The rounding makes some assumptions about how subsampling is done.
  249|  16.4k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|  16.4k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|  16.4k|      if let Some(results) = estimate_motion(
  256|  16.4k|        fi,
  257|  16.4k|        ts,
  258|  16.4k|        w,
  259|  16.4k|        h,
  260|  16.4k|        sub_bo,
  261|  16.4k|        ref_frame,
  262|  16.4k|        None,
  263|  16.4k|        corner,
  264|  16.4k|        init,
  265|  16.4k|        ssdec,
  266|  16.4k|        Some(lambda),
  267|  16.4k|      ) {
  268|  15.7k|        // normalize sad to 128x128 block
  269|  15.7k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  15.7k|          / (w * h) as u64) as u32;
  271|  15.7k|        save_me_stats(
  272|  15.7k|          ts,
  273|  15.7k|          mv_size_in_b_log2,
  274|  15.7k|          sub_bo,
  275|  15.7k|          ref_frame,
  276|  15.7k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  15.7k|        );
  278|  15.7k|      }
  279|       |    }
  280|       |  }
  281|  4.06k|}
