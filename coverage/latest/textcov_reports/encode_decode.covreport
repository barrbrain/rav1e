  163|  2.83k|  (
  164|  2.83k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  2.83k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  2.83k|    ((a + 128) >> 8) as i32,
  167|  2.83k|  )
  168|  2.83k|}
