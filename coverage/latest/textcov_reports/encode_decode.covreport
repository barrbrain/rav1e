  456|  43.2M|$($s)* fn daala_fdst_iv_4_asym<T: TxOperations>(
  457|  43.2M|  q0: (T, T), q1h: T, q2: (T, T), q3h: T, output: &mut [T],
  458|  43.2M|) {
  459|  43.2M|  // Stage 0
  460|  43.2M|  //  9633/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/2 = 0.5879378012096793
  461|  43.2M|  //  12873/8192 = (Sin[7*Pi/16] - Cos[7*Pi/16])*2 = 1.5713899167742045
  462|  43.2M|  // 12785/32768 = Cos[7*Pi/16]*2                  = 0.3901806440322565
  463|  43.2M|  let (q0, q3) = RotateAddShift::half_kernel(
  464|  43.2M|    q0,
  465|  43.2M|    q3h,
  466|  43.2M|    ((9633, 14), (12873, 13), (12785, 15)),
  467|  43.2M|  );
  468|  43.2M|  // 11363/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/2 = 0.6935199226610738
