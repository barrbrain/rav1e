  312|   231M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|   231M|  let p0 = p0.sub(p1);
  314|   231M|  let p0h = p0.rshift1();
  315|   231M|  let p1h = p1.add(p0h);
  316|   231M|  ((p0h, p0), p1h)
  317|   231M|}
