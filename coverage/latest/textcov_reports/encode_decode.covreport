  297|  53.1M|  pub fn rollback(&mut self, checkpoint: &BlockContextCheckpoint) {
  298|  53.1M|    let x = checkpoint.x & (COEFF_CONTEXT_MAX_WIDTH - MIB_SIZE);
  299|  53.1M|    self.cdef_coded = checkpoint.cdef_coded;
  300|  53.1M|    self.above_partition_context[(x >> 1)..][..(MIB_SIZE >> 1)]
  301|  53.1M|      .copy_from_slice(&checkpoint.above_partition_context);
  302|  53.1M|    self.left_partition_context = checkpoint.left_partition_context;
  303|  53.1M|    self.above_tx_context[x..][..MIB_SIZE]
  304|  53.1M|      .copy_from_slice(&checkpoint.above_tx_context);
  305|  53.1M|    self.left_tx_context = checkpoint.left_tx_context;
  306|  53.1M|    let num_planes =
  307|  53.1M|      if checkpoint.chroma_sampling == ChromaSampling::Cs400 { 1 } else { 3 };
  308|   103M|    for (p, (dst, src)) in self
  309|  53.1M|      .above_coeff_context
  310|  53.1M|      .iter_mut()
  311|  53.1M|      .zip(checkpoint.above_coeff_context.iter())
  312|  53.1M|      .enumerate()
  313|  53.1M|      .take(num_planes)
  314|   103M|    {
  315|   103M|      let xdec = (p > 0 && checkpoint.chroma_sampling != ChromaSampling::Cs444)
  316|       |        as usize;
  317|   103M|      dst[(x >> xdec)..][..MIB_SIZE].copy_from_slice(src);
  318|       |    }
  319|  53.1M|    self.left_coeff_context = checkpoint.left_coeff_context;
  320|  53.1M|  }
