  237|   952k|  pub fn get_weighted_sse<T: Pixel>(
  238|   952k|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|   952k|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|   952k|    _cpu: CpuFeatureLevel,
  241|   952k|  ) -> u64 {
  242|   952k|    // Always chunk and apply scaling on the sse of squares the size of
  243|   952k|    // decimated/sub-sampled importance block sizes.
  244|   952k|    // Warning: Changing this will require changing/disabling assembly.
  245|   952k|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|   952k|
  247|   952k|    let mut sse: u64 = 0;
  248|       |
  249|  2.39M|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|  8.12M|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|  8.12M|        let mut block_sse: u32 = 0;
  252|       |
  253|  29.2M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|  29.2M|          let s1 = &src1[block_y * chunk_size + j]
  255|  29.2M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|  29.2M|          let s2 = &src2[block_y * chunk_size + j]
  257|  29.2M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|  29.2M|
  259|  29.2M|          block_sse += s1
  260|  29.2M|            .iter()
  261|  29.2M|            .zip(s2)
  262|  29.2M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|  29.2M|            })
  266|  29.2M|            .sum::<u32>();
  267|  29.2M|        }
  268|       |
  269|  8.12M|        sse += (block_sse as u64
  270|  8.12M|          * scale[block_y * scale_stride + block_x] as u64
  271|  8.12M|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|  8.12M|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|   952k|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|   952k|    (sse + (den >> 1)) / den
  277|   952k|  }
