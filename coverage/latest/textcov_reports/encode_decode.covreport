  476|   365k|      if plane_bsize == tx_size.block_size() {
  477|   226k|        txb_ctx.txb_skip_ctx = 0;
  478|   226k|      } else {
  479|   139k|        // This is the algorithm to generate table skip_contexts[min][max].
  480|   139k|        //    if (!max)
  481|   139k|        //      txb_skip_ctx = 1;
  482|   139k|        //    else if (!min)
  483|   139k|        //      txb_skip_ctx = 2 + (max > 3);
  484|   139k|        //    else if (max <= 3)
  485|   139k|        //      txb_skip_ctx = 4;
  486|   139k|        //    else if (min <= 3)
  487|   139k|        //      txb_skip_ctx = 5;
  488|   139k|        //    else
  489|   139k|        //      txb_skip_ctx = 6;
  490|   139k|        const skip_contexts: [[u8; 5]; 5] = [
  491|   139k|          [1, 2, 2, 2, 3],
  492|   139k|          [1, 4, 4, 4, 5],
  493|   139k|          [1, 4, 4, 4, 5],
  494|   139k|          [1, 4, 4, 4, 5],
  495|   139k|          [1, 4, 4, 4, 6],
  496|   139k|        ];
  497|   139k|
  498|   139k|        let top: u8 = above_ctxs.iter().fold(0, |acc, ctx| acc | *ctx)
  499|   139k|          & COEFF_CONTEXT_MASK as u8;
  500|   139k|
  501|   139k|        let left: u8 = left_ctxs.iter().fold(0, |acc, ctx| acc | *ctx)
