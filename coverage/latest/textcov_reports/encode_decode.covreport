  177|    313|fn setup_encoder<T: Pixel>(
  178|    313|  w: usize, h: usize, speed: u8, quantizer: usize, bit_depth: usize,
  179|    313|  chroma_sampling: ChromaSampling, min_keyint: u64, max_keyint: u64,
  180|    313|  switch_frame_interval: u64, low_latency: bool, error_resilient: bool,
  181|    313|  bitrate: i32, tile_cols_log2: usize, tile_rows_log2: usize,
  182|    313|  still_picture: bool, grain_table: Option<Vec<GrainTableSegment>>,
  183|    313|) -> Context<T> {
