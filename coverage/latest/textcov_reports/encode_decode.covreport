  824|  2.31M|    RotateSubShift::kernel(s8, s7, ((32729, 15), (201, 11), (1945, 11)));
  825|  2.31M|
  826|  2.31M|  // Stage 1
  827|  2.31M|  let (s0, s7) = butterfly_sub_asym((s0.rshift1(), s0), s7);
