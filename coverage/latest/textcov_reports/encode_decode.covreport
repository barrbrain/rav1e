  177|    125|fn setup_encoder<T: Pixel>(
  178|    125|  w: usize, h: usize, speed: u8, quantizer: usize, bit_depth: usize,
  179|    125|  chroma_sampling: ChromaSampling, min_keyint: u64, max_keyint: u64,
  180|    125|  switch_frame_interval: u64, low_latency: bool, error_resilient: bool,
  181|    125|  bitrate: i32, tile_cols_log2: usize, tile_rows_log2: usize,
  182|    125|  still_picture: bool, grain_table: Option<Vec<GrainTableSegment>>,
  183|    125|) -> Context<T> {
  184|    125|  assert!(bit_depth == 8 || std::mem::size_of::<T>() > 1);
  185|    125|  let mut enc = EncoderConfig::with_speed_preset(speed);
  186|    125|  enc.quantizer = quantizer;
  187|    125|  enc.min_key_frame_interval = min_keyint;
  188|    125|  enc.max_key_frame_interval = max_keyint;
  189|    125|  enc.switch_frame_interval = switch_frame_interval;
  190|    125|  enc.low_latency = low_latency;
  191|    125|  enc.error_resilient = error_resilient;
  192|    125|  enc.width = w;
  193|    125|  enc.height = h;
  194|    125|  enc.bit_depth = bit_depth;
  195|    125|  enc.chroma_sampling = chroma_sampling;
  196|    125|  enc.bitrate = bitrate;
  197|    125|  enc.tile_cols = 1 << tile_cols_log2;
  198|    125|  enc.tile_rows = 1 << tile_rows_log2;
  199|    125|  enc.still_picture = still_picture;
  200|    125|  enc.film_grain_params = grain_table;
  201|       |
  202|    125|  let threads = if cfg!(fuzzing) { 1 } else { 2 };
  203|       |
  204|    125|  let cfg = Config::new().with_encoder_config(enc).with_threads(threads);
  205|    125|
  206|    125|  cfg.new_context().unwrap()
  207|    125|}
