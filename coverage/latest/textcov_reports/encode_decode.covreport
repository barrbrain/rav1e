  401|   135k|  let clipped_half_h = (h >> 1).min(tile_me_stats.rows() - 1 - tile_bo.0.y);
  402|   135k|
  403|   135k|  let mut process_cand = |stats: MEStats| -> MotionVector {
  404|       |    min_sad = min_sad.min(stats.normalized_sad);
  405|       |    let mv = stats.mv.quantize_to_fullpel();
  406|       |    MotionVector {
  407|       |      col: clamp(mv.col as isize, mvx_min, mvx_max) as i16,
  408|       |      row: clamp(mv.row as isize, mvy_min, mvy_max) as i16,
