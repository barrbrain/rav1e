  218|   315M|    // distortion is used, distortion is only known at the tx block level which
  219|   315M|    // might be bigger than 8x8. So temporal RDO is always disabled in that case.
  220|   315M|    !self.speed_settings.transform.tx_domain_distortion
  221|   315M|  }
