 1456|  33.5k|fn full_search<T: Pixel>(
 1457|  33.5k|  fi: &FrameInvariants<T>, x_lo: isize, x_hi: isize, y_lo: isize, y_hi: isize,
 1458|  33.5k|  w: usize, h: usize, org_region: &PlaneRegion<T>, p_ref: &Plane<T>,
