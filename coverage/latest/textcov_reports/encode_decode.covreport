  131|  2.63M|            _mm256_unpacklo_epi16(coeffs_abs, _mm256_setzero_si256()),
  132|  2.63M|          ),
  133|  2.63M|          log_tx_scale,
  134|  2.63M|        ),
  135|  2.63M|        // Second half
  136|  2.63M|        _mm256_srlv_epi32(
  137|  2.63M|          _mm256_madd_epi16(
  138|  2.63M|            quants_ac,
  139|  2.63M|            _mm256_unpackhi_epi16(coeffs_abs, _mm256_setzero_si256()),
  140|  2.63M|          ),
  141|  2.63M|          log_tx_scale,
  142|  2.63M|        ),
  143|  2.63M|      ),
  144|  2.63M|      coeffs,
  145|  2.63M|    );
