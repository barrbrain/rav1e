  579|    973|  pub fn update_threshold(&mut self, base_q_idx: u8, bd: usize) {
  580|    973|    let base_ac_q = ac_q(base_q_idx, 0, bd) as u64;
  581|    973|    let real_ac_q = ArrayVec::<_, MAX_SEGMENTS>::from_iter(
  582|    973|      self.data[..=self.max_segment as usize].iter().map(|data| {
  583|       |        ac_q(base_q_idx, data[SegLvl::SEG_LVL_ALT_Q as usize] as i8, bd) as u64
  584|    973|      }),
  585|    973|    );
  586|    973|    self.threshold.fill(DistortionScale(0));
  587|  2.15k|    for ((q1, q2), threshold) in
  588|    973|      real_ac_q.iter().skip(1).zip(&real_ac_q).zip(&mut self.threshold)
  589|  2.15k|    {
  590|  2.15k|      *threshold = DistortionScale::new(base_ac_q.pow(2), q1 * q2);
  591|  2.15k|    }
  592|    973|  }
