_RINvNtCsixsdkNzQ5tW_5rav1e2me18estimate_sb_motionhEB4_:
  219|  10.2k|fn estimate_sb_motion<T: Pixel>(
  220|  10.2k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  10.2k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  10.2k|  lambda: u32,
  223|  10.2k|) {
  224|  10.2k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  10.2k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  10.2k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  10.2k|
  228|  10.2k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  19.7k|  for y in (0..sb_h).step_by(mv_size) {
  232|  46.2k|    for x in (0..sb_w).step_by(mv_size) {
  233|  46.2k|      let corner: MVSamplingMode = if init {
  234|  3.41k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  42.8k|        MVSamplingMode::CORNER {
  239|  42.8k|          right: x as usize & mv_size == mv_size,
  240|  42.8k|          bottom: y as usize & mv_size == mv_size,
  241|  42.8k|        }
  242|       |      };
  243|       |
  244|  46.2k|      let sub_bo = tile_bo
  245|  46.2k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|  46.2k|
  247|  46.2k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|  46.2k|      // The rounding makes some assumptions about how subsampling is done.
  249|  46.2k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|  46.2k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|  46.2k|      if let Some(results) = estimate_motion(
  256|  46.2k|        fi,
  257|  46.2k|        ts,
  258|  46.2k|        w,
  259|  46.2k|        h,
  260|  46.2k|        sub_bo,
  261|  46.2k|        ref_frame,
  262|  46.2k|        None,
  263|  46.2k|        corner,
  264|  46.2k|        init,
  265|  46.2k|        ssdec,
  266|  46.2k|        Some(lambda),
  267|  46.2k|      ) {
  268|  41.9k|        // normalize sad to 128x128 block
  269|  41.9k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  41.9k|          / (w * h) as u64) as u32;
  271|  41.9k|        save_me_stats(
  272|  41.9k|          ts,
  273|  41.9k|          mv_size_in_b_log2,
  274|  41.9k|          sub_bo,
  275|  41.9k|          ref_frame,
  276|  41.9k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  41.9k|        );
  278|  41.9k|      }
  279|       |    }
  280|       |  }
  281|  10.2k|}
