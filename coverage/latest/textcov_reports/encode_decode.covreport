  177|     15|    for sby in 0..ts.sb_height {
  178|     27|      for sbx in 0..ts.sb_width {
  179|     27|        let mut tested_frames_flags = 0;
  180|    189|        for &ref_frame in inter_cfg.allowed_ref_frames() {
  181|    189|          let frame_flag = 1 << fi.ref_frames[ref_frame.to_index()];
  182|    189|          if tested_frames_flags & frame_flag == frame_flag {
  183|    138|            continue;
  184|     51|          }
