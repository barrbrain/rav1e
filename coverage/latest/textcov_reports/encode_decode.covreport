  687|  95.8k|fn deblock_size8_inner(
  688|  95.8k|  [p3, p2, p1, p0, q0, q1, q2, q3]: [i32; 8], level: usize, bd: usize,
  689|  95.8k|) -> Option<[i32; 6]> {
