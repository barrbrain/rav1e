  778|       |    } else {
  779|       |      // eight taps
  780|   370k|      (
  781|   370k|        rec[i][0].as_(),
  782|   370k|        rec[i][1].as_(),
  783|   370k|        rec[i][2].as_(),
  784|   370k|        rec[i][3].as_(),
  785|   370k|        rec[i][4].as_(),
  786|   370k|        rec[i][5].as_(),
