  456|   344k|$($s)* fn daala_fdst_iv_4_asym<T: TxOperations>(
  457|   344k|  q0: (T, T), q1h: T, q2: (T, T), q3h: T, output: &mut [T],
  458|   344k|) {
  459|   344k|  // Stage 0
  460|   344k|  //  9633/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/2 = 0.5879378012096793
  461|   344k|  //  12873/8192 = (Sin[7*Pi/16] - Cos[7*Pi/16])*2 = 1.5713899167742045
