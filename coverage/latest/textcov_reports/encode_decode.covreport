 1480|    108|fn sse_plane<T: Pixel>(
 1481|    108|  rec: &PlaneRegion<T>, src: &PlaneRegion<T>,
 1482|    108|  v_sse: &mut [i64; MAX_LOOP_FILTER + 2],
 1483|    108|  h_sse: &mut [i64; MAX_LOOP_FILTER + 2], pli: usize, blocks: &TileBlocks,
 1484|    108|  crop_w: usize, crop_h: usize, bd: usize,
 1485|    108|) {
