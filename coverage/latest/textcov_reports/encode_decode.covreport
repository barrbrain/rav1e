  355|   138M|}
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward15daala_fdct_ii_8NtB2_5I32X8EBa_:
  490|  68.2M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  68.2M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  68.2M|) {
  493|  68.2M|  // +/- Butterflies with asymmetric output.
  494|  68.2M|  let (r0h, r7) = butterfly_neg(r0, r7);
  495|  68.2M|  let (r1, r6h) = butterfly_add(r1, r6);
  496|  68.2M|  let (r2h, r5) = butterfly_neg(r2, r5);
  497|  68.2M|  let (r3, r4h) = butterfly_add(r3, r4);
  498|  68.2M|
  499|  68.2M|  // Embedded 4-point transforms with asymmetric input.
  500|  68.2M|  daala_fdct_ii_4_asym(r0h, r1, r2h, r3, &mut output[0..4]);
  501|  68.2M|  daala_fdst_iv_4_asym(r7, r6h, r5, r4h, &mut output[4..8]);
  502|  68.2M|  output[4..8].reverse();
  503|  68.2M|}
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward21daala_fdst_iv_16_asymNtB2_5I32X8EBa_:
  969|  17.3M|$($s)* fn daala_fdst_iv_16_asym<T: TxOperations>(
  970|  17.3M|  s0: (T, T), s1h: T, s2: (T, T), s3h: T, s4: (T, T), s5h: T, s6: (T, T),
  971|  17.3M|  s7h: T, s8: (T, T), s9h: T, sa: (T, T), sbh: T, sc: (T, T), sdh: T,
  972|  17.3M|  se: (T, T), sfh: T, output: &mut [T],
  973|  17.3M|) {
  974|  17.3M|  // Stage 0
  975|  17.3M|  //   1073/2048 = (Sin[31*Pi/64] + Cos[31*Pi/64])/2 = 0.5239315652662953
  976|  17.3M|  // 62241/32768 = (Sin[31*Pi/64] - Cos[31*Pi/64])*2 = 1.8994555637555088
  977|  17.3M|  //   201/16384 = Cos[31*Pi/64]*2                   = 0.0981353486548360
  978|  17.3M|  let (s0, sf) =
  979|  17.3M|    RotateAddShift::half_kernel(s0, sfh, ((1073, 11), (62241, 15), (201, 11)));
  980|  17.3M|  // 18611/32768 = (Sin[29*Pi/64] + Cos[29*Pi/64])/2 = 0.5679534922100714
  981|  17.3M|  // 55211/32768 = (Sin[29*Pi/64] - Cos[29*Pi/64])*2 = 1.6848920710188384
  982|  17.3M|  //    601/2048 = Cos[29*Pi/64]*2                   = 0.2934609489107235
  983|  17.3M|  let (se, s1) = RotateSubShift::half_kernel(
  984|  17.3M|    se,
  985|  17.3M|    s1h,
  986|  17.3M|    ((18611, 15), (55211, 15), (601, 11)),
  987|  17.3M|  );
  988|  17.3M|  //  9937/16384 = (Sin[27*Pi/64] + Cos[27*Pi/64])/2 = 0.6065057165489039
  989|  17.3M|  //   1489/1024 = (Sin[27*Pi/64] - Cos[27*Pi/64])*2 = 1.4541021465825602
  990|  17.3M|  //   3981/8192 = Cos[27*Pi/64]*2                   = 0.4859603598065277
  991|  17.3M|  let (s2, sd) =
  992|  17.3M|    RotateAddShift::half_kernel(s2, sdh, ((9937, 14), (1489, 10), (3981, 13)));
  993|  17.3M|  // 10473/16384 = (Sin[25*Pi/64] + Cos[25*Pi/64])/2 = 0.6392169592876205
  994|  17.3M|  // 39627/32768 = (Sin[25*Pi/64] - Cos[25*Pi/64])*2 = 1.2093084235816014
  995|  17.3M|  // 11039/16384 = Cos[25*Pi/64]*2                   = 0.6737797067844401
  996|  17.3M|  let (sc, s3) = RotateSubShift::half_kernel(
  997|  17.3M|    sc,
  998|  17.3M|    s3h,
  999|  17.3M|    ((10473, 14), (39627, 15), (11039, 14)),
 1000|  17.3M|  );
 1001|  17.3M|  // 2727/4096 = (Sin[23*Pi/64] + Cos[23*Pi/64])/2 = 0.6657721932768628
 1002|  17.3M|  // 3903/4096 = (Sin[23*Pi/64] - Cos[23*Pi/64])*2 = 0.9528683993863225
 1003|  17.3M|  // 7005/8192 = Cos[23*Pi/64]*2                   = 0.8551101868605642
 1004|  17.3M|  let (s4, sb) =
 1005|  17.3M|    RotateAddShift::half_kernel(s4, sbh, ((2727, 12), (3903, 12), (7005, 13)));
 1006|  17.3M|  // 5619/8192 = (Sin[21*Pi/64] + Cos[21*Pi/64])/2 = 0.6859156770967569
 1007|  17.3M|  // 2815/4096 = (Sin[21*Pi/64] - Cos[21*Pi/64])*2 = 0.6872517316141069
 1008|  17.3M|  // 8423/8192 = Cos[21*Pi/64]*2                   = 1.0282054883864433
 1009|  17.3M|  let (sa, s5) =
 1010|  17.3M|    RotateSubShift::half_kernel(sa, s5h, ((5619, 13), (2815, 12), (8423, 13)));
 1011|  17.3M|  //   2865/4096 = (Sin[19*Pi/64] + Cos[19*Pi/64])/2 = 0.6994534179865391
 1012|  17.3M|  // 13588/32768 = (Sin[19*Pi/64] - Cos[19*Pi/64])*2 = 0.4150164539764232
 1013|  17.3M|  //     305/256 = Cos[19*Pi/64]*2                   = 1.1913986089848667
 1014|  17.3M|  let (s6, s9) =
 1015|  17.3M|    RotateAddShift::half_kernel(s6, s9h, ((2865, 12), (13599, 15), (305, 8)));
 1016|  17.3M|  // 23143/32768 = (Sin[17*Pi/64] + Cos[17*Pi/64])/2 = 0.7062550401009887
 1017|  17.3M|  //   1137/8192 = (Sin[17*Pi/64] - Cos[17*Pi/64])*2 = 0.1387843410158816
 1018|  17.3M|  //  11003/8192 = Cos[17*Pi/64]*2                   = 1.3431179096940367
 1019|  17.3M|  let (s8, s7) = RotateSubShift::half_kernel(
 1020|  17.3M|    s8,
 1021|  17.3M|    s7h,
 1022|  17.3M|    ((23143, 15), (1137, 13), (11003, 13)),
 1023|  17.3M|  );
 1024|  17.3M|
 1025|  17.3M|  // Stage 1
 1026|  17.3M|  let (s0, s7) = butterfly_sub_asym((s0.rshift1(), s0), s7);
 1027|  17.3M|  let (s8, sf) = butterfly_sub_asym((s8.rshift1(), s8), sf);
 1028|  17.3M|  let (s4, s3) = butterfly_add_asym((s4.rshift1(), s4), s3);
 1029|  17.3M|  let (sc, sb) = butterfly_add_asym((sc.rshift1(), sc), sb);
 1030|  17.3M|  let (s2, s5) = butterfly_sub_asym((s2.rshift1(), s2), s5);
 1031|  17.3M|  let (sa, sd) = butterfly_sub_asym((sa.rshift1(), sa), sd);
 1032|  17.3M|  let (s6, s1) = butterfly_add_asym((s6.rshift1(), s6), s1);
 1033|  17.3M|  let (se, s9) = butterfly_add_asym((se.rshift1(), se), s9);
 1034|  17.3M|
 1035|  17.3M|  // Stage 2
 1036|  17.3M|  let ((_s8h, s8), s4h) = butterfly_add(s8, s4);
 1037|  17.3M|  let ((_s7h, s7), sbh) = butterfly_add(s7, sb);
 1038|  17.3M|  let ((_sah, sa), s6h) = butterfly_sub(sa, s6);
 1039|  17.3M|  let ((_s5h, s5), s9h) = butterfly_sub(s5, s9);
 1040|  17.3M|  let (s0, s3h) = butterfly_add(s0, s3);
 1041|  17.3M|  let (sd, seh) = butterfly_add(sd, se);
 1042|  17.3M|  let (s2, s1h) = butterfly_sub(s2, s1);
 1043|  17.3M|  let (sf, sch) = butterfly_sub(sf, sc);
 1044|  17.3M|
 1045|  17.3M|  // Stage 3
 1046|  17.3M|  //   9633/8192 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1047|  17.3M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1048|  17.3M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1049|  17.3M|  let (s8, s7) =
 1050|  17.3M|    RotateAdd::kernel(s8, s7, ((9633, 13), (12873, 14), (6393, 15)));
 1051|  17.3M|  // 22725/16384 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1052|  17.3M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1053|  17.3M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1054|  17.3M|  let (s9, s6) =
 1055|  17.3M|    RotateAdd::kernel(s9h, s6h, ((22725, 14), (9041, 15), (4551, 13)));
 1056|  17.3M|  //  11363/8192 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1057|  17.3M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1058|  17.3M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1059|  17.3M|  let (s5, sa) =
 1060|  17.3M|    RotateNeg::kernel(s5, sa, ((11363, 13), (9041, 15), (4551, 13)));
 1061|  17.3M|  //  9633/32768 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1062|  17.3M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1063|  17.3M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1064|  17.3M|  let (s4, sb) =
 1065|  17.3M|    RotateNeg::kernel(s4h, sbh, ((9633, 13), (12873, 14), (6393, 15)));
 1066|  17.3M|
 1067|  17.3M|  // Stage 4
 1068|  17.3M|  let (s2, sc) = butterfly_add_asym(s2, sch);
 1069|  17.3M|  let (s0, s1) = butterfly_sub_asym(s0, s1h);
 1070|  17.3M|  let (sf, se) = butterfly_add_asym(sf, seh);
 1071|  17.3M|  let (sd, s3) = butterfly_add_asym(sd, s3h);
 1072|  17.3M|  let (s7, s6) = butterfly_add_asym((s7.rshift1(), s7), s6);
 1073|  17.3M|  let (s8, s9) = butterfly_sub_asym((s8.rshift1(), s8), s9);
 1074|  17.3M|  let (sa, sb) = butterfly_sub_asym((sa.rshift1(), sa), sb);
 1075|  17.3M|  let (s5, s4) = butterfly_add_asym((s5.rshift1(), s5), s4);
 1076|  17.3M|
 1077|  17.3M|  // Stage 5
 1078|  17.3M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
 1079|  17.3M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1080|  17.3M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1081|  17.3M|  let (sc, s3) =
 1082|  17.3M|    RotateAdd::kernel(sc, s3, ((10703, 13), (8867, 14), (3135, 13)));
 1083|  17.3M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3870398453221475
 1084|  17.3M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1085|  17.3M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1086|  17.3M|  let (s2, sd) =
 1087|  17.3M|    RotateNeg::kernel(s2, sd, ((10703, 13), (8867, 14), (3135, 13)));
 1088|  17.3M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1089|  17.3M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1090|  17.3M|  let (sa, s5) = RotatePi4Add::kernel(sa, s5, ((11585, 13), (5793, 13)));
 1091|  17.3M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1092|  17.3M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1093|  17.3M|  let (s6, s9) = RotatePi4Add::kernel(s6, s9, ((11585, 13), (5793, 13)));
 1094|  17.3M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1095|  17.3M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1096|  17.3M|  let (se, s1) = RotatePi4Add::kernel(se, s1, ((11585, 13), (5793, 13)));
 1097|  17.3M|
 1098|  17.3M|  store_coeffs!(
 1099|  17.3M|    output, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, sa, sb, sc, sd, se, sf
 1100|  17.3M|  );
 1101|  17.3M|}
_RNvYNtNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward9RotateSubINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   147M|  $($s)* fn half_kernel(
  219|   147M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   147M|  ) -> (T, T) {
  221|   147M|    let t = Self::ADD(p1, p0.0);
  222|   147M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   147M|    let out0 = b.add(c);
  224|   147M|    let shifted = Self::SHIFT(c);
  225|   147M|    let out1 = Self::SUB(a, shifted);
  226|   147M|    (out0, out1)
  227|   147M|  }
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward11daala_fdct4NtB2_5I32X8EBa_:
  381|   113M|$($s)* fn daala_fdct4<T: TxOperations>(coeffs: &mut [T]) {
  382|   113M|  assert!(coeffs.len() >= 4);
  383|   113M|  let mut temp_out: [T; 4] = [T::zero(); 4];
  384|   113M|  daala_fdct_ii_4(coeffs[0], coeffs[1], coeffs[2], coeffs[3], &mut temp_out);
  385|   113M|
  386|   113M|  coeffs[0] = temp_out[0];
  387|   113M|  coeffs[1] = temp_out[2];
  388|   113M|  coeffs[2] = temp_out[1];
  389|   113M|  coeffs[3] = temp_out[3];
  390|   113M|}
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward16daala_fdct_ii_16NtB2_5I32X8EBa_:
  717|  24.8M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  24.8M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  24.8M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  24.8M|) {
  721|  24.8M|  // +/- Butterflies with asymmetric output.
  722|  24.8M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  24.8M|  let (s1, seh) = butterfly_add(s1, se);
  724|  24.8M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  24.8M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  24.8M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  24.8M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  24.8M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  24.8M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  24.8M|
  731|  24.8M|  // Embedded 8-point transforms with asymmetric input.
  732|  24.8M|  daala_fdct_ii_8_asym(s0h, s1, s2h, s3, s4h, s5, s6h, s7, &mut output[0..8]);
  733|  24.8M|  daala_fdst_iv_8_asym(sf, seh, sd, sch, sb, sah, s9, s8h, &mut output[8..16]);
  734|  24.8M|  output[8..16].reverse();
  735|  24.8M|}
_RNvYNtNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward12RotatePi4AddINtB4_15RotateKernelPi4NtB4_5I32X8E6kernelBc_:
  179|  59.2M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  59.2M|    let t = Self::ADD(p1, p0);
  181|  59.2M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  59.2M|    let out1 = Self::SUB(a, out0);
  183|  59.2M|    (out0, out1)
  184|  59.2M|  }
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward20daala_fdst_iv_4_asymNtB2_5I32X8EBa_:
  456|  68.2M|$($s)* fn daala_fdst_iv_4_asym<T: TxOperations>(
  457|  68.2M|  q0: (T, T), q1h: T, q2: (T, T), q3h: T, output: &mut [T],
  458|  68.2M|) {
  459|  68.2M|  // Stage 0
  460|  68.2M|  //  9633/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/2 = 0.5879378012096793
  461|  68.2M|  //  12873/8192 = (Sin[7*Pi/16] - Cos[7*Pi/16])*2 = 1.5713899167742045
  462|  68.2M|  // 12785/32768 = Cos[7*Pi/16]*2                  = 0.3901806440322565
  463|  68.2M|  let (q0, q3) = RotateAddShift::half_kernel(
  464|  68.2M|    q0,
  465|  68.2M|    q3h,
  466|  68.2M|    ((9633, 14), (12873, 13), (12785, 15)),
  467|  68.2M|  );
  468|  68.2M|  // 11363/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/2 = 0.6935199226610738
  469|  68.2M|  // 18081/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*2 = 0.5517987585658861
  470|  68.2M|  //  4551/4096 = Cos[5*Pi/16]*2                  = 1.1111404660392044
  471|  68.2M|  let (q2, q1) = RotateSubShift::half_kernel(
  472|  68.2M|    q2,
  473|  68.2M|    q1h,
  474|  68.2M|    ((11363, 14), (18081, 15), (4551, 12)),
  475|  68.2M|  );
  476|  68.2M|
  477|  68.2M|  // Stage 1
  478|  68.2M|  let (q2, q3) = butterfly_sub_asym((q2.rshift1(), q2), q3);
  479|  68.2M|  let (q0, q1) = butterfly_sub_asym((q0.rshift1(), q0), q1);
  480|  68.2M|
  481|  68.2M|  // Stage 2
  482|  68.2M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  483|  68.2M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  484|  68.2M|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  485|  68.2M|
  486|  68.2M|  store_coeffs!(output, q0, q1, q2, q3);
  487|  68.2M|}
_RINvNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward13butterfly_addNtB2_5I32X8EBa_:
  303|   811M|$($s)* fn butterfly_add<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  304|   811M|  let p0 = p0.add(p1);
  305|   811M|  let p0h = p0.rshift1();
  306|   811M|  let p1h = p1.sub(p0h);
  307|   811M|  ((p0h, p0), p1h)
  308|   811M|}
