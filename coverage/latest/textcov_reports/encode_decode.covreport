  338|   658M|$($s)* fn butterfly_sub_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  339|   658M|  let p1 = p1h.sub(p0.0);
  340|   658M|  let p0 = p0.1.add(p1);
  341|   658M|  (p0, p1)
  342|   658M|}
