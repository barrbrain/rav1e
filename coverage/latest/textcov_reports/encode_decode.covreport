  181|  65.5M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  65.5M|    let out1 = Self::SUB(a, out0);
  183|  65.5M|    (out0, out1)
  184|  65.5M|  }
