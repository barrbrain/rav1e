  524|  6.19k|  stripe_h: usize, cdeffed: &PlaneSlice<T>, deblocked: &PlaneSlice<T>,
  525|  6.19k|) {
  526|  6.19k|  let integral_image = &mut integral_image_buffer.integral_image;
  527|  6.19k|  let sq_integral_image = &mut integral_image_buffer.sq_integral_image;
  528|  6.19k|
  529|  6.19k|  // Number of elements outside the stripe
  530|  6.19k|  let left_w = 4; // max radius of 2 + 2 padding
  531|  6.19k|  let right_w = 3; // max radius of 2 + 1 padding
  532|  6.19k|
  533|  6.19k|  assert_eq!(cdeffed.x, deblocked.x);
  534|       |
  535|       |  // Find how many unique elements to use to the left and right
