  836|   782k|      mag += cmp::min(3, levels[(3 << bhl) + (3 << TX_PAD_HOR_LOG2)]); // { 0, 3 }
  837|   782k|      mag += cmp::min(3, levels[(4 << bhl) + (4 << TX_PAD_HOR_LOG2)]); // { 0, 4 }
  838|   782k|    }
  839|       |
  840|  39.3M|    mag as usize
  841|  39.3M|  }
