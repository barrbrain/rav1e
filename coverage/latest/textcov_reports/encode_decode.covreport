 1164|     12|fn uneven_multi_hex_search<T: Pixel>(
 1165|     12|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|     12|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|     12|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|     12|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|     12|) {
 1170|     12|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|     12|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|    144|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|    432|    for &offset in &HORIZONTAL_LINE {
 1196|    288|      let cand_mv = center + offset * i;
 1197|    288|      let rd = get_fullpel_mv_rd(
 1198|    288|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|    288|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|    288|      );
 1201|    288|
 1202|    288|      if rd.cost < current.rd.cost {
 1203|     15|        current.mv = cand_mv;
 1204|     15|        current.rd = rd;
 1205|    273|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|     72|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|    216|    for &offset in &VERTICAL_LINE {
 1217|    144|      let cand_mv = center + offset * i;
 1218|    144|      let rd = get_fullpel_mv_rd(
 1219|    144|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|    144|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|    144|      );
 1222|    144|
 1223|    144|      if rd.cost < current.rd.cost {
 1224|      3|        current.mv = cand_mv;
 1225|      3|        current.rd = rd;
 1226|    141|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|     12|  let center = current.mv;
 1232|     72|  for row in -2..=2 {
 1233|    360|    for col in -2..=2 {
 1234|    300|      if row == 0 && col == 0 {
 1235|     12|        continue;
 1236|    288|      }
 1237|    288|      let cand_mv = center + MotionVector { row, col };
 1238|    288|      let rd = get_fullpel_mv_rd(
 1239|    288|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|    288|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|    288|      );
 1242|    288|
 1243|    288|      if rd.cost < current.rd.cost {
 1244|      6|        current.mv = cand_mv;
 1245|      6|        current.rd = rd;
 1246|    282|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|     12|  let center = current.mv;
 1274|     12|
 1275|     12|  // Divide by 4, the radius of the UMH's hexagon.
 1276|     12|  let iterations = me_range >> 2;
 1277|     72|  for i in 1..=iterations {
 1278|  1.22k|    for &offset in &UMH_PATTERN {
 1279|  1.15k|      let cand_mv = center + offset * i;
 1280|  1.15k|      let rd = get_fullpel_mv_rd(
 1281|  1.15k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|  1.15k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|  1.15k|      );
 1284|  1.15k|
 1285|  1.15k|      if rd.cost < current.rd.cost {
 1286|     18|        current.mv = cand_mv;
 1287|     18|        current.rd = rd;
 1288|  1.13k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|     12|  hexagon_search(
 1294|     12|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|     12|    mvx_max, mvy_min, mvy_max, w, h,
 1296|     12|  );
