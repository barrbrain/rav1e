 1485|  13.8k|) {
 1486|  13.8k|  let xdec = rec.plane_cfg.xdec;
 1487|  13.8k|  let ydec = rec.plane_cfg.ydec;
 1488|  13.8k|  assert!(xdec <= 1 && ydec <= 1);
 1489|  13.8k|  let rect = rec.rect();
 1490|  13.8k|  let cols = (cmp::min(
 1491|  13.8k|    blocks.cols(),
 1492|  13.8k|    (crop_w - rect.x as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1493|  13.8k|  ) + (1 << xdec >> 1))
