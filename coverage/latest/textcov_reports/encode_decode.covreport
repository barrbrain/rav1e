  237|  3.80M|  pub fn get_weighted_sse<T: Pixel>(
  238|  3.80M|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|  3.80M|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|  3.80M|    _cpu: CpuFeatureLevel,
  241|  3.80M|  ) -> u64 {
  242|  3.80M|    // Always chunk and apply scaling on the sse of squares the size of
  243|  3.80M|    // decimated/sub-sampled importance block sizes.
  244|  3.80M|    // Warning: Changing this will require changing/disabling assembly.
  245|  3.80M|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|  3.80M|
  247|  3.80M|    let mut sse: u64 = 0;
  248|       |
  249|  10.0M|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|  36.9M|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|  36.9M|        let mut block_sse: u32 = 0;
  252|       |
  253|   135M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|   135M|          let s1 = &src1[block_y * chunk_size + j]
  255|   135M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|   135M|          let s2 = &src2[block_y * chunk_size + j]
  257|   135M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|   135M|
  259|   135M|          block_sse += s1
  260|   135M|            .iter()
  261|   135M|            .zip(s2)
  262|   135M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|   135M|            })
  266|   135M|            .sum::<u32>();
  267|   135M|        }
  268|       |
  269|  36.9M|        sse += (block_sse as u64
  270|  36.9M|          * scale[block_y * scale_stride + block_x] as u64
  271|  36.9M|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|  36.9M|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|  3.80M|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|  3.80M|    (sse + (den >> 1)) / den
  277|  3.80M|  }
_RINvNtNtCs5T1csxkeGwJ_5rav1e4dist4rust16cdef_dist_kernelhEB6_:
  296|  10.3M|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  10.3M|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  10.3M|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  10.3M|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  10.3M|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  10.3M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  10.3M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  10.3M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  10.3M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|  56.3M|    for j in 0..h {
  319|  56.3M|      let row1 = &src[j][0..w];
  320|  56.3M|      let row2 = &dst[j][0..w];
  321|   279M|      for (s, d) in row1.iter().zip(row2) {
  322|   279M|        let s: u32 = u32::cast_from(*s);
  323|   279M|        let d: u32 = u32::cast_from(*d);
  324|   279M|        sum_s += s;
  325|   279M|        sum_d += d;
  326|   279M|
  327|   279M|        sum_s2 += s * s;
  328|   279M|        sum_d2 += d * d;
  329|   279M|        sum_sd += s * d;
  330|   279M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  10.3M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  10.3M|
  337|  10.3M|    // Convert to 64-bits to avoid overflow when squaring
  338|  10.3M|    let sum_s = sum_s as u64;
  339|  10.3M|    let sum_d = sum_d as u64;
  340|  10.3M|
  341|  10.3M|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  10.3M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  10.3M|    //    (n = # samples i.e. area)
  344|  10.3M|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  10.3M|    // When w and h are powers of two, this can be done via shifting.
  346|  10.3M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  10.3M|    let div_shift = AREA_DIVISOR_BITS;
  348|  10.3M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  10.3M|    // two. Saturate to avoid underflow.
  350|  10.3M|    let mut svar = sum_s2.saturating_sub(
  351|  10.3M|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  10.3M|    );
  353|  10.3M|    let mut dvar = sum_d2.saturating_sub(
  354|  10.3M|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  10.3M|    );
  356|  10.3M|
  357|  10.3M|    // Scale variances up to 8x8 size.
  358|  10.3M|    //   scaled variance = var * (8x8) / wxh
  359|  10.3M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  10.3M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  10.3M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  10.3M|    svar =
  363|  10.3M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  10.3M|    dvar =
  365|  10.3M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  10.3M|
  367|  10.3M|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  10.3M|  }
