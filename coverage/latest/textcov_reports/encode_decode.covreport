  312|  1.57M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|  1.57M|  let p0 = p0.sub(p1);
  314|  1.57M|  let p0h = p0.rshift1();
  315|  1.57M|  let p1h = p1.add(p0h);
  316|  1.57M|  ((p0h, p0), p1h)
  317|  1.57M|}
_RINvNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward16daala_fdst_vii_4NtB2_5I32X8EBa_:
  393|   144k|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|   144k|  assert!(coeffs.len() >= 4);
  395|       |
  396|   144k|  let q0 = coeffs[0];
  397|   144k|  let q1 = coeffs[1];
  398|   144k|  let q2 = coeffs[2];
  399|   144k|  let q3 = coeffs[3];
  400|   144k|  let t0 = q1.add(q3);
  401|   144k|  // t1 = (q0 + q1 - q3)/2
  402|   144k|  let t1 = q1.add(q0.sub_avg(t0));
  403|   144k|  let t2 = q0.sub(q1);
  404|   144k|  let t3 = q2;
  405|   144k|  let t4 = q0.add(q3);
  406|   144k|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|   144k|  let t0 = t0.tx_mul((7021, 14));
  408|   144k|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|   144k|  let t1 = t1.tx_mul((37837, 15));
  410|   144k|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|   144k|  let t2 = t2.tx_mul((21513, 15));
  412|   144k|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|   144k|  let t3 = t3.tx_mul((37837, 15));
  414|   144k|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|   144k|  let t4 = t4.tx_mul((467, 11));
  416|   144k|  let t3h = t3.rshift1();
  417|   144k|  let u4 = t4.add(t3h);
  418|   144k|  coeffs[0] = t0.add(u4);
  419|   144k|  coeffs[1] = t1;
  420|   144k|  coeffs[2] = t0.add(t2.sub(t3h));
  421|   144k|  coeffs[3] = t2.add(t3.sub(u4));
  422|   144k|}
_RINvNtNtNtNtCsgzd1EjkjF4V_5rav1e3asm3x869transform7forward21daala_fdst_iv_16_asymNtB2_5I32X8EBa_:
  969|   123k|$($s)* fn daala_fdst_iv_16_asym<T: TxOperations>(
  970|   123k|  s0: (T, T), s1h: T, s2: (T, T), s3h: T, s4: (T, T), s5h: T, s6: (T, T),
  971|   123k|  s7h: T, s8: (T, T), s9h: T, sa: (T, T), sbh: T, sc: (T, T), sdh: T,
  972|   123k|  se: (T, T), sfh: T, output: &mut [T],
  973|   123k|) {
  974|   123k|  // Stage 0
  975|   123k|  //   1073/2048 = (Sin[31*Pi/64] + Cos[31*Pi/64])/2 = 0.5239315652662953
  976|   123k|  // 62241/32768 = (Sin[31*Pi/64] - Cos[31*Pi/64])*2 = 1.8994555637555088
  977|   123k|  //   201/16384 = Cos[31*Pi/64]*2                   = 0.0981353486548360
  978|   123k|  let (s0, sf) =
  979|   123k|    RotateAddShift::half_kernel(s0, sfh, ((1073, 11), (62241, 15), (201, 11)));
  980|   123k|  // 18611/32768 = (Sin[29*Pi/64] + Cos[29*Pi/64])/2 = 0.5679534922100714
  981|   123k|  // 55211/32768 = (Sin[29*Pi/64] - Cos[29*Pi/64])*2 = 1.6848920710188384
  982|   123k|  //    601/2048 = Cos[29*Pi/64]*2                   = 0.2934609489107235
  983|   123k|  let (se, s1) = RotateSubShift::half_kernel(
  984|   123k|    se,
  985|   123k|    s1h,
  986|   123k|    ((18611, 15), (55211, 15), (601, 11)),
  987|   123k|  );
  988|   123k|  //  9937/16384 = (Sin[27*Pi/64] + Cos[27*Pi/64])/2 = 0.6065057165489039
  989|   123k|  //   1489/1024 = (Sin[27*Pi/64] - Cos[27*Pi/64])*2 = 1.4541021465825602
  990|   123k|  //   3981/8192 = Cos[27*Pi/64]*2                   = 0.4859603598065277
  991|   123k|  let (s2, sd) =
  992|   123k|    RotateAddShift::half_kernel(s2, sdh, ((9937, 14), (1489, 10), (3981, 13)));
  993|   123k|  // 10473/16384 = (Sin[25*Pi/64] + Cos[25*Pi/64])/2 = 0.6392169592876205
  994|   123k|  // 39627/32768 = (Sin[25*Pi/64] - Cos[25*Pi/64])*2 = 1.2093084235816014
  995|   123k|  // 11039/16384 = Cos[25*Pi/64]*2                   = 0.6737797067844401
  996|   123k|  let (sc, s3) = RotateSubShift::half_kernel(
  997|   123k|    sc,
  998|   123k|    s3h,
  999|   123k|    ((10473, 14), (39627, 15), (11039, 14)),
 1000|   123k|  );
 1001|   123k|  // 2727/4096 = (Sin[23*Pi/64] + Cos[23*Pi/64])/2 = 0.6657721932768628
 1002|   123k|  // 3903/4096 = (Sin[23*Pi/64] - Cos[23*Pi/64])*2 = 0.9528683993863225
 1003|   123k|  // 7005/8192 = Cos[23*Pi/64]*2                   = 0.8551101868605642
 1004|   123k|  let (s4, sb) =
 1005|   123k|    RotateAddShift::half_kernel(s4, sbh, ((2727, 12), (3903, 12), (7005, 13)));
 1006|   123k|  // 5619/8192 = (Sin[21*Pi/64] + Cos[21*Pi/64])/2 = 0.6859156770967569
