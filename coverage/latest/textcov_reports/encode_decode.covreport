  882|   138k|pub fn has_tr(bo: TileBlockOffset, bsize: BlockSize) -> bool {
  883|   138k|  let sb_mi_size = BLOCK_64X64.width_mi(); /* Assume 64x64 for now */
  884|   138k|  let mask_row = bo.0.y & LOCAL_BLOCK_MASK;
  885|   138k|  let mask_col = bo.0.x & LOCAL_BLOCK_MASK;
  886|   138k|  let target_n4_w = bsize.width_mi();
  887|   138k|  let target_n4_h = bsize.height_mi();
  888|   138k|
  889|   138k|  let mut bs = target_n4_w.max(target_n4_h);
  890|   138k|
  891|   138k|  if bs > BLOCK_64X64.width_mi() {
  892|      0|    return false;
  893|   138k|  }
  894|       |
  895|   138k|  let mut has_tr = !((mask_row & bs) != 0 && (mask_col & bs) != 0);
  896|       |
  897|       |  /* TODO: assert its a power of two */
  898|       |
  899|   203k|  while bs < sb_mi_size {
  900|   180k|    if (mask_col & bs) != 0 {
  901|  75.6k|      if (mask_col & (2 * bs) != 0) && (mask_row & (2 * bs) != 0) {
  902|  10.6k|        has_tr = false;
  903|  10.6k|        break;
  904|  65.0k|      }
  905|       |    } else {
  906|   105k|      break;
  907|       |    }
  908|  65.0k|    bs <<= 1;
  909|       |  }
  910|       |
  911|       |  /* The left hand of two vertical rectangles always has a top right (as the
  912|       |   * block above will have been decoded) */
  913|   138k|  if (target_n4_w < target_n4_h) && (bo.0.x & target_n4_w) == 0 {
  914|  6.29k|    has_tr = true;
  915|   132k|  }
  916|       |
  917|       |  /* The bottom of two horizontal rectangles never has a top right (as the block
  918|       |   * to the right won't have been decoded) */
  919|   138k|  if (target_n4_w > target_n4_h) && (bo.0.y & target_n4_h) != 0 {
  920|    906|    has_tr = false;
  921|   137k|  }
  922|       |
  923|       |  /* The bottom left square of a Vertical A (in the old format) does
  924|       |   * not have a top right as it is decoded before the right hand
  925|       |   * rectangle of the partition */
  926|       |  /*
  927|       |    if blk.partition == PartitionType::PARTITION_VERT_A {
  928|       |      if blk.n4_w == blk.n4_h {
  929|       |        if (mask_row & bs) != 0 {
  930|       |          has_tr = false;
  931|       |        }
  932|       |      }
  933|       |    }
  934|       |  */
  935|       |
  936|   138k|  has_tr
  937|   138k|}
