  976|   683k|      cmp::min(target_n4_w, bc.blocks.cols() - bo.0.x),
  977|   683k|      BLOCK_64X64.width_mi(),
  978|   683k|    );
  979|   683k|    let n4_w_8 = BLOCK_8X8.width_mi();
  980|   683k|    let n4_w_16 = BLOCK_16X16.width_mi();
