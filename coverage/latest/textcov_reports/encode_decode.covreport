  178|  4.57M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  4.57M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  4.57M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  4.57M|) -> Distortion {
  182|  4.57M|  // See get_weighted_sse in src/dist.rs.
  183|  4.57M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  4.57M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  4.57M|
  186|  4.57M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  4.57M|  // importance block size in a non-subsampled plane.
  188|  4.57M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  4.57M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  4.57M|
  191|  4.57M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  4.57M|
  193|  4.57M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  4.57M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  4.57M|
  196|  4.57M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  4.57M|  // passed directly. To do this, we would need different versions of the
  198|  4.57M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  4.57M|  // eliminating use of unbiased sse.
  200|  4.57M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  4.57M|
  202|  4.57M|  // Copy biases into a buffer.
  203|  4.57M|  let mut buf_storage = Aligned::new(
  204|  4.57M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  4.57M|  );
  206|  4.57M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  4.57M|  let buf = init_slice_repeat_mut(
  208|  4.57M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  4.57M|    0,
  210|  4.57M|  );
  211|       |
  212|  6.45M|  for block_y in 0..n_imp_blocks_h {
  213|  12.4M|    for block_x in 0..n_imp_blocks_w {
  214|  12.4M|      let block = Area::StartingAt {
  215|  12.4M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  12.4M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  12.4M|      };
  218|  12.4M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  12.4M|    }
  220|       |  }
  221|       |
  222|  4.57M|  Distortion(get_weighted_sse(
  223|  4.57M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  4.57M|  ))
  225|  4.57M|}
