  659|  83.9M|
  660|  83.9M|  // SAFETY: We write to the array below before reading from it.
  661|  83.9M|  let mut edge_buf: Aligned<[T; 4 * MAX_TX_SIZE + 1]> =
  662|  83.9M|    unsafe { Aligned::uninitialized() };
  663|  83.9M|  //Aligned::new([T::cast_from(0); 4 * MAX_TX_SIZE + 1]);
  664|  83.9M|  let base = 128u16 << (bit_depth - 8);
  665|  83.9M|
