  384|   389k|    limit_to_level(cmp::max((p1 - p0).abs(), (q1 - q0).abs()), shift),
  385|   389k|    blimit_to_level((p0 - q0).abs() * 2 + (p1 - q1).abs() / 2, shift),
  386|   389k|  ) as usize
