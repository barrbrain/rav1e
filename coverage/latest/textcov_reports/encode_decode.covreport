 1701|  6.08M|  $($s)* fn reorder_4<T: TxOperations>(
 1702|  6.08M|    output: &mut [T], i: usize, tmp: [T; 64], j: usize
 1703|  6.08M|  ) {
 1704|  6.08M|    output[0 + i * 4] = tmp[0 + j];
 1705|  6.08M|    output[1 + i * 4] = tmp[32 + j];
 1706|  6.08M|    output[2 + i * 4] = tmp[16 + j];
 1707|  6.08M|    output[3 + i * 4] = tmp[48 + j];
 1708|  6.08M|  }
