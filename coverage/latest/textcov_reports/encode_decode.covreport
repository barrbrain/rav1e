  699|  11.6M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  700|  11.6M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  701|  11.6M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  702|  11.6M|  let (r3, r4) =
  703|  11.6M|    RotateSubAvg::kernel(r3, r4, ((669, 9), (8867, 14), (3135, 12)));
  704|  11.6M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  705|  11.6M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  706|  11.6M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  707|  11.6M|  let (r2, r5) =
  708|  11.6M|    RotateNegAvg::kernel(r2, r5, ((669, 9), (8867, 14), (3135, 12)));
