  969|  11.1M|$($s)* fn daala_fdst_iv_16_asym<T: TxOperations>(
  970|  11.1M|  s0: (T, T), s1h: T, s2: (T, T), s3h: T, s4: (T, T), s5h: T, s6: (T, T),
  971|  11.1M|  s7h: T, s8: (T, T), s9h: T, sa: (T, T), sbh: T, sc: (T, T), sdh: T,
  972|  11.1M|  se: (T, T), sfh: T, output: &mut [T],
  973|  11.1M|) {
  974|  11.1M|  // Stage 0
  975|  11.1M|  //   1073/2048 = (Sin[31*Pi/64] + Cos[31*Pi/64])/2 = 0.5239315652662953
  976|  11.1M|  // 62241/32768 = (Sin[31*Pi/64] - Cos[31*Pi/64])*2 = 1.8994555637555088
  977|  11.1M|  //   201/16384 = Cos[31*Pi/64]*2                   = 0.0981353486548360
  978|  11.1M|  let (s0, sf) =
  979|  11.1M|    RotateAddShift::half_kernel(s0, sfh, ((1073, 11), (62241, 15), (201, 11)));
  980|  11.1M|  // 18611/32768 = (Sin[29*Pi/64] + Cos[29*Pi/64])/2 = 0.5679534922100714
  981|  11.1M|  // 55211/32768 = (Sin[29*Pi/64] - Cos[29*Pi/64])*2 = 1.6848920710188384
  982|  11.1M|  //    601/2048 = Cos[29*Pi/64]*2                   = 0.2934609489107235
  983|  11.1M|  let (se, s1) = RotateSubShift::half_kernel(
  984|  11.1M|    se,
  985|  11.1M|    s1h,
  986|  11.1M|    ((18611, 15), (55211, 15), (601, 11)),
  987|  11.1M|  );
  988|  11.1M|  //  9937/16384 = (Sin[27*Pi/64] + Cos[27*Pi/64])/2 = 0.6065057165489039
  989|  11.1M|  //   1489/1024 = (Sin[27*Pi/64] - Cos[27*Pi/64])*2 = 1.4541021465825602
  990|  11.1M|  //   3981/8192 = Cos[27*Pi/64]*2                   = 0.4859603598065277
  991|  11.1M|  let (s2, sd) =
  992|  11.1M|    RotateAddShift::half_kernel(s2, sdh, ((9937, 14), (1489, 10), (3981, 13)));
  993|  11.1M|  // 10473/16384 = (Sin[25*Pi/64] + Cos[25*Pi/64])/2 = 0.6392169592876205
  994|  11.1M|  // 39627/32768 = (Sin[25*Pi/64] - Cos[25*Pi/64])*2 = 1.2093084235816014
  995|  11.1M|  // 11039/16384 = Cos[25*Pi/64]*2                   = 0.6737797067844401
  996|  11.1M|  let (sc, s3) = RotateSubShift::half_kernel(
  997|  11.1M|    sc,
  998|  11.1M|    s3h,
  999|  11.1M|    ((10473, 14), (39627, 15), (11039, 14)),
 1000|  11.1M|  );
 1001|  11.1M|  // 2727/4096 = (Sin[23*Pi/64] + Cos[23*Pi/64])/2 = 0.6657721932768628
 1002|  11.1M|  // 3903/4096 = (Sin[23*Pi/64] - Cos[23*Pi/64])*2 = 0.9528683993863225
 1003|  11.1M|  // 7005/8192 = Cos[23*Pi/64]*2                   = 0.8551101868605642
 1004|  11.1M|  let (s4, sb) =
 1005|  11.1M|    RotateAddShift::half_kernel(s4, sbh, ((2727, 12), (3903, 12), (7005, 13)));
 1006|  11.1M|  // 5619/8192 = (Sin[21*Pi/64] + Cos[21*Pi/64])/2 = 0.6859156770967569
 1007|  11.1M|  // 2815/4096 = (Sin[21*Pi/64] - Cos[21*Pi/64])*2 = 0.6872517316141069
 1008|  11.1M|  // 8423/8192 = Cos[21*Pi/64]*2                   = 1.0282054883864433
 1009|  11.1M|  let (sa, s5) =
 1010|  11.1M|    RotateSubShift::half_kernel(sa, s5h, ((5619, 13), (2815, 12), (8423, 13)));
 1011|  11.1M|  //   2865/4096 = (Sin[19*Pi/64] + Cos[19*Pi/64])/2 = 0.6994534179865391
 1012|  11.1M|  // 13588/32768 = (Sin[19*Pi/64] - Cos[19*Pi/64])*2 = 0.4150164539764232
 1013|  11.1M|  //     305/256 = Cos[19*Pi/64]*2                   = 1.1913986089848667
 1014|  11.1M|  let (s6, s9) =
 1015|  11.1M|    RotateAddShift::half_kernel(s6, s9h, ((2865, 12), (13599, 15), (305, 8)));
 1016|  11.1M|  // 23143/32768 = (Sin[17*Pi/64] + Cos[17*Pi/64])/2 = 0.7062550401009887
 1017|  11.1M|  //   1137/8192 = (Sin[17*Pi/64] - Cos[17*Pi/64])*2 = 0.1387843410158816
 1018|  11.1M|  //  11003/8192 = Cos[17*Pi/64]*2                   = 1.3431179096940367
 1019|  11.1M|  let (s8, s7) = RotateSubShift::half_kernel(
 1020|  11.1M|    s8,
 1021|  11.1M|    s7h,
 1022|  11.1M|    ((23143, 15), (1137, 13), (11003, 13)),
 1023|  11.1M|  );
 1024|  11.1M|
 1025|  11.1M|  // Stage 1
 1026|  11.1M|  let (s0, s7) = butterfly_sub_asym((s0.rshift1(), s0), s7);
 1027|  11.1M|  let (s8, sf) = butterfly_sub_asym((s8.rshift1(), s8), sf);
 1028|  11.1M|  let (s4, s3) = butterfly_add_asym((s4.rshift1(), s4), s3);
 1029|  11.1M|  let (sc, sb) = butterfly_add_asym((sc.rshift1(), sc), sb);
 1030|  11.1M|  let (s2, s5) = butterfly_sub_asym((s2.rshift1(), s2), s5);
 1031|  11.1M|  let (sa, sd) = butterfly_sub_asym((sa.rshift1(), sa), sd);
 1032|  11.1M|  let (s6, s1) = butterfly_add_asym((s6.rshift1(), s6), s1);
 1033|  11.1M|  let (se, s9) = butterfly_add_asym((se.rshift1(), se), s9);
 1034|  11.1M|
 1035|  11.1M|  // Stage 2
 1036|  11.1M|  let ((_s8h, s8), s4h) = butterfly_add(s8, s4);
 1037|  11.1M|  let ((_s7h, s7), sbh) = butterfly_add(s7, sb);
 1038|  11.1M|  let ((_sah, sa), s6h) = butterfly_sub(sa, s6);
 1039|  11.1M|  let ((_s5h, s5), s9h) = butterfly_sub(s5, s9);
 1040|  11.1M|  let (s0, s3h) = butterfly_add(s0, s3);
 1041|  11.1M|  let (sd, seh) = butterfly_add(sd, se);
 1042|  11.1M|  let (s2, s1h) = butterfly_sub(s2, s1);
 1043|  11.1M|  let (sf, sch) = butterfly_sub(sf, sc);
 1044|  11.1M|
 1045|  11.1M|  // Stage 3
 1046|  11.1M|  //   9633/8192 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1047|  11.1M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1048|  11.1M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1049|  11.1M|  let (s8, s7) =
 1050|  11.1M|    RotateAdd::kernel(s8, s7, ((9633, 13), (12873, 14), (6393, 15)));
 1051|  11.1M|  // 22725/16384 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1052|  11.1M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1053|  11.1M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1054|  11.1M|  let (s9, s6) =
 1055|  11.1M|    RotateAdd::kernel(s9h, s6h, ((22725, 14), (9041, 15), (4551, 13)));
 1056|  11.1M|  //  11363/8192 = Sin[5*Pi/16] + Cos[5*Pi/16] = 1.3870398453221475
 1057|  11.1M|  //  9041/32768 = Sin[5*Pi/16] - Cos[5*Pi/16] = 0.2758993792829431
 1058|  11.1M|  //   4551/8192 = Cos[5*Pi/16]                = 0.5555702330196022
 1059|  11.1M|  let (s5, sa) =
 1060|  11.1M|    RotateNeg::kernel(s5, sa, ((11363, 13), (9041, 15), (4551, 13)));
 1061|  11.1M|  //  9633/32768 = Sin[7*Pi/16] + Cos[7*Pi/16] = 1.1758756024193586
 1062|  11.1M|  // 12873/16384 = Sin[7*Pi/16] - Cos[7*Pi/16] = 0.7856949583871022
 1063|  11.1M|  //  6393/32768 = Cos[7*Pi/16]                = 0.1950903220161283
 1064|  11.1M|  let (s4, sb) =
 1065|  11.1M|    RotateNeg::kernel(s4h, sbh, ((9633, 13), (12873, 14), (6393, 15)));
 1066|  11.1M|
 1067|  11.1M|  // Stage 4
 1068|  11.1M|  let (s2, sc) = butterfly_add_asym(s2, sch);
 1069|  11.1M|  let (s0, s1) = butterfly_sub_asym(s0, s1h);
 1070|  11.1M|  let (sf, se) = butterfly_add_asym(sf, seh);
 1071|  11.1M|  let (sd, s3) = butterfly_add_asym(sd, s3h);
 1072|  11.1M|  let (s7, s6) = butterfly_add_asym((s7.rshift1(), s7), s6);
 1073|  11.1M|  let (s8, s9) = butterfly_sub_asym((s8.rshift1(), s8), s9);
 1074|  11.1M|  let (sa, sb) = butterfly_sub_asym((sa.rshift1(), sa), sb);
 1075|  11.1M|  let (s5, s4) = butterfly_add_asym((s5.rshift1(), s5), s4);
 1076|  11.1M|
 1077|  11.1M|  // Stage 5
 1078|  11.1M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
 1079|  11.1M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1080|  11.1M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1081|  11.1M|  let (sc, s3) =
 1082|  11.1M|    RotateAdd::kernel(sc, s3, ((10703, 13), (8867, 14), (3135, 13)));
 1083|  11.1M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3870398453221475
 1084|  11.1M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
 1085|  11.1M|  //  3135/8192 = Cos[3*Pi/8]               = 0.3826834323650898
 1086|  11.1M|  let (s2, sd) =
 1087|  11.1M|    RotateNeg::kernel(s2, sd, ((10703, 13), (8867, 14), (3135, 13)));
 1088|  11.1M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1089|  11.1M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1090|  11.1M|  let (sa, s5) = RotatePi4Add::kernel(sa, s5, ((11585, 13), (5793, 13)));
 1091|  11.1M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1092|  11.1M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1093|  11.1M|  let (s6, s9) = RotatePi4Add::kernel(s6, s9, ((11585, 13), (5793, 13)));
 1094|  11.1M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
 1095|  11.1M|  //  5793/8192 = Cos[Pi/4]             = 0.7071067811865475
 1096|  11.1M|  let (se, s1) = RotatePi4Add::kernel(se, s1, ((11585, 13), (5793, 13)));
