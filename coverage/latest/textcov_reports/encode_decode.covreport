  200|     40|        >> 24) as i32;
  201|     40|    self.x[1] = self.x[0];
  202|     40|    self.x[0] = x;
  203|     40|    self.y[1] = self.y[0];
  204|     40|    self.y[0] = ya;
  205|     40|    ya
  206|     40|  }
