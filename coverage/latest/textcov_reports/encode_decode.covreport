  426|  66.2M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4]  = 1.4142135623730951
  427|  66.2M|  // 11585/8192 = 2*Cos[Pi/4]            = 1.4142135623730951
  428|  66.2M|  let (p1, p0) = RotatePi4SubAvg::kernel(p1, p0, ((11585, 13), (11585, 13)));
  429|  66.2M|  (p0, p1)
  430|  66.2M|}
_RNvYNtNtNtNtNtCs19TYAUSqLvI_5rav1e3asm3x869transform7forward14RotateAddShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   198M|  $($s)* fn half_kernel(
  219|   198M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   198M|  ) -> (T, T) {
  221|   198M|    let t = Self::ADD(p1, p0.0);
  222|   198M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   198M|    let out0 = b.add(c);
  224|   198M|    let shifted = Self::SHIFT(c);
  225|   198M|    let out1 = Self::SUB(a, shifted);
  226|   198M|    (out0, out1)
  227|   198M|  }
