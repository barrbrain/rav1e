  532|  19.8M|$($s)* fn daala_fdst_iv_8<T: TxOperations>(
  533|  19.8M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  534|  19.8M|) {
  535|  19.8M|  // Stage 0
  536|  19.8M|  // 17911/16384 = Sin[15*Pi/32] + Cos[15*Pi/32] = 1.0932018670017576
  537|  19.8M|  // 14699/16384 = Sin[15*Pi/32] - Cos[15*Pi/32] = 0.8971675863426363
  538|  19.8M|  //    803/8192 = Cos[15*Pi/32]                 = 0.0980171403295606
  539|  19.8M|  let (r0, r7) =
  540|  19.8M|    RotateAdd::kernel(r0, r7, ((17911, 14), (14699, 14), (803, 13)));
  541|  19.8M|  // 20435/16384 = Sin[13*Pi/32] + Cos[13*Pi/32] = 1.24722501298667123
  542|  19.8M|  // 21845/32768 = Sin[13*Pi/32] - Cos[13*Pi/32] = 0.66665565847774650
  543|  19.8M|  //   1189/4096 = Cos[13*Pi/32]                 = 0.29028467725446233
  544|  19.8M|  let (r6, r1) =
  545|  19.8M|    RotateSub::kernel(r6, r1, ((20435, 14), (21845, 15), (1189, 12)));
  546|  19.8M|  // 22173/16384 = Sin[11*Pi/32] + Cos[11*Pi/32] = 1.3533180011743526
  547|  19.8M|  //   3363/8192 = Sin[11*Pi/32] - Cos[11*Pi/32] = 0.4105245275223574
  548|  19.8M|  // 15447/32768 = Cos[11*Pi/32]                 = 0.47139673682599764
  549|  19.8M|  let (r2, r5) =
  550|  19.8M|    RotateAdd::kernel(r2, r5, ((22173, 14), (3363, 13), (15447, 15)));
  551|  19.8M|  // 23059/16384 = Sin[9*Pi/32] + Cos[9*Pi/32] = 1.4074037375263826
  552|  19.8M|  //  2271/16384 = Sin[9*Pi/32] - Cos[9*Pi/32] = 0.1386171691990915
  553|  19.8M|  //   5197/8192 = Cos[9*Pi/32]                = 0.6343932841636455
  554|  19.8M|  let (r4, r3) =
  555|  19.8M|    RotateSub::kernel(r4, r3, ((23059, 14), (2271, 14), (5197, 13)));
  556|  19.8M|
  557|  19.8M|  // Stage 1
  558|  19.8M|  let (r0, r3h) = butterfly_add(r0, r3);
  559|  19.8M|  let (r2, r1h) = butterfly_sub(r2, r1);
  560|  19.8M|  let (r5, r6h) = butterfly_add(r5, r6);
  561|  19.8M|  let (r7, r4h) = butterfly_sub(r7, r4);
  562|  19.8M|
  563|  19.8M|  // Stage 2
  564|  19.8M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  565|  19.8M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  566|  19.8M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  567|  19.8M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  568|  19.8M|
  569|  19.8M|  // Stage 3
  570|  19.8M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  571|  19.8M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  572|  19.8M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  573|  19.8M|  let (r3, r4) =
  574|  19.8M|    RotateSubAvg::kernel(r3, r4, ((10703, 13), (8867, 14), (3135, 12)));
  575|  19.8M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  576|  19.8M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  577|  19.8M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  578|  19.8M|  let (r2, r5) =
  579|  19.8M|    RotateNegAvg::kernel(r2, r5, ((10703, 13), (8867, 14), (3135, 12)));
  580|  19.8M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  581|  19.8M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  582|  19.8M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((11585, 13), (11585, 13)));
  583|  19.8M|
  584|  19.8M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  585|  19.8M|}
