  169|  2.17k|    }
  170|  2.87k|    Some(k as usize)
  171|  2.87k|  }
_RNvMNtNtCsixsdkNzQ5tW_5rav1e6tiling5tilerNtB2_10TilingInfo17from_target_tiles:
   56|    319|  pub fn from_target_tiles(
   57|    319|    sb_size_log2: usize, frame_width: usize, frame_height: usize,
   58|    319|    frame_rate: f64, tile_cols_log2: usize, tile_rows_log2: usize,
   59|    319|    is_422_p: bool,
   60|    319|  ) -> Self {
   61|    319|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    319|
   63|    319|    // Frame::new() aligns to the next multiple of 8
   64|    319|    let frame_width = frame_width.align_power_of_two(3);
   65|    319|    let frame_height = frame_height.align_power_of_two(3);
   66|    319|    let frame_width_sb =
   67|    319|      frame_width.align_power_of_two_and_shift(sb_size_log2);
   68|    319|    let frame_height_sb =
   69|    319|      frame_height.align_power_of_two_and_shift(sb_size_log2);
   70|    319|    let sb_cols = frame_width.align_power_of_two_and_shift(sb_size_log2);
   71|    319|    let sb_rows = frame_height.align_power_of_two_and_shift(sb_size_log2);
   72|    319|
   73|    319|    // these are bitstream-defined values and must not be changed
   74|    319|    let max_tile_width_sb = MAX_TILE_WIDTH >> sb_size_log2;
   75|    319|    let max_tile_area_sb = MAX_TILE_AREA >> (2 * sb_size_log2);
   76|    319|    let min_tile_cols_log2 =
   77|    319|      Self::tile_log2(max_tile_width_sb, sb_cols).unwrap();
   78|    319|    let max_tile_cols_log2 =
   79|    319|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    319|    let max_tile_rows_log2 =
   81|    319|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    319|    let min_tiles_log2 = min_tile_cols_log2
   83|    319|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    319|
   85|    319|    // Implements restriction in Annex A of the spec.
   86|    319|    // Unlike the other restrictions, this one does not change
   87|    319|    // the header coding of the tile rows/cols.
   88|    319|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    319|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    319|        .ceil()
   91|    319|        .log2()
   92|    319|        .ceil() as usize,
   93|    319|    );
   94|    319|
   95|    319|    let tile_cols_log2 =
   96|    319|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    319|    let tile_width_sb_pre =
   98|    319|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
  100|       |    // If this is 4:2:2, our UV horizontal is subsampled but not our
  101|       |    // vertical.  Loop Restoration Units must be square, so they
  102|       |    // will always have an even number of horizontal superblocks. For
  103|       |    // tiles and LRUs to align, tile_width_sb must be even in 4:2:2
  104|       |    // video.
  105|       |
  106|       |    // This is only relevant when doing loop restoration RDO inline
  107|       |    // with block/superblock encoding, that is, where tiles are
  108|       |    // relevant.  If (when) we introduce optionally delaying loop-filter
  109|       |    // encode to after the partitioning loop, we won't need to make
  110|       |    // any 4:2:2 adjustment.
  111|       |
  112|    319|    let tile_width_sb = if is_422_p {
  113|     45|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    274|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    319|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    319|
  120|    319|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    319|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    319|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    319|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    319|      0
  128|       |    };
  129|    319|    let min_tile_rows_ratelimit_log2 =
  130|    319|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    319|        0
  134|       |      };
  135|    319|    let tile_rows_log2 = tile_rows_log2
  136|    319|      .max(min_tile_rows_log2)
  137|    319|      .max(min_tile_rows_ratelimit_log2)
  138|    319|      .min(max_tile_rows_log2);
  139|    319|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    319|
  141|    319|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    319|
  143|    319|    Self {
  144|    319|      frame_width,
  145|    319|      frame_height,
  146|    319|      tile_width_sb,
  147|    319|      tile_height_sb,
  148|    319|      cols,
  149|    319|      rows,
  150|    319|      tile_cols_log2,
  151|    319|      tile_rows_log2,
  152|    319|      min_tile_cols_log2,
  153|    319|      max_tile_cols_log2,
  154|    319|      min_tile_rows_log2,
  155|    319|      max_tile_rows_log2,
  156|    319|      sb_size_log2,
  157|    319|      min_tiles_log2,
  158|    319|    }
  159|    319|  }

