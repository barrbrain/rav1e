  614|  15.6M|$($s)* fn daala_fdst_iv_4<T: TxOperations>(
  615|  15.6M|  q0: T, q1: T, q2: T, q3: T, output: &mut [T],
  616|  15.6M|) {
  617|  15.6M|  // Stage 0
  618|  15.6M|  // 13623/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/Sqrt[2] = 0.831469612302545
  619|  15.6M|  //   4551/4096 = (Sin[7*Pi/16] - Cos[7*Pi/16])*Sqrt[2] = 1.111140466039204
  620|  15.6M|  //  9041/32768 = Cos[7*Pi/16]*Sqrt[2]                  = 0.275899379282943
  621|  15.6M|  let (q0, q3) =
  622|  15.6M|    RotateAddShift::kernel(q0, q3, ((13623, 14), (4551, 12), (565, 11)));
  623|  15.6M|  // 16069/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/Sqrt[2] = 0.9807852804032304
  624|  15.6M|  // 12785/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*Sqrt[2] = 0.3901806440322566
  625|  15.6M|  //   1609/2048 = Cos[5*Pi/16]*Sqrt[2]                  = 0.7856949583871021
  626|  15.6M|  let (q2, q1) =
  627|  15.6M|    RotateSubShift::kernel(q2, q1, ((16069, 14), (12785, 15), (1609, 11)));
  628|  15.6M|
  629|  15.6M|  // Stage 1
  630|  15.6M|  let (q2, q3) = butterfly_sub_asym((q2.rshift1(), q2), q3);
  631|  15.6M|  let (q0, q1) = butterfly_sub_asym((q0.rshift1(), q0), q1);
  632|  15.6M|
  633|  15.6M|  // Stage 2
  634|  15.6M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  635|  15.6M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  636|  15.6M|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  637|  15.6M|
  638|  15.6M|  store_coeffs!(output, q0, q1, q2, q3);
  639|  15.6M|}
