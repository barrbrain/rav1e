_RINvNtCs19TYAUSqLvI_5rav1e7deblock12sse_optimizehEB4_:
 1572|  5.48k|fn sse_optimize<T: Pixel>(
 1573|  5.48k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  5.48k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  5.48k|) -> [u8; 4] {
 1576|  5.48k|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|  5.48k|  assert!(
 1578|  5.48k|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|  5.48k|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|  5.48k|      < 35
 1581|  5.48k|  );
 1582|  5.48k|  let mut level = [0; 4];
 1583|  5.48k|  let planes = if monochrome { 1 } else { MAX_PLANES };
 1584|       |
 1585|  13.8k|  for pli in 0..planes {
 1586|  13.8k|    let mut v_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1587|  13.8k|    let mut h_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1588|  13.8k|
 1589|  13.8k|    sse_plane(
 1590|  13.8k|      &rec.planes[pli],
 1591|  13.8k|      &input.planes[pli],
 1592|  13.8k|      &mut v_tally,
 1593|  13.8k|      &mut h_tally,
 1594|  13.8k|      pli,
 1595|  13.8k|      blocks,
 1596|  13.8k|      crop_w,
 1597|  13.8k|      crop_h,
 1598|  13.8k|      bd,
 1599|  13.8k|    );
 1600|       |
 1601|   887k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   873k|      v_tally[i] += v_tally[i - 1];
 1603|   873k|      h_tally[i] += h_tally[i - 1];
 1604|   873k|    }
 1605|       |
 1606|  13.8k|    match pli {
 1607|       |      0 => {
 1608|  5.48k|        let mut best_v = 999;
 1609|  5.48k|        let mut best_h = 999;
 1610|   356k|        for i in 0..=MAX_LOOP_FILTER {
 1611|   350k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  9.84k|            best_v = i;
 1613|   340k|          };
 1614|   350k|          if best_h == 999 || h_tally[best_h] > h_tally[i] {
 1615|  9.68k|            best_h = i;
 1616|   341k|          };
 1617|       |        }
 1618|  5.48k|        level[0] = best_v as u8;
 1619|  5.48k|        level[1] = best_h as u8;
 1620|       |      }
 1621|       |      1 | 2 => {
 1622|  8.38k|        let mut best = 999;
 1623|   545k|        for i in 0..=MAX_LOOP_FILTER {
 1624|   536k|          if best == 999
 1625|   528k|            || v_tally[best] + h_tally[best] > v_tally[i] + h_tally[i]
 1626|  12.6k|          {
 1627|  12.6k|            best = i;
 1628|   524k|          };
 1629|       |        }
 1630|  8.38k|        level[pli + 1] = best as u8;
 1631|       |      }
 1632|      0|      _ => unreachable!(),
 1633|       |    }
 1634|       |  }
 1635|  5.48k|  level
 1636|  5.48k|}
