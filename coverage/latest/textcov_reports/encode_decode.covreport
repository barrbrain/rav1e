  116|   534M|
  117|   534M|    // TODO: Since log_tx_scale is at most 2 and we gain an extra bit by taking
  118|   534M|    // the abs value (unless the range is [-(2^15), 2^15 + 1]), it might be
  119|   534M|    // possible to perform a 16-bit multiply and get the highest bit by
  120|   534M|    // comparing coeffs to (1<<16) / quant. The would cost 1 compare, 1 blend,
  121|   534M|    // and 1 add, but would get rid of 1 pack, 2 unpacks, 1 shift, and 1
  122|   534M|    // multiply.
  123|   534M|
  124|   534M|    let rcoeffs = _mm256_sign_epi16(
  125|   534M|      _mm256_packs_epi32(
  126|   534M|        // (abs_coeff * quant) >> log_tx_scale
  127|   534M|        _mm256_srlv_epi32(
  128|   534M|          _mm256_madd_epi16(
  129|   534M|            quants,
  130|   534M|            // Convert the first half of each lane to 32-bits
  131|   534M|            _mm256_unpacklo_epi16(coeffs_abs, _mm256_setzero_si256()),
  132|   534M|          ),
  133|   534M|          log_tx_scale,
  134|   534M|        ),
  135|   534M|        // Second half
  136|   534M|        _mm256_srlv_epi32(
  137|   534M|          _mm256_madd_epi16(
  138|   534M|            quants_ac,
  139|   534M|            _mm256_unpackhi_epi16(coeffs_abs, _mm256_setzero_si256()),
  140|   534M|          ),
  141|   534M|          log_tx_scale,
  142|   534M|        ),
  143|   534M|      ),
  144|   534M|      coeffs,
  145|   534M|    );
