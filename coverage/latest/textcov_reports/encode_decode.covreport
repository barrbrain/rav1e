_RNvMs3_NtCsixsdkNzQ5tW_5rav1e4rateNtB5_7RCState12update_state:
 1084|    940|  pub fn update_state(
 1085|    940|    &mut self, bits: i64, fti: usize, show_frame: bool, log_target_q: i64,
 1086|    940|    trial: bool, droppable: bool,
 1087|    940|  ) -> bool {
 1088|    940|    if trial {
 1089|    416|      assert!(self.needs_trial_encode(fti));
 1090|    416|      assert!(bits > 0);
 1091|    524|    }
 1092|    940|    let mut dropped = false;
 1093|    940|    // Update rate control only if rate control is active.
 1094|    940|    if self.target_bitrate > 0 {
 1095|    872|      let mut estimated_bits = 0;
 1096|    872|      let mut bits = bits;
 1097|    872|      let mut droppable = droppable;
 1098|    872|      let mut log_scale = q57(-64);
 1099|    872|      // Drop frames is also disabled for now in the case of infinite-buffer
