  178|  62.9k|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  62.9k|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  62.9k|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  62.9k|) -> Distortion {
  182|  62.9k|  // See get_weighted_sse in src/dist.rs.
  183|  62.9k|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  62.9k|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  62.9k|
  186|  62.9k|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  62.9k|  // importance block size in a non-subsampled plane.
  188|  62.9k|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  62.9k|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  62.9k|
  191|  62.9k|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  62.9k|
  193|  62.9k|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  62.9k|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  62.9k|
  196|  62.9k|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  62.9k|  // passed directly. To do this, we would need different versions of the
  198|  62.9k|  // weighted sse function for decimated/subsampled data. Also requires
  199|  62.9k|  // eliminating use of unbiased sse.
  200|  62.9k|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  62.9k|
  202|  62.9k|  // Copy biases into a buffer.
  203|  62.9k|  let mut buf_storage = Aligned::new(
  204|  62.9k|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  62.9k|  );
  206|  62.9k|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  62.9k|  let buf = init_slice_repeat_mut(
  208|  62.9k|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  62.9k|    0,
  210|  62.9k|  );
  211|       |
  212|   115k|  for block_y in 0..n_imp_blocks_h {
  213|   143k|    for block_x in 0..n_imp_blocks_w {
  214|   143k|      let block = Area::StartingAt {
  215|   143k|        x: (block_x * CHUNK_SIZE) as isize,
  216|   143k|        y: (block_y * CHUNK_SIZE) as isize,
  217|   143k|      };
  218|   143k|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|   143k|    }
  220|       |  }
  221|       |
  222|  62.9k|  Distortion(get_weighted_sse(
  223|  62.9k|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  62.9k|  ))
  225|  62.9k|}
