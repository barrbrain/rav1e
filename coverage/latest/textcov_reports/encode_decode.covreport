 1404|  4.58k|fn get_subpel_mv_rd<T: Pixel>(
 1405|  4.58k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1406|  4.58k|  bit_depth: usize, pmv: [MotionVector; 2], lambda: u32, use_satd: bool,
 1407|  4.58k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1408|  4.58k|  h: usize, cand_mv: MotionVector, tmp_region: &mut PlaneRegionMut<T>,
 1409|  4.58k|  ref_frame: RefType,
 1410|  4.58k|) -> MVCandidateRD {
 1411|  4.58k|  if (cand_mv.col as isize) < mvx_min
 1412|  4.58k|    || (cand_mv.col as isize) > mvx_max
 1413|  4.58k|    || (cand_mv.row as isize) < mvy_min
 1414|  4.58k|    || (cand_mv.row as isize) > mvy_max
 1415|       |  {
 1416|      0|    return MVCandidateRD::empty();
 1417|  4.58k|  }
 1418|  4.58k|
 1419|  4.58k|  let tmp_width = tmp_region.rect().width;
 1420|  4.58k|  let tmp_height = tmp_region.rect().height;
 1421|  4.58k|  let tile_rect =
 1422|  4.58k|    TileRect { x: 0, y: 0, width: tmp_width, height: tmp_height };
 1423|  4.58k|
 1424|  4.58k|  PredictionMode::NEWMV.predict_inter_single(
 1425|  4.58k|    fi, tile_rect, 0, po, tmp_region,
 1426|  4.58k|    // motion comp's w & h on edges can be different than distortion's
 1427|  4.58k|    tmp_width, tmp_height, ref_frame, cand_mv,
 1428|  4.58k|  );
 1429|  4.58k|  let plane_ref = tmp_region.as_const();
 1430|  4.58k|  compute_mv_rd(
 1431|  4.58k|    fi, pmv, lambda, use_satd, bit_depth, w, h, cand_mv, org_region,
 1432|  4.58k|    &plane_ref,
 1433|  4.58k|  )
 1434|  4.58k|}
_RINvNtCsgzd1EjkjF4V_5rav1e2me13compute_mv_rdhEB4_:
 1438|  17.8k|fn compute_mv_rd<T: Pixel>(
 1439|  17.8k|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  17.8k|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  17.8k|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  17.8k|) -> MVCandidateRD {
 1443|  17.8k|  let sad = if use_satd {
 1444|  4.86k|    get_satd(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1445|       |  } else {
 1446|  13.0k|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  17.8k|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  17.8k|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  17.8k|  let rate = rate1.min(rate2 + 1);
 1452|  17.8k|
 1453|  17.8k|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
 1454|  17.8k|}
