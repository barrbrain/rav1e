 2178|   465k|pub fn luma_ac<T: Pixel>(
 2179|   465k|  ac: &mut [i16], ts: &mut TileStateMut<'_, T>, tile_bo: TileBlockOffset,
 2180|   465k|  bsize: BlockSize, tx_size: TxSize, fi: &FrameInvariants<T>,
 2181|   465k|) {
 2182|   465k|  let PlaneConfig { xdec, ydec, .. } = ts.input.planes[1].cfg;
 2183|   465k|  let plane_bsize = bsize.subsampled_size(xdec, ydec).unwrap();
