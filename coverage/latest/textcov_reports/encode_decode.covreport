   40|      0|      if let Some(func) = INV_TXFM_HBD_FNS_10[cpu.as_index()]
   41|      0|        [get_tx_size_idx(tx_size)][get_tx_type_idx(tx_type)]
   42|       |      {
   43|      0|        return call_inverse_hbd_func(
   44|      0|          func,
   45|      0|          input,
   46|      0|          output,
   47|      0|          eob,
   48|      0|          tx_size.width(),
   49|      0|          tx_size.height(),
   50|      0|          bd,
   51|      0|        );
   52|      0|      }
   53|       |    }
   54|      0|    PixelType::U16 => {}
