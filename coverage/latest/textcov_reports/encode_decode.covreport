  296|  2.96M|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  2.96M|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  2.96M|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  2.96M|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  2.96M|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  2.96M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  2.96M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  2.96M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  2.96M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|  16.2M|    for j in 0..h {
  319|  16.2M|      let row1 = &src[j][0..w];
  320|  16.2M|      let row2 = &dst[j][0..w];
  321|  79.7M|      for (s, d) in row1.iter().zip(row2) {
  322|  79.7M|        let s: u32 = u32::cast_from(*s);
  323|  79.7M|        let d: u32 = u32::cast_from(*d);
  324|  79.7M|        sum_s += s;
  325|  79.7M|        sum_d += d;
  326|  79.7M|
  327|  79.7M|        sum_s2 += s * s;
  328|  79.7M|        sum_d2 += d * d;
  329|  79.7M|        sum_sd += s * d;
  330|  79.7M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  2.96M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  2.96M|
  337|  2.96M|    // Convert to 64-bits to avoid overflow when squaring
