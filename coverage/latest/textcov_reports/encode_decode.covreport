_RINvNtCs5T1csxkeGwJ_5rav1e7deblock12sse_optimizehEB4_:
 1572|  3.70k|fn sse_optimize<T: Pixel>(
 1573|  3.70k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  3.70k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  3.70k|) -> [u8; 4] {
 1576|  3.70k|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|  3.70k|  assert!(
 1578|  3.70k|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|  3.70k|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|  3.70k|      < 35
 1581|  3.70k|  );
 1582|  3.70k|  let mut level = [0; 4];
 1583|  3.70k|  let planes = if monochrome { 1 } else { MAX_PLANES };
 1584|       |
 1585|  9.35k|  for pli in 0..planes {
 1586|  9.35k|    let mut v_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1587|  9.35k|    let mut h_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1588|  9.35k|
 1589|  9.35k|    sse_plane(
 1590|  9.35k|      &rec.planes[pli],
 1591|  9.35k|      &input.planes[pli],
 1592|  9.35k|      &mut v_tally,
 1593|  9.35k|      &mut h_tally,
 1594|  9.35k|      pli,
 1595|  9.35k|      blocks,
 1596|  9.35k|      crop_w,
 1597|  9.35k|      crop_h,
 1598|  9.35k|      bd,
 1599|  9.35k|    );
 1600|       |
 1601|   598k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   589k|      v_tally[i] += v_tally[i - 1];
 1603|   589k|      h_tally[i] += h_tally[i - 1];
 1604|   589k|    }
 1605|       |
 1606|  9.35k|    match pli {
 1607|       |      0 => {
 1608|  3.70k|        let mut best_v = 999;
 1609|  3.70k|        let mut best_h = 999;
 1610|   240k|        for i in 0..=MAX_LOOP_FILTER {
 1611|   236k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  5.97k|            best_v = i;
 1613|   230k|          };
 1614|   236k|          if best_h == 999 || h_tally[best_h] > h_tally[i] {
 1615|  5.88k|            best_h = i;
 1616|   230k|          };
 1617|       |        }
 1618|  3.70k|        level[0] = best_v as u8;
 1619|  3.70k|        level[1] = best_h as u8;
 1620|       |      }
 1621|       |      1 | 2 => {
 1622|  5.65k|        let mut best = 999;
 1623|   367k|        for i in 0..=MAX_LOOP_FILTER {
 1624|   361k|          if best == 999
 1625|   355k|            || v_tally[best] + h_tally[best] > v_tally[i] + h_tally[i]
 1626|  7.32k|          {
 1627|  7.32k|            best = i;
 1628|   354k|          };
 1629|       |        }
 1630|  5.65k|        level[pli + 1] = best as u8;
 1631|       |      }
 1632|      0|      _ => unreachable!(),
 1633|       |    }
 1634|       |  }
 1635|  3.70k|  level
 1636|  3.70k|}
