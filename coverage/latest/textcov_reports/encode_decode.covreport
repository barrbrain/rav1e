 1471|   218k|  for vert_window in search_region.vert_windows(h).step_by(step) {
 1472|  6.29M|    for ref_window in vert_window.horz_windows(w).step_by(step) {
 1473|  6.29M|      let &Rect { x, y, .. } = ref_window.rect();
 1474|  6.29M|
 1475|  6.29M|      let mv = MotionVector {
 1476|  6.29M|        row: 8 * (y as i16 - po.y as i16),
 1477|  6.29M|        col: 8 * (x as i16 - po.x as i16),
 1478|  6.29M|      };
 1479|  6.29M|
 1480|  6.29M|      let rd = compute_mv_rd(
 1481|  6.29M|        fi,
 1482|  6.29M|        pmv,
 1483|  6.29M|        lambda,
 1484|  6.29M|        false,
 1485|  6.29M|        fi.sequence.bit_depth,
 1486|  6.29M|        w,
 1487|  6.29M|        h,
 1488|  6.29M|        mv,
 1489|  6.29M|        org_region,
 1490|  6.29M|        &ref_window,
 1491|  6.29M|      );
 1492|  6.29M|
 1493|  6.29M|      if rd.cost < best.rd.cost {
 1494|   139k|        best.rd = rd;
 1495|   139k|        best.mv = mv;
 1496|  6.15M|      }
 1497|       |    }
 1498|       |  }
