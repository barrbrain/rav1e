  524|  21.7k|  stripe_h: usize, cdeffed: &PlaneSlice<T>, deblocked: &PlaneSlice<T>,
  525|  21.7k|) {
  526|  21.7k|  let integral_image = &mut integral_image_buffer.integral_image;
  527|  21.7k|  let sq_integral_image = &mut integral_image_buffer.sq_integral_image;
  528|  21.7k|
