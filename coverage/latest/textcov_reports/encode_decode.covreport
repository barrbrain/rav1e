   76|    125|    grain_table: Option<Vec<GrainTableSegment>>,
   77|    125|  ) {
   78|    125|    let mut ra = ChaChaRng::from_seed([0; 32]);
   79|    125|
   80|    125|    let mut ctx: Context<T> = setup_encoder(
   81|    125|      w,
   82|    125|      h,
   83|    125|      speed,
   84|    125|      quantizer,
   85|    125|      bit_depth,
   86|    125|      chroma_sampling,
   87|    125|      min_keyint,
   88|    125|      max_keyint,
