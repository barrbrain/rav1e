_RINvNtNtCsgLNdNkfkEgK_5rav1e11scenechange4fast19detect_scale_factorhEB6_:
  116|    125|pub(super) fn detect_scale_factor<T: Pixel>(
  117|    125|  sequence: &Arc<Sequence>, speed_mode: SceneDetectionSpeed,
  118|    125|) -> Option<ScaleFunction<T>> {
  119|    125|  let small_edge =
  120|    125|    cmp::min(sequence.max_frame_height, sequence.max_frame_width) as usize;
  121|    125|  let scale_func = if speed_mode == SceneDetectionSpeed::Fast {
  122|     65|    match small_edge {
  123|     65|      0..=240 => None,
  124|     13|      241..=480 => Some(ScaleFunction::from_scale::<2>()),
  125|      0|      481..=720 => Some(ScaleFunction::from_scale::<4>()),
  126|      0|      721..=1080 => Some(ScaleFunction::from_scale::<8>()),
  127|      0|      1081..=1600 => Some(ScaleFunction::from_scale::<16>()),
  128|      0|      1601..=usize::MAX => Some(ScaleFunction::from_scale::<32>()),
  129|      0|      _ => None,
  130|       |    }
  131|       |  } else {
  132|     60|    None
  133|       |  };
  134|       |
  135|    125|  if let Some(scale_factor) = scale_func.as_ref().map(|x| x.factor) {
  136|     13|    debug!(
  137|      0|      "Scene detection scale factor {}, [{},{}] -> [{},{}]",
  138|      0|      scale_factor,
  139|      0|      sequence.max_frame_width,
  140|      0|      sequence.max_frame_height,
  141|      0|      // SAFETY: We ensure that scale_factor is set based on nonzero powers of 2.
  142|      0|      unsafe { fast_idiv(sequence.max_frame_width as usize, scale_factor) },
  143|      0|      unsafe { fast_idiv(sequence.max_frame_height as usize, scale_factor) }
  144|       |    );
  145|    112|  }
  146|       |
