  747|       |
  748|   160k|    for score in scores.iter_mut() {
  749|   160k|      *score *= inv_mean;
  750|   160k|    }
  751|       |
  752|   160k|    for scale in self.distortion_scales.iter_mut() {
  753|   160k|      *scale *= inv_mean;
  754|   160k|    }
  755|       |
  756|    524|    self.spatiotemporal_scores = scores;
  757|    524|
  758|    524|    inv_mean.blog64() >> 1
