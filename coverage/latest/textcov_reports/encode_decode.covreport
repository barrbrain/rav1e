  107|   202M|fn divu_gen(d: u32) -> (u32, u32, u32) {
  108|   202M|  let nbits = (mem::size_of_val(&d) as u64) * 8;
  109|   202M|  let m = nbits - d.leading_zeros() as u64 - 1;
  110|   202M|  if (d & (d - 1)) == 0 {
  111|  15.0M|    (0xFFFF_FFFF, 0xFFFF_FFFF, m as u32)
  112|       |  } else {
  113|   187M|    let d = d as u64;
  114|   187M|    let t = (1u64 << (m + nbits)) / d;
  115|   187M|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|   187M|    if r <= 1u64 << m {
  117|   137M|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|  49.8M|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
  122|   202M|}
