  877|  3.79k|          p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6,
  878|  3.79k|        )
  879|       |      } else {
  880|       |        // only flat in inner area, run 8-tap
  881|    748|        filter_wide8_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5)
  882|       |      }
  883|  92.6k|    } else if nhev4(p1, p0, q0, q1, bd - 8) <= level {
  884|       |      // not flat, run narrow filter
  885|  2.56k|      filter_narrow4_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  886|       |    } else {
  887|  90.0k|      filter_narrow2_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  888|       |    };
  889|  97.1k|    Some(x)
  890|       |  } else {
  891|  1.08M|    None
  892|       |  }
  893|  1.18M|}
_RNvNtCsixsdkNzQ5tW_5rav1e7deblock22deblock_adjusted_level:
   25|   753k|fn deblock_adjusted_level(
   26|   753k|  deblock: &DeblockState, block: &Block, pli: usize, vertical: bool,
   27|   753k|) -> usize {
   28|   753k|  let idx = if pli == 0 {
   29|   414k|    if vertical {
   30|   203k|      0
   31|       |    } else {
   32|   210k|      1
   33|       |    }
   34|       |  } else {
   35|   338k|    pli + 1
   36|       |  };
   37|       |
   38|   753k|  let level = if deblock.block_deltas_enabled {
   39|       |    // By-block filter strength delta, if the feature is active.
   40|      0|    let block_delta = if deblock.block_delta_multi {
   41|      0|      block.deblock_deltas[idx] << deblock.block_delta_shift
   42|       |    } else {
   43|      0|      block.deblock_deltas[0] << deblock.block_delta_shift
   44|       |    };
   45|       |
   46|       |    // Add to frame-specified filter strength (Y-vertical, Y-horizontal, U, V)
   47|      0|    clamp(block_delta + deblock.levels[idx] as i8, 0, MAX_LOOP_FILTER as i8)
   48|      0|      as u8
   49|       |  } else {
   50|   753k|    deblock.levels[idx]
   51|       |  };
   52|       |
   53|       |  // if fi.seg_feaure_active {
   54|       |  // rav1e does not yet support segments or segment features
   55|       |  // }
   56|       |
   57|       |  // Are delta modifiers for specific references and modes active?  If so, add them too.
   58|   753k|  if deblock.deltas_enabled {
   59|      0|    let mode = block.mode;
   60|      0|    let reference = block.ref_frames[0];
   61|      0|    let mode_type =
