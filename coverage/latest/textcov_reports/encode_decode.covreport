   33|   777k|  pub fn get_sad<T: Pixel>(
   34|   777k|    plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>, w: usize,
   35|   777k|    h: usize, _bit_depth: usize, _cpu: CpuFeatureLevel,
   36|   777k|  ) -> u32 {
   37|   777k|    assert!(w <= 128 && h <= 128);
   38|   777k|    assert!(plane_org.rect().width >= w && plane_org.rect().height >= h);
   39|   777k|    assert!(plane_ref.rect().width >= w && plane_ref.rect().height >= h);
   40|       |
   41|   777k|    let mut sum: u32 = 0;
   42|       |
   43|  8.78M|    for (slice_org, slice_ref) in
   44|   777k|      plane_org.rows_iter().take(h).zip(plane_ref.rows_iter())
   45|  8.78M|    {
   46|  8.78M|      sum += slice_org
   47|  8.78M|        .iter()
   48|  8.78M|        .take(w)
   49|  8.78M|        .zip(slice_ref)
   50|  8.78M|        .map(|(&a, &b)| (i32::cast_from(a) - i32::cast_from(b)).unsigned_abs())
   51|  8.78M|        .sum::<u32>();
   52|  8.78M|    }
   53|       |
   54|   777k|    sum
   55|   777k|  }
