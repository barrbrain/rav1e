 1438|  7.57M|fn compute_mv_rd<T: Pixel>(
 1439|  7.57M|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  7.57M|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  7.57M|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  7.57M|) -> MVCandidateRD {
