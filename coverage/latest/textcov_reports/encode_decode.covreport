  441|  15.4M|$($s)* fn daala_fdct_ii_4_asym<T: TxOperations>(
  442|  15.4M|  q0h: T, q1: (T, T), q2h: T, q3: (T, T), output: &mut [T],
  443|  15.4M|) {
  444|  15.4M|  // +/- Butterflies with asymmetric input.
  445|  15.4M|  let (q0, q3) = butterfly_neg_asym(q0h, q3);
  446|  15.4M|  let (q1, q2) = butterfly_sub_asym(q1, q2h);
  447|  15.4M|
  448|  15.4M|  // Embedded 2-point orthonormal transforms.
  449|  15.4M|  let (q0, q1) = daala_fdct_ii_2(q0, q1);
  450|  15.4M|  let (q3, q2) = daala_fdst_iv_2(q3, q2);
  451|  15.4M|
  452|  15.4M|  store_coeffs!(output, q0, q1, q2, q3);
  453|  15.4M|}
