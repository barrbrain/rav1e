 2125|    114|    let sb_v_shift = ts.restoration.planes[pli].rp_cfg.sb_v_shift;
 2126|    114|    if sb_w < (1 << sb_h_shift) {
 2127|      4|      sb_w = 1 << sb_h_shift;
 2128|    110|    }
 2129|    114|    if sb_h < (1 << sb_v_shift) {
 2130|      2|      sb_h = 1 << sb_v_shift;
 2131|    112|    }
 2132|       |  }
 2133|    114|  for pli in 0..planes {
 2134|    114|    let sb_h_shift = ts.restoration.planes[pli].rp_cfg.sb_h_shift;
 2135|    114|    let sb_v_shift = ts.restoration.planes[pli].rp_cfg.sb_v_shift;
 2136|    114|    lru_w[pli] = sb_w / (1 << sb_h_shift);
