  353|   484k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   484k|  use crate::context::{MV_LOW, MV_UPP};
  355|   484k|  (
  356|   484k|    mvx_min.max(MV_LOW as isize + 1),
  357|   484k|    mvx_max.min(MV_UPP as isize - 1),
  358|   484k|    mvy_min.max(MV_LOW as isize + 1),
  359|   484k|    mvy_max.min(MV_UPP as isize - 1),
  360|   484k|  )
  361|   484k|}
