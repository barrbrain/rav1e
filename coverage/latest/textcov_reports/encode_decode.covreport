_RNvMNtCs3tIhnEwGhQF_5rav1e4rateNtB2_10IIRBessel26update:
  190|     32|  pub fn update(&mut self, x: i32) -> i32 {
  191|     32|    let c0 = self.c[0] as i64;
  192|     32|    let c1 = self.c[1] as i64;
  193|     32|    let g = self.g as i64;
  194|     32|    let x0 = self.x[0] as i64;
  195|     32|    let x1 = self.x[1] as i64;
  196|     32|    let y0 = self.y[0] as i64;
  197|     32|    let y1 = self.y[1] as i64;
  198|     32|    let ya =
  199|     32|      ((((x as i64) + x0 * 2 + x1) * g + y0 * c0 + y1 * c1 + (1i64 << 23))
  200|     32|        >> 24) as i32;
  201|     32|    self.x[1] = self.x[0];
  202|     32|    self.x[0] = x;
  203|     32|    self.y[1] = self.y[0];
  204|     32|    self.y[0] = ya;
  205|     32|    ya
  206|     32|  }
