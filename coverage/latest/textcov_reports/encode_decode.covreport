  219|  9.67k|fn estimate_sb_motion<T: Pixel>(
  220|  9.67k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  9.67k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  9.67k|  lambda: u32,
  223|  9.67k|) {
  224|  9.67k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  9.67k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  9.67k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  9.67k|
  228|  9.67k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
