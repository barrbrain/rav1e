  222|  29.5M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  29.5M|    let out0 = b.add(c);
  224|  29.5M|    let shifted = Self::SHIFT(c);
  225|  29.5M|    let out1 = Self::SUB(a, shifted);
  226|  29.5M|    (out0, out1)
  227|  29.5M|  }
