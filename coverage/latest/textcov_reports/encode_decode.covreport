_RNvNtCsgzd1EjkjF4V_5rav1e7encoder10pos_to_lvl:
  773|     27|pub(crate) const fn pos_to_lvl(pos: u64, pyramid_depth: u64) -> u64 {
  774|     27|  // Derive level within pyramid for a frame with a given coding order position
  775|     27|  // For example, with a pyramid of depth 2, the 2 least significant bits of the
  776|     27|  // position determine the level:
  777|     27|  // 00 -> 0
  778|     27|  // 01 -> 2
  779|     27|  // 10 -> 1
  780|     27|  // 11 -> 2
  781|     27|  pyramid_depth - (pos | (1 << pyramid_depth)).trailing_zeros() as u64
  782|     27|}
