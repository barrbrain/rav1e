   33|  1.84k|  pub fn get_sad<T: Pixel>(
   34|  1.84k|    plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>, w: usize,
   35|  1.84k|    h: usize, _bit_depth: usize, _cpu: CpuFeatureLevel,
   36|  1.84k|  ) -> u32 {
   37|  1.84k|    assert!(w <= 128 && h <= 128);
   38|  1.84k|    assert!(plane_org.rect().width >= w && plane_org.rect().height >= h);
   39|  1.84k|    assert!(plane_ref.rect().width >= w && plane_ref.rect().height >= h);
   40|       |
   41|  1.84k|    let mut sum: u32 = 0;
   42|       |
   43|  24.0k|    for (slice_org, slice_ref) in
   44|  1.84k|      plane_org.rows_iter().take(h).zip(plane_ref.rows_iter())
   45|  24.0k|    {
   46|  24.0k|      sum += slice_org
