  242|  96.7M|  pub fn quantize<T: Coefficient>(
  243|  96.7M|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|  96.7M|  ) -> usize {
  245|  96.7M|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|  96.7M|
  247|  96.7M|    qcoeffs[0] = {
  248|  96.7M|      let coeff: i32 =
  249|  96.7M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|  96.7M|      let abs_coeff = coeff.unsigned_abs();
  251|  96.7M|      T::cast_from(copysign(
  252|  96.7M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|  96.7M|        coeff,
  254|  96.7M|      ))
  255|  96.7M|    };
  256|  96.7M|
  257|  96.7M|    // Find the last non-zero coefficient using our smaller biases and
  258|  96.7M|    // zero everything else.
  259|  96.7M|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|  96.7M|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|  96.7M|    let deadzone = T::cast_from(
  262|  96.7M|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|  96.7M|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|  96.7M|    );
  265|  96.7M|    let eob = {
  266|  96.7M|      // We skip the DC coefficient since it has its own quantizer index.
  267|  96.7M|      let eob_minus_two =
  268|  96.7M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|  96.7M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|  96.7M|      })
  276|  96.7M|    };
  277|  96.7M|
  278|  96.7M|    // Here we use different rounding biases depending on whether we've
  279|  96.7M|    // had recent coefficients that are larger than one, or less than
  280|  96.7M|    // one. The reason for this is that a block usually has a chunk of
  281|  96.7M|    // large coefficients and a tail of zeroes and ones, and the tradeoffs
  282|  96.7M|    // for coding these two are different. In the tail of zeroes and ones,
  283|  96.7M|    // you'll likely end up spending most bits just saying where that
  284|  96.7M|    // coefficient is in the block, whereas in the chunk of larger
  285|  96.7M|    // coefficients, most bits will be spent on coding its magnitude.
  286|  96.7M|    // To that end, we want to bias more toward rounding to zero for
  287|  96.7M|    // that tail of zeroes and ones than we do for the larger coefficients.
  288|  96.7M|    let mut level_mode = 1;
  289|  4.82G|    for &pos in scan.iter().take(eob).skip(1) {
  290|  4.82G|      let coeff = i32::cast_from(coeffs[pos as usize]) << self.log_tx_scale;
  291|  4.82G|      let abs_coeff = coeff.unsigned_abs();
  292|  4.82G|
  293|  4.82G|      let level0 = divu_pair(abs_coeff, self.ac_mul_add);
  294|  4.82G|      let offset = if level0 > 1 - level_mode {
  295|  1.99G|        self.ac_offset1
  296|       |      } else {
  297|  2.82G|        self.ac_offset0
  298|       |      };
  299|       |
  300|  4.82G|      let abs_qcoeff: u32 = divu_pair(abs_coeff + offset, self.ac_mul_add);
  301|  4.82G|      if level_mode != 0 && abs_qcoeff == 0 {
  302|   312M|        level_mode = 0;
  303|  4.50G|      } else if abs_qcoeff > 1 {
  304|  1.85G|        level_mode = 1;
  305|  2.65G|      }
  306|       |
  307|  4.82G|      qcoeffs[pos as usize] = T::cast_from(copysign(abs_qcoeff, coeff));
  308|       |    }
  309|       |
  310|       |    // Rather than zeroing the tail in scan order, assume that qcoeffs is
  311|       |    // pre-filled with zeros.
  312|       |
  313|       |    // Check the eob is correct
  314|       |    debug_assert_eq!(
  315|       |      eob,
  316|      0|      scan
  317|      0|        .iter()
  318|      0|        .rposition(|&i| qcoeffs[i as usize] != T::cast_from(0))
  319|      0|        .map(|n| n + 1)
  320|      0|        .unwrap_or(0)
  321|       |    );
  322|       |
  323|  96.7M|    eob
  324|  96.7M|  }
