  722|  10.6M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  10.6M|  let (s1, seh) = butterfly_add(s1, se);
  724|  10.6M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  10.6M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  10.6M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  10.6M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  10.6M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  10.6M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  10.6M|
  731|  10.6M|  // Embedded 8-point transforms with asymmetric input.
  732|  10.6M|  daala_fdct_ii_8_asym(s0h, s1, s2h, s3, s4h, s5, s6h, s7, &mut output[0..8]);
  733|  10.6M|  daala_fdst_iv_8_asym(sf, seh, sd, sch, sb, sah, s9, s8h, &mut output[8..16]);
  734|  10.6M|  output[8..16].reverse();
  735|  10.6M|}
