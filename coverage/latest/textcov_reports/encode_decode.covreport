 2104|  5.10k|pub fn rdo_loop_decision<T: Pixel, W: Writer>(
 2105|  5.10k|  base_sbo: TileSuperBlockOffset, fi: &FrameInvariants<T>,
 2106|  5.10k|  ts: &mut TileStateMut<'_, T>, cw: &mut ContextWriter, w: &mut W,
 2107|  5.10k|  deblock_p: bool,
 2108|  5.10k|) {
 2109|  5.10k|  let planes = if fi.sequence.chroma_sampling == ChromaSampling::Cs400 {
 2110|  1.26k|    1
 2111|       |  } else {
 2112|  3.84k|    MAX_PLANES
 2113|       |  };
 2114|  5.10k|  assert!(fi.sequence.enable_cdef || fi.sequence.enable_restoration);
 2115|       |  // Determine area of optimization: Which plane has the largest LRUs?
 2116|       |  // How many LRUs for each?
 2117|  5.10k|  let mut sb_w = 1; // how many superblocks wide the largest LRU
 2118|  5.10k|                    // is/how many SBs we're processing (same thing)
 2119|  5.10k|  let mut sb_h = 1; // how many superblocks wide the largest LRU
 2120|  5.10k|                    // is/how many SBs we're processing (same thing)
 2121|  5.10k|  let mut lru_w = [0; MAX_PLANES]; // how many LRUs we're processing
 2122|  5.10k|  let mut lru_h = [0; MAX_PLANES]; // how many LRUs we're processing
 2123|  12.7k|  for pli in 0..planes {
 2124|  12.7k|    let sb_h_shift = ts.restoration.planes[pli].rp_cfg.sb_h_shift;
 2125|  12.7k|    let sb_v_shift = ts.restoration.planes[pli].rp_cfg.sb_v_shift;
 2126|  12.7k|    if sb_w < (1 << sb_h_shift) {
 2127|    910|      sb_w = 1 << sb_h_shift;
 2128|  11.8k|    }
 2129|  12.7k|    if sb_h < (1 << sb_v_shift) {
 2130|    665|      sb_h = 1 << sb_v_shift;
 2131|  12.1k|    }
 2132|       |  }
 2133|  12.7k|  for pli in 0..planes {
 2134|  12.7k|    let sb_h_shift = ts.restoration.planes[pli].rp_cfg.sb_h_shift;
 2135|  12.7k|    let sb_v_shift = ts.restoration.planes[pli].rp_cfg.sb_v_shift;
 2136|  12.7k|    lru_w[pli] = sb_w / (1 << sb_h_shift);
 2137|  12.7k|    lru_h[pli] = sb_h / (1 << sb_v_shift);
 2138|  12.7k|  }
 2139|       |
 2140|       |  // The superblock width/height determinations may be calling for us
 2141|       |  // to compute over superblocks that do not actually exist in the
 2142|       |  // frame (off the right or lower edge).  Trim sb width/height down
 2143|       |  // to actual superblocks.  Note that these last superblocks on the
 2144|       |  // right/bottom may themselves still span the edge of the frame, but
 2145|       |  // they do hold at least some visible pixels.
 2146|  5.10k|  sb_w = sb_w.min(ts.sb_width - base_sbo.0.x);
 2147|  5.10k|  sb_h = sb_h.min(ts.sb_height - base_sbo.0.y);
 2148|  5.10k|
 2149|  5.10k|  // We have need to know the Y visible pixel limits as well (the
 2150|  5.10k|  // sb_w/sb_h figures above can be used to determine how many
 2151|  5.10k|  // allocated pixels, possibly beyond the visible frame, exist).
 2152|  5.10k|  let crop_w =
 2153|  5.10k|    fi.width - ((ts.sbo.0.x + base_sbo.0.x) << SUPERBLOCK_TO_PLANE_SHIFT);
 2154|  5.10k|  let crop_h =
 2155|  5.10k|    fi.height - ((ts.sbo.0.y + base_sbo.0.y) << SUPERBLOCK_TO_PLANE_SHIFT);
 2156|  5.10k|  let pixel_w = crop_w.min(sb_w << SUPERBLOCK_TO_PLANE_SHIFT);
 2157|  5.10k|  let pixel_h = crop_h.min(sb_h << SUPERBLOCK_TO_PLANE_SHIFT);
