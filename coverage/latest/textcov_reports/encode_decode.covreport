_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward11daala_fdct4NtB2_5I32X8EBa_:
  381|  72.8M|$($s)* fn daala_fdct4<T: TxOperations>(coeffs: &mut [T]) {
  382|  72.8M|  assert!(coeffs.len() >= 4);
  383|  72.8M|  let mut temp_out: [T; 4] = [T::zero(); 4];
  384|  72.8M|  daala_fdct_ii_4(coeffs[0], coeffs[1], coeffs[2], coeffs[3], &mut temp_out);
  385|  72.8M|
  386|  72.8M|  coeffs[0] = temp_out[0];
  387|  72.8M|  coeffs[1] = temp_out[2];
  388|  72.8M|  coeffs[2] = temp_out[1];
  389|  72.8M|  coeffs[3] = temp_out[3];
  390|  72.8M|}
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward16daala_fdct_ii_16NtB2_5I32X8EBa_:
  717|  15.6M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  15.6M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  15.6M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  15.6M|) {
  721|  15.6M|  // +/- Butterflies with asymmetric output.
  722|  15.6M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  15.6M|  let (s1, seh) = butterfly_add(s1, se);
  724|  15.6M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  15.6M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  15.6M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  15.6M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  15.6M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  15.6M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  15.6M|
  731|  15.6M|  // Embedded 8-point transforms with asymmetric input.
  732|  15.6M|  daala_fdct_ii_8_asym(s0h, s1, s2h, s3, s4h, s5, s6h, s7, &mut output[0..8]);
  733|  15.6M|  daala_fdst_iv_8_asym(sf, seh, sd, sch, sb, sah, s9, s8h, &mut output[8..16]);
  734|  15.6M|  output[8..16].reverse();
  735|  15.6M|}
