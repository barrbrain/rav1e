 1050|  6.32k|fn hexagon_search<T: Pixel>(
 1051|  6.32k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  6.32k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  6.32k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  6.32k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  6.32k|) {
 1056|  6.32k|  // The first iteration of hexagon search is implemented separate from
 1057|  6.32k|  // subsequent iterations, which overlap with previous iterations.
 1058|  6.32k|
 1059|  6.32k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  6.32k|  // candidates have already been tested in a previous iteration and can be
 1061|  6.32k|  // skipped.
 1062|  6.32k|  let mut best_cand_idx: usize = 0;
 1063|  6.32k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  44.2k|  for i in 0..6 {
 1067|  37.9k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  37.9k|    let rd = get_fullpel_mv_rd(
 1069|  37.9k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  37.9k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  37.9k|    );
 1072|  37.9k|
 1073|  37.9k|    if rd.cost < best_cand.rd.cost {
 1074|  13.4k|      best_cand_idx = i;
 1075|  13.4k|      best_cand.mv = cand_mv;
 1076|  13.4k|      best_cand.rd = rd;
 1077|  24.4k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  8.32k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|  2.00k|    *current = best_cand;
 1085|  2.00k|    best_cand = MotionSearchResult::empty();
 1086|  2.00k|
 1087|  2.00k|    // Save the index/direction taken in the previous iteration to the current
 1088|  2.00k|    // search location.
 1089|  2.00k|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|  8.00k|    for idx_offset_mod6 in 5..=7 {
 1097|  6.00k|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|  6.00k|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|  6.00k|
 1100|  6.00k|      let rd = get_fullpel_mv_rd(
 1101|  6.00k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|  6.00k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|  6.00k|      );
 1104|  6.00k|
 1105|  6.00k|      if rd.cost < best_cand.rd.cost {
 1106|  3.62k|        best_cand_idx = i;
 1107|  3.62k|        best_cand.mv = cand_mv;
 1108|  3.62k|        best_cand.rd = rd;
 1109|  3.62k|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  6.32k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  56.9k|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|  50.6k|    let cand_mv = current.mv + offset;
 1117|  50.6k|    let rd = get_fullpel_mv_rd(
 1118|  50.6k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|  50.6k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  50.6k|    );
 1121|  50.6k|
 1122|  50.6k|    if rd.cost < best_cand.rd.cost {
 1123|  17.1k|      best_cand.mv = cand_mv;
 1124|  17.1k|      best_cand.rd = rd;
 1125|  33.4k|    }
 1126|       |  }
 1127|  6.32k|  if best_cand.rd.cost < current.rd.cost {
 1128|    894|    *current = best_cand;
 1129|  5.43k|  }
 1130|       |
 1131|  6.32k|  assert!(!current.is_empty());
