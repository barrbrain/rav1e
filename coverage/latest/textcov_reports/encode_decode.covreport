  179|  8.28k|pub fn prep_8tap<T: Pixel>(
  180|  8.28k|  tmp: &mut [i16], src: PlaneSlice<'_, T>, width: usize, height: usize,
  181|  8.28k|  col_frac: i32, row_frac: i32, mode_x: FilterMode, mode_y: FilterMode,
  182|  8.28k|  bit_depth: usize, cpu: CpuFeatureLevel,
  183|  8.28k|) {
  184|  8.28k|  let call_rust = |tmp: &mut [i16]| {
  185|       |    rust::prep_8tap(
  186|       |      tmp, src, width, height, col_frac, row_frac, mode_x, mode_y, bit_depth,
  187|       |      cpu,
  188|       |    );
  189|       |  };
  190|       |  #[cfg(feature = "check_asm")]
  191|       |  let ref_tmp = {
  192|       |    let mut copy = vec![0; width * height];
  193|       |    copy[..].copy_from_slice(&tmp[..width * height]);
  194|       |    call_rust(&mut copy);
  195|       |    copy
  196|       |  };
  197|       |
  198|       |  // SAFETY: The assembly only supports even heights and valid uncropped
  199|       |  //         widths
  200|       |  unsafe {
  201|  8.28k|    assert_eq!(height & 1, 0);
  202|  8.28k|    assert!(width.is_power_of_two() && (2..=128).contains(&width));
  203|       |
  204|       |    // SAFETY: Check length of tmp
  205|  8.28k|    assert!(tmp.len() >= width * height);
  206|       |
  207|       |    // SAFETY: Check bounds of src
  208|  8.28k|    assert!(src.accessible(width + 4, height + 4));
  209|  8.28k|    assert!(src.accessible_neg(3, 3));
  210|       |
  211|      0|    match T::type_enum() {
  212|       |      PixelType::U8 => {
  213|  8.28k|        match PREP_FNS[cpu.as_index()][get_2d_mode_idx(mode_x, mode_y)] {
  214|  8.28k|          Some(func) => (func)(
  215|  8.28k|            tmp.as_mut_ptr(),
  216|  8.28k|            src.as_ptr() as *const _,
  217|  8.28k|            T::to_asm_stride(src.plane.cfg.stride),
  218|  8.28k|            width as i32,
  219|  8.28k|            height as i32,
  220|  8.28k|            col_frac,
  221|  8.28k|            row_frac,
  222|  8.28k|          ),
  223|      0|          None => call_rust(tmp),
  224|       |        }
  225|       |      }
  226|      0|      PixelType::U16 if bit_depth > 8 => {
  227|      0|        match PREP_HBD_FNS[cpu.as_index()][get_2d_mode_idx(mode_x, mode_y)] {
  228|      0|          Some(func) => (func)(
  229|      0|            tmp.as_mut_ptr() as *mut _,
  230|      0|            src.as_ptr() as *const _,
  231|      0|            T::to_asm_stride(src.plane.cfg.stride),
  232|      0|            width as i32,
  233|      0|            height as i32,
  234|      0|            col_frac,
  235|      0|            row_frac,
  236|      0|            (1 << bit_depth) - 1,
  237|      0|          ),
  238|      0|          None => call_rust(tmp),
  239|       |        }
  240|       |      }
  241|      0|      _ => call_rust(tmp),
  242|       |    }
  243|       |  }
  244|       |  #[cfg(feature = "check_asm")]
  245|       |  {
  246|       |    assert_eq!(&tmp[..width * height], &ref_tmp[..]);
  247|       |  }
  248|  8.28k|}
