  178|  11.1M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  11.1M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  11.1M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  11.1M|) -> Distortion {
  182|  11.1M|  // See get_weighted_sse in src/dist.rs.
  183|  11.1M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  11.1M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  11.1M|
  186|  11.1M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  11.1M|  // importance block size in a non-subsampled plane.
  188|  11.1M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  11.1M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  11.1M|
  191|  11.1M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  11.1M|
  193|  11.1M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  11.1M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  11.1M|
  196|  11.1M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  11.1M|  // passed directly. To do this, we would need different versions of the
  198|  11.1M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  11.1M|  // eliminating use of unbiased sse.
  200|  11.1M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  11.1M|
  202|  11.1M|  // Copy biases into a buffer.
  203|  11.1M|  let mut buf_storage = Aligned::new(
  204|  11.1M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  11.1M|  );
  206|  11.1M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  11.1M|  let buf = init_slice_repeat_mut(
  208|  11.1M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  11.1M|    0,
  210|  11.1M|  );
  211|       |
  212|  24.4M|  for block_y in 0..n_imp_blocks_h {
  213|  90.4M|    for block_x in 0..n_imp_blocks_w {
  214|  90.4M|      let block = Area::StartingAt {
  215|  90.4M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  90.4M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  90.4M|      };
  218|  90.4M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  90.4M|    }
  220|       |  }
  221|       |
  222|  11.1M|  Distortion(get_weighted_sse(
  223|  11.1M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  11.1M|  ))
  225|  11.1M|}
