  828|  37.7M|      mag += cmp::min(3, levels[2]); // { 2, 0 }
  829|  37.7M|      mag += cmp::min(3, levels[(2 << bhl) + (2 << TX_PAD_HOR_LOG2)]); // { 0, 2 }
