_RINvNtCsgzd1EjkjF4V_5rav1e4cdef29cdef_analyze_superblock_rangehEB4_:
  326|     38|pub fn cdef_analyze_superblock_range<T: Pixel>(
  327|     38|  fi: &FrameInvariants<T>, in_frame: &Frame<T>, blocks: &TileBlocks<'_>,
  328|     38|  sb_w: usize, sb_h: usize,
  329|     38|) -> Vec<CdefDirections> {
  330|     38|  let mut ret = Vec::<CdefDirections>::with_capacity(sb_h * sb_w);
  331|     44|  for sby in 0..sb_h {
  332|     68|    for sbx in 0..sb_w {
  333|     68|      let sbo = TileSuperBlockOffset(SuperBlockOffset { x: sbx, y: sby });
  334|     68|      ret.push(cdef_analyze_superblock(fi, in_frame, blocks, sbo));
  335|     68|    }
  336|       |  }
  337|     38|  ret
  338|     38|}
_RINvNtCsgzd1EjkjF4V_5rav1e4cdef16cdef_filter_tilehEB4_:
  596|      8|pub fn cdef_filter_tile<T: Pixel>(
  597|      8|  fi: &FrameInvariants<T>, input: &Frame<T>, tb: &TileBlocks,
  598|      8|  output: &mut TileMut<'_, T>,
  599|      8|) {
  600|      8|  // Each filter block is 64x64, except right and/or bottom for non-multiple-of-64 sizes.
  601|      8|  // FIXME: 128x128 SB support will break this, we need FilterBlockOffset etc.
  602|      8|
  603|      8|  // No need to guard against having fewer actual coded blocks than
  604|      8|  // the output.rect() area.  Inner code already guards this case.
  605|      8|  let fb_width = (output.planes[0].rect().width + 63) / 64;
  606|      8|  let fb_height = (output.planes[0].rect().height + 63) / 64;
  607|       |
  608|       |  // should parallelize this
  609|     26|  for fby in 0..fb_height {
  610|     68|    for fbx in 0..fb_width {
  611|     68|      // tile_sbo is treated as an offset into the Tiles' plane
  612|     68|      // regions, not as an absolute offset in the visible frame.  The
  613|     68|      // Tile's own offset is added to this in order to address into
  614|     68|      // the input Frame.
  615|     68|      let tile_sbo = TileSuperBlockOffset(SuperBlockOffset { x: fbx, y: fby });
  616|     68|      let cdef_index = tb.get_cdef(tile_sbo);
  617|     68|      let cdef_dirs = cdef_analyze_superblock(fi, input, tb, tile_sbo);
  618|     68|
  619|     68|      cdef_filter_superblock(
  620|     68|        fi, input, output, tb, tile_sbo, cdef_index, &cdef_dirs,
  621|     68|      );
  622|     68|    }
  623|       |  }
  624|      8|}
_RINvNtCsgzd1EjkjF4V_5rav1e4cdef23cdef_analyze_superblockhEB4_:
  340|    136|pub fn cdef_analyze_superblock<T: Pixel>(
  341|    136|  fi: &FrameInvariants<T>, in_frame: &Frame<T>, blocks: &TileBlocks<'_>,
  342|    136|  sbo: TileSuperBlockOffset,
  343|    136|) -> CdefDirections {
  344|    136|  let coeff_shift = fi.sequence.bit_depth as usize - 8;
  345|    136|  let mut dir: CdefDirections =
  346|    136|    CdefDirections { dir: [[0; 8]; 8], var: [[0; 8]; 8] };
  347|       |  // Each direction block is 8x8 in y, and direction computation only looks at y
  348|  1.22k|  for by in 0..8 {
  349|  9.79k|    for bx in 0..8 {
  350|  8.70k|      let block_offset = sbo.block_offset(bx << 1, by << 1);
  351|  8.70k|      if block_offset.0.x < blocks.cols() && block_offset.0.y < blocks.rows() {
  352|  6.42k|        let skip = blocks[block_offset].skip
  353|  6.42k|          & blocks[sbo.block_offset(2 * bx + 1, 2 * by)].skip
  354|  6.42k|          & blocks[sbo.block_offset(2 * bx, 2 * by + 1)].skip
  355|  6.42k|          & blocks[sbo.block_offset(2 * bx + 1, 2 * by + 1)].skip;
  356|  6.42k|
  357|  6.42k|        if !skip {
  358|  6.42k|          let mut var: u32 = 0;
  359|  6.42k|          let in_plane = &in_frame.planes[0];
  360|  6.42k|          let in_po = sbo.plane_offset(&in_plane.cfg);
  361|  6.42k|          let in_slice = in_plane.slice(in_po);
  362|  6.42k|          dir.dir[bx][by] = cdef_find_dir::<T>(
  363|  6.42k|            &in_slice.reslice(8 * bx as isize, 8 * by as isize),
  364|  6.42k|            &mut var,
  365|  6.42k|            coeff_shift,
  366|  6.42k|            fi.cpu_feature_level,
  367|  6.42k|          ) as u8;
  368|  6.42k|          dir.var[bx][by] = var as i32;
  369|  6.42k|        }
  370|  2.28k|      }
  371|       |    }
  372|       |  }
  373|    136|  dir
  374|    136|}
_RINvNtCsgzd1EjkjF4V_5rav1e4cdef22cdef_filter_superblockhEB4_:
  400|    212|pub fn cdef_filter_superblock<T: Pixel>(
  401|    212|  fi: &FrameInvariants<T>, input: &Frame<T>, output: &mut TileMut<'_, T>,
  402|    212|  blocks: &TileBlocks<'_>, tile_sbo: TileSuperBlockOffset, cdef_index: u8,
  403|    212|  cdef_dirs: &CdefDirections,
  404|    212|) {
  405|    212|  let bit_depth = fi.sequence.bit_depth;
  406|    212|  let coeff_shift = fi.sequence.bit_depth as i32 - 8;
  407|    212|  let cdef_damping = fi.cdef_damping as i32;
  408|    212|  let cdef_y_strength = fi.cdef_y_strengths[cdef_index as usize];
  409|    212|  let cdef_uv_strength = fi.cdef_uv_strengths[cdef_index as usize];
  410|    212|  let cdef_pri_y_strength = (cdef_y_strength / CDEF_SEC_STRENGTHS) as i32;
  411|    212|  let mut cdef_sec_y_strength = (cdef_y_strength % CDEF_SEC_STRENGTHS) as i32;
  412|    212|  let cdef_pri_uv_strength = (cdef_uv_strength / CDEF_SEC_STRENGTHS) as i32;
  413|    212|  let planes = if fi.sequence.chroma_sampling == Cs400 { 1 } else { 3 };
  414|    212|  let mut cdef_sec_uv_strength =
  415|    212|    (cdef_uv_strength % CDEF_SEC_STRENGTHS) as i32;
  416|    212|  if cdef_sec_y_strength == 3 {
  417|     96|    cdef_sec_y_strength += 1;
