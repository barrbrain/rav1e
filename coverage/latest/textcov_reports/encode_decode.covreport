   49|    246|fn select_qi(quantizer: i64, qlookup: &[i16; QINDEX_RANGE]) -> u8 {
   50|    246|  if quantizer < qlookup[MINQ] as i64 {
   51|      6|    MINQ as u8
   52|    240|  } else if quantizer >= qlookup[MAXQ] as i64 {
   53|      4|    MAXQ as u8
   54|       |  } else {
   55|    236|    match qlookup.binary_search(&(quantizer as i16)) {
   56|    154|      Ok(qi) => qi as u8,
   57|     82|      Err(qi) => {
   58|      0|        debug_assert!(qi > MINQ);
   59|      0|        debug_assert!(qi <= MAXQ);
   60|       |        // Pick the closest quantizer in the log domain.
   61|     82|        let qthresh = (qlookup[qi - 1] as i32) * (qlookup[qi] as i32);
   62|     82|        let q2_i32 = (quantizer as i32) * (quantizer as i32);
   63|     82|        if q2_i32 < qthresh {
   64|     38|          (qi - 1) as u8
   65|       |        } else {
   66|     44|          qi as u8
   67|       |        }
   68|       |      }
   69|       |    }
   70|       |  }
   71|    246|}
_RNvNtCsgzd1EjkjF4V_5rav1e8quantize9divu_pairB3_:
  125|  79.2M|const fn divu_pair(x: u32, d: (u32, u32, u32)) -> u32 {
  126|  79.2M|  let x = x as u64;
  127|  79.2M|  let (a, b, shift) = d;
  128|  79.2M|  let shift = shift as u64;
  129|  79.2M|  let a = a as u64;
  130|  79.2M|  let b = b as u64;
  131|  79.2M|
  132|  79.2M|  (((a * x + b) >> 32) >> shift) as u32
  133|  79.2M|}

_RNvMs3_NtCsgzd1EjkjF4V_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|     27|  fn calc_flat_quantizer(
 1061|     27|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|     27|  ) -> (i64, i64) {
 1063|     27|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|     27|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|     27|    //  parameterize a "quality" configuration parameter).
 1066|     27|
 1067|     27|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|     27|    //  tables have unique entries, while the DC tables do not.
 1069|     27|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|     27|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|     27|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|     27|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|     27|    // Get the log quantizers as Q57.
 1074|     27|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|     27|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|     27|    // Target the midpoint of the chosen entries.
 1077|     27|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|     27|    // Adjust the quantizer for the frame type, result is Q57:
 1079|     27|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|     27|      + DQP_Q57[fti];
 1081|     27|    (log_base_q, log_q)
 1082|     27|  }
_RNvMNtCsgzd1EjkjF4V_5rav1e4rateNtB2_10IIRBessel23new:
