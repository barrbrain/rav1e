  711|  11.6M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((5793, 12), (11585, 13)));
  712|  11.6M|
  713|  11.6M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
