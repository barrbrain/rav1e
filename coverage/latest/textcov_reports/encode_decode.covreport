  312|   118M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|   118M|  let p0 = p0.sub(p1);
  314|   118M|  let p0h = p0.rshift1();
  315|   118M|  let p1h = p1.add(p0h);
  316|   118M|  ((p0h, p0), p1h)
  317|   118M|}
_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward16daala_fdst_vii_4NtB2_5I32X8EBa_:
  393|  20.9M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  20.9M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  20.9M|  let q0 = coeffs[0];
  397|  20.9M|  let q1 = coeffs[1];
  398|  20.9M|  let q2 = coeffs[2];
  399|  20.9M|  let q3 = coeffs[3];
  400|  20.9M|  let t0 = q1.add(q3);
  401|  20.9M|  // t1 = (q0 + q1 - q3)/2
  402|  20.9M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  20.9M|  let t2 = q0.sub(q1);
  404|  20.9M|  let t3 = q2;
  405|  20.9M|  let t4 = q0.add(q3);
  406|  20.9M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  20.9M|  let t0 = t0.tx_mul((7021, 14));
  408|  20.9M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  20.9M|  let t1 = t1.tx_mul((37837, 15));
  410|  20.9M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  20.9M|  let t2 = t2.tx_mul((21513, 15));
  412|  20.9M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  20.9M|  let t3 = t3.tx_mul((37837, 15));
  414|  20.9M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  20.9M|  let t4 = t4.tx_mul((467, 11));
  416|  20.9M|  let t3h = t3.rshift1();
  417|  20.9M|  let u4 = t4.add(t3h);
  418|  20.9M|  coeffs[0] = t0.add(u4);
  419|  20.9M|  coeffs[1] = t1;
  420|  20.9M|  coeffs[2] = t0.add(t2.sub(t3h));
  421|  20.9M|  coeffs[3] = t2.add(t3.sub(u4));
  422|  20.9M|}
