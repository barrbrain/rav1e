  490|  66.2M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  66.2M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  66.2M|) {
  493|  66.2M|  // +/- Butterflies with asymmetric output.
  494|  66.2M|  let (r0h, r7) = butterfly_neg(r0, r7);
  495|  66.2M|  let (r1, r6h) = butterfly_add(r1, r6);
  496|  66.2M|  let (r2h, r5) = butterfly_neg(r2, r5);
  497|  66.2M|  let (r3, r4h) = butterfly_add(r3, r4);
  498|  66.2M|
  499|  66.2M|  // Embedded 4-point transforms with asymmetric input.
  500|  66.2M|  daala_fdct_ii_4_asym(r0h, r1, r2h, r3, &mut output[0..4]);
  501|  66.2M|  daala_fdst_iv_4_asym(r7, r6h, r5, r4h, &mut output[4..8]);
  502|  66.2M|  output[4..8].reverse();
  503|  66.2M|}
