  107|   131M|fn divu_gen(d: u32) -> (u32, u32, u32) {
  108|   131M|  let nbits = (mem::size_of_val(&d) as u64) * 8;
  109|   131M|  let m = nbits - d.leading_zeros() as u64 - 1;
  110|   131M|  if (d & (d - 1)) == 0 {
  111|  11.8M|    (0xFFFF_FFFF, 0xFFFF_FFFF, m as u32)
  112|       |  } else {
  113|   119M|    let d = d as u64;
  114|   119M|    let t = (1u64 << (m + nbits)) / d;
  115|   119M|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|   119M|    if r <= 1u64 << m {
  117|  88.8M|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|  30.6M|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
  122|   131M|}
