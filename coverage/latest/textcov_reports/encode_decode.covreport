  410|       |  };
  411|       |
  412|       |  // Sample the middle of all block edges bordering this one.
  413|       |  // Note: If motion vectors haven't been precomputed to a given blocksize, then
  414|       |  // the right and bottom edges will be duplicates of the center predictor when
  415|       |  // processing in raster order.
  416|       |
  417|       |  // left
  418|   135k|  if tile_bo.0.x > 0 {
  419|  98.6k|    subset_b.push(process_cand(
  420|  98.6k|      tile_me_stats[tile_bo.0.y + clipped_half_h][tile_bo.0.x - 1],
  421|  98.6k|    ));
  422|  98.6k|  }
  423|       |  // top
  424|   135k|  if tile_bo.0.y > 0 {
  425|  97.4k|    subset_b.push(process_cand(
  426|  97.4k|      tile_me_stats[tile_bo.0.y - 1][tile_bo.0.x + clipped_half_w],
  427|  97.4k|    ));
  428|  97.4k|  }
