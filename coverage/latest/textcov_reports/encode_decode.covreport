_RINvNtCs3tIhnEwGhQF_5rav1e2me22fullpel_diamond_searchhEB4_:
  951|   138k|fn fullpel_diamond_search<T: Pixel>(
  952|   138k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   138k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   138k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   138k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   138k|) {
  957|   138k|  // Define the initial and the final scale (log2) of the diamond.
  958|   138k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|   401k|  loop {
  961|   401k|    // Find the best candidate from the diamond pattern.
  962|   401k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  2.00M|    for &offset in &DIAMOND_R1_PATTERN {
  964|  1.60M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  1.60M|      let rd = get_fullpel_mv_rd(
  966|  1.60M|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  1.60M|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  1.60M|      );
  969|  1.60M|
  970|  1.60M|      if rd.cost < best_cand.rd.cost {
  971|   812k|        best_cand.mv = cand_mv;
  972|   812k|        best_cand.rd = rd;
  973|   812k|      }
  974|       |    }
  975|       |
  976|       |    // Continue the search at this scale until the can't find a better candidate
  977|       |    // to use.
  978|   401k|    if current.rd.cost <= best_cand.rd.cost {
  979|   277k|      if diamond_radius_log2 == diamond_radius_end_log2 {
  980|   138k|        break;
  981|   138k|      } else {
  982|   138k|        diamond_radius_log2 -= 1;
  983|   138k|      }
  984|   124k|    } else {
  985|   124k|      *current = best_cand;
  986|   124k|    }
  987|       |  }
  988|       |
  989|   138k|  assert!(!current.is_empty());
  990|   138k|}
