  197|  77.7M|  ) -> Result<BlockSize, InvalidBlockSize> {
  198|  77.7M|    static BLOCK_LUT: [[Result<BlockSize, InvalidBlockSize>; 6]; 6] = [
  199|  77.7M|      [
  200|  77.7M|        Ok(BLOCK_4X4),
  201|  77.7M|        Ok(BLOCK_4X8),
  202|  77.7M|        Ok(BLOCK_4X16),
  203|  77.7M|        Err(InvalidBlockSize), // X32
  204|  77.7M|        Err(InvalidBlockSize), // X64
  205|  77.7M|        Err(InvalidBlockSize), // X128
  206|  77.7M|      ],
  207|  77.7M|      [
  208|  77.7M|        Ok(BLOCK_8X4),
  209|  77.7M|        Ok(BLOCK_8X8),
  210|  77.7M|        Ok(BLOCK_8X16),
  211|  77.7M|        Ok(BLOCK_8X32),
  212|  77.7M|        Err(InvalidBlockSize), // X64
  213|  77.7M|        Err(InvalidBlockSize), // X128
  214|  77.7M|      ],
  215|  77.7M|      [
  216|  77.7M|        Ok(BLOCK_16X4),
  217|  77.7M|        Ok(BLOCK_16X8),
  218|  77.7M|        Ok(BLOCK_16X16),
  219|  77.7M|        Ok(BLOCK_16X32),
  220|  77.7M|        Ok(BLOCK_16X64),
  221|  77.7M|        Err(InvalidBlockSize), // X128
  222|  77.7M|      ],
  223|  77.7M|      [
  224|  77.7M|        Err(InvalidBlockSize), // X4
  225|  77.7M|        Ok(BLOCK_32X8),
  226|  77.7M|        Ok(BLOCK_32X16),
  227|  77.7M|        Ok(BLOCK_32X32),
  228|  77.7M|        Ok(BLOCK_32X64),
  229|  77.7M|        Err(InvalidBlockSize), // X128
  230|  77.7M|      ],
  231|  77.7M|      [
  232|  77.7M|        Err(InvalidBlockSize), // X4
  233|  77.7M|        Err(InvalidBlockSize), // X8
  234|  77.7M|        Ok(BLOCK_64X16),
  235|  77.7M|        Ok(BLOCK_64X32),
  236|  77.7M|        Ok(BLOCK_64X64),
  237|  77.7M|        Ok(BLOCK_64X128),
  238|  77.7M|      ],
  239|  77.7M|      [
  240|  77.7M|        Err(InvalidBlockSize), // X4
  241|  77.7M|        Err(InvalidBlockSize), // X8
  242|  77.7M|        Err(InvalidBlockSize), // X16
  243|  77.7M|        Err(InvalidBlockSize), // X32
  244|  77.7M|        Ok(BLOCK_128X64),
  245|  77.7M|        Ok(BLOCK_128X128),
  246|  77.7M|      ],
  247|  77.7M|    ];
  248|  77.7M|
  249|  77.7M|    if (4..=128).contains(&w) && (4..=128).contains(&h) {
