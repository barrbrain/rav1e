  441|   344k|$($s)* fn daala_fdct_ii_4_asym<T: TxOperations>(
  442|   344k|  q0h: T, q1: (T, T), q2h: T, q3: (T, T), output: &mut [T],
  443|   344k|) {
  444|   344k|  // +/- Butterflies with asymmetric input.
  445|   344k|  let (q0, q3) = butterfly_neg_asym(q0h, q3);
  446|   344k|  let (q1, q2) = butterfly_sub_asym(q1, q2h);
