  283|  17.8k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  17.8k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  17.8k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
