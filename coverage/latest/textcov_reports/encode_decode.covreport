  340|       |      // in order for a frame to be referenced with a unique delta.
  341|       |      // Avoid wasting bits by using a coding that enforces this restriction.
  342|      0|      self.write(4, seq.delta_frame_id_length - 2)?;
  343|      0|      self.write(3, seq.frame_id_length - seq.delta_frame_id_length - 1)?;
