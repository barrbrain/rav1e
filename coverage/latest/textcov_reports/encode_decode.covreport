  283|     34|fn refine_subsampled_sb_motion<T: Pixel>(
  284|     34|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|     34|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
  286|     34|) {
  287|     34|  let pix_offset = tile_bo.to_luma_plane_offset();
  288|     34|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  289|     34|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  290|     34|
  291|     34|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  292|       |
  293|       |  // Process in blocks, cropping at edges.
  294|     46|  for y in (0..sb_h).step_by(mv_size) {
  295|     74|    for x in (0..sb_w).step_by(mv_size) {
  296|     74|      let sub_bo = tile_bo
  297|     74|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  298|     74|
  299|     74|      // Clamp to frame edge, rounding up in the case of subsampling.
  300|     74|      // The rounding makes some assumptions about how subsampling is done.
  301|     74|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  302|     74|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  303|       |
  304|       |      // Refine the existing motion estimate
  305|     74|      if let Some(results) = refine_subsampled_motion_estimate(
  306|     74|        fi, ts, w, h, sub_bo, ref_frame, ssdec, lambda,
  307|     74|      ) {
  308|     60|        // normalize sad to 128x128 block
  309|     60|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  310|     60|          / (w * h) as u64) as u32;
  311|     60|        save_me_stats(
  312|     60|          ts,
  313|     60|          mv_size_in_b_log2,
  314|     60|          sub_bo,
  315|     60|          ref_frame,
  316|     60|          MEStats { mv: results.mv, normalized_sad: sad },
  317|     60|        );
  318|     60|      }
  319|       |    }
  320|       |  }
  321|     34|}
