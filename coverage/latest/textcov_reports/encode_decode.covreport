   78|    708|    let max_tile_cols_log2 =
   79|    708|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|    708|    let max_tile_rows_log2 =
   81|    708|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|    708|    let min_tiles_log2 = min_tile_cols_log2
   83|    708|      .max(Self::tile_log2(max_tile_area_sb, sb_cols * sb_rows).unwrap());
   84|    708|
   85|    708|    // Implements restriction in Annex A of the spec.
   86|    708|    // Unlike the other restrictions, this one does not change
   87|    708|    // the header coding of the tile rows/cols.
   88|    708|    let min_tiles_ratelimit_log2 = min_tiles_log2.max(
   89|    708|      ((frame_width * frame_height) as f64 * frame_rate / MAX_TILE_RATE)
   90|    708|        .ceil()
   91|    708|        .log2()
   92|    708|        .ceil() as usize,
   93|    708|    );
   94|    708|
   95|    708|    let tile_cols_log2 =
   96|    708|      tile_cols_log2.max(min_tile_cols_log2).min(max_tile_cols_log2);
   97|    708|    let tile_width_sb_pre =
   98|    708|      sb_cols.align_power_of_two_and_shift(tile_cols_log2);
   99|       |
