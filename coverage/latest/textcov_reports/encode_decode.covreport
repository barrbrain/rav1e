   78|      9|    let max_tile_cols_log2 =
   79|      9|      Self::tile_log2(1, sb_cols.min(MAX_TILE_COLS)).unwrap();
   80|      9|    let max_tile_rows_log2 =
   81|      9|      Self::tile_log2(1, sb_rows.min(MAX_TILE_ROWS)).unwrap();
   82|      9|    let min_tiles_log2 = min_tile_cols_log2
