  180|  1.16M|    let t = Self::ADD(p1, p0);
  181|  1.16M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  1.16M|    let out1 = Self::SUB(a, out0);
  183|  1.16M|    (out0, out1)
