  140|  5.32k|  pub const fn notequal(self, cmp: RestorationFilter) -> bool {
  141|  5.32k|    match self {
  142|  5.32k|      RestorationFilter::None {} => !matches!(cmp, RestorationFilter::None {}),
  143|      0|      RestorationFilter::Sgrproj { set, xqd } => {
  144|      0|        if let RestorationFilter::Sgrproj { set: set2, xqd: xqd2 } = cmp {
  145|      0|          !(set == set2 && xqd[0] == xqd2[0] && xqd[1] == xqd2[1])
  146|       |        } else {
  147|      0|          true
  148|       |        }
  149|       |      }
  150|      0|      RestorationFilter::Wiener { coeffs } => {
  151|      0|        if let RestorationFilter::Wiener { coeffs: coeffs2 } = cmp {
  152|      0|          !(coeffs[0][0] == coeffs2[0][0]
  153|      0|            && coeffs[0][1] == coeffs2[0][1]
  154|      0|            && coeffs[0][2] == coeffs2[0][2]
  155|      0|            && coeffs[1][0] == coeffs2[1][0]
  156|      0|            && coeffs[1][1] == coeffs2[1][1]
  157|      0|            && coeffs[1][2] == coeffs2[1][2])
  158|       |        } else {
  159|      0|          true
  160|       |        }
  161|       |      }
  162|       |    }
  163|  5.32k|  }
