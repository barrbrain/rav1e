_RINvNtCsgGiEFdpFC8m_5rav1e7deblock12sse_optimizehEB4_:
 1572|  5.49k|fn sse_optimize<T: Pixel>(
 1573|  5.49k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  5.49k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  5.49k|) -> [u8; 4] {
 1576|  5.49k|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|  5.49k|  assert!(
 1578|  5.49k|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|  5.49k|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|  5.49k|      < 35
 1581|  5.49k|  );
 1582|  5.49k|  let mut level = [0; 4];
 1583|  5.49k|  let planes = if monochrome { 1 } else { MAX_PLANES };
 1584|       |
 1585|  13.9k|  for pli in 0..planes {
 1586|  13.9k|    let mut v_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1587|  13.9k|    let mut h_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1588|  13.9k|
 1589|  13.9k|    sse_plane(
 1590|  13.9k|      &rec.planes[pli],
 1591|  13.9k|      &input.planes[pli],
 1592|  13.9k|      &mut v_tally,
 1593|  13.9k|      &mut h_tally,
 1594|  13.9k|      pli,
 1595|  13.9k|      blocks,
 1596|  13.9k|      crop_w,
 1597|  13.9k|      crop_h,
 1598|  13.9k|      bd,
 1599|  13.9k|    );
 1600|       |
 1601|   895k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   881k|      v_tally[i] += v_tally[i - 1];
 1603|   881k|      h_tally[i] += h_tally[i - 1];
 1604|   881k|    }
 1605|       |
 1606|  13.9k|    match pli {
 1607|       |      0 => {
 1608|  5.49k|        let mut best_v = 999;
 1609|  5.49k|        let mut best_h = 999;
 1610|   356k|        for i in 0..=MAX_LOOP_FILTER {
 1611|   351k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  10.0k|            best_v = i;
 1613|   341k|          };
 1614|   351k|          if best_h == 999 || h_tally[best_h] > h_tally[i] {
 1615|  9.90k|            best_h = i;
 1616|   341k|          };
 1617|       |        }
 1618|  5.49k|        level[0] = best_v as u8;
 1619|  5.49k|        level[1] = best_h as u8;
 1620|       |      }
 1621|       |      1 | 2 => {
 1622|  8.50k|        let mut best = 999;
 1623|   553k|        for i in 0..=MAX_LOOP_FILTER {
 1624|   544k|          if best == 999
 1625|   536k|            || v_tally[best] + h_tally[best] > v_tally[i] + h_tally[i]
 1626|  12.6k|          {
 1627|  12.6k|            best = i;
 1628|   531k|          };
 1629|       |        }
 1630|  8.50k|        level[pli + 1] = best as u8;
 1631|       |      }
 1632|      0|      _ => unreachable!(),
 1633|       |    }
 1634|       |  }
 1635|  5.49k|  level
 1636|  5.49k|}
