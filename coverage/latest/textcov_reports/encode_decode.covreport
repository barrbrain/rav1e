  138|    611|      .min(max_tile_rows_log2);
  139|    611|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    611|
  141|    611|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    611|
  143|    611|    Self {
  144|    611|      frame_width,
  145|    611|      frame_height,
  146|    611|      tile_width_sb,
  147|    611|      tile_height_sb,
  148|    611|      cols,
  149|    611|      rows,
  150|    611|      tile_cols_log2,
  151|    611|      tile_rows_log2,
  152|    611|      min_tile_cols_log2,
  153|    611|      max_tile_cols_log2,
  154|    611|      min_tile_rows_log2,
  155|    611|      max_tile_rows_log2,
  156|    611|      sb_size_log2,
  157|    611|      min_tiles_log2,
