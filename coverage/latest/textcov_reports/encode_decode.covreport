  219|  26.7k|fn estimate_sb_motion<T: Pixel>(
  220|  26.7k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  26.7k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  26.7k|  lambda: u32,
  223|  26.7k|) {
  224|  26.7k|  let pix_offset = tile_bo.to_luma_plane_offset();
  225|  26.7k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  226|  26.7k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  227|  26.7k|
  228|  26.7k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  229|       |
  230|       |  // Process in blocks, cropping at edges.
  231|  52.2k|  for y in (0..sb_h).step_by(mv_size) {
  232|   124k|    for x in (0..sb_w).step_by(mv_size) {
  233|   124k|      let corner: MVSamplingMode = if init {
  234|  8.93k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|   115k|        MVSamplingMode::CORNER {
  239|   115k|          right: x as usize & mv_size == mv_size,
  240|   115k|          bottom: y as usize & mv_size == mv_size,
  241|   115k|        }
  242|       |      };
  243|       |
  244|   124k|      let sub_bo = tile_bo
  245|   124k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|   124k|
  247|   124k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|   124k|      // The rounding makes some assumptions about how subsampling is done.
  249|   124k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|   124k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|   124k|      if let Some(results) = estimate_motion(
  256|   124k|        fi,
  257|   124k|        ts,
  258|   124k|        w,
  259|   124k|        h,
  260|   124k|        sub_bo,
  261|   124k|        ref_frame,
  262|   124k|        None,
  263|   124k|        corner,
  264|   124k|        init,
  265|   124k|        ssdec,
  266|   124k|        Some(lambda),
  267|   124k|      ) {
  268|   108k|        // normalize sad to 128x128 block
  269|   108k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|   108k|          / (w * h) as u64) as u32;
  271|   108k|        save_me_stats(
  272|   108k|          ts,
  273|   108k|          mv_size_in_b_log2,
  274|   108k|          sub_bo,
  275|   108k|          ref_frame,
  276|   108k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|   108k|        );
  278|   108k|      }
  279|       |    }
  280|       |  }
  281|  26.7k|}
