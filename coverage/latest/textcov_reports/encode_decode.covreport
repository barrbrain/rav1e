  782|  4.70M|        stripe_w: usize, bit_depth: usize, w0: i32, w1: i32, w2: i32,
  783|  4.70M|      ) {
  784|  4.70M|        let line_it = line[..stripe_w].iter();
  785|  4.70M|        let f_r2_ab_it = f_r2_ab[..stripe_w].iter();
  786|  4.70M|        let f_r1_it = f_r1[..stripe_w].iter();
  787|  4.70M|        let out_it = out[..stripe_w].iter_mut();
  788|  4.70M|
  789|  4.70M|        for ((o, &u), (&f_r2_ab, &f_r1)) in
  790|  4.70M|          out_it.zip(line_it).zip(f_r2_ab_it.zip(f_r1_it))
  791|  4.70M|        {
  792|  4.70M|          let u = i32::cast_from(u) << SGRPROJ_RST_BITS;
  793|  4.70M|          let v = w0 * f_r2_ab as i32 + w1 * u + w2 * f_r1 as i32;
  794|  4.70M|          let s = (v + (1 << (SGRPROJ_RST_BITS + SGRPROJ_PRJ_BITS) >> 1))
  795|  4.70M|            >> (SGRPROJ_RST_BITS + SGRPROJ_PRJ_BITS);
  796|  4.70M|          *o = U::cast_from(clamp(s, 0, (1 << bit_depth) - 1));
  797|  4.70M|        }
  798|  4.70M|      }
  799|  4.70M|
  800|  4.70M|      apply_filter(
  801|  4.70M|        &mut out[y],
  802|  4.70M|        line,
  803|  4.70M|        &f_r1,
  804|  4.70M|        f_r2_ab[dy],
  805|  4.70M|        stripe_w,
  806|  4.70M|        fi.sequence.bit_depth,
  807|  4.70M|        w0,
  808|  4.70M|        w1,
  809|  4.70M|        w2,
  810|  4.70M|      );
  811|       |    }
  812|       |  }
