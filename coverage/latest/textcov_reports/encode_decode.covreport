  283|  7.11k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  7.11k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  7.11k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
  286|  7.11k|) {
  287|  7.11k|  let pix_offset = tile_bo.to_luma_plane_offset();
  288|  7.11k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  289|  7.11k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  290|  7.11k|
  291|  7.11k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  292|       |
  293|       |  // Process in blocks, cropping at edges.
  294|  9.52k|  for y in (0..sb_h).step_by(mv_size) {
  295|  13.6k|    for x in (0..sb_w).step_by(mv_size) {
  296|  13.6k|      let sub_bo = tile_bo
  297|  13.6k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  298|  13.6k|
  299|  13.6k|      // Clamp to frame edge, rounding up in the case of subsampling.
  300|  13.6k|      // The rounding makes some assumptions about how subsampling is done.
  301|  13.6k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  302|  13.6k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  303|       |
  304|       |      // Refine the existing motion estimate
  305|  13.6k|      if let Some(results) = refine_subsampled_motion_estimate(
  306|  13.6k|        fi, ts, w, h, sub_bo, ref_frame, ssdec, lambda,
  307|  13.6k|      ) {
  308|  12.4k|        // normalize sad to 128x128 block
  309|  12.4k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  310|  12.4k|          / (w * h) as u64) as u32;
  311|  12.4k|        save_me_stats(
  312|  12.4k|          ts,
  313|  12.4k|          mv_size_in_b_log2,
  314|  12.4k|          sub_bo,
  315|  12.4k|          ref_frame,
  316|  12.4k|          MEStats { mv: results.mv, normalized_sad: sad },
  317|  12.4k|        );
  318|  12.4k|      }
  319|       |    }
  320|       |  }
  321|  7.11k|}
