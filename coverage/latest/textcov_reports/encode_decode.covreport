  390|   135k|  let mut min_sad: u32 = u32::MAX;
  391|   135k|  let mut subset_b = ArrayVec::<MotionVector, 5>::new();
  392|   135k|  let mut subset_c = ArrayVec::<MotionVector, 5>::new();
  393|   135k|
  394|   135k|  // rounded up width in blocks
  395|   135k|  let w = ((pix_w << ssdec) + MI_SIZE - 1) >> MI_SIZE_LOG2;
  396|   135k|  let h = ((pix_h << ssdec) + MI_SIZE - 1) >> MI_SIZE_LOG2;
  397|   135k|
  398|   135k|  // Get predictors from the same frame.
  399|   135k|
