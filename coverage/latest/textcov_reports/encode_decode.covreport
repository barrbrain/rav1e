   76|    319|    grain_table: Option<Vec<GrainTableSegment>>,
   77|    319|  ) {
   78|    319|    let mut ra = ChaChaRng::from_seed([0; 32]);
   79|    319|
   80|    319|    let mut ctx: Context<T> = setup_encoder(
   81|    319|      w,
   82|    319|      h,
   83|    319|      speed,
   84|    319|      quantizer,
   85|    319|      bit_depth,
   86|    319|      chroma_sampling,
   87|    319|      min_keyint,
   88|    319|      max_keyint,
   89|    319|      switch_frame_interval,
   90|    319|      low_latency,
   91|    319|      error_resilient,
   92|    319|      bitrate,
   93|    319|      tile_cols_log2,
   94|    319|      tile_rows_log2,
   95|    319|      still_picture,
   96|    319|      grain_table,
   97|    319|    );
   98|    319|
   99|    319|    debug!(
  100|      0|      "Encoding {}x{} speed {} quantizer {} bit-depth {} bitrate {}",
  101|       |      w, h, speed, quantizer, bit_depth, bitrate
  102|       |    );
  103|       |    #[cfg(feature = "dump_ivf")]
  104|       |    let mut out = std::fs::File::create(&format!(
  105|       |      "out-{}x{}-s{}-q{}-r{}-{:?}.ivf",
  106|       |      w, h, speed, quantizer, bitrate, chroma_sampling
  107|       |    ))
  108|       |    .unwrap();
  109|       |    #[cfg(feature = "dump_ivf")]
  110|       |    ivf::write_ivf_header(&mut out, w, h, 30, 1);
  111|       |
  112|    319|    let mut rec_fifo = VecDeque::new();
  113|    319|    read_frame_batch(&mut ctx, &mut ra, limit);
  114|    319|
  115|    319|    for _ in 0..limit {
  116|    539|      let mut corrupted_count = 0;
  117|    539|      loop {
  118|    539|        let res = ctx.receive_packet();
  119|    539|        if let Ok(pkt) = res {
  120|    473|          debug!("Encoded packet {}", pkt.input_frameno);
  121|       |
  122|       |          #[cfg(feature = "dump_ivf")]
  123|       |          ivf::write_ivf_frame(&mut out, pkt.input_frameno, &pkt.data);
  124|       |
  125|    473|          if let Some(pkt_rec) = pkt.rec {
  126|    473|            rec_fifo.push_back((*pkt_rec).clone());
  127|    473|          }
  128|    473|          let packet = pkt.data;
  129|    473|          debug!("Decoding frame {}", pkt.input_frameno);
  130|    473|          match self.decode_packet(
  131|    473|            &packet,
  132|    473|            &mut rec_fifo,
  133|    473|            w,
  134|    473|            h,
  135|    473|            chroma_sampling,
  136|    473|            bit_depth,
  137|    473|            verify,
  138|    473|          ) {
  139|       |            DecodeResult::Done => {
  140|    473|              break;
  141|       |            }
  142|      0|            DecodeResult::NotDone => {}
  143|      0|            DecodeResult::Corrupted(corrupted) => {
  144|      0|              corrupted_count += corrupted;
  145|      0|            }
  146|       |          }
  147|       |        } else {
  148|     66|          break;
  149|       |        }
  150|       |      }
  151|    539|      assert_eq!(corrupted_count, 0);
  152|       |    }
  153|    319|  }
