  473|       |  // Sample the middle of this block in the previous frame.
  474|       |
  475|   137k|  if let Some(frame_me_stats) = frame_ref_opt {
  476|   137k|    let prev_frame = &frame_me_stats[ref_frame_id];
  477|   137k|
  478|   137k|    let frame_bo = PlaneBlockOffset(BlockOffset {
  479|   137k|      x: tile_me_stats.x() + tile_bo.0.x,
  480|   137k|      y: tile_me_stats.y() + tile_bo.0.y,
