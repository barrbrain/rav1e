 1391|  7.67M|  }
 1392|  7.67M|
 1393|  7.67M|  // Convert the motion vector into an full pixel offset.
 1394|  7.67M|  let plane_ref = p_ref.region(Area::StartingAt {
 1395|  7.67M|    x: po.x + (cand_mv.col / 8) as isize,
 1396|  7.67M|    y: po.y + (cand_mv.row / 8) as isize,
 1397|  7.67M|  });
 1398|  7.67M|  compute_mv_rd(
 1399|  7.67M|    fi, pmv, lambda, use_satd, bit_depth, w, h, cand_mv, org_region,
 1400|  7.67M|    &plane_ref,
 1401|  7.67M|  )
