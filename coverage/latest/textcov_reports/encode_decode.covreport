  179|  26.1M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  26.1M|    let t = Self::ADD(p1, p0);
  181|  26.1M|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  26.1M|    let out1 = Self::SUB(a, out0);
  183|  26.1M|    (out0, out1)
  184|  26.1M|  }
_RNvYNtNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward14RotateSubShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  96.7M|  $($s)* fn half_kernel(
  219|  96.7M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  96.7M|  ) -> (T, T) {
  221|  96.7M|    let t = Self::ADD(p1, p0.0);
  222|  96.7M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  96.7M|    let out0 = b.add(c);
  224|  96.7M|    let shifted = Self::SHIFT(c);
  225|  96.7M|    let out1 = Self::SUB(a, shifted);
  226|  96.7M|    (out0, out1)
  227|  96.7M|  }
_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward21daala_fdct_ii_16_asymNtB2_5I32X8EBa_:
  947|  7.61M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  7.61M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  7.61M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|  7.61M|  seh: T, sf: (T, T), output: &mut [T],
  951|  7.61M|) {
  952|  7.61M|  // +/- Butterflies with asymmetric input.
  953|  7.61M|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|  7.61M|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|  7.61M|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|  7.61M|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|  7.61M|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|  7.61M|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|  7.61M|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|  7.61M|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|  7.61M|
  962|  7.61M|  // Embedded 8-point orthonormal transforms.
  963|  7.61M|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|  7.61M|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
