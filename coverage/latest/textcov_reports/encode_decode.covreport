 1546|   554k|      let ref_frames = &self.bc.blocks[bo_up].ref_frames;
 1547|   554k|      (ref_frames[0], ref_frames[1])
 1548|       |    } else {
 1549|   217k|      (INTRA_FRAME, NONE_FRAME)
 1550|       |    };
 1551|   771k|    let left_single = left1 == NONE_FRAME;
 1552|   771k|    let above_single = above1 == NONE_FRAME;
 1553|   771k|    let left_intra = left0 == INTRA_FRAME;
 1554|   771k|    let above_intra = above0 == INTRA_FRAME;
