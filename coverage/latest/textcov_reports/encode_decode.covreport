 1586|   746k|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|   746k|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|   746k|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|   746k|  let mut half: [T; 32] = [T::zero(); 32];
 1591|   746k|  // +/- Butterflies with asymmetric output.
 1592|   746k|  {
 1593|   746k|    #[$m]
 1594|   746k|    #[inline]
 1595|   746k|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|   746k|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|   746k|    ) {
 1598|   746k|      let j = i * 2;
 1599|   746k|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|   746k|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|   746k|      half[i] = ah;
 1602|   746k|      half[31 - i] = dh;
 1603|   746k|      asym[i] = b;
 1604|   746k|      asym[31 - i] = c;
 1605|   746k|    }
 1606|   746k|    butterfly_pair(&mut half, &mut asym, coeffs, 0);
