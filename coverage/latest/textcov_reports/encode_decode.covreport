 1233|      8|        }
 1234|       |        // If we're too quick draining the buffer and underflow is capped,
 1235|       |        //  don't try to make up that rate later.
 1236|      8|        if self.cap_underflow {
 1237|      0|          self.reservoir_fullness = self.reservoir_fullness.max(0);
 1238|      8|        }
 1239|       |        // Adjust the bias for the real bits we've used.
