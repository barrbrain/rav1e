  338|    116|    if !&self.score_deque[self.deque_offset..]
  339|    116|      .iter()
  340|    116|      .any(|result| result.imp_block_cost >= imp_block_threshold)
  341|       |    {
  342|      0|      return (false, score);
  343|    116|    }
  344|    116|
  345|    116|    let cost = score.forward_adjusted_cost;
