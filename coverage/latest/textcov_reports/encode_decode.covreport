  346|  5.75M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  5.75M|    let div_shift = AREA_DIVISOR_BITS;
  348|  5.75M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  5.75M|    // two. Saturate to avoid underflow.
