_RNvMNtCs5T1csxkeGwJ_5rav1e8quantizeNtB2_19QuantizationContext6update:
  195|   101M|  pub fn update(
  196|   101M|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|   101M|    dc_delta_q: i8, ac_delta_q: i8,
  198|   101M|  ) {
  199|   101M|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|   101M|
  201|   101M|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|   101M|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|   101M|
  204|   101M|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|   101M|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|   101M|
  207|   101M|    // All of these biases were derived by measuring the cost of coding
  208|   101M|    // a zero vs coding a one on any given coefficient position, or, in
  209|   101M|    // the case of the EOB bias, the cost of coding the block with
  210|   101M|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|   101M|    // to choose a new EOB. This was done over several clips, with the
  212|   101M|    // average of the bit costs taken over all blocks in the set, and a new
  213|   101M|    // bias derived via the method outlined in Jean-Marc Valin's
  214|   101M|    // Journal of Dubious Theoretical Results[1], aka:
  215|   101M|    //
  216|   101M|    // lambda = ln(2) / 6.0
  217|   101M|    // threshold = 0.5 + (lambda * avg_rate_diff) / 2.0
  218|   101M|    // bias = 1 - threshold
  219|   101M|    //
  220|   101M|    // lambda is a constant since our offsets are already adjusted for the
  221|   101M|    // quantizer.
  222|   101M|    //
  223|   101M|    // Biases were then updated, and cost collection was re-run, until
  224|   101M|    // the calculated biases started to converge after 2-4 iterations.
  225|   101M|    //
  226|   101M|    // In theory, the rounding biases for inter should be somewhat smaller
  227|   101M|    // than the biases for intra, but this turns out to only be the case
  228|   101M|    // for EOB optimization, or at least, is covered by EOB optimization.
  229|   101M|    // The RD-optimal rounding biases for the actual coefficients seem
  230|   101M|    // to be quite close (+/- 1/256), for both inter and intra,
  231|   101M|    // post-deadzoning.
  232|   101M|    //
  233|   101M|    // [1] https://jmvalin.ca/notes/theoretical_results.pdf
  234|   101M|    self.dc_offset = self.dc_quant * (if is_intra { 109 } else { 108 }) / 256;
  235|   101M|    self.ac_offset0 = self.ac_quant * (if is_intra { 98 } else { 97 }) / 256;
  236|   101M|    self.ac_offset1 = self.ac_quant * (if is_intra { 109 } else { 108 }) / 256;
  237|       |    self.ac_offset_eob =
  238|   101M|      self.ac_quant * (if is_intra { 88 } else { 44 }) / 256;
  239|   101M|  }
