   49|  10.5k|fn select_qi(quantizer: i64, qlookup: &[i16; QINDEX_RANGE]) -> u8 {
   50|  10.5k|  if quantizer < qlookup[MINQ] as i64 {
   51|     88|    MINQ as u8
   52|  10.4k|  } else if quantizer >= qlookup[MAXQ] as i64 {
   53|    351|    MAXQ as u8
   54|       |  } else {
   55|  10.0k|    match qlookup.binary_search(&(quantizer as i16)) {
   56|  5.47k|      Ok(qi) => qi as u8,
   57|  4.61k|      Err(qi) => {
   58|      0|        debug_assert!(qi > MINQ);
   59|      0|        debug_assert!(qi <= MAXQ);
   60|       |        // Pick the closest quantizer in the log domain.
   61|  4.61k|        let qthresh = (qlookup[qi - 1] as i32) * (qlookup[qi] as i32);
   62|  4.61k|        let q2_i32 = (quantizer as i32) * (quantizer as i32);
   63|  4.61k|        if q2_i32 < qthresh {
   64|  1.35k|          (qi - 1) as u8
   65|       |        } else {
   66|  3.25k|          qi as u8
   67|       |        }
   68|       |      }
   69|       |    }
   70|       |  }
   71|  10.5k|}
_RNvNtCs3tIhnEwGhQF_5rav1e8quantize9divu_pairB3_:
  125|  7.23G|const fn divu_pair(x: u32, d: (u32, u32, u32)) -> u32 {
  126|  7.23G|  let x = x as u64;
  127|  7.23G|  let (a, b, shift) = d;
  128|  7.23G|  let shift = shift as u64;
  129|  7.23G|  let a = a as u64;
  130|  7.23G|  let b = b as u64;
  131|  7.23G|
  132|  7.23G|  (((a * x + b) >> 32) >> shift) as u32
  133|  7.23G|}
