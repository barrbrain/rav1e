_RNvMs1_NtCsixsdkNzQ5tW_5rav1e3lrfINtB5_14VertPaddedIterhE3newB7_:
  394|  13.8k|  fn new(
  395|  13.8k|    cdeffed: &PlaneSlice<'a, T>, deblocked: &PlaneSlice<'a, T>,
  396|  13.8k|    stripe_h: usize, crop: usize,
  397|  13.8k|  ) -> VertPaddedIter<'a, T> {
  398|  13.8k|    // cdeffed and deblocked must start at the same coordinates from their
  399|  13.8k|    // underlying planes. Since cropping is provided via a separate params, the
  400|  13.8k|    // height of the underlying planes do not need to match.
  401|  13.8k|    assert_eq!(cdeffed.x, deblocked.x);
  402|  13.8k|    assert_eq!(cdeffed.y, deblocked.y);
  403|       |
  404|       |    // To share integral images, always use the max box filter radius of 2
  405|  13.8k|    let r = 2;
  406|  13.8k|
  407|  13.8k|    // The number of rows outside the stripe are needed
  408|  13.8k|    let rows_above = r + 2;
  409|  13.8k|    let rows_below = 2;
  410|  13.8k|
  411|  13.8k|    // Offset crop and stripe_h so they are relative to the underlying plane
  412|  13.8k|    // and not the plane slice.
  413|  13.8k|    let crop = crop as isize + deblocked.y;
  414|  13.8k|    let stripe_end = stripe_h as isize + deblocked.y;
  415|  13.8k|
  416|  13.8k|    // Move y up the number rows above.
  417|  13.8k|    // If y is negative we repeat the first row
  418|  13.8k|    let y = deblocked.y - rows_above as isize;
  419|  13.8k|
  420|  13.8k|    VertPaddedIter {
  421|  13.8k|      deblocked: deblocked.plane,
  422|  13.8k|      cdeffed: cdeffed.plane,
  423|  13.8k|      x: deblocked.x,
  424|  13.8k|      y,
  425|  13.8k|      end: (rows_above + stripe_h + rows_below) as isize + y,
  426|  13.8k|      stripe_begin: deblocked.y,
  427|  13.8k|      stripe_end,
  428|  13.8k|      crop,
  429|  13.8k|    }
  430|  13.8k|  }
