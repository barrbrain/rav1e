  449|   344k|  let (q0, q1) = daala_fdct_ii_2(q0, q1);
  450|   344k|  let (q3, q2) = daala_fdst_iv_2(q3, q2);
  451|   344k|
  452|   344k|  store_coeffs!(output, q0, q1, q2, q3);
  453|   344k|}
