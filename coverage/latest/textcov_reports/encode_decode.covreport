_RNvNtCsgGiEFdpFC8m_5rav1e2me12get_mv_range:
  338|   484k|fn get_mv_range(
  339|   484k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   484k|  blk_h: usize,
  341|   484k|) -> (isize, isize, isize, isize) {
  342|   484k|  let border_w = 128 + blk_w as isize * 8;
  343|   484k|  let border_h = 128 + blk_h as isize * 8;
  344|   484k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   484k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   484k|    * (8 * MI_SIZE) as isize
  347|   484k|    + border_w;
  348|   484k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   484k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   484k|    * (8 * MI_SIZE) as isize
  351|   484k|    + border_h;
