  248|   128k|      // The rounding makes some assumptions about how subsampling is done.
  249|   128k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|   128k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
