   43|   173M|    [&ac_qlookup_Q3, &ac_qlookup_10_Q3, &ac_qlookup_12_Q3];
   44|   173M|  let bd = ((bit_depth ^ 8) >> 1).min(2);
   45|   173M|  AC_Q[bd][((qindex as isize + delta_q as isize).max(0) as usize).min(255)]
   46|   173M|}
