_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward20daala_fdst_iv_4_asymNtB2_5I32X8EBa_:
  456|  15.4M|$($s)* fn daala_fdst_iv_4_asym<T: TxOperations>(
  457|  15.4M|  q0: (T, T), q1h: T, q2: (T, T), q3h: T, output: &mut [T],
  458|  15.4M|) {
  459|  15.4M|  // Stage 0
  460|  15.4M|  //  9633/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/2 = 0.5879378012096793
  461|  15.4M|  //  12873/8192 = (Sin[7*Pi/16] - Cos[7*Pi/16])*2 = 1.5713899167742045
  462|  15.4M|  // 12785/32768 = Cos[7*Pi/16]*2                  = 0.3901806440322565
  463|  15.4M|  let (q0, q3) = RotateAddShift::half_kernel(
  464|  15.4M|    q0,
  465|  15.4M|    q3h,
  466|  15.4M|    ((9633, 14), (12873, 13), (12785, 15)),
  467|  15.4M|  );
  468|  15.4M|  // 11363/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/2 = 0.6935199226610738
  469|  15.4M|  // 18081/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*2 = 0.5517987585658861
  470|  15.4M|  //  4551/4096 = Cos[5*Pi/16]*2                  = 1.1111404660392044
  471|  15.4M|  let (q2, q1) = RotateSubShift::half_kernel(
  472|  15.4M|    q2,
  473|  15.4M|    q1h,
  474|  15.4M|    ((11363, 14), (18081, 15), (4551, 12)),
  475|  15.4M|  );
  476|  15.4M|
  477|  15.4M|  // Stage 1
  478|  15.4M|  let (q2, q3) = butterfly_sub_asym((q2.rshift1(), q2), q3);
  479|  15.4M|  let (q0, q1) = butterfly_sub_asym((q0.rshift1(), q0), q1);
  480|  15.4M|
  481|  15.4M|  // Stage 2
  482|  15.4M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  483|  15.4M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  484|  15.4M|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  485|  15.4M|
  486|  15.4M|  store_coeffs!(output, q0, q1, q2, q3);
  487|  15.4M|}
