  470|       |  // EPZS subset C predictors.
  471|       |  // Sample the middle of bordering side of the left, right, top and bottom
  472|       |  // blocks of the previous frame.
  473|       |  // Sample the middle of this block in the previous frame.
  474|       |
  475|   135k|  if let Some(frame_me_stats) = frame_ref_opt {
  476|   135k|    let prev_frame = &frame_me_stats[ref_frame_id];
  477|   135k|
  478|   135k|    let frame_bo = PlaneBlockOffset(BlockOffset {
  479|   135k|      x: tile_me_stats.x() + tile_bo.0.x,
  480|   135k|      y: tile_me_stats.y() + tile_bo.0.y,
  481|   135k|    });
  482|   135k|    let clipped_half_w = (w >> 1).min(prev_frame.cols - 1 - frame_bo.0.x);
  483|   135k|    let clipped_half_h = (h >> 1).min(prev_frame.rows - 1 - frame_bo.0.y);
  484|   135k|
  485|   135k|    // left
  486|   135k|    if frame_bo.0.x > 0 {
  487|   116k|      subset_c.push(process_cand(
  488|   116k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x - 1],
  489|   116k|      ));
  490|   116k|    }
  491|       |    // top
  492|   135k|    if frame_bo.0.y > 0 {
  493|   116k|      subset_c.push(process_cand(
  494|   116k|        prev_frame[frame_bo.0.y - 1][frame_bo.0.x + clipped_half_w],
  495|   116k|      ));
  496|   116k|    }
  497|       |    // right
  498|   135k|    if frame_bo.0.x + w < prev_frame.cols {
  499|   114k|      subset_c.push(process_cand(
  500|   114k|        prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + w],
  501|   114k|      ));
  502|   114k|    }
  503|       |    // bottom
  504|   135k|    if frame_bo.0.y + h < prev_frame.rows {
  505|   114k|      subset_c.push(process_cand(
  506|   114k|        prev_frame[frame_bo.0.y + h][frame_bo.0.x + clipped_half_w],
  507|   114k|      ));
  508|   114k|    }
  509|       |
  510|   135k|    subset_c.push(process_cand(
  511|   135k|      prev_frame[frame_bo.0.y + clipped_half_h][frame_bo.0.x + clipped_half_w],
  512|   135k|    ));
  513|      0|  }
  514|       |
  515|       |  // Undo normalization to 128x128 block size
  516|   135k|  let min_sad = ((min_sad as u64 * (pix_w * pix_h) as u64)
  517|   135k|    >> (MAX_SB_SIZE_LOG2 * 2)) as u32;
  518|   135k|
  519|   135k|  let dec_mv = |mv: MotionVector| MotionVector {
  520|       |    col: mv.col >> ssdec,
  521|       |    row: mv.row >> ssdec,
  522|       |  };
  523|   135k|  let median = median.map(dec_mv);
  524|   491k|  for mv in subset_b.iter_mut() {
  525|   491k|    *mv = dec_mv(*mv);
  526|   491k|  }
  527|   597k|  for mv in subset_c.iter_mut() {
  528|   597k|    *mv = dec_mv(*mv);
  529|   597k|  }
  530|       |
  531|   135k|  MotionEstimationSubsets { min_sad, median, subset_b, subset_c }
  532|   135k|}
