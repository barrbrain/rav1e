   59|    708|    is_422_p: bool,
   60|    708|  ) -> Self {
   61|    708|    // <https://aomediacodec.github.io/av1-spec/#tile-info-syntax>
   62|    708|
   63|    708|    // Frame::new() aligns to the next multiple of 8
   64|    708|    let frame_width = frame_width.align_power_of_two(3);
   65|    708|    let frame_height = frame_height.align_power_of_two(3);
   66|    708|    let frame_width_sb =
