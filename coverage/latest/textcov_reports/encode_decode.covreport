_RNvNtCsgLNdNkfkEgK_5rav1e7deblock20deblock_size14_innerB3_:
  864|   429k|fn deblock_size14_inner(
  865|   429k|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|   429k|  level: usize, bd: usize,
  867|   429k|) -> Option<[i32; 12]> {
  868|   429k|  // 'mask' test
  869|   429k|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|  38.1k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
  872|  38.1k|    let x = if flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat {
  873|       |      // outer flatness test
  874|  2.99k|      if flat14_outer(p6, p5, p4, p0, q0, q4, q5, q6) <= flat {
  875|       |        // sufficient flatness across 14 pixel width; run full-width filter
  876|  2.48k|        filter_wide14_12(
  877|  2.48k|          p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6,
  878|  2.48k|        )
  879|       |      } else {
  880|       |        // only flat in inner area, run 8-tap
  881|    512|        filter_wide8_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5)
  882|       |      }
  883|  35.1k|    } else if nhev4(p1, p0, q0, q1, bd - 8) <= level {
  884|       |      // not flat, run narrow filter
  885|  1.41k|      filter_narrow4_12(p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, bd - 8)
  886|       |    } else {
