  411|  64.3M|        // Don't need to loop over rows
  412|  64.3M|        let buf = array_mut_ref!(buf, 0, 4);
  413|  64.3M|        let input = array_ref!(col_coeffs, 0, 4);
  414|  64.3M|        transpose_4x4_avx2(input, buf);
  415|  64.3M|      }
  416|       |    }
  417|       |  }
  418|       |
  419|       |  // Rows
  420|   143M|  for rg in (0..txfm_size_row).step_by(8) {
  421|   143M|    let row_coeffs = &mut buf[rg / 8 * txfm_size_col..][..txfm_size_col];
  422|   143M|
  423|   143M|    if cfg.lr_flip {
  424|      0|      row_coeffs.reverse();
  425|   143M|    }
  426|       |
  427|   143M|    txfm_func_row(row_coeffs);
  428|   143M|    round_shift_array_avx2(row_coeffs, -cfg.shift[2]);
