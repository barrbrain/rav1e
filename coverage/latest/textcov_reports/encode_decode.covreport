  394|    102|  fn new(
  395|    102|    cdeffed: &PlaneSlice<'a, T>, deblocked: &PlaneSlice<'a, T>,
  396|    102|    stripe_h: usize, crop: usize,
  397|    102|  ) -> VertPaddedIter<'a, T> {
  398|    102|    // cdeffed and deblocked must start at the same coordinates from their
  399|    102|    // underlying planes. Since cropping is provided via a separate params, the
  400|    102|    // height of the underlying planes do not need to match.
  401|    102|    assert_eq!(cdeffed.x, deblocked.x);
