  218|  64.8M|  $($s)* fn half_kernel(
  219|  64.8M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  64.8M|  ) -> (T, T) {
  221|  64.8M|    let t = Self::ADD(p1, p0.0);
  222|  64.8M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
