  743|     11|      .map(|(&d, &a)| d * a)
  744|     11|      .collect::<Box<_>>();
  745|     11|
  746|     11|    let inv_mean = DistortionScale::inv_mean(&scores);
  747|       |
  748|  2.02k|    for score in scores.iter_mut() {
  749|  2.02k|      *score *= inv_mean;
  750|  2.02k|    }
  751|       |
  752|  2.02k|    for scale in self.distortion_scales.iter_mut() {
  753|  2.02k|      *scale *= inv_mean;
  754|  2.02k|    }
  755|       |
  756|     11|    self.spatiotemporal_scores = scores;
  757|     11|
  758|     11|    inv_mean.blog64() >> 1
  759|     11|  }
