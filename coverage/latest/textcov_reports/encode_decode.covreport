 1586|  1.16M|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|  1.16M|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|  1.16M|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|  1.16M|  let mut half: [T; 32] = [T::zero(); 32];
 1591|  1.16M|  // +/- Butterflies with asymmetric output.
 1592|  1.16M|  {
 1593|  1.16M|    #[$m]
 1594|  1.16M|    #[inline]
 1595|  1.16M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  1.16M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  1.16M|    ) {
 1598|  1.16M|      let j = i * 2;
 1599|  1.16M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  1.16M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  1.16M|      half[i] = ah;
 1602|  1.16M|      half[31 - i] = dh;
 1603|  1.16M|      asym[i] = b;
 1604|  1.16M|      asym[31 - i] = c;
 1605|  1.16M|    }
 1606|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 0);
 1607|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 1);
 1608|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 2);
 1609|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 3);
 1610|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 4);
 1611|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 5);
 1612|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 6);
 1613|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 7);
 1614|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 8);
 1615|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 9);
 1616|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 10);
 1617|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 11);
 1618|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 12);
 1619|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 13);
 1620|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 14);
 1621|  1.16M|    butterfly_pair(&mut half, &mut asym, coeffs, 15);
 1622|  1.16M|  }
 1623|  1.16M|
 1624|  1.16M|  let mut temp_out: [T; 64] = [T::zero(); 64];
 1625|  1.16M|  // Embedded 2-point transforms with asymmetric input.
 1626|  1.16M|  daala_fdct_ii_32_asym(
 1627|  1.16M|    half[0],
 1628|  1.16M|    asym[0],
 1629|  1.16M|    half[1],
 1630|  1.16M|    asym[1],
 1631|  1.16M|    half[2],
 1632|  1.16M|    asym[2],
 1633|  1.16M|    half[3],
 1634|  1.16M|    asym[3],
 1635|  1.16M|    half[4],
 1636|  1.16M|    asym[4],
 1637|  1.16M|    half[5],
 1638|  1.16M|    asym[5],
 1639|  1.16M|    half[6],
 1640|  1.16M|    asym[6],
 1641|  1.16M|    half[7],
 1642|  1.16M|    asym[7],
 1643|  1.16M|    half[8],
 1644|  1.16M|    asym[8],
 1645|  1.16M|    half[9],
 1646|  1.16M|    asym[9],
 1647|  1.16M|    half[10],
 1648|  1.16M|    asym[10],
 1649|  1.16M|    half[11],
 1650|  1.16M|    asym[11],
 1651|  1.16M|    half[12],
 1652|  1.16M|    asym[12],
 1653|  1.16M|    half[13],
 1654|  1.16M|    asym[13],
 1655|  1.16M|    half[14],
 1656|  1.16M|    asym[14],
 1657|  1.16M|    half[15],
 1658|  1.16M|    asym[15],
 1659|  1.16M|    &mut temp_out[0..32],
 1660|  1.16M|  );
 1661|  1.16M|  daala_fdst_iv_32_asym(
 1662|  1.16M|    asym[31],
 1663|  1.16M|    half[31],
 1664|  1.16M|    asym[30],
 1665|  1.16M|    half[30],
 1666|  1.16M|    asym[29],
 1667|  1.16M|    half[29],
 1668|  1.16M|    asym[28],
 1669|  1.16M|    half[28],
 1670|  1.16M|    asym[27],
 1671|  1.16M|    half[27],
 1672|  1.16M|    asym[26],
 1673|  1.16M|    half[26],
 1674|  1.16M|    asym[25],
 1675|  1.16M|    half[25],
 1676|  1.16M|    asym[24],
 1677|  1.16M|    half[24],
 1678|  1.16M|    asym[23],
 1679|  1.16M|    half[23],
 1680|  1.16M|    asym[22],
 1681|  1.16M|    half[22],
 1682|  1.16M|    asym[21],
 1683|  1.16M|    half[21],
 1684|  1.16M|    asym[20],
 1685|  1.16M|    half[20],
 1686|  1.16M|    asym[19],
 1687|  1.16M|    half[19],
 1688|  1.16M|    asym[18],
 1689|  1.16M|    half[18],
 1690|  1.16M|    asym[17],
 1691|  1.16M|    half[17],
 1692|  1.16M|    asym[16],
 1693|  1.16M|    half[16],
 1694|  1.16M|    &mut temp_out[32..64],
 1695|  1.16M|  );
 1696|  1.16M|  temp_out[32..64].reverse();
 1697|  1.16M|
 1698|  1.16M|  // Store a reordered version of output in temp_out
 1699|  1.16M|  #[$m]
 1700|  1.16M|  #[inline]
 1701|  1.16M|  $($s)* fn reorder_4<T: TxOperations>(
 1702|  1.16M|    output: &mut [T], i: usize, tmp: [T; 64], j: usize
 1703|  1.16M|  ) {
 1704|  1.16M|    output[0 + i * 4] = tmp[0 + j];
 1705|  1.16M|    output[1 + i * 4] = tmp[32 + j];
 1706|  1.16M|    output[2 + i * 4] = tmp[16 + j];
 1707|  1.16M|    output[3 + i * 4] = tmp[48 + j];
 1708|  1.16M|  }
 1709|  1.16M|  reorder_4(coeffs, 0, temp_out, 0);
 1710|  1.16M|  reorder_4(coeffs, 1, temp_out, 8);
 1711|  1.16M|  reorder_4(coeffs, 2, temp_out, 4);
 1712|  1.16M|  reorder_4(coeffs, 3, temp_out, 12);
 1713|  1.16M|  reorder_4(coeffs, 4, temp_out, 2);
 1714|  1.16M|  reorder_4(coeffs, 5, temp_out, 10);
 1715|  1.16M|  reorder_4(coeffs, 6, temp_out, 6);
 1716|  1.16M|  reorder_4(coeffs, 7, temp_out, 14);
 1717|  1.16M|
 1718|  1.16M|  reorder_4(coeffs, 8, temp_out, 1);
 1719|  1.16M|  reorder_4(coeffs, 9, temp_out, 9);
 1720|  1.16M|  reorder_4(coeffs, 10, temp_out, 5);
 1721|  1.16M|  reorder_4(coeffs, 11, temp_out, 13);
 1722|  1.16M|  reorder_4(coeffs, 12, temp_out, 3);
 1723|  1.16M|  reorder_4(coeffs, 13, temp_out, 11);
 1724|  1.16M|  reorder_4(coeffs, 14, temp_out, 7);
 1725|  1.16M|  reorder_4(coeffs, 15, temp_out, 15);
 1726|  1.16M|}
