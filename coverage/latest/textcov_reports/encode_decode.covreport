  312|   127M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|   127M|  let p0 = p0.sub(p1);
  314|   127M|  let p0h = p0.rshift1();
  315|   127M|  let p1h = p1.add(p0h);
  316|   127M|  ((p0h, p0), p1h)
  317|   127M|}
_RINvNtNtNtNtCsixsdkNzQ5tW_5rav1e3asm3x869transform7forward16daala_fdst_vii_4NtB2_5I32X8EBa_:
  393|  23.7M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  23.7M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  23.7M|  let q0 = coeffs[0];
  397|  23.7M|  let q1 = coeffs[1];
  398|  23.7M|  let q2 = coeffs[2];
  399|  23.7M|  let q3 = coeffs[3];
  400|  23.7M|  let t0 = q1.add(q3);
  401|  23.7M|  // t1 = (q0 + q1 - q3)/2
  402|  23.7M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  23.7M|  let t2 = q0.sub(q1);
  404|  23.7M|  let t3 = q2;
  405|  23.7M|  let t4 = q0.add(q3);
  406|  23.7M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  23.7M|  let t0 = t0.tx_mul((7021, 14));
  408|  23.7M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  23.7M|  let t1 = t1.tx_mul((37837, 15));
  410|  23.7M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  23.7M|  let t2 = t2.tx_mul((21513, 15));
  412|  23.7M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  23.7M|  let t3 = t3.tx_mul((37837, 15));
  414|  23.7M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  23.7M|  let t4 = t4.tx_mul((467, 11));
  416|  23.7M|  let t3h = t3.rshift1();
  417|  23.7M|  let u4 = t4.add(t3h);
  418|  23.7M|  coeffs[0] = t0.add(u4);
  419|  23.7M|  coeffs[1] = t1;
  420|  23.7M|  coeffs[2] = t0.add(t2.sub(t3h));
