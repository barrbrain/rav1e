  218|  14.1M|  $($s)* fn half_kernel(
  219|  14.1M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  14.1M|  ) -> (T, T) {
  221|  14.1M|    let t = Self::ADD(p1, p0.0);
  222|  14.1M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
