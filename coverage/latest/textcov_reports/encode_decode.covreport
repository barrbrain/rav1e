  463|   344k|  let (q0, q3) = RotateAddShift::half_kernel(
  464|   344k|    q0,
  465|   344k|    q3h,
  466|   344k|    ((9633, 14), (12873, 13), (12785, 15)),
  467|   344k|  );
  468|   344k|  // 11363/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/2 = 0.6935199226610738
  469|   344k|  // 18081/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*2 = 0.5517987585658861
  470|   344k|  //  4551/4096 = Cos[5*Pi/16]*2                  = 1.1111404660392044
  471|   344k|  let (q2, q1) = RotateSubShift::half_kernel(
  472|   344k|    q2,
  473|   344k|    q1h,
  474|   344k|    ((11363, 14), (18081, 15), (4551, 12)),
  475|   344k|  );
