  636|  26.4k|  if let Some(ref rec) =
  637|  30.1k|    fi.rec_buffer.frames[fi.ref_frames[ref_frame.to_index()] as usize]
  638|       |  {
  639|  26.4k|    let frame_bo = ts.to_frame_block_offset(tile_bo);
  640|  26.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  641|  26.4k|      get_mv_range(fi.w_in_b, fi.h_in_b, frame_bo, w << ssdec, h << ssdec);
  642|  26.4k|
  643|  26.4k|    let pmv = [MotionVector { row: 0, col: 0 }; 2];
  644|  26.4k|
  645|  26.4k|    let po = frame_bo.to_luma_plane_offset();
  646|  26.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  647|  26.4k|      (mvx_min >> ssdec, mvx_max >> ssdec, mvy_min >> ssdec, mvy_max >> ssdec);
  648|  26.4k|    let po = PlaneOffset { x: po.x >> ssdec, y: po.y >> ssdec };
  649|  26.4k|    let p_ref = match ssdec {
  650|  19.7k|      0 => &rec.frame.planes[0],
  651|  6.71k|      1 => &rec.input_hres,
  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|  26.4k|    let org_region = &match ssdec {
  657|  19.7k|      0 => ts.input_tile.planes[0]
  658|  19.7k|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|  6.71k|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|  26.4k|    let mv =
