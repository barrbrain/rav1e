  634|  13.6k|  tile_bo: TileBlockOffset, ref_frame: RefType, ssdec: u8, lambda: u32,
  635|  13.6k|) -> Option<MotionSearchResult> {
  636|  12.4k|  if let Some(ref rec) =
  637|  13.6k|    fi.rec_buffer.frames[fi.ref_frames[ref_frame.to_index()] as usize]
  638|       |  {
  639|  12.4k|    let frame_bo = ts.to_frame_block_offset(tile_bo);
  640|  12.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  641|  12.4k|      get_mv_range(fi.w_in_b, fi.h_in_b, frame_bo, w << ssdec, h << ssdec);
  642|  12.4k|
  643|  12.4k|    let pmv = [MotionVector { row: 0, col: 0 }; 2];
  644|  12.4k|
  645|  12.4k|    let po = frame_bo.to_luma_plane_offset();
  646|  12.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  647|  12.4k|      (mvx_min >> ssdec, mvx_max >> ssdec, mvy_min >> ssdec, mvy_max >> ssdec);
  648|  12.4k|    let po = PlaneOffset { x: po.x >> ssdec, y: po.y >> ssdec };
  649|  12.4k|    let p_ref = match ssdec {
  650|  9.18k|      0 => &rec.frame.planes[0],
  651|  3.27k|      1 => &rec.input_hres,
  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|  12.4k|    let org_region = &match ssdec {
  657|  9.18k|      0 => ts.input_tile.planes[0]
  658|  9.18k|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|  3.27k|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|  12.4k|    let mv =
  665|  12.4k|      ts.me_stats[ref_frame.to_index()][tile_bo.0.y][tile_bo.0.x].mv >> ssdec;
  666|  12.4k|
  667|  12.4k|    // Given a motion vector at 0 at higher subsampling:
  668|  12.4k|    // |  -1   |   0   |   1   |
  669|  12.4k|    // then the vectors at -1 to 2 should be tested at the current subsampling.
  670|  12.4k|    //      |-------------|
  671|  12.4k|    // | -2 -1 |  0  1 |  2  3 |
  672|  12.4k|    // This corresponds to a 4x4 full search.
  673|  12.4k|    let x_lo = po.x + (mv.col as isize / 8 - 1).max(mvx_min / 8);
  674|  12.4k|    let x_hi = po.x + (mv.col as isize / 8 + 2).min(mvx_max / 8);
  675|  12.4k|    let y_lo = po.y + (mv.row as isize / 8 - 1).max(mvy_min / 8);
  676|  12.4k|    let y_hi = po.y + (mv.row as isize / 8 + 2).min(mvy_max / 8);
  677|  12.4k|    let mut results = full_search(
  678|  12.4k|      fi, x_lo, x_hi, y_lo, y_hi, w, h, org_region, p_ref, po, 1, lambda, pmv,
  679|  12.4k|    );
  680|  12.4k|
  681|  12.4k|    // Scale motion vectors to full res size
  682|  12.4k|    results.mv = results.mv << ssdec;
  683|  12.4k|
  684|  12.4k|    Some(results)
  685|       |  } else {
  686|  1.15k|    None
  687|       |  }
  688|  13.6k|}
