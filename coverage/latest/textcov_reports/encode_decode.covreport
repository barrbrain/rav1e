 2013|   114M|    let mut new_cul_level =
 2014|   114M|      cmp::min(COEFF_CONTEXT_MASK as u32, orig_cul_level);
 2015|   114M|
 2016|   114M|    BlockContext::set_dc_sign(&mut new_cul_level, i32::cast_from(coeffs[0]));
