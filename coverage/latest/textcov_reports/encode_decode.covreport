  554|       |    HorzPaddedIter::new(
  555|       |      // Limit how many unique elements we use
  556|       |      &row[..row_uniques],
  557|       |      start_index_x,
  558|       |      left_w + stripe_w + right_w,
  559|       |    )
  560|  6.19k|  });
  561|  6.19k|
