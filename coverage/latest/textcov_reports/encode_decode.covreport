  366|   474k|  fn frac_compute(nbits_total: u32, mut rng: u32) -> u32 {
  367|   474k|    // To handle the non-integral number of bits still left in the encoder/decoder
  368|   474k|    //  state, we compute the worst-case number of bits of val that must be
  369|   474k|    //  encoded to ensure that the value is inside the range for any possible
  370|   474k|    //  subsequent bits.
  371|   474k|    // The computation here is independent of val itself (the decoder does not
  372|   474k|    //  even track that value), even though the real number of bits used after
  373|   474k|    //  od_ec_enc_done() may be 1 smaller if rng is a power of two and the
  374|   474k|    //  corresponding trailing bits of val are all zeros.
  375|   474k|    // If we did try to track that special case, then coding a value with a
  376|   474k|    //  probability of 1/(1 << n) might sometimes appear to use more than n bits.
  377|   474k|    // This may help explain the surprising result that a newly initialized
  378|   474k|    //  encoder or decoder claims to have used 1 bit.
  379|   474k|    let nbits = nbits_total << OD_BITRES;
  380|   474k|    let mut l = 0;
  381|  1.89M|    for _ in 0..OD_BITRES {
  382|  1.42M|      rng = (rng * rng) >> 15;
  383|  1.42M|      let b = rng >> 16;
  384|  1.42M|      l = (l << 1) | b;
  385|  1.42M|      rng >>= b;
  386|  1.42M|    }
  387|   474k|    nbits - l
  388|   474k|  }
