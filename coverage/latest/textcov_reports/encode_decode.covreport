  482|  11.3M|    if n >= slice.len() {
  483|  11.3M|      slice
  484|  11.3M|    } else {
  485|  11.3M|      &slice[..n]
  486|  11.3M|    }
  487|  11.3M|  }
  488|  11.3M|
  489|  11.3M|  let mut sum = 0;
  490|  14.1M|  for y in y0..y1 {
