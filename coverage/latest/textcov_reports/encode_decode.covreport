 1586|  1.81M|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|  1.81M|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|  1.81M|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|  1.81M|  let mut half: [T; 32] = [T::zero(); 32];
 1591|  1.81M|  // +/- Butterflies with asymmetric output.
 1592|  1.81M|  {
 1593|  1.81M|    #[$m]
 1594|  1.81M|    #[inline]
 1595|  1.81M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  1.81M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
