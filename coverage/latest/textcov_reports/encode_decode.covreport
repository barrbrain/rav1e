  230|  20.0M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  231|  20.0M|    Self::half_kernel((p0, p0), p1, m)
  232|  20.0M|  }
_RNvYNtNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward9RotateSubINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  32.0M|  $($s)* fn half_kernel(
  219|  32.0M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  32.0M|  ) -> (T, T) {
  221|  32.0M|    let t = Self::ADD(p1, p0.0);
  222|  32.0M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  32.0M|    let out0 = b.add(c);
  224|  32.0M|    let shifted = Self::SHIFT(c);
  225|  32.0M|    let out1 = Self::SUB(a, shifted);
  226|  32.0M|    (out0, out1)
  227|  32.0M|  }
