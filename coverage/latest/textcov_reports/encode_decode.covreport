  338|   469k|fn get_mv_range(
  339|   469k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   469k|  blk_h: usize,
  341|   469k|) -> (isize, isize, isize, isize) {
  342|   469k|  let border_w = 128 + blk_w as isize * 8;
