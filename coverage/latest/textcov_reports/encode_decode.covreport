  717|  10.6M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  10.6M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  10.6M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  10.6M|) {
