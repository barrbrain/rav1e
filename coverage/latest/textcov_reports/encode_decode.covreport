  648|  74.7M|  bx: usize,
  649|  74.7M|  by: usize,
  650|  74.7M|  partition_size: BlockSize, // partition size, BlockSize
  651|  74.7M|  po: PlaneOffset,
  652|  74.7M|  tx_size: TxSize,
  653|  74.7M|  bit_depth: usize,
  654|  74.7M|  opt_mode: Option<PredictionMode>,
  655|  74.7M|  enable_intra_edge_filter: bool,
