_RNvNtCsixsdkNzQ5tW_5rav1e4rate13chroma_offset:
  509|  1.46k|fn chroma_offset(
  510|  1.46k|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|  1.46k|) -> (i64, i64) {
  512|  1.46k|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|  1.46k|  let y = match chroma_sampling {
  515|    273|    ChromaSampling::Cs400 => 0,
  516|    210|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|    172|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|    809|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|  1.46k|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|  1.46k|}
_RNvNtCsixsdkNzQ5tW_5rav1e4rate26iir_bessel2_get_parameters:
  140|  1.25k|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|  1.25k|  // This borrows some code from an unreleased version of Postfish.
  142|  1.25k|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|  1.25k|  //  on deriving the filter coefficients.
  144|  1.25k|  // alpha is Q24
  145|  1.25k|  let alpha = (1 << 24) / delay;
  146|  1.25k|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|  1.25k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  1.25k|  // k1 is 9.12 (6.12?)
  149|  1.25k|  let k1 = 3 * warp;
  150|  1.25k|  // k2 is 16.24 (11.24?)
  151|  1.25k|  let k2 = k1 * warp;
  152|  1.25k|  // d is 16.15 (10.15?)
  153|  1.25k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  1.25k|  // a is 0.32, since d is larger than both 1.0 and k2
  155|  1.25k|  let a = (k2 << 23) / d;
  156|  1.25k|  // ik2 is 25.24
  157|  1.25k|  let ik2 = (1i64 << 48) / k2;
  158|  1.25k|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|  1.25k|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|  1.25k|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|  1.25k|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|  1.25k|  // All of the filter parameters are Q24.
  163|  1.25k|  (
  164|  1.25k|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|  1.25k|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|  1.25k|    ((a + 128) >> 8) as i32,
  167|  1.25k|  )
  168|  1.25k|}
_RNvMs3_NtCsixsdkNzQ5tW_5rav1e4rateNtB5_7RCState3new:
  597|    313|  pub fn new(
  598|    313|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    313|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    313|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    313|    maybe_reservoir_frame_delay: Option<i32>,
  602|    313|  ) -> RCState {
  603|    313|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    313|    //  frames; whichever is smaller, with a minimum of 12.
  605|    313|    // For user set values, we enforce a minimum of 12.
  606|    313|    // The interval is short enough to allow reaction, but long enough to allow
  607|    313|    //  looking into the next GOP (avoiding the case where the last frames
  608|    313|    //  before an I-frame get starved), in most cases.
  609|    313|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    313|    //  errors in the worst case.
  611|    313|    let reservoir_frame_delay = maybe_reservoir_frame_delay
  612|    313|      .unwrap_or_else(|| ((max_key_frame_interval * 3) >> 1).min(240))
  613|    313|      .max(12);
  614|    313|    // TODO: What are the limits on these?
  615|    313|    let npixels = (frame_width as i64) * (frame_height as i64);
  616|    313|    // Insane framerates or frame sizes mean insane bitrates.
  617|    313|    // Let's not get carried away.
  618|    313|    // We also subtract 16 bits from each temporal unit to account for the
  619|    313|    //  temporal delimiter, whose bits are not included in the frame sizes
  620|    313|    //  reported to update_state().
  621|    313|    // TODO: Support constraints imposed by levels.
  622|    313|    let bits_per_tu = clamp(
  623|    313|      (target_bitrate as i64) * framerate_den / framerate_num,
  624|    313|      40,
  625|    313|      0x4000_0000_0000,
  626|    313|    ) - (TEMPORAL_DELIMITER.len() * 8) as i64;
  627|    313|    let reservoir_max = bits_per_tu * (reservoir_frame_delay as i64);
  628|    313|    // Start with a buffer fullness and fullness target of 50%.
  629|    313|    let reservoir_target = (reservoir_max + 1) >> 1;
  630|    313|    // Pick exponents and initial scales for quantizer selection.
  631|    313|    let ibpp = npixels / bits_per_tu;
  632|       |    // These have been derived by encoding many clips at every quantizer
  633|       |    // and running a piecewise-linear regression in binary log space.
  634|    313|    let (i_exp, i_log_scale) = if ibpp < 1 {
  635|     13|      (48u8, blog64(36) - q57(QSCALE))
  636|    300|    } else if ibpp < 4 {
  637|     33|      (61u8, blog64(55) - q57(QSCALE))
  638|       |    } else {
  639|    267|      (77u8, blog64(129) - q57(QSCALE))
  640|       |    };
  641|    313|    let (p_exp, p_log_scale) = if ibpp < 2 {
  642|     17|      (69u8, blog64(32) - q57(QSCALE))
  643|    296|    } else if ibpp < 139 {
  644|    255|      (104u8, blog64(84) - q57(QSCALE))
  645|       |    } else {
  646|     41|      (83u8, blog64(19) - q57(QSCALE))
  647|       |    };
  648|    313|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
  649|     17|      (84u8, blog64(30) - q57(QSCALE))
  650|    296|    } else if ibpp < 92 {
  651|    249|      (120u8, blog64(68) - q57(QSCALE))
  652|       |    } else {
  653|     47|      (68u8, blog64(4) - q57(QSCALE))
  654|       |    };
  655|    313|    let (b1_exp, b1_log_scale) = if ibpp < 2 {
  656|     17|      (87u8, blog64(27) - q57(QSCALE))
  657|    296|    } else if ibpp < 126 {
  658|    255|      (139u8, blog64(84) - q57(QSCALE))
  659|       |    } else {
  660|     41|      (61u8, blog64(1) - q57(QSCALE))
  661|       |    };
  662|       |
  663|       |    // TODO: Add support for "golden" P frames.
  664|    313|    RCState {
  665|    313|      target_bitrate,
  666|    313|      reservoir_frame_delay,
  667|    313|      reservoir_frame_delay_is_set: maybe_reservoir_frame_delay.is_some(),
  668|    313|      maybe_ac_qi_max,
  669|    313|      ac_qi_min,
  670|    313|      drop_frames: false,
  671|    313|      cap_overflow: true,
  672|    313|      cap_underflow: false,
  673|    313|      pass1_log_base_q: 0,
  674|    313|      twopass_state: PASS_SINGLE,
  675|    313|      log_npixels: blog64(npixels),
  676|    313|      bits_per_tu,
  677|    313|      reservoir_fullness: reservoir_target,
  678|    313|      reservoir_target,
  679|    313|      reservoir_max,
  680|    313|      log_scale: [i_log_scale, p_log_scale, b0_log_scale, b1_log_scale],
  681|    313|      exp: [i_exp, p_exp, b0_exp, b1_exp],
  682|    313|      scalefilter: [
  683|    313|        IIRBessel2::new(4, q57_to_q24(i_log_scale)),
  684|    313|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(p_log_scale)),
  685|    313|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b0_log_scale)),
  686|    313|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b1_log_scale)),
  687|    313|      ],
  688|    313|      // TODO VFR
  689|    313|      nframes: [0; FRAME_NSUBTYPES + 1],
  690|    313|      inter_delay: [INTER_DELAY_TARGET_MIN; FRAME_NSUBTYPES - 1],
  691|    313|      inter_delay_target: reservoir_frame_delay >> 1,
  692|    313|      rate_bias: 0,
  693|    313|      nencoded_frames: 0,
  694|    313|      nsef_frames: 0,
  695|    313|      pass1_buffer: [0; TWOPASS_HEADER_SZ],
  696|    313|      pass1_data_retrieved: true,
  697|    313|      pass1_summary_retrieved: false,
  698|    313|      pass2_data_ready: false,
  699|    313|      prev_metrics: RCFrameMetrics::new(),
  700|    313|      cur_metrics: RCFrameMetrics::new(),
  701|    313|      frame_metrics: Vec::new(),
  702|    313|      nframe_metrics: 0,
  703|    313|      frame_metrics_head: 0,
  704|    313|      ntus: 0,
  705|    313|      ntus_total: 0,
  706|    313|      ntus_left: 0,
  707|    313|      nframes_total: [0; FRAME_NSUBTYPES + 1],
  708|    313|      nframes_total_total: 0,
  709|    313|      nframes_left: [0; FRAME_NSUBTYPES + 1],
  710|    313|      scale_sum: [0; FRAME_NSUBTYPES],
  711|    313|      scale_window_ntus: 0,
  712|    313|      scale_window_nframes: [0; FRAME_NSUBTYPES + 1],
  713|    313|      scale_window_sum: [0; FRAME_NSUBTYPES],
  714|    313|      des: RCDeserialize::default(),
