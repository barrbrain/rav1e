 1519|       |  // as separable cases.  No need to lag the horizontal processing
 1520|       |  // behind vertical.
 1521|  2.54k|  for y in (1 << ydec..rows).step_by(1 << ydec) {
 1522|       |    // No vertical filtering along left edge of frame
 1523|  2.54k|    sse_h_edge(
 1524|  2.54k|      blocks,
 1525|  2.54k|      TileBlockOffset(BlockOffset { x: 0, y }),
 1526|  2.54k|      rec,
 1527|  2.54k|      src,
 1528|  2.54k|      h_sse,
 1529|  2.54k|      pli,
 1530|  2.54k|      bd,
 1531|  2.54k|      xdec,
 1532|  2.54k|      ydec,
