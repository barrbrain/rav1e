  113|    122|      (tile_width_sb_pre + 1) >> 1 << 1
  114|       |    } else {
  115|    586|      tile_width_sb_pre
  116|       |    };
  117|       |
  118|    708|    let cols = (frame_width_sb + tile_width_sb - 1) / tile_width_sb;
  119|    708|
  120|    708|    // Adjust tile_cols_log2 in case of rounding tile_width_sb to even.
  121|    708|    let tile_cols_log2 = Self::tile_log2(1, cols).unwrap();
  122|    708|    assert!(tile_cols_log2 >= min_tile_cols_log2);
  123|       |
  124|    708|    let min_tile_rows_log2 = if min_tiles_log2 > tile_cols_log2 {
  125|      0|      min_tiles_log2 - tile_cols_log2
  126|       |    } else {
  127|    708|      0
  128|       |    };
  129|    708|    let min_tile_rows_ratelimit_log2 =
  130|    708|      if min_tiles_ratelimit_log2 > tile_cols_log2 {
  131|      0|        min_tiles_ratelimit_log2 - tile_cols_log2
  132|       |      } else {
  133|    708|        0
  134|       |      };
