   67|   535k|            eob,
   68|   535k|            rcoeffs.as_mut_ptr() as *mut _,
   69|   535k|            tx_size,
   70|   535k|            bit_depth,
   71|   535k|            dc_delta_q,
   72|   535k|            ac_delta_q,
   73|   535k|          )
   74|       |        }
   75|       |      } else {
