_RINvNtCs19TYAUSqLvI_5rav1e3rdo7sse_wxhhNCNCNCINvB2_13rdo_cfl_alphahE000EB4_:
  178|  15.1M|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|  15.1M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|  15.1M|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|  15.1M|) -> Distortion {
  182|  15.1M|  // See get_weighted_sse in src/dist.rs.
  183|  15.1M|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|  15.1M|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|  15.1M|
  186|  15.1M|  // To bias the distortion correctly, compute it in blocks up to the size
  187|  15.1M|  // importance block size in a non-subsampled plane.
  188|  15.1M|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|  15.1M|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|  15.1M|
  191|  15.1M|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|  15.1M|
  193|  15.1M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  15.1M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  15.1M|
  196|  15.1M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  15.1M|  // passed directly. To do this, we would need different versions of the
  198|  15.1M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  15.1M|  // eliminating use of unbiased sse.
  200|  15.1M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  15.1M|
  202|  15.1M|  // Copy biases into a buffer.
  203|  15.1M|  let mut buf_storage = Aligned::new(
  204|  15.1M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  15.1M|  );
  206|  15.1M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  15.1M|  let buf = init_slice_repeat_mut(
  208|  15.1M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  15.1M|    0,
  210|  15.1M|  );
  211|       |
  212|  24.4M|  for block_y in 0..n_imp_blocks_h {
  213|  54.0M|    for block_x in 0..n_imp_blocks_w {
  214|  54.0M|      let block = Area::StartingAt {
  215|  54.0M|        x: (block_x * CHUNK_SIZE) as isize,
  216|  54.0M|        y: (block_y * CHUNK_SIZE) as isize,
  217|  54.0M|      };
  218|  54.0M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|  54.0M|    }
  220|       |  }
  221|       |
  222|  15.1M|  Distortion(get_weighted_sse(
  223|  15.1M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  15.1M|  ))
  225|  15.1M|}
