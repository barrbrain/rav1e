  191|    313|  enc.error_resilient = error_resilient;
  192|    313|  enc.width = w;
  193|    313|  enc.height = h;
  194|    313|  enc.bit_depth = bit_depth;
  195|    313|  enc.chroma_sampling = chroma_sampling;
  196|    313|  enc.bitrate = bitrate;
  197|    313|  enc.tile_cols = 1 << tile_cols_log2;
  198|    313|  enc.tile_rows = 1 << tile_rows_log2;
  199|    313|  enc.still_picture = still_picture;
  200|    313|  enc.film_grain_params = grain_table;
  201|       |
  202|    313|  let threads = if cfg!(fuzzing) { 1 } else { 2 };
