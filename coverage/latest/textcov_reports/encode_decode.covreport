  658|  74.7M|  let plane_cfg = &dst.plane_cfg;
  659|  74.7M|
  660|  74.7M|  // SAFETY: We write to the array below before reading from it.
  661|  74.7M|  let mut edge_buf: Aligned<[T; 4 * MAX_TX_SIZE + 1]> =
  662|  74.7M|    unsafe { Aligned::uninitialized() };
  663|  74.7M|  //Aligned::new([T::cast_from(0); 4 * MAX_TX_SIZE + 1]);
  664|  74.7M|  let base = 128u16 << (bit_depth - 8);
  665|  74.7M|
  666|  74.7M|  {
  667|  74.7M|    // left pixels are ordered from bottom to top and right-aligned
  668|  74.7M|    let (left, not_left) = edge_buf.data.split_at_mut(2 * MAX_TX_SIZE);
  669|  74.7M|    let (top_left, above) = not_left.split_at_mut(1);
  670|  74.7M|
  671|  74.7M|    let x = po.x as usize;
  672|  74.7M|    let y = po.y as usize;
