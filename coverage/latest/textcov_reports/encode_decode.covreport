  296|  16.1M|      x: po.x + col_offset as isize - 3,
  297|  16.1M|      y: po.y + row_offset as isize - 3,
  298|  16.1M|    };
  299|  16.1M|    (row_frac, col_frac, rec_plane.slice(qo).clamp().subslice(3, 3))
