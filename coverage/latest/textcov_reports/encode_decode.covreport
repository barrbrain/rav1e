 1395|  1.48M|fn intra_frame_rdo_mode_decision<T: Pixel>(
 1396|  1.48M|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>,
 1397|  1.48M|  cw: &mut ContextWriter, bsize: BlockSize, tile_bo: TileBlockOffset,
 1398|  1.48M|  cw_checkpoint: &ContextWriterCheckpoint, rdo_type: RDOType,
 1399|  1.48M|  mut best: PartitionParameters, is_chroma_block: bool,
 1400|  1.48M|) -> PartitionParameters {
 1401|  1.48M|  let mut modes = ArrayVec::<_, INTRA_MODES>::new();
 1402|       |
 1403|       |  // Reduce number of prediction modes at higher speed levels
 1404|  1.48M|  let num_modes_rdo = if (fi.frame_type == FrameType::KEY
 1405|  1.37M|    && fi.config.speed_settings.prediction.prediction_modes
 1406|  1.37M|      >= PredictionModesSetting::ComplexKeyframes)
 1407|   165k|    || (fi.frame_type.has_inter()
 1408|   109k|      && fi.config.speed_settings.prediction.prediction_modes
 1409|   109k|        >= PredictionModesSetting::ComplexAll)
 1410|       |  {
 1411|  1.32M|    7
 1412|       |  } else {
 1413|   162k|    3
 1414|       |  };
 1415|       |
 1416|  1.48M|  let intra_mode_set = RAV1E_INTRA_MODES;
 1417|       |
 1418|       |  // Find mode with lowest rate cost
 1419|  1.48M|  {
 1420|  1.48M|    use crate::ec::cdf_to_pdf;
 1421|  1.48M|
 1422|  1.48M|    let probs_all = cdf_to_pdf(if fi.frame_type.has_inter() {
 1423|   109k|      cw.get_cdf_intra_mode(bsize)
 1424|       |    } else {
 1425|  1.37M|      cw.get_cdf_intra_mode_kf(tile_bo)
 1426|       |    });
 1427|       |
 1428|  1.48M|    modes.try_extend_from_slice(intra_mode_set).unwrap();
 1429|  1.48M|    modes.sort_by_key(|&a| !probs_all[a as usize]);
 1430|       |  }
 1431|       |
 1432|       |  // If tx partition (i.e. fi.tx_mode_select) is enabled, the below intra prediction screening
 1433|       |  // may be improved by emulating prediction for each tx block.
 1434|  1.48M|  {
 1435|  1.48M|    let satds = {
 1436|       |      // FIXME: If tx partition is used, this whole sads block should be fixed
 1437|  1.48M|      let tx_size = bsize.tx_size();
 1438|  1.48M|      let edge_buf = {
 1439|  1.48M|        let rec = &ts.rec.planes[0].as_const();
 1440|  1.48M|        let po = tile_bo.plane_offset(rec.plane_cfg);
 1441|  1.48M|        // FIXME: If tx partition is used, get_intra_edges() should be called for each tx block
 1442|  1.48M|        get_intra_edges(
 1443|  1.48M|          rec,
 1444|  1.48M|          tile_bo,
 1445|  1.48M|          0,
 1446|  1.48M|          0,
 1447|  1.48M|          bsize,
 1448|  1.48M|          po,
 1449|  1.48M|          tx_size,
 1450|  1.48M|          fi.sequence.bit_depth,
 1451|  1.48M|          None,
 1452|  1.48M|          fi.sequence.enable_intra_edge_filter,
 1453|  1.48M|          IntraParam::None,
 1454|  1.48M|        )
 1455|       |      };
 1456|       |
 1457|  1.48M|      let ief_params = if fi.sequence.enable_intra_edge_filter {
 1458|  1.48M|        let above_block_info = ts.above_block_info(tile_bo, 0, 0);
 1459|  1.48M|        let left_block_info = ts.left_block_info(tile_bo, 0, 0);
 1460|  1.48M|        Some(IntraEdgeFilterParameters::new(
 1461|  1.48M|          0,
 1462|  1.48M|          above_block_info,
 1463|  1.48M|          left_block_info,
 1464|  1.48M|        ))
 1465|       |      } else {
 1466|      0|        None
 1467|       |      };
 1468|       |
 1469|  1.48M|      let mut satds_all = [0; INTRA_MODES];
 1470|  15.1M|      for &luma_mode in modes.iter().skip(num_modes_rdo / 2) {
 1471|  15.1M|        let tile_rect = ts.tile_rect();
 1472|  15.1M|        let rec = &mut ts.rec.planes[0];
 1473|  15.1M|        let mut rec_region =
