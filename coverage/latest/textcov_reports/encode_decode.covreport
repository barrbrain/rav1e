 1119|  59.5k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  59.5k|    );
 1121|  59.5k|
 1122|  59.5k|    if rd.cost < best_cand.rd.cost {
 1123|  19.9k|      best_cand.mv = cand_mv;
 1124|  19.9k|      best_cand.rd = rd;
 1125|  39.5k|    }
 1126|       |  }
 1127|  7.43k|  if best_cand.rd.cost < current.rd.cost {
