 1164|  2.91k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  2.91k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  2.91k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  2.91k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  2.91k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  2.91k|) {
 1170|  2.91k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  2.91k|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|  34.9k|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|   104k|    for &offset in &HORIZONTAL_LINE {
 1196|  69.9k|      let cand_mv = center + offset * i;
 1197|  69.9k|      let rd = get_fullpel_mv_rd(
 1198|  69.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|  69.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|  69.9k|      );
 1201|  69.9k|
 1202|  69.9k|      if rd.cost < current.rd.cost {
 1203|  2.95k|        current.mv = cand_mv;
 1204|  2.95k|        current.rd = rd;
 1205|  66.9k|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|  17.4k|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|  52.4k|    for &offset in &VERTICAL_LINE {
 1217|  34.9k|      let cand_mv = center + offset * i;
 1218|  34.9k|      let rd = get_fullpel_mv_rd(
 1219|  34.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|  34.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|  34.9k|      );
 1222|  34.9k|
 1223|  34.9k|      if rd.cost < current.rd.cost {
 1224|    744|        current.mv = cand_mv;
 1225|    744|        current.rd = rd;
 1226|  34.2k|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|  2.91k|  let center = current.mv;
 1232|  17.4k|  for row in -2..=2 {
 1233|  87.4k|    for col in -2..=2 {
 1234|  72.8k|      if row == 0 && col == 0 {
 1235|  2.91k|        continue;
 1236|  69.9k|      }
 1237|  69.9k|      let cand_mv = center + MotionVector { row, col };
 1238|  69.9k|      let rd = get_fullpel_mv_rd(
 1239|  69.9k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|  69.9k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|  69.9k|      );
 1242|  69.9k|
 1243|  69.9k|      if rd.cost < current.rd.cost {
 1244|    455|        current.mv = cand_mv;
 1245|    455|        current.rd = rd;
 1246|  69.4k|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|  2.91k|  let center = current.mv;
