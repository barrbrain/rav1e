  643|   144k|$($s)* fn daala_fdct_ii_8_asym<T: TxOperations>(
  644|   144k|  r0h: T, r1: (T, T), r2h: T, r3: (T, T), r4h: T, r5: (T, T), r6h: T,
  645|   144k|  r7: (T, T), output: &mut [T],
  646|   144k|) {
  647|   144k|  // +/- Butterflies with asymmetric input.
  648|   144k|  let (r0, r7) = butterfly_neg_asym(r0h, r7);
  649|   144k|  let (r1, r6) = butterfly_sub_asym(r1, r6h);
  650|   144k|  let (r2, r5) = butterfly_neg_asym(r2h, r5);
  651|   144k|  let (r3, r4) = butterfly_sub_asym(r3, r4h);
  652|   144k|
  653|   144k|  // Embedded 4-point orthonormal transforms.
  654|   144k|  daala_fdct_ii_4(r0, r1, r2, r3, &mut output[0..4]);
  655|   144k|  daala_fdst_iv_4(r7, r6, r5, r4, &mut output[4..8]);
  656|   144k|  output[4..8].reverse();
  657|   144k|}
