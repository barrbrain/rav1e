 1050|  7.43k|fn hexagon_search<T: Pixel>(
 1051|  7.43k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  7.43k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  7.43k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
