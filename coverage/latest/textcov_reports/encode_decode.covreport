  522|       |  };
  523|   137k|  let median = median.map(dec_mv);
  524|   496k|  for mv in subset_b.iter_mut() {
  525|   496k|    *mv = dec_mv(*mv);
  526|   496k|  }
  527|   604k|  for mv in subset_c.iter_mut() {
  528|   604k|    *mv = dec_mv(*mv);
  529|   604k|  }
  530|       |
  531|   137k|  MotionEstimationSubsets { min_sad, median, subset_b, subset_c }
  532|   137k|}
