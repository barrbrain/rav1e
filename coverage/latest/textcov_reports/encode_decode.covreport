  434|       |  // right
  435|   135k|  if let MVSamplingMode::CORNER { right: true, bottom: _ } = corner {
  436|   112k|    if tile_bo.0.x + w < tile_me_stats.cols() {
  437|  80.4k|      subset_b.push(process_cand(
  438|  80.4k|        tile_me_stats[tile_bo.0.y + clipped_half_h][tile_bo.0.x + w],
  439|  80.4k|      ));
  440|  80.4k|    }
  441|  23.3k|  }
  442|       |  // bottom
