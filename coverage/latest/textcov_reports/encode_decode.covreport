 1119|  3.40M|  let (t8h, tn) = butterfly_neg(t8, tn);
 1120|  3.40M|  let (t9, tmh) = butterfly_add(t9, tm);
 1121|  3.40M|  let (tah, tl) = butterfly_neg(ta, tl);
 1122|  3.40M|  let (tb, tkh) = butterfly_add(tb, tk);
 1123|  3.40M|  let (tch, tj) = butterfly_neg(tc, tj);
 1124|  3.40M|  let (td, tih) = butterfly_add(td, ti);
 1125|  3.40M|  let (teh, th) = butterfly_neg(te, th);
 1126|  3.40M|  let (tf, tgh) = butterfly_add(tf, tg);
 1127|  3.40M|
 1128|  3.40M|  // Embedded 16-point transforms with asymmetric input.
 1129|  3.40M|  daala_fdct_ii_16_asym(
