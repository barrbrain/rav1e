 1060|  3.06k|  fn calc_flat_quantizer(
 1061|  3.06k|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|  3.06k|  ) -> (i64, i64) {
 1063|  3.06k|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|  3.06k|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|  3.06k|    //  parameterize a "quality" configuration parameter).
 1066|  3.06k|
 1067|  3.06k|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|  3.06k|    //  tables have unique entries, while the DC tables do not.
 1069|  3.06k|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|  3.06k|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|  3.06k|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|  3.06k|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|  3.06k|    // Get the log quantizers as Q57.
 1074|  3.06k|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|  3.06k|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|  3.06k|    // Target the midpoint of the chosen entries.
 1077|  3.06k|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|  3.06k|    // Adjust the quantizer for the frame type, result is Q57:
 1079|  3.06k|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|  3.06k|      + DQP_Q57[fti];
 1081|  3.06k|    (log_base_q, log_q)
 1082|  3.06k|  }
