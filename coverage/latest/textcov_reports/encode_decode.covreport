   29|  13.1G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  13.1G|  let nsymbs = 4;
   31|  13.1G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  13.1G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  13.1G|
   34|  13.1G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  13.1G|  // implementation:
   36|  13.1G|  //
   37|  13.1G|  // ```
   38|  13.1G|  // if i as u32 >= val {
   39|  13.1G|  //   *v -= *v >> rate;
   40|  13.1G|  // } else {
   41|  13.1G|  //   *v += (32768 - *v) >> rate;
   42|  13.1G|  // }
   43|  13.1G|  // ```
   44|  13.1G|  //
   45|  13.1G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  13.1G|  // transform in something like:
   47|  13.1G|  //
   48|  13.1G|  // ```
   49|  13.1G|  // if i as u32 >= val {
   50|  13.1G|  //   *v -= *v >> rate;
   51|  13.1G|  // } else {
   52|  13.1G|  //   *v -= -((32768 - *v) >> rate);
   53|  13.1G|  // }
   54|  13.1G|  // ```
   55|  13.1G|  //
   56|  13.1G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  13.1G|  // using the following rule:
   58|  13.1G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  13.1G|  // So we obtain
   60|  13.1G|  //
   61|  13.1G|  // ```
   62|  13.1G|  // if i as u32 >= val {
   63|  13.1G|  //   *v -= *v >> rate;
   64|  13.1G|  // } else {
   65|  13.1G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  13.1G|  // }
   67|  13.1G|  // ```
   68|  13.1G|  //
   69|  13.1G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  13.1G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  13.1G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  13.1G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  13.1G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  13.1G|  //
   75|  13.1G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  13.1G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  13.1G|
