  567|   150k|fn sse_size6<T: Pixel>(
  568|   150k|  rec: &PlaneRegion<'_, T>, src: &PlaneRegion<'_, T>,
  569|   150k|  tally: &mut [i64; MAX_LOOP_FILTER + 2], horizontal_p: bool, bd: usize,
  570|   150k|) {
  571|   150k|  let flat = 1 << (bd - 8);
  572|   750k|  for i in 0..4 {
  573|   600k|    let (p2, p1, p0, q0, q1, q2, a) = if horizontal_p {
  574|       |      // six taps
  575|   281k|      (
  576|   281k|        rec[0][i].as_(),
  577|   281k|        rec[1][i].as_(),
  578|   281k|        rec[2][i].as_(),
  579|   281k|        rec[3][i].as_(),
  580|   281k|        rec[4][i].as_(),
  581|   281k|        rec[5][i].as_(),
  582|   281k|        // four pixels to compare so offset one forward
  583|   281k|        [src[1][i].as_(), src[2][i].as_(), src[3][i].as_(), src[4][i].as_()],
  584|   281k|      )
  585|       |    } else {
  586|       |      // six taps
  587|   318k|      (
  588|   318k|        rec[i][0].as_(),
  589|   318k|        rec[i][1].as_(),
  590|   318k|        rec[i][2].as_(),
  591|   318k|        rec[i][3].as_(),
  592|   318k|        rec[i][4].as_(),
  593|   318k|        rec[i][5].as_(),
  594|   318k|        // four pixels to compare so offset one forward
  595|   318k|        [src[i][1].as_(), src[i][2].as_(), src[i][3].as_(), src[i][4].as_()],
  596|   318k|      )
  597|       |    };
  598|       |
  599|       |    // Four possibilities: no filter, wide6, narrow2 and narrow4
  600|       |    // All possibilities produce four outputs
  601|   600k|    let none: [_; 4] = [p1, p0, q0, q1];
  602|   600k|    let wide6 = filter_wide6_4(p2, p1, p0, q0, q1, q2);
  603|   600k|    let narrow2 = filter_narrow2_4(p1, p0, q0, q1, bd - 8);
  604|   600k|    let narrow4 = filter_narrow4_4(p1, p0, q0, q1, bd - 8);
  605|   600k|
  606|   600k|    // mask6 sets the dividing line for filter vs no filter
  607|   600k|    // flat6 decides between wide and narrow filters (unrelated to level)
  608|   600k|    // nhev4 sets the dividing line between narrow2 and narrow4
  609|   600k|    let mask =
  610|   600k|      clamp(mask6(p2, p1, p0, q0, q1, q2, bd - 8), 1, MAX_LOOP_FILTER + 1)
  611|   600k|        as usize;
  612|   600k|    let flatp = flat6(p2, p1, p0, q0, q1, q2) <= flat;
  613|   600k|    let nhev =
  614|   600k|      clamp(nhev4(p1, p0, q0, q1, bd - 8), mask, MAX_LOOP_FILTER + 1) as usize;
  615|   600k|
  616|   600k|    // sse for each; short-circuit the 'special' no-op cases.
  617|   600k|    let sse_none = stride_sse(&a, &none);
  618|   600k|    let sse_wide6 = if flatp && mask <= MAX_LOOP_FILTER {
  619|      0|      stride_sse(&a, &wide6)
  620|       |    } else {
  621|   600k|      sse_none
  622|       |    };
  623|   600k|    let sse_narrow2 =
  624|   600k|      if !flatp && nhev != mask { stride_sse(&a, &narrow2) } else { sse_none };
  625|   600k|    let sse_narrow4 = if !flatp && nhev <= MAX_LOOP_FILTER {
  626|     34|      stride_sse(&a, &narrow4)
  627|       |    } else {
  628|   600k|      sse_none
  629|       |    };
  630|       |
  631|       |    // accumulate possible filter values into the tally
  632|   600k|    tally[0] += sse_none;
  633|   600k|    tally[mask] -= sse_none;
  634|   600k|    if flatp {
  635|      0|      tally[mask] += sse_wide6;
  636|   600k|    } else {
  637|   600k|      tally[mask] += sse_narrow2;
  638|   600k|      tally[nhev] -= sse_narrow2;
  639|   600k|      tally[nhev] += sse_narrow4;
  640|   600k|    }
  641|       |  }
