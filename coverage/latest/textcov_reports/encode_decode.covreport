 1989|   114M|  ) -> u32 {
 1990|       |    // Loop to code all signs in the transform block,
 1991|       |    // starting with the sign of DC (if applicable)
 1992|  6.45G|    for (c, &v) in coeffs.iter().enumerate() {
 1993|  6.45G|      if v == T::cast_from(0) {
