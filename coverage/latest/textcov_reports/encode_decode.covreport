_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward20daala_fdct_ii_4_asymNtB2_5I32X8EBa_:
  441|  43.2M|$($s)* fn daala_fdct_ii_4_asym<T: TxOperations>(
  442|  43.2M|  q0h: T, q1: (T, T), q2h: T, q3: (T, T), output: &mut [T],
  443|  43.2M|) {
  444|  43.2M|  // +/- Butterflies with asymmetric input.
  445|  43.2M|  let (q0, q3) = butterfly_neg_asym(q0h, q3);
  446|  43.2M|  let (q1, q2) = butterfly_sub_asym(q1, q2h);
  447|  43.2M|
  448|  43.2M|  // Embedded 2-point orthonormal transforms.
  449|  43.2M|  let (q0, q1) = daala_fdct_ii_2(q0, q1);
  450|  43.2M|  let (q3, q2) = daala_fdst_iv_2(q3, q2);
  451|  43.2M|
  452|  43.2M|  store_coeffs!(output, q0, q1, q2, q3);
  453|  43.2M|}
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward20daala_fdst_iv_8_asymNtB2_5I32X8EBa_:
  660|  15.6M|$($s)* fn daala_fdst_iv_8_asym<T: TxOperations>(
  661|  15.6M|  r0: (T, T), r1h: T, r2: (T, T), r3h: T, r4: (T, T), r5h: T, r6: (T, T),
  662|  15.6M|  r7h: T, output: &mut [T],
  663|  15.6M|) {
  664|  15.6M|  // Stage 0
  665|  15.6M|  // 12665/16384 = (Sin[15*Pi/32] + Cos[15*Pi/32])/Sqrt[2] = 0.77301045336274
  666|  15.6M|  //   5197/4096 = (Sin[15*Pi/32] - Cos[15*Pi/32])*Sqrt[2] = 1.26878656832729
  667|  15.6M|  //  2271/16384 = Cos[15*Pi/32]*Sqrt[2]                   = 0.13861716919909
  668|  15.6M|  let (r0, r7) =
  669|  15.6M|    RotateAdd::half_kernel(r0, r7h, ((12665, 14), (5197, 12), (2271, 14)));
  670|  15.6M|  // 14449/16384 = Sin[13*Pi/32] + Cos[13*Pi/32])/Sqrt[2] = 0.881921264348355
  671|  15.6M|  // 30893/32768 = Sin[13*Pi/32] - Cos[13*Pi/32])*Sqrt[2] = 0.942793473651995
  672|  15.6M|  //   3363/8192 = Cos[13*Pi/32]*Sqrt[2]                  = 0.410524527522357
  673|  15.6M|  let (r6, r1) =
  674|  15.6M|    RotateSub::half_kernel(r6, r1h, ((14449, 14), (30893, 15), (3363, 13)));
  675|  15.6M|  // 15679/16384 = Sin[11*Pi/32] + Cos[11*Pi/32])/Sqrt[2] = 0.956940335732209
  676|  15.6M|  //   1189/2048 = Sin[11*Pi/32] - Cos[11*Pi/32])*Sqrt[2] = 0.580569354508925
  677|  15.6M|  //   5461/8192 = Cos[11*Pi/32]*Sqrt[2]                  = 0.666655658477747
  678|  15.6M|  let (r2, r5) =
  679|  15.6M|    RotateAdd::half_kernel(r2, r5h, ((15679, 14), (1189, 11), (5461, 13)));
  680|  15.6M|  // 16305/16384 = (Sin[9*Pi/32] + Cos[9*Pi/32])/Sqrt[2] = 0.9951847266721969
  681|  15.6M|  //    803/4096 = (Sin[9*Pi/32] - Cos[9*Pi/32])*Sqrt[2] = 0.1960342806591213
  682|  15.6M|  // 14699/16384 = Cos[9*Pi/32]*Sqrt[2]                  = 0.8971675863426364
  683|  15.6M|  let (r4, r3) =
  684|  15.6M|    RotateSub::half_kernel(r4, r3h, ((16305, 14), (803, 12), (14699, 14)));
  685|  15.6M|
  686|  15.6M|  // Stage 1
  687|  15.6M|  let (r0, r3h) = butterfly_add(r0, r3);
  688|  15.6M|  let (r2, r1h) = butterfly_sub(r2, r1);
  689|  15.6M|  let (r5, r6h) = butterfly_add(r5, r6);
  690|  15.6M|  let (r7, r4h) = butterfly_sub(r7, r4);
  691|  15.6M|
  692|  15.6M|  // Stage 2
  693|  15.6M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  694|  15.6M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  695|  15.6M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  696|  15.6M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  697|  15.6M|
  698|  15.6M|  // Stage 3
  699|  15.6M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  700|  15.6M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  701|  15.6M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  702|  15.6M|  let (r3, r4) =
  703|  15.6M|    RotateSubAvg::kernel(r3, r4, ((669, 9), (8867, 14), (3135, 12)));
  704|  15.6M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  705|  15.6M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  706|  15.6M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  707|  15.6M|  let (r2, r5) =
  708|  15.6M|    RotateNegAvg::kernel(r2, r5, ((669, 9), (8867, 14), (3135, 12)));
  709|  15.6M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  710|  15.6M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  711|  15.6M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((5793, 12), (11585, 13)));
  712|  15.6M|
  713|  15.6M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  714|  15.6M|}
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward13butterfly_subNtB2_5I32X8EBa_:
  312|   171M|$($s)* fn butterfly_sub<T: TxOperations>(p0: T, p1: T) -> ((T, T), T) {
  313|   171M|  let p0 = p0.sub(p1);
  314|   171M|  let p0h = p0.rshift1();
  315|   171M|  let p1h = p1.add(p0h);
  316|   171M|  ((p0h, p0), p1h)
  317|   171M|}
