  384|   144k|fn get_subset_predictors(
  385|   144k|  tile_bo: TileBlockOffset, tile_me_stats: &TileMEStats<'_>,
  386|   144k|  frame_ref_opt: Option<ReadGuardMEStats<'_>>, ref_frame_id: usize,
  387|   144k|  pix_w: usize, pix_h: usize, mvx_min: isize, mvx_max: isize, mvy_min: isize,
  388|   144k|  mvy_max: isize, corner: MVSamplingMode, ssdec: u8,
  389|   144k|) -> MotionEstimationSubsets {
  390|   144k|  let mut min_sad: u32 = u32::MAX;
  391|   144k|  let mut subset_b = ArrayVec::<MotionVector, 5>::new();
  392|   144k|  let mut subset_c = ArrayVec::<MotionVector, 5>::new();
  393|   144k|
  394|   144k|  // rounded up width in blocks
  395|   144k|  let w = ((pix_w << ssdec) + MI_SIZE - 1) >> MI_SIZE_LOG2;
  396|   144k|  let h = ((pix_h << ssdec) + MI_SIZE - 1) >> MI_SIZE_LOG2;
  397|   144k|
  398|   144k|  // Get predictors from the same frame.
  399|   144k|
  400|   144k|  let clipped_half_w = (w >> 1).min(tile_me_stats.cols() - 1 - tile_bo.0.x);
  401|   144k|  let clipped_half_h = (h >> 1).min(tile_me_stats.rows() - 1 - tile_bo.0.y);
  402|   144k|
  403|   144k|  let mut process_cand = |stats: MEStats| -> MotionVector {
  404|       |    min_sad = min_sad.min(stats.normalized_sad);
  405|       |    let mv = stats.mv.quantize_to_fullpel();
  406|       |    MotionVector {
  407|       |      col: clamp(mv.col as isize, mvx_min, mvx_max) as i16,
  408|       |      row: clamp(mv.row as isize, mvy_min, mvy_max) as i16,
  409|       |    }
  410|       |  };
  411|       |
  412|       |  // Sample the middle of all block edges bordering this one.
  413|       |  // Note: If motion vectors haven't been precomputed to a given blocksize, then
  414|       |  // the right and bottom edges will be duplicates of the center predictor when
  415|       |  // processing in raster order.
  416|       |
  417|       |  // left
  418|   144k|  if tile_bo.0.x > 0 {
  419|   104k|    subset_b.push(process_cand(
  420|   104k|      tile_me_stats[tile_bo.0.y + clipped_half_h][tile_bo.0.x - 1],
  421|   104k|    ));
  422|   104k|  }
  423|       |  // top
  424|   144k|  if tile_bo.0.y > 0 {
  425|   103k|    subset_b.push(process_cand(
  426|   103k|      tile_me_stats[tile_bo.0.y - 1][tile_bo.0.x + clipped_half_w],
  427|   103k|    ));
  428|   103k|  }
  429|       |
  430|       |  // Sampling far right and far bottom edges was tested, but had worse results
  431|       |  // without an extensive threshold test (with threshold being applied after
  432|       |  // checking median and the best of each subset).
  433|       |
  434|       |  // right
  435|   144k|  if let MVSamplingMode::CORNER { right: true, bottom: _ } = corner {
  436|   118k|    if tile_bo.0.x + w < tile_me_stats.cols() {
  437|  84.9k|      subset_b.push(process_cand(
  438|  84.9k|        tile_me_stats[tile_bo.0.y + clipped_half_h][tile_bo.0.x + w],
  439|  84.9k|      ));
  440|  84.9k|    }
  441|  25.4k|  }
  442|       |  // bottom
  443|   144k|  if let MVSamplingMode::CORNER { right: _, bottom: true } = corner {
  444|   118k|    if tile_bo.0.y + h < tile_me_stats.rows() {
  445|  83.9k|      subset_b.push(process_cand(
  446|  83.9k|        tile_me_stats[tile_bo.0.y + h][tile_bo.0.x + clipped_half_w],
  447|  83.9k|      ));
  448|  83.9k|    }
  449|  25.5k|  }
  450|       |
  451|   144k|  let median = if corner != MVSamplingMode::INIT {
