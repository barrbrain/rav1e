_RINvNtCs19TYAUSqLvI_5rav1e2me17get_fullpel_mv_rdhEB4_:
 1379|  10.5M|fn get_fullpel_mv_rd<T: Pixel>(
 1380|  10.5M|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1381|  10.5M|  p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1382|  10.5M|  use_satd: bool, mvx_min: isize, mvx_max: isize, mvy_min: isize,
 1383|  10.5M|  mvy_max: isize, w: usize, h: usize, cand_mv: MotionVector,
 1384|  10.5M|) -> MVCandidateRD {
 1385|  10.5M|  if (cand_mv.col as isize) < mvx_min
 1386|  10.5M|    || (cand_mv.col as isize) > mvx_max
 1387|  10.5M|    || (cand_mv.row as isize) < mvy_min
 1388|  10.4M|    || (cand_mv.row as isize) > mvy_max
 1389|       |  {
 1390|   206k|    return MVCandidateRD::empty();
 1391|  10.3M|  }
 1392|  10.3M|
 1393|  10.3M|  // Convert the motion vector into an full pixel offset.
 1394|  10.3M|  let plane_ref = p_ref.region(Area::StartingAt {
 1395|  10.3M|    x: po.x + (cand_mv.col / 8) as isize,
 1396|  10.3M|    y: po.y + (cand_mv.row / 8) as isize,
 1397|  10.3M|  });
 1398|  10.3M|  compute_mv_rd(
 1399|  10.3M|    fi, pmv, lambda, use_satd, bit_depth, w, h, cand_mv, org_region,
 1400|  10.3M|    &plane_ref,
 1401|  10.3M|  )
 1402|  10.5M|}
