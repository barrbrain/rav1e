  136|    708|      .max(min_tile_rows_log2)
  137|    708|      .max(min_tile_rows_ratelimit_log2)
  138|    708|      .min(max_tile_rows_log2);
  139|    708|    let tile_height_sb = sb_rows.align_power_of_two_and_shift(tile_rows_log2);
  140|    708|
  141|    708|    let rows = (frame_height_sb + tile_height_sb - 1) / tile_height_sb;
  142|    708|
  143|    708|    Self {
  144|    708|      frame_width,
  145|    708|      frame_height,
  146|    708|      tile_width_sb,
  147|    708|      tile_height_sb,
  148|    708|      cols,
  149|    708|      rows,
  150|    708|      tile_cols_log2,
  151|    708|      tile_rows_log2,
  152|    708|      min_tile_cols_log2,
  153|    708|      max_tile_cols_log2,
  154|    708|      min_tile_rows_log2,
  155|    708|      max_tile_rows_log2,
  156|    708|      sb_size_log2,
  157|    708|      min_tiles_log2,
  158|    708|    }
  159|    708|  }
