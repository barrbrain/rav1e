  588|  22.6M|$($s)* fn daala_fdst8<T: TxOperations>(coeffs: &mut [T]) {
  589|  22.6M|  assert!(coeffs.len() >= 8);
  590|  22.6M|  let mut temp_out: [T; 8] = [T::zero(); 8];
  591|  22.6M|  daala_fdst_iv_8(
  592|  22.6M|    coeffs[0],
  593|  22.6M|    coeffs[1],
  594|  22.6M|    coeffs[2],
  595|  22.6M|    coeffs[3],
  596|  22.6M|    coeffs[4],
  597|  22.6M|    coeffs[5],
  598|  22.6M|    coeffs[6],
  599|  22.6M|    coeffs[7],
  600|  22.6M|    &mut temp_out,
  601|  22.6M|  );
  602|  22.6M|
  603|  22.6M|  coeffs[0] = temp_out[0];
  604|  22.6M|  coeffs[1] = temp_out[4];
  605|  22.6M|  coeffs[2] = temp_out[2];
  606|  22.6M|  coeffs[3] = temp_out[6];
  607|  22.6M|  coeffs[4] = temp_out[1];
  608|  22.6M|  coeffs[5] = temp_out[5];
  609|  22.6M|  coeffs[6] = temp_out[3];
  610|  22.6M|  coeffs[7] = temp_out[7];
  611|  22.6M|}
_RNvYNtNtNtNtNtCsgGiEFdpFC8m_5rav1e3asm3x869transform7forward14RotateAddShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   203M|  $($s)* fn half_kernel(
  219|   203M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   203M|  ) -> (T, T) {
  221|   203M|    let t = Self::ADD(p1, p0.0);
  222|   203M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   203M|    let out0 = b.add(c);
  224|   203M|    let shifted = Self::SHIFT(c);
  225|   203M|    let out1 = Self::SUB(a, shifted);
  226|   203M|    (out0, out1)
  227|   203M|  }
