 1701|  28.2M|  $($s)* fn reorder_4<T: TxOperations>(
 1702|  28.2M|    output: &mut [T], i: usize, tmp: [T; 64], j: usize
 1703|  28.2M|  ) {
 1704|  28.2M|    output[0 + i * 4] = tmp[0 + j];
 1705|  28.2M|    output[1 + i * 4] = tmp[32 + j];
 1706|  28.2M|    output[2 + i * 4] = tmp[16 + j];
 1707|  28.2M|    output[3 + i * 4] = tmp[48 + j];
 1708|  28.2M|  }
_RNvMs_NtNtCs19TYAUSqLvI_5rav1e9transform14forward_sharedNtB4_13Txfm2DFlipCfg12get_flip_cfg:
  144|   146M|  const fn get_flip_cfg(tx_type: TxType) -> (bool, bool) {
  145|   146M|    use self::TxType::*;
  146|   146M|    match tx_type {
  147|       |      DCT_DCT | ADST_DCT | DCT_ADST | ADST_ADST | IDTX | V_DCT | H_DCT
  148|   146M|      | V_ADST | H_ADST => (false, false),
  149|      0|      FLIPADST_DCT | FLIPADST_ADST | V_FLIPADST => (true, false),
  150|      0|      DCT_FLIPADST | ADST_FLIPADST | H_FLIPADST => (false, true),
  151|      0|      FLIPADST_FLIPADST => (true, true),
  152|       |    }
  153|   146M|  }
_RNvMs_NtNtCs19TYAUSqLvI_5rav1e9transform14forward_sharedNtB4_13Txfm2DFlipCfg3fwd:
  122|   146M|  pub fn fwd(tx_type: TxType, tx_size: TxSize, bd: usize) -> Self {
  123|   146M|    let tx_type_1d_col = VTX_TAB[tx_type as usize];
  124|   146M|    let tx_type_1d_row = HTX_TAB[tx_type as usize];
  125|   146M|    let txw_idx = tx_size.width_index();
  126|   146M|    let txh_idx = tx_size.height_index();
  127|   146M|    let txfm_type_col =
  128|   146M|      TxfmType::AV1_TXFM_TYPE_LS[txh_idx][tx_type_1d_col as usize].unwrap();
  129|   146M|    let txfm_type_row =
  130|   146M|      TxfmType::AV1_TXFM_TYPE_LS[txw_idx][tx_type_1d_row as usize].unwrap();
  131|   146M|    let (ud_flip, lr_flip) = Self::get_flip_cfg(tx_type);
  132|   146M|
  133|   146M|    Txfm2DFlipCfg {
  134|   146M|      tx_size,
  135|   146M|      ud_flip,
  136|   146M|      lr_flip,
  137|   146M|      shift: FWD_TXFM_SHIFT_LS[tx_size as usize][(bd - 8) / 2],
  138|   146M|      txfm_type_col,
  139|   146M|      txfm_type_row,
  140|   146M|    }
  141|   146M|  }

_RNvMs_NtCs19TYAUSqLvI_5rav1e9transformNtB4_6TxSize6heightB6_:
  152|  2.29G|  pub const fn height(self) -> usize {
  153|  2.29G|    1 << self.height_log2()
  154|  2.29G|  }
_RNvMs_NtCs19TYAUSqLvI_5rav1e9transformNtB4_6TxSize9area_log2B6_:
  183|  1.10G|  pub const fn area_log2(self) -> usize {
