 1572|  2.65k|fn sse_optimize<T: Pixel>(
 1573|  2.65k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  2.65k|  crop_h: usize, bd: usize, monochrome: bool,
