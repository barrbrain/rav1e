 1302|    245|  pub fn new<T: Pixel>(fi: &FrameInvariants<T>, input: &Frame<T>) -> Self {
 1303|    245|    let PlaneConfig { xdec, ydec, .. } = input.planes[1].cfg;
 1304|       |    // stripe size is decimated in 4:2:0 (and only 4:2:0)
 1305|    245|    let stripe_uv_decimate = if xdec > 0 && ydec > 0 { 1 } else { 0 };
