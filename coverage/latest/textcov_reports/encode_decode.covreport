  143|   100M|pub fn cdef_dist_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  144|   100M|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  145|   100M|  bit_depth: usize, compute_bias: F, cpu: CpuFeatureLevel,
  146|   100M|) -> Distortion {
  147|      0|  debug_assert!(src1.plane_cfg.xdec == 0);
  148|      0|  debug_assert!(src1.plane_cfg.ydec == 0);
  149|      0|  debug_assert!(src2.plane_cfg.xdec == 0);
  150|      0|  debug_assert!(src2.plane_cfg.ydec == 0);
  151|       |
  152|   100M|  let mut sum = Distortion::zero();
  153|   112M|  for y in (0..h).step_by(8) {
  154|   151M|    for x in (0..w).step_by(8) {
  155|   151M|      let kernel_h = (h - y).min(8);
  156|   151M|      let kernel_w = (w - x).min(8);
  157|   151M|      let area = Area::StartingAt { x: x as isize, y: y as isize };
  158|   151M|
  159|   151M|      let value = RawDistortion(cdef_dist_kernel(
  160|   151M|        &src1.subregion(area),
  161|   151M|        &src2.subregion(area),
  162|   151M|        kernel_w,
  163|   151M|        kernel_h,
  164|   151M|        bit_depth,
  165|   151M|        cpu,
  166|   151M|      ) as u64);
  167|   151M|
  168|   151M|      // cdef is always called on non-subsampled planes, so BLOCK_8X8 is
  169|   151M|      // correct here.
  170|   151M|      sum += value * compute_bias(area, BlockSize::BLOCK_8X8);
  171|   151M|    }
  172|       |  }
  173|   100M|  sum
  174|   100M|}
