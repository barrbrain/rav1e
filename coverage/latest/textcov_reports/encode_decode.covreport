  218|  1.13M|  $($s)* fn half_kernel(
  219|  1.13M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  1.13M|  ) -> (T, T) {
  221|  1.13M|    let t = Self::ADD(p1, p0.0);
  222|  1.13M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  1.13M|    let out0 = b.add(c);
  224|  1.13M|    let shifted = Self::SHIFT(c);
  225|  1.13M|    let out1 = Self::SUB(a, shifted);
