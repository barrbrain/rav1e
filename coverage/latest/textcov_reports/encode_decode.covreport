_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward15daala_fdct_ii_8NtB2_5I32X8EBa_:
  490|  43.2M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  43.2M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  43.2M|) {
  493|  43.2M|  // +/- Butterflies with asymmetric output.
  494|  43.2M|  let (r0h, r7) = butterfly_neg(r0, r7);
  495|  43.2M|  let (r1, r6h) = butterfly_add(r1, r6);
  496|  43.2M|  let (r2h, r5) = butterfly_neg(r2, r5);
  497|  43.2M|  let (r3, r4h) = butterfly_add(r3, r4);
  498|  43.2M|
  499|  43.2M|  // Embedded 4-point transforms with asymmetric input.
  500|  43.2M|  daala_fdct_ii_4_asym(r0h, r1, r2h, r3, &mut output[0..4]);
  501|  43.2M|  daala_fdst_iv_4_asym(r7, r6h, r5, r4h, &mut output[4..8]);
  502|  43.2M|  output[4..8].reverse();
  503|  43.2M|}
