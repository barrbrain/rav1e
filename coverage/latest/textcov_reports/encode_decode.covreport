  864|  1.82M|fn deblock_size14_inner(
  865|  1.82M|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|  1.82M|  level: usize, bd: usize,
  867|  1.82M|) -> Option<[i32; 12]> {
  868|  1.82M|  // 'mask' test
  869|  1.82M|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|   119k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
  872|   119k|    let x = if flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat {
