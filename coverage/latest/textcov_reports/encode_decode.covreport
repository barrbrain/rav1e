 1705|  18.5M|    output[1 + i * 4] = tmp[32 + j];
 1706|  18.5M|    output[2 + i * 4] = tmp[16 + j];
 1707|  18.5M|    output[3 + i * 4] = tmp[48 + j];
 1708|  18.5M|  }
