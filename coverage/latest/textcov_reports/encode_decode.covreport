  338|   121M|      *above = value;
  339|   121M|    }
  340|  78.4M|    let bo_y = bo.y_in_sb();
  341|   121M|    for left in &mut self.left_coeff_context[plane][(bo_y >> ydec)..]
  342|  78.4M|      [..tx_size.height_mi()]
  343|   121M|    {
