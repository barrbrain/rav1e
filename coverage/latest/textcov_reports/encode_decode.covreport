  116|    319|pub(super) fn detect_scale_factor<T: Pixel>(
  117|    319|  sequence: &Arc<Sequence>, speed_mode: SceneDetectionSpeed,
  118|    319|) -> Option<ScaleFunction<T>> {
  119|    319|  let small_edge =
  120|    319|    cmp::min(sequence.max_frame_height, sequence.max_frame_width) as usize;
  121|    319|  let scale_func = if speed_mode == SceneDetectionSpeed::Fast {
  122|    163|    match small_edge {
  123|    163|      0..=240 => None,
  124|     24|      241..=480 => Some(ScaleFunction::from_scale::<2>()),
