  583|  10.4k|        [src[1][i].as_(), src[2][i].as_(), src[3][i].as_(), src[4][i].as_()],
  584|  10.4k|      )
  585|       |    } else {
  586|       |      // six taps
  587|  17.1k|      (
  588|  17.1k|        rec[i][0].as_(),
  589|  17.1k|        rec[i][1].as_(),
  590|  17.1k|        rec[i][2].as_(),
  591|  17.1k|        rec[i][3].as_(),
  592|  17.1k|        rec[i][4].as_(),
  593|  17.1k|        rec[i][5].as_(),
  594|  17.1k|        // four pixels to compare so offset one forward
  595|  17.1k|        [src[i][1].as_(), src[i][2].as_(), src[i][3].as_(), src[i][4].as_()],
  596|  17.1k|      )
  597|       |    };
  598|       |
  599|       |    // Four possibilities: no filter, wide6, narrow2 and narrow4
  600|       |    // All possibilities produce four outputs
  601|  27.6k|    let none: [_; 4] = [p1, p0, q0, q1];
  602|  27.6k|    let wide6 = filter_wide6_4(p2, p1, p0, q0, q1, q2);
  603|  27.6k|    let narrow2 = filter_narrow2_4(p1, p0, q0, q1, bd - 8);
  604|  27.6k|    let narrow4 = filter_narrow4_4(p1, p0, q0, q1, bd - 8);
  605|  27.6k|
  606|  27.6k|    // mask6 sets the dividing line for filter vs no filter
  607|  27.6k|    // flat6 decides between wide and narrow filters (unrelated to level)
  608|  27.6k|    // nhev4 sets the dividing line between narrow2 and narrow4
  609|  27.6k|    let mask =
  610|  27.6k|      clamp(mask6(p2, p1, p0, q0, q1, q2, bd - 8), 1, MAX_LOOP_FILTER + 1)
  611|  27.6k|        as usize;
  612|  27.6k|    let flatp = flat6(p2, p1, p0, q0, q1, q2) <= flat;
  613|  27.6k|    let nhev =
  614|  27.6k|      clamp(nhev4(p1, p0, q0, q1, bd - 8), mask, MAX_LOOP_FILTER + 1) as usize;
  615|  27.6k|
  616|  27.6k|    // sse for each; short-circuit the 'special' no-op cases.
  617|  27.6k|    let sse_none = stride_sse(&a, &none);
  618|  27.6k|    let sse_wide6 = if flatp && mask <= MAX_LOOP_FILTER {
  619|      0|      stride_sse(&a, &wide6)
  620|       |    } else {
  621|  27.6k|      sse_none
  622|       |    };
  623|  27.6k|    let sse_narrow2 =
  624|  27.6k|      if !flatp && nhev != mask { stride_sse(&a, &narrow2) } else { sse_none };
  625|  27.6k|    let sse_narrow4 = if !flatp && nhev <= MAX_LOOP_FILTER {
  626|      4|      stride_sse(&a, &narrow4)
  627|       |    } else {
  628|  27.6k|      sse_none
  629|       |    };
  630|       |
  631|       |    // accumulate possible filter values into the tally
  632|  27.6k|    tally[0] += sse_none;
  633|  27.6k|    tally[mask] -= sse_none;
  634|  27.6k|    if flatp {
  635|      0|      tally[mask] += sse_wide6;
  636|  27.6k|    } else {
  637|  27.6k|      tally[mask] += sse_narrow2;
  638|  27.6k|      tally[nhev] -= sse_narrow2;
  639|  27.6k|      tally[nhev] += sse_narrow4;
  640|  27.6k|    }
  641|       |  }
