  165|  2.54k|  pub fn tile_log2(blk_size: usize, target: usize) -> Option<usize> {
  166|  2.54k|    let mut k = 0;
  167|  4.50k|    while (blk_size.checked_shl(k)?) < target {
  168|  1.96k|      k += 1;
  169|  1.96k|    }
