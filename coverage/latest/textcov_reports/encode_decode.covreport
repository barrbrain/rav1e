  433|  43.2M|$($s)* fn daala_fdst_iv_2<T: TxOperations>(p0: T, p1: T) -> (T, T) {
  434|  43.2M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8]  = 1.3065629648763766
  435|  43.2M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8]  = 0.5411961001461971
  436|  43.2M|  //  3135/4096 = 2*Cos[3*Pi/8]              = 0.7653668647301796
