  864|  2.81M|fn deblock_size14_inner(
  865|  2.81M|  [p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6]: [i32; 14],
  866|  2.81M|  level: usize, bd: usize,
  867|  2.81M|) -> Option<[i32; 12]> {
  868|  2.81M|  // 'mask' test
  869|  2.81M|  if mask8(p3, p2, p1, p0, q0, q1, q2, q3, bd - 8) <= level {
  870|   222k|    let flat = 1 << (bd - 8);
  871|       |    // inner flatness test
  872|   222k|    let x = if flat8(p3, p2, p1, p0, q0, q1, q2, q3) <= flat {
  873|       |      // outer flatness test
  874|  11.6k|      if flat14_outer(p6, p5, p4, p0, q0, q4, q5, q6) <= flat {
  875|       |        // sufficient flatness across 14 pixel width; run full-width filter
