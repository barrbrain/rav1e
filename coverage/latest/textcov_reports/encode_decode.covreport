  469|   977k|    }
  470|       |
  471|   535k|    txb_ctx.dc_sign_ctx =
  472|   535k|      dc_sign_contexts[(dc_sign + 2 * MAX_TX_SIZE_UNIT as i16) as usize];
  473|   535k|
  474|   535k|    // Decide txb_ctx.txb_skip_ctx
