 1989|  12.6k|          ts,
 1990|  12.6k|          cw,
 1991|  12.6k|          w_pre_cdef,
 1992|  12.6k|          w_post_cdef,
 1993|  12.6k|          bsize,
 1994|  12.6k|          tile_bo,
