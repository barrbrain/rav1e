 1447|       |  };
 1448|       |
 1449|  7.15M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  7.15M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  7.15M|  let rate = rate1.min(rate2 + 1);
 1452|  7.15M|
 1453|  7.15M|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
