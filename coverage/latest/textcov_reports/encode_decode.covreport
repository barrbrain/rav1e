   33|  1.22M|  pub fn get_sad<T: Pixel>(
   34|  1.22M|    plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>, w: usize,
   35|  1.22M|    h: usize, _bit_depth: usize, _cpu: CpuFeatureLevel,
