  660|  5.32M|$($s)* fn daala_fdst_iv_8_asym<T: TxOperations>(
  661|  5.32M|  r0: (T, T), r1h: T, r2: (T, T), r3h: T, r4: (T, T), r5h: T, r6: (T, T),
  662|  5.32M|  r7h: T, output: &mut [T],
  663|  5.32M|) {
  664|  5.32M|  // Stage 0
  665|  5.32M|  // 12665/16384 = (Sin[15*Pi/32] + Cos[15*Pi/32])/Sqrt[2] = 0.77301045336274
  666|  5.32M|  //   5197/4096 = (Sin[15*Pi/32] - Cos[15*Pi/32])*Sqrt[2] = 1.26878656832729
  667|  5.32M|  //  2271/16384 = Cos[15*Pi/32]*Sqrt[2]                   = 0.13861716919909
  668|  5.32M|  let (r0, r7) =
  669|  5.32M|    RotateAdd::half_kernel(r0, r7h, ((12665, 14), (5197, 12), (2271, 14)));
  670|  5.32M|  // 14449/16384 = Sin[13*Pi/32] + Cos[13*Pi/32])/Sqrt[2] = 0.881921264348355
  671|  5.32M|  // 30893/32768 = Sin[13*Pi/32] - Cos[13*Pi/32])*Sqrt[2] = 0.942793473651995
  672|  5.32M|  //   3363/8192 = Cos[13*Pi/32]*Sqrt[2]                  = 0.410524527522357
  673|  5.32M|  let (r6, r1) =
  674|  5.32M|    RotateSub::half_kernel(r6, r1h, ((14449, 14), (30893, 15), (3363, 13)));
  675|  5.32M|  // 15679/16384 = Sin[11*Pi/32] + Cos[11*Pi/32])/Sqrt[2] = 0.956940335732209
  676|  5.32M|  //   1189/2048 = Sin[11*Pi/32] - Cos[11*Pi/32])*Sqrt[2] = 0.580569354508925
  677|  5.32M|  //   5461/8192 = Cos[11*Pi/32]*Sqrt[2]                  = 0.666655658477747
  678|  5.32M|  let (r2, r5) =
  679|  5.32M|    RotateAdd::half_kernel(r2, r5h, ((15679, 14), (1189, 11), (5461, 13)));
  680|  5.32M|  // 16305/16384 = (Sin[9*Pi/32] + Cos[9*Pi/32])/Sqrt[2] = 0.9951847266721969
  681|  5.32M|  //    803/4096 = (Sin[9*Pi/32] - Cos[9*Pi/32])*Sqrt[2] = 0.1960342806591213
  682|  5.32M|  // 14699/16384 = Cos[9*Pi/32]*Sqrt[2]                  = 0.8971675863426364
  683|  5.32M|  let (r4, r3) =
  684|  5.32M|    RotateSub::half_kernel(r4, r3h, ((16305, 14), (803, 12), (14699, 14)));
  685|  5.32M|
  686|  5.32M|  // Stage 1
  687|  5.32M|  let (r0, r3h) = butterfly_add(r0, r3);
  688|  5.32M|  let (r2, r1h) = butterfly_sub(r2, r1);
  689|  5.32M|  let (r5, r6h) = butterfly_add(r5, r6);
  690|  5.32M|  let (r7, r4h) = butterfly_sub(r7, r4);
  691|  5.32M|
  692|  5.32M|  // Stage 2
  693|  5.32M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  694|  5.32M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  695|  5.32M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  696|  5.32M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  697|  5.32M|
  698|  5.32M|  // Stage 3
  699|  5.32M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  700|  5.32M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  701|  5.32M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  702|  5.32M|  let (r3, r4) =
  703|  5.32M|    RotateSubAvg::kernel(r3, r4, ((669, 9), (8867, 14), (3135, 12)));
  704|  5.32M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  705|  5.32M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  706|  5.32M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  707|  5.32M|  let (r2, r5) =
  708|  5.32M|    RotateNegAvg::kernel(r2, r5, ((669, 9), (8867, 14), (3135, 12)));
  709|  5.32M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  710|  5.32M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  711|  5.32M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((5793, 12), (11585, 13)));
  712|  5.32M|
  713|  5.32M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  714|  5.32M|}
