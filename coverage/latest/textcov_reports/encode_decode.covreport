  323|  53.9k|fn save_me_stats<T: Pixel>(
  324|  53.9k|  ts: &mut TileStateMut<'_, T>, mv_size_in_b_log2: usize,
  325|  53.9k|  tile_bo: TileBlockOffset, ref_frame: RefType, stats: MEStats,
  326|  53.9k|) {
  327|  53.9k|  let size_in_b = 1 << mv_size_in_b_log2;
  328|  53.9k|  let tile_me_stats = &mut ts.me_stats[ref_frame.to_index()];
  329|  53.9k|  let tile_bo_x_end = (tile_bo.0.x + size_in_b).min(ts.mi_width);
  330|  53.9k|  let tile_bo_y_end = (tile_bo.0.y + size_in_b).min(ts.mi_height);
