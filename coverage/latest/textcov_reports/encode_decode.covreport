  951|   140k|fn fullpel_diamond_search<T: Pixel>(
  952|   140k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   140k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   140k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   140k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   140k|) {
  957|   140k|  // Define the initial and the final scale (log2) of the diamond.
  958|   140k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|   404k|  loop {
  961|   404k|    // Find the best candidate from the diamond pattern.
  962|   404k|    let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
  963|  2.02M|    for &offset in &DIAMOND_R1_PATTERN {
  964|  1.61M|      let cand_mv = current.mv + (offset << diamond_radius_log2);
  965|  1.61M|      let rd = get_fullpel_mv_rd(
  966|  1.61M|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
  967|  1.61M|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
  968|  1.61M|      );
  969|  1.61M|
  970|  1.61M|      if rd.cost < best_cand.rd.cost {
  971|   813k|        best_cand.mv = cand_mv;
  972|   813k|        best_cand.rd = rd;
  973|   813k|      }
  974|       |    }
  975|       |
  976|       |    // Continue the search at this scale until the can't find a better candidate
  977|       |    // to use.
  978|   404k|    if current.rd.cost <= best_cand.rd.cost {
  979|   280k|      if diamond_radius_log2 == diamond_radius_end_log2 {
  980|   140k|        break;
  981|   140k|      } else {
  982|   140k|        diamond_radius_log2 -= 1;
  983|   140k|      }
  984|   124k|    } else {
  985|   124k|      *current = best_cand;
  986|   124k|    }
  987|       |  }
  988|       |
  989|   140k|  assert!(!current.is_empty());
  990|   140k|}
