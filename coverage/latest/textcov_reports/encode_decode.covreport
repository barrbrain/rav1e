  593|   372k|    let (sq_integral_row_prev, sq_integral_row) =
  594|   372k|      sq_integral_slice.split_at_mut(integral_image_stride);
  595|       |    for (
  596|  28.5M|      src,
  597|  28.5M|      ((integral_above, sq_integral_above), (integral, sq_integral)),
  598|   372k|    ) in row.zip(
  599|   372k|      integral_row_prev
  600|   372k|        .iter()
  601|   372k|        .zip(sq_integral_row_prev.iter())
  602|   372k|        .zip(integral_row.iter_mut().zip(sq_integral_row.iter_mut())),
