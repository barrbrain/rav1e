  509|  3.40k|fn chroma_offset(
  510|  3.40k|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|  3.40k|) -> (i64, i64) {
  512|  3.40k|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|  3.40k|  let y = match chroma_sampling {
  515|    648|    ChromaSampling::Cs400 => 0,
  516|    604|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|    492|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|  1.66k|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
