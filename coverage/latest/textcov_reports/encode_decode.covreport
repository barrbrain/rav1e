  310|  30.7k|          / (w * h) as u64) as u32;
  311|  30.7k|        save_me_stats(
  312|  30.7k|          ts,
  313|  30.7k|          mv_size_in_b_log2,
  314|  30.7k|          sub_bo,
  315|  30.7k|          ref_frame,
  316|  30.7k|          MEStats { mv: results.mv, normalized_sad: sad },
