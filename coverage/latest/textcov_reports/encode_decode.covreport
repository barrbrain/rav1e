 1009|  7.11M|  let (sa, s5) =
 1010|  7.11M|    RotateSubShift::half_kernel(sa, s5h, ((5619, 13), (2815, 12), (8423, 13)));
 1011|  7.11M|  //   2865/4096 = (Sin[19*Pi/64] + Cos[19*Pi/64])/2 = 0.6994534179865391
 1012|  7.11M|  // 13588/32768 = (Sin[19*Pi/64] - Cos[19*Pi/64])*2 = 0.4150164539764232
 1013|  7.11M|  //     305/256 = Cos[19*Pi/64]*2                   = 1.1913986089848667
 1014|  7.11M|  let (s6, s9) =
