  463|  9.40M|pub fn spatiotemporal_scale<T: Pixel>(
  464|  9.40M|  fi: &FrameInvariants<T>, frame_bo: PlaneBlockOffset, bsize: BlockSize,
  465|  9.40M|) -> DistortionScale {
  466|  9.40M|  if !fi.config.temporal_rdo() && fi.config.tune != Tune::Psychovisual {
  467|      0|    return DistortionScale::default();
