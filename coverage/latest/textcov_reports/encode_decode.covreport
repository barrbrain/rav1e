  469|  9.40M|
  470|  9.40M|  let coded_data = fi.coded_frame_data.as_ref().unwrap();
  471|  9.40M|
  472|  9.40M|  let x0 = frame_bo.0.x >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  473|  9.40M|  let y0 = frame_bo.0.y >> IMPORTANCE_BLOCK_TO_BLOCK_SHIFT;
  474|  9.40M|  let x1 = (x0 + bsize.width_imp_b()).min(coded_data.w_in_imp_b);
  475|  9.40M|  let y1 = (y0 + bsize.height_imp_b()).min(coded_data.h_in_imp_b);
  476|  9.40M|  let den = (((x1 - x0) * (y1 - y0)) as u64) << DistortionScale::SHIFT;
  477|  9.40M|
  478|  9.40M|  // calling this on each slice individually improves autovectorization
  479|  9.40M|  // compared to using `Iterator::take`
  480|  9.40M|  #[inline(always)]
  481|  9.40M|  fn take_slice<T>(slice: &[T], n: usize) -> &[T] {
  482|  9.40M|    if n >= slice.len() {
  483|  9.40M|      slice
  484|  9.40M|    } else {
  485|  9.40M|      &slice[..n]
  486|  9.40M|    }
  487|  9.40M|  }
  488|  9.40M|
  489|  9.40M|  let mut sum = 0;
  490|  11.7M|  for y in y0..y1 {
  491|  11.7M|    sum += take_slice(
  492|  11.7M|      &coded_data.distortion_scales[y * coded_data.w_in_imp_b..][x0..x1],
  493|  11.7M|      MAX_SB_IN_IMP_B,
  494|  11.7M|    )
  495|  11.7M|    .iter()
  496|  11.7M|    .zip(
  497|  11.7M|      take_slice(
  498|  11.7M|        &coded_data.activity_scales[y * coded_data.w_in_imp_b..][x0..x1],
  499|  11.7M|        MAX_SB_IN_IMP_B,
  500|  11.7M|      )
  501|  11.7M|      .iter(),
  502|  11.7M|    )
  503|  11.7M|    .map(|(d, a)| d.0 as u64 * a.0 as u64)
  504|  11.7M|    .sum::<u64>();
  505|  11.7M|  }
