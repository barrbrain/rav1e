  690|    705|      inter_delay: [INTER_DELAY_TARGET_MIN; FRAME_NSUBTYPES - 1],
  691|    705|      inter_delay_target: reservoir_frame_delay >> 1,
  692|    705|      rate_bias: 0,
  693|    705|      nencoded_frames: 0,
