 1471|   189k|  for vert_window in search_region.vert_windows(h).step_by(step) {
 1472|  4.98M|    for ref_window in vert_window.horz_windows(w).step_by(step) {
 1473|  4.98M|      let &Rect { x, y, .. } = ref_window.rect();
 1474|  4.98M|
 1475|  4.98M|      let mv = MotionVector {
 1476|  4.98M|        row: 8 * (y as i16 - po.y as i16),
 1477|  4.98M|        col: 8 * (x as i16 - po.x as i16),
 1478|  4.98M|      };
 1479|  4.98M|
 1480|  4.98M|      let rd = compute_mv_rd(
 1481|  4.98M|        fi,
 1482|  4.98M|        pmv,
 1483|  4.98M|        lambda,
 1484|  4.98M|        false,
 1485|  4.98M|        fi.sequence.bit_depth,
 1486|  4.98M|        w,
 1487|  4.98M|        h,
 1488|  4.98M|        mv,
 1489|  4.98M|        org_region,
 1490|  4.98M|        &ref_window,
 1491|  4.98M|      );
 1492|  4.98M|
 1493|  4.98M|      if rd.cost < best.rd.cost {
 1494|   120k|        best.rd = rd;
 1495|   120k|        best.mv = mv;
 1496|  4.86M|      }
 1497|       |    }
 1498|       |  }
