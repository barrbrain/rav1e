 1137|     16|      if self.twopass_state == PASS_2 || self.twopass_state == PASS_2_PLUS_1 {
 1138|       |        // Pass 2 mode:
 1139|      0|        if !trial {
 1140|       |          // Move the current metrics back one frame.
 1141|      0|          self.prev_metrics = self.cur_metrics;
 1142|      0|          // Back out the last frame's statistics from the sliding window.
 1143|      0|          let ftj = self.prev_metrics.fti;
 1144|      0|          self.nframes_left[ftj] -= 1;
 1145|      0|          self.scale_window_nframes[ftj] -= 1;
