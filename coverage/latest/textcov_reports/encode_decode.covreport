  611|     17|    &self, in_plane: &mut Plane<T>,
  612|     17|  ) {
  613|     17|    // SAFETY: Bounds checks have been removed for performance reasons
  614|     17|    unsafe {
  615|     17|      let src = self;
  616|     17|      let box_pixels = SCALE * SCALE;
  617|     17|      let half_box_pixels = box_pixels as u32 / 2; // Used for rounding int division
  618|     17|
  619|     17|      let data_origin = src.data_origin();
  620|     17|
  621|     17|      let stride = in_plane.cfg.stride;
  622|     17|      let width = in_plane.cfg.width;
  623|     17|      let height = in_plane.cfg.height;
  624|     17|
  625|     17|      if stride == 0 {
  626|      0|        debug_unreachable!();
  627|     17|      }
  628|     17|      if src.cfg.stride == 0 {
  629|      0|        debug_unreachable!();
  630|     17|      }
  631|     17|
  632|     17|      let plane_data_mut_slice = in_plane.data.deref_mut();
  633|       |
  634|       |      // Iter dst rows
  635|  2.29k|      for row_idx in 0..height {
  636|  2.29k|        let dst_row =
  637|  2.29k|          plane_data_mut_slice.get_unchecked_mut(row_idx * stride..);
  638|       |        // Iter dst cols
  639|   310k|        for (col_idx, dst) in
  640|  2.29k|          dst_row.get_unchecked_mut(..width).iter_mut().enumerate()
  641|       |        {
  642|       |          macro_rules! generate_inner_loop {
  643|       |            ($x:ty) => {
  644|       |              let mut sum = half_box_pixels as $x;
  645|       |              // Sum box of size scale * scale
  646|       |
  647|       |              // Iter src row
  648|       |              for y in 0..SCALE {
  649|       |                let src_row_idx = row_idx * SCALE + y;
  650|       |                let src_row =
  651|       |                  data_origin.get_unchecked((src_row_idx * src.cfg.stride)..);
  652|       |
  653|       |                // Iter src col
  654|       |                for x in 0..SCALE {
  655|       |                  let src_col_idx = col_idx * SCALE + x;
  656|       |                  sum += <$x>::cast_from(*src_row.get_unchecked(src_col_idx));
  657|       |                }
  658|       |              }
  659|       |
  660|       |              // Box average
  661|       |              let avg = sum as usize / box_pixels;
  662|       |              *dst = T::cast_from(avg);
  663|       |            };
  664|       |          }
  665|       |
  666|       |          // Use 16 bit precision if overflow would not happen
  667|   310k|          if T::type_enum() == PixelType::U8
  668|   310k|            && SCALE as u128 * SCALE as u128 * (u8::MAX as u128)
  669|   310k|              + half_box_pixels as u128
  670|   310k|              <= u16::MAX as u128
  671|       |          {
  672|   310k|            generate_inner_loop!(u16);
  673|       |          } else {
  674|      0|            generate_inner_loop!(u32);
  675|       |          }
  676|       |        }
  677|       |      }
  678|       |    }
  679|     17|  }
