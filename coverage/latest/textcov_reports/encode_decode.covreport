  660|  11.0M|$($s)* fn daala_fdst_iv_8_asym<T: TxOperations>(
  661|  11.0M|  r0: (T, T), r1h: T, r2: (T, T), r3h: T, r4: (T, T), r5h: T, r6: (T, T),
  662|  11.0M|  r7h: T, output: &mut [T],
  663|  11.0M|) {
  664|  11.0M|  // Stage 0
  665|  11.0M|  // 12665/16384 = (Sin[15*Pi/32] + Cos[15*Pi/32])/Sqrt[2] = 0.77301045336274
  666|  11.0M|  //   5197/4096 = (Sin[15*Pi/32] - Cos[15*Pi/32])*Sqrt[2] = 1.26878656832729
  667|  11.0M|  //  2271/16384 = Cos[15*Pi/32]*Sqrt[2]                   = 0.13861716919909
  668|  11.0M|  let (r0, r7) =
  669|  11.0M|    RotateAdd::half_kernel(r0, r7h, ((12665, 14), (5197, 12), (2271, 14)));
  670|  11.0M|  // 14449/16384 = Sin[13*Pi/32] + Cos[13*Pi/32])/Sqrt[2] = 0.881921264348355
  671|  11.0M|  // 30893/32768 = Sin[13*Pi/32] - Cos[13*Pi/32])*Sqrt[2] = 0.942793473651995
  672|  11.0M|  //   3363/8192 = Cos[13*Pi/32]*Sqrt[2]                  = 0.410524527522357
  673|  11.0M|  let (r6, r1) =
  674|  11.0M|    RotateSub::half_kernel(r6, r1h, ((14449, 14), (30893, 15), (3363, 13)));
  675|  11.0M|  // 15679/16384 = Sin[11*Pi/32] + Cos[11*Pi/32])/Sqrt[2] = 0.956940335732209
  676|  11.0M|  //   1189/2048 = Sin[11*Pi/32] - Cos[11*Pi/32])*Sqrt[2] = 0.580569354508925
  677|  11.0M|  //   5461/8192 = Cos[11*Pi/32]*Sqrt[2]                  = 0.666655658477747
  678|  11.0M|  let (r2, r5) =
  679|  11.0M|    RotateAdd::half_kernel(r2, r5h, ((15679, 14), (1189, 11), (5461, 13)));
  680|  11.0M|  // 16305/16384 = (Sin[9*Pi/32] + Cos[9*Pi/32])/Sqrt[2] = 0.9951847266721969
  681|  11.0M|  //    803/4096 = (Sin[9*Pi/32] - Cos[9*Pi/32])*Sqrt[2] = 0.1960342806591213
  682|  11.0M|  // 14699/16384 = Cos[9*Pi/32]*Sqrt[2]                  = 0.8971675863426364
  683|  11.0M|  let (r4, r3) =
  684|  11.0M|    RotateSub::half_kernel(r4, r3h, ((16305, 14), (803, 12), (14699, 14)));
  685|  11.0M|
  686|  11.0M|  // Stage 1
  687|  11.0M|  let (r0, r3h) = butterfly_add(r0, r3);
  688|  11.0M|  let (r2, r1h) = butterfly_sub(r2, r1);
  689|  11.0M|  let (r5, r6h) = butterfly_add(r5, r6);
  690|  11.0M|  let (r7, r4h) = butterfly_sub(r7, r4);
  691|  11.0M|
  692|  11.0M|  // Stage 2
  693|  11.0M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  694|  11.0M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  695|  11.0M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  696|  11.0M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  697|  11.0M|
  698|  11.0M|  // Stage 3
  699|  11.0M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  700|  11.0M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  701|  11.0M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  702|  11.0M|  let (r3, r4) =
  703|  11.0M|    RotateSubAvg::kernel(r3, r4, ((669, 9), (8867, 14), (3135, 12)));
  704|  11.0M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  705|  11.0M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  706|  11.0M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  707|  11.0M|  let (r2, r5) =
  708|  11.0M|    RotateNegAvg::kernel(r2, r5, ((669, 9), (8867, 14), (3135, 12)));
  709|  11.0M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  710|  11.0M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  711|  11.0M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((5793, 12), (11585, 13)));
  712|  11.0M|
  713|  11.0M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  714|  11.0M|}
