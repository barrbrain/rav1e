_RNvNtCs3tIhnEwGhQF_5rav1e2me12get_mv_range:
  338|   147k|fn get_mv_range(
  339|   147k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   147k|  blk_h: usize,
  341|   147k|) -> (isize, isize, isize, isize) {
  342|   147k|  let border_w = 128 + blk_w as isize * 8;
  343|   147k|  let border_h = 128 + blk_h as isize * 8;
  344|   147k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   147k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   147k|    * (8 * MI_SIZE) as isize
  347|   147k|    + border_w;
  348|   147k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   147k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   147k|    * (8 * MI_SIZE) as isize
  351|   147k|    + border_h;
  352|   147k|
  353|   147k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   147k|  use crate::context::{MV_LOW, MV_UPP};
  355|   147k|  (
  356|   147k|    mvx_min.max(MV_LOW as isize + 1),
  357|   147k|    mvx_max.min(MV_UPP as isize - 1),
  358|   147k|    mvy_min.max(MV_LOW as isize + 1),
  359|   147k|    mvy_max.min(MV_UPP as isize - 1),
  360|   147k|  )
  361|   147k|}
