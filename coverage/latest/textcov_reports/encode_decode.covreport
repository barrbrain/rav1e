  730|  14.6M|pub fn rdo_tx_size_type<T: Pixel>(
  731|  14.6M|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>,
  732|  14.6M|  cw: &mut ContextWriter, bsize: BlockSize, tile_bo: TileBlockOffset,
