  393|  35.1M|$($s)* fn daala_fdst_vii_4<T: TxOperations>(coeffs: &mut [T]) {
  394|  35.1M|  assert!(coeffs.len() >= 4);
  395|       |
  396|  35.1M|  let q0 = coeffs[0];
  397|  35.1M|  let q1 = coeffs[1];
  398|  35.1M|  let q2 = coeffs[2];
  399|  35.1M|  let q3 = coeffs[3];
  400|  35.1M|  let t0 = q1.add(q3);
  401|  35.1M|  // t1 = (q0 + q1 - q3)/2
  402|  35.1M|  let t1 = q1.add(q0.sub_avg(t0));
  403|  35.1M|  let t2 = q0.sub(q1);
  404|  35.1M|  let t3 = q2;
  405|  35.1M|  let t4 = q0.add(q3);
  406|  35.1M|  // 7021/16384 ~= 2*Sin[2*Pi/9]/3 ~= 0.428525073124360
  407|  35.1M|  let t0 = t0.tx_mul((7021, 14));
  408|  35.1M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  409|  35.1M|  let t1 = t1.tx_mul((37837, 15));
  410|  35.1M|  // 21513/32768 ~= 2*Sin[4*Pi/9]/3 ~= 0.656538502008139
  411|  35.1M|  let t2 = t2.tx_mul((21513, 15));
  412|  35.1M|  // 37837/32768 ~= 4*Sin[3*Pi/9]/3 ~= 1.154700538379252
  413|  35.1M|  let t3 = t3.tx_mul((37837, 15));
  414|  35.1M|  // 467/2048 ~= 2*Sin[1*Pi/9]/3 ~= 0.228013428883779
  415|  35.1M|  let t4 = t4.tx_mul((467, 11));
  416|  35.1M|  let t3h = t3.rshift1();
  417|  35.1M|  let u4 = t4.add(t3h);
  418|  35.1M|  coeffs[0] = t0.add(u4);
  419|  35.1M|  coeffs[1] = t1;
  420|  35.1M|  coeffs[2] = t0.add(t2.sub(t3h));
  421|  35.1M|  coeffs[3] = t2.add(t3.sub(u4));
  422|  35.1M|}
