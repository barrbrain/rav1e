 1586|   827k|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|   827k|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|   827k|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|   827k|  let mut half: [T; 32] = [T::zero(); 32];
 1591|   827k|  // +/- Butterflies with asymmetric output.
 1592|   827k|  {
 1593|   827k|    #[$m]
 1594|   827k|    #[inline]
 1595|   827k|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|   827k|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|   827k|    ) {
 1598|   827k|      let j = i * 2;
 1599|   827k|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|   827k|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|   827k|      half[i] = ah;
 1602|   827k|      half[31 - i] = dh;
 1603|   827k|      asym[i] = b;
 1604|   827k|      asym[31 - i] = c;
 1605|   827k|    }
 1606|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 0);
 1607|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 1);
 1608|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 2);
 1609|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 3);
 1610|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 4);
 1611|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 5);
 1612|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 6);
 1613|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 7);
 1614|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 8);
 1615|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 9);
 1616|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 10);
 1617|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 11);
 1618|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 12);
 1619|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 13);
 1620|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 14);
 1621|   827k|    butterfly_pair(&mut half, &mut asym, coeffs, 15);
 1622|   827k|  }
 1623|   827k|
 1624|   827k|  let mut temp_out: [T; 64] = [T::zero(); 64];
 1625|   827k|  // Embedded 2-point transforms with asymmetric input.
 1626|   827k|  daala_fdct_ii_32_asym(
 1627|   827k|    half[0],
 1628|   827k|    asym[0],
 1629|   827k|    half[1],
