 1139|  3.40M|    t9,
 1140|  3.40M|    tah,
 1141|  3.40M|    tb,
 1142|  3.40M|    tch,
 1143|  3.40M|    td,
 1144|  3.40M|    teh,
 1145|  3.40M|    tf,
