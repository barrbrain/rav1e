 1505|  32.5M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  32.5M|) -> u32 {
 1507|  32.5M|  #[inline(always)]
 1508|  32.5M|  fn diff_to_rate(diff: i16, allow_high_precision_mv: bool) -> u32 {
 1509|  32.5M|    let d = if allow_high_precision_mv { diff } else { diff >> 1 };
 1510|  32.5M|    2 * ILog::ilog(d.abs()) as u32
 1511|  32.5M|  }
 1512|  32.5M|
 1513|  32.5M|  diff_to_rate(a.row - b.row, allow_high_precision_mv)
 1514|  32.5M|    + diff_to_rate(a.col - b.col, allow_high_precision_mv)
 1515|  32.5M|}
