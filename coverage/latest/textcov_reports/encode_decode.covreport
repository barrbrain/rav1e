  663|       |    // TODO: Add support for "golden" P frames.
  664|    705|    RCState {
  665|    705|      target_bitrate,
  666|    705|      reservoir_frame_delay,
  667|    705|      reservoir_frame_delay_is_set: maybe_reservoir_frame_delay.is_some(),
  668|    705|      maybe_ac_qi_max,
  669|    705|      ac_qi_min,
  670|    705|      drop_frames: false,
  671|    705|      cap_overflow: true,
  672|    705|      cap_underflow: false,
  673|    705|      pass1_log_base_q: 0,
