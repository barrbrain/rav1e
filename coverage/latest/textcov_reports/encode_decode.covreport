  416|       |
  417|       |  // left
  418|   137k|  if tile_bo.0.x > 0 {
  419|   100k|    subset_b.push(process_cand(
  420|   100k|      tile_me_stats[tile_bo.0.y + clipped_half_h][tile_bo.0.x - 1],
  421|   100k|    ));
  422|   100k|  }
  423|       |  // top
  424|   137k|  if tile_bo.0.y > 0 {
  425|  98.9k|    subset_b.push(process_cand(
  426|  98.9k|      tile_me_stats[tile_bo.0.y - 1][tile_bo.0.x + clipped_half_w],
  427|  98.9k|    ));
  428|  98.9k|  }
