  490|  31.6M|$($s)* fn daala_fdct_ii_8<T: TxOperations>(
  491|  31.6M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  492|  31.6M|) {
