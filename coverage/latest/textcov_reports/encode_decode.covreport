   98|       |      c.iter().skip(1).zip(c).map(|(&a, &b)| b as i64 - a as i64),
   99|       |    );
  100|       |    let mean = delta.iter().sum::<i64>() / delta.len() as i64;
  101|       |    delta.iter().map(|&d| (d - mean).pow(2)).sum::<i64>() as u64
  102|       |  };
  103|    677|  let variance =
  104|    677|    [var(&c.0), var(&c.1), var(&c.2), var(&c.3), var(&c.4), var(&c.5)];
  105|    677|
  106|    677|  // Choose the k value with minimal variance in spacing
  107|    677|  let min_variance = *variance.iter().min().unwrap();
  108|    677|  let position = variance.iter().rposition(|&v| v == min_variance).unwrap();
  109|    677|
  110|    677|  // For the selected centroids, derive a target quantizer:
  111|    677|  //   scale Q'^2 = Q^2
  112|    677|  // See `distortion_scale_for` for more information.
  113|    677|  let compute_delta = |centroids: &[i16]| {
  114|       |    use crate::util::{bexp64, blog64};
  115|       |    let log2_base_ac_q_q57 =
  116|       |      blog64(ac_q(fi.base_q_idx, 0, fi.config.bit_depth).into());
  117|       |    centroids
  118|       |      .iter()
  119|       |      .rev()
  120|       |      // Rewrite in log form and exponentiate:
  121|       |      //   scale Q'^2 = Q^2
  122|       |      //           Q' = Q / sqrt(scale)
  123|       |      //      log(Q') = log(Q) - 0.5 log(scale)
  124|       |      .map(|&log2_scale_q11| {
  125|       |        bexp64(log2_base_ac_q_q57 - ((log2_scale_q11 as i64) << (57 - 11 - 1)))
  126|       |      })
  127|       |      // Find the index of the nearest quantizer to the target,
  128|       |      // and take the delta from the base quantizer index.
  129|       |      .map(|q| {
  130|       |        // Avoid going into lossless mode by never bringing qidx below 1.
  131|       |        select_ac_qi(q, fi.config.bit_depth).max(1) as i16
  132|       |          - fi.base_q_idx as i16
  133|       |      })
  134|       |      .collect::<ArrayVec<_, MAX_SEGMENTS>>()
  135|       |  };
  136|       |
  137|       |  // Compute segment deltas for best value of k
  138|    677|  let seg_delta = match position {
  139|      5|    0 => compute_delta(&c.0),
  140|      0|    1 => compute_delta(&c.1),
  141|     13|    2 => compute_delta(&c.2),
  142|     69|    3 => compute_delta(&c.3),
  143|     11|    4 => compute_delta(&c.4),
  144|    579|    _ => compute_delta(&c.5),
  145|       |  };
  146|       |
  147|       |  // Update the segmentation data
  148|    677|  fs.segmentation.max_segment = seg_delta.len() as u8 - 1;
  149|  2.24k|  for (&delta, (features, data)) in seg_delta
  150|    677|    .iter()
  151|    677|    .zip(fs.segmentation.features.iter_mut().zip(&mut fs.segmentation.data))
  152|  2.24k|  {
  153|  2.24k|    features[SegLvl::SEG_LVL_ALT_Q as usize] = true;
  154|  2.24k|    data[SegLvl::SEG_LVL_ALT_Q as usize] = delta.max(offset_lower_limit);
  155|  2.24k|  }
  156|       |
  157|    677|  fs.segmentation.update_threshold(fi.base_q_idx, fi.config.bit_depth);
  158|    677|}
