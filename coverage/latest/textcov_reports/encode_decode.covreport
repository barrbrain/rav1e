 1504|  14.3M|fn get_mv_rate(
 1505|  14.3M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  14.3M|) -> u32 {
 1507|  14.3M|  #[inline(always)]
