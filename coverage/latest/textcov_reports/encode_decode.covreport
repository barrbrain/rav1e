  147|  2.83k|  let warp = warp_alpha(alpha).max(1) as i64;
  148|  2.83k|  // k1 is 9.12 (6.12?)
  149|  2.83k|  let k1 = 3 * warp;
  150|  2.83k|  // k2 is 16.24 (11.24?)
  151|  2.83k|  let k2 = k1 * warp;
  152|  2.83k|  // d is 16.15 (10.15?)
  153|  2.83k|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|  2.83k|  // a is 0.32, since d is larger than both 1.0 and k2
