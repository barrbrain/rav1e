  179|  16.2k|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32))) -> (T, T) {
  180|  16.2k|    let t = Self::ADD(p1, p0);
  181|  16.2k|    let (a, out0) = (p0.tx_mul(m.0), t.tx_mul(m.1));
  182|  16.2k|    let out1 = Self::SUB(a, out0);
  183|  16.2k|    (out0, out1)
  184|  16.2k|  }
