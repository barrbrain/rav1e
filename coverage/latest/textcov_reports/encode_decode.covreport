 1480|  9.35k|fn sse_plane<T: Pixel>(
 1481|  9.35k|  rec: &PlaneRegion<T>, src: &PlaneRegion<T>,
 1482|  9.35k|  v_sse: &mut [i64; MAX_LOOP_FILTER + 2],
 1483|  9.35k|  h_sse: &mut [i64; MAX_LOOP_FILTER + 2], pli: usize, blocks: &TileBlocks,
 1484|  9.35k|  crop_w: usize, crop_h: usize, bd: usize,
 1485|  9.35k|) {
 1486|  9.35k|  let xdec = rec.plane_cfg.xdec;
 1487|  9.35k|  let ydec = rec.plane_cfg.ydec;
 1488|  9.35k|  assert!(xdec <= 1 && ydec <= 1);
 1489|  9.35k|  let rect = rec.rect();
 1490|  9.35k|  let cols = (cmp::min(
 1491|  9.35k|    blocks.cols(),
 1492|  9.35k|    (crop_w - rect.x as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1493|  9.35k|  ) + (1 << xdec >> 1))
 1494|  9.35k|    >> xdec
 1495|  9.35k|    << xdec; // Clippy can go suck an egg
 1496|  9.35k|  let rows = (cmp::min(
 1497|  9.35k|    blocks.rows(),
 1498|  9.35k|    (crop_h - rect.y as usize + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1499|  9.35k|  ) + (1 << ydec >> 1))
 1500|  9.35k|    >> ydec
