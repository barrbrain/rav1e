  441|  58.7M|$($s)* fn daala_fdct_ii_4_asym<T: TxOperations>(
  442|  58.7M|  q0h: T, q1: (T, T), q2h: T, q3: (T, T), output: &mut [T],
  443|  58.7M|) {
  444|  58.7M|  // +/- Butterflies with asymmetric input.
  445|  58.7M|  let (q0, q3) = butterfly_neg_asym(q0h, q3);
  446|  58.7M|  let (q1, q2) = butterfly_sub_asym(q1, q2h);
  447|  58.7M|
  448|  58.7M|  // Embedded 2-point orthonormal transforms.
  449|  58.7M|  let (q0, q1) = daala_fdct_ii_2(q0, q1);
  450|  58.7M|  let (q3, q2) = daala_fdst_iv_2(q3, q2);
  451|  58.7M|
  452|  58.7M|  store_coeffs!(output, q0, q1, q2, q3);
  453|  58.7M|}
