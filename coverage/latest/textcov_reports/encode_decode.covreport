  597|    705|  pub fn new(
  598|    705|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    705|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    705|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    705|    maybe_reservoir_frame_delay: Option<i32>,
  602|    705|  ) -> RCState {
  603|    705|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    705|    //  frames; whichever is smaller, with a minimum of 12.
  605|    705|    // For user set values, we enforce a minimum of 12.
  606|    705|    // The interval is short enough to allow reaction, but long enough to allow
  607|    705|    //  looking into the next GOP (avoiding the case where the last frames
  608|    705|    //  before an I-frame get starved), in most cases.
  609|    705|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    705|    //  errors in the worst case.
