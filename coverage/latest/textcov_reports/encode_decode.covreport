  632|  12.2k|fn refine_subsampled_motion_estimate<T: Pixel>(
  633|  12.2k|  fi: &FrameInvariants<T>, ts: &TileStateMut<'_, T>, w: usize, h: usize,
  634|  12.2k|  tile_bo: TileBlockOffset, ref_frame: RefType, ssdec: u8, lambda: u32,
  635|  12.2k|) -> Option<MotionSearchResult> {
  636|  11.4k|  if let Some(ref rec) =
  637|  12.2k|    fi.rec_buffer.frames[fi.ref_frames[ref_frame.to_index()] as usize]
  638|       |  {
  639|  11.4k|    let frame_bo = ts.to_frame_block_offset(tile_bo);
  640|  11.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  641|  11.4k|      get_mv_range(fi.w_in_b, fi.h_in_b, frame_bo, w << ssdec, h << ssdec);
  642|  11.4k|
  643|  11.4k|    let pmv = [MotionVector { row: 0, col: 0 }; 2];
  644|  11.4k|
  645|  11.4k|    let po = frame_bo.to_luma_plane_offset();
  646|  11.4k|    let (mvx_min, mvx_max, mvy_min, mvy_max) =
  647|  11.4k|      (mvx_min >> ssdec, mvx_max >> ssdec, mvy_min >> ssdec, mvy_max >> ssdec);
  648|  11.4k|    let po = PlaneOffset { x: po.x >> ssdec, y: po.y >> ssdec };
  649|  11.4k|    let p_ref = match ssdec {
  650|  8.44k|      0 => &rec.frame.planes[0],
  651|  3.02k|      1 => &rec.input_hres,
  652|      0|      2 => &rec.input_qres,
  653|      0|      _ => unimplemented!(),
  654|       |    };
  655|       |
  656|  11.4k|    let org_region = &match ssdec {
  657|  8.44k|      0 => ts.input_tile.planes[0]
  658|  8.44k|        .subregion(Area::BlockStartingAt { bo: tile_bo.0 }),
  659|  3.02k|      1 => ts.input_hres.region(Area::StartingAt { x: po.x, y: po.y }),
  660|      0|      2 => ts.input_qres.region(Area::StartingAt { x: po.x, y: po.y }),
  661|      0|      _ => unimplemented!(),
  662|       |    };
  663|       |
  664|  11.4k|    let mv =
  665|  11.4k|      ts.me_stats[ref_frame.to_index()][tile_bo.0.y][tile_bo.0.x].mv >> ssdec;
  666|  11.4k|
  667|  11.4k|    // Given a motion vector at 0 at higher subsampling:
  668|  11.4k|    // |  -1   |   0   |   1   |
  669|  11.4k|    // then the vectors at -1 to 2 should be tested at the current subsampling.
  670|  11.4k|    //      |-------------|
  671|  11.4k|    // | -2 -1 |  0  1 |  2  3 |
  672|  11.4k|    // This corresponds to a 4x4 full search.
  673|  11.4k|    let x_lo = po.x + (mv.col as isize / 8 - 1).max(mvx_min / 8);
  674|  11.4k|    let x_hi = po.x + (mv.col as isize / 8 + 2).min(mvx_max / 8);
  675|  11.4k|    let y_lo = po.y + (mv.row as isize / 8 - 1).max(mvy_min / 8);
  676|  11.4k|    let y_hi = po.y + (mv.row as isize / 8 + 2).min(mvy_max / 8);
  677|  11.4k|    let mut results = full_search(
  678|  11.4k|      fi, x_lo, x_hi, y_lo, y_hi, w, h, org_region, p_ref, po, 1, lambda, pmv,
  679|  11.4k|    );
  680|  11.4k|
  681|  11.4k|    // Scale motion vectors to full res size
  682|  11.4k|    results.mv = results.mv << ssdec;
  683|  11.4k|
  684|  11.4k|    Some(results)
  685|       |  } else {
  686|    807|    None
  687|       |  }
  688|  12.2k|}
_RINvNtCs3tIhnEwGhQF_5rav1e2me27refine_subsampled_sb_motionhEB4_:
  283|  6.45k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  6.45k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  6.45k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
  286|  6.45k|) {
  287|  6.45k|  let pix_offset = tile_bo.to_luma_plane_offset();
  288|  6.45k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  289|  6.45k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  290|  6.45k|
  291|  6.45k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  292|       |
  293|       |  // Process in blocks, cropping at edges.
  294|  8.61k|  for y in (0..sb_h).step_by(mv_size) {
  295|  12.2k|    for x in (0..sb_w).step_by(mv_size) {
  296|  12.2k|      let sub_bo = tile_bo
  297|  12.2k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  298|  12.2k|
  299|  12.2k|      // Clamp to frame edge, rounding up in the case of subsampling.
  300|  12.2k|      // The rounding makes some assumptions about how subsampling is done.
  301|  12.2k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  302|  12.2k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  303|       |
  304|       |      // Refine the existing motion estimate
  305|  12.2k|      if let Some(results) = refine_subsampled_motion_estimate(
  306|  12.2k|        fi, ts, w, h, sub_bo, ref_frame, ssdec, lambda,
  307|  12.2k|      ) {
  308|  11.4k|        // normalize sad to 128x128 block
  309|  11.4k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  310|  11.4k|          / (w * h) as u64) as u32;
  311|  11.4k|        save_me_stats(
  312|  11.4k|          ts,
  313|  11.4k|          mv_size_in_b_log2,
  314|  11.4k|          sub_bo,
  315|  11.4k|          ref_frame,
  316|  11.4k|          MEStats { mv: results.mv, normalized_sad: sad },
  317|  11.4k|        );
  318|  11.4k|      }
  319|       |    }
  320|       |  }
  321|  6.45k|}
_RINvNtCs3tIhnEwGhQF_5rav1e2me18get_best_predictorhEB4_:
  881|   138k|fn get_best_predictor<T: Pixel>(
  882|   138k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  883|   138k|  p_ref: &Plane<T>, predictors: &[MotionVector], bit_depth: usize,
  884|   138k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  885|   138k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  886|   138k|) -> MotionSearchResult {
