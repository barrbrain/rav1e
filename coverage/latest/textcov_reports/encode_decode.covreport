  969|  16.9M|$($s)* fn daala_fdst_iv_16_asym<T: TxOperations>(
  970|  16.9M|  s0: (T, T), s1h: T, s2: (T, T), s3h: T, s4: (T, T), s5h: T, s6: (T, T),
  971|  16.9M|  s7h: T, s8: (T, T), s9h: T, sa: (T, T), sbh: T, sc: (T, T), sdh: T,
  972|  16.9M|  se: (T, T), sfh: T, output: &mut [T],
