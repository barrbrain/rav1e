  218|   203M|  $($s)* fn half_kernel(
  219|   203M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   203M|  ) -> (T, T) {
  221|   203M|    let t = Self::ADD(p1, p0.0);
  222|   203M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   203M|    let out0 = b.add(c);
  224|   203M|    let shifted = Self::SHIFT(c);
  225|   203M|    let out1 = Self::SUB(a, shifted);
  226|   203M|    (out0, out1)
  227|   203M|  }
