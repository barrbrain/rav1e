   90|    125|      low_latency,
   91|    125|      error_resilient,
   92|    125|      bitrate,
   93|    125|      tile_cols_log2,
   94|    125|      tile_rows_log2,
   95|    125|      still_picture,
   96|    125|      grain_table,
   97|    125|    );
   98|    125|
   99|    125|    debug!(
  100|      0|      "Encoding {}x{} speed {} quantizer {} bit-depth {} bitrate {}",
  101|       |      w, h, speed, quantizer, bit_depth, bitrate
  102|       |    );
  103|       |    #[cfg(feature = "dump_ivf")]
  104|       |    let mut out = std::fs::File::create(&format!(
  105|       |      "out-{}x{}-s{}-q{}-r{}-{:?}.ivf",
  106|       |      w, h, speed, quantizer, bitrate, chroma_sampling
  107|       |    ))
  108|       |    .unwrap();
  109|       |    #[cfg(feature = "dump_ivf")]
  110|       |    ivf::write_ivf_header(&mut out, w, h, 30, 1);
  111|       |
  112|    125|    let mut rec_fifo = VecDeque::new();
  113|    125|    read_frame_batch(&mut ctx, &mut ra, limit);
  114|    125|
  115|    125|    for _ in 0..limit {
  116|    211|      let mut corrupted_count = 0;
  117|    211|      loop {
  118|    211|        let res = ctx.receive_packet();
  119|    211|        if let Ok(pkt) = res {
  120|    177|          debug!("Encoded packet {}", pkt.input_frameno);
  121|       |
  122|       |          #[cfg(feature = "dump_ivf")]
  123|       |          ivf::write_ivf_frame(&mut out, pkt.input_frameno, &pkt.data);
  124|       |
  125|    177|          if let Some(pkt_rec) = pkt.rec {
  126|    177|            rec_fifo.push_back((*pkt_rec).clone());
  127|    177|          }
  128|    177|          let packet = pkt.data;
  129|    177|          debug!("Decoding frame {}", pkt.input_frameno);
  130|    177|          match self.decode_packet(
  131|    177|            &packet,
  132|    177|            &mut rec_fifo,
  133|    177|            w,
  134|    177|            h,
  135|    177|            chroma_sampling,
  136|    177|            bit_depth,
  137|    177|            verify,
  138|    177|          ) {
  139|       |            DecodeResult::Done => {
  140|    177|              break;
  141|       |            }
  142|      0|            DecodeResult::NotDone => {}
  143|      0|            DecodeResult::Corrupted(corrupted) => {
  144|      0|              corrupted_count += corrupted;
  145|      0|            }
  146|       |          }
  147|       |        } else {
  148|     34|          break;
  149|       |        }
  150|       |      }
  151|    211|      assert_eq!(corrupted_count, 0);
  152|       |    }
  153|    125|  }
