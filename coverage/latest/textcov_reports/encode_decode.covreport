  562|  18.5M|
  563|  18.5M|  // Stage 2
  564|  18.5M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  565|  18.5M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  566|  18.5M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  567|  18.5M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  568|  18.5M|
  569|  18.5M|  // Stage 3
  570|  18.5M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  571|  18.5M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  572|  18.5M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  573|  18.5M|  let (r3, r4) =
  574|  18.5M|    RotateSubAvg::kernel(r3, r4, ((10703, 13), (8867, 14), (3135, 12)));
  575|  18.5M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  576|  18.5M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  577|  18.5M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  578|  18.5M|  let (r2, r5) =
  579|  18.5M|    RotateNegAvg::kernel(r2, r5, ((10703, 13), (8867, 14), (3135, 12)));
  580|  18.5M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
