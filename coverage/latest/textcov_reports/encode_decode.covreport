_RNvNtCs5T1csxkeGwJ_5rav1e7deblock16filter_narrow4_4B3_:
  211|  5.38M|fn filter_narrow4_4(
  212|  5.38M|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  213|  5.38M|) -> [i32; 4] {
  214|  5.38M|  let filter1 =
  215|  5.38M|    clamp(3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  216|       |  // be certain our optimization removing a clamp is sound
  217|       |  debug_assert!({
  218|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  219|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  220|      0|    filter1 == test
  221|       |  });
  222|  5.38M|  let filter2 =
  223|  5.38M|    clamp(3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  224|       |  // be certain our optimization removing a clamp is sound
  225|       |  debug_assert!({
  226|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  227|      0|    let test = clamp(base + 3, -128 << shift, (128 << shift) - 1) >> 3;
  228|      0|    filter2 == test
  229|       |  });
  230|  5.38M|  let filter3 = (filter1 + 1) >> 1;
  231|  5.38M|  [
  232|  5.38M|    clamp(p1 + filter3, 0, (256 << shift) - 1),
  233|  5.38M|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  234|  5.38M|    clamp(q0 - filter1, 0, (256 << shift) - 1),
  235|  5.38M|    clamp(q1 - filter3, 0, (256 << shift) - 1),
  236|  5.38M|  ]
  237|  5.38M|}
