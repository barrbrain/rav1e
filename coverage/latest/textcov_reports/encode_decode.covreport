  179|  4.25k|        let mut tested_frames_flags = 0;
  180|  27.2k|        for &ref_frame in inter_cfg.allowed_ref_frames() {
  181|  27.2k|          let frame_flag = 1 << fi.ref_frames[ref_frame.to_index()];
  182|  27.2k|          if tested_frames_flags & frame_flag == frame_flag {
  183|  16.9k|            continue;
  184|  10.2k|          }
  185|  10.2k|          tested_frames_flags |= frame_flag;
  186|  10.2k|
  187|  10.2k|          let tile_bo =
  188|  10.2k|            TileSuperBlockOffset(SuperBlockOffset { x: sbx, y: sby })
  189|  10.2k|              .block_offset(0, 0);
  190|  10.2k|
  191|  10.2k|          if new_subsampling {
  192|  6.83k|            refine_subsampled_sb_motion(
  193|  6.83k|              fi,
  194|  6.83k|              ts,
  195|  6.83k|              ref_frame,
  196|  6.83k|              mv_size_in_b_log2 + 1,
  197|  6.83k|              tile_bo,
  198|  6.83k|              ssdec,
  199|  6.83k|              lambda,
  200|  6.83k|            );
  201|  6.83k|          }
  202|       |
  203|  10.2k|          estimate_sb_motion(
  204|  10.2k|            fi,
  205|  10.2k|            ts,
  206|  10.2k|            ref_frame,
  207|  10.2k|            mv_size_in_b_log2,
  208|  10.2k|            tile_bo,
  209|  10.2k|            init,
  210|  10.2k|            ssdec,
  211|  10.2k|            lambda,
  212|  10.2k|          );
  213|       |        }
  214|       |      }
  215|       |    }
  216|       |  }
