  785|  18.3M|    if rd_cost < best_rd {
  786|  11.4M|      best_tx_size = tx_size;
  787|  11.4M|      best_tx_type = tx_type;
  788|  11.4M|      best_rd = rd_cost;
  789|  11.4M|    }
  790|       |
  791|      0|    debug_assert!(tx_size.width_log2() <= bsize.width_log2());
  792|      0|    debug_assert!(tx_size.height_log2() <= bsize.height_log2());
  793|       |    debug_assert!(
  794|      0|      tx_size.sqr() <= TxSize::TX_32X32 || tx_type == TxType::DCT_DCT
  795|       |    );
  796|       |
  797|  18.3M|    let next_tx_size = sub_tx_size_map[tx_size as usize];
  798|  18.3M|
  799|  18.3M|    if next_tx_size == tx_size {
  800|  10.2M|      break;
  801|  8.01M|    } else {
  802|  8.01M|      tx_size = next_tx_size;
  803|  8.01M|    };
  804|       |  }
  805|       |
  806|  10.7M|  (best_tx_size, best_tx_type)
  807|  14.6M|}
