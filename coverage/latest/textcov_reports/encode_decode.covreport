  218|   422k|  $($s)* fn half_kernel(
  219|   422k|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   422k|  ) -> (T, T) {
  221|   422k|    let t = Self::ADD(p1, p0.0);
  222|   422k|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   422k|    let out0 = b.add(c);
  224|   422k|    let shifted = Self::SHIFT(c);
  225|   422k|    let out1 = Self::SUB(a, shifted);
  226|   422k|    (out0, out1)
  227|   422k|  }
