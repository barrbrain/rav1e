  314|  5.75M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  5.75M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  5.75M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  5.75M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
