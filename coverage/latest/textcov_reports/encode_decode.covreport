   90|   535k|unsafe fn dequantize_avx2(
   91|   535k|  qindex: u8, coeffs_ptr: *const i16, _eob: usize, rcoeffs_ptr: *mut i16,
   92|   535k|  tx_size: TxSize, bit_depth: usize, dc_delta_q: i8, ac_delta_q: i8,
   93|   535k|) {
   94|   535k|  let log_tx_scale = _mm256_set1_epi32(get_log_tx_scale(tx_size) as i32);
   95|   535k|
   96|   535k|  let quants_ac =
   97|   535k|    _mm256_set1_epi32(ac_q(qindex, ac_delta_q, bit_depth) as i32);
   98|   535k|  // Use the dc quantize as first vector element for the first iteration
