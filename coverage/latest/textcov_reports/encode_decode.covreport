   85|    135|    8 => &ac_qlookup_Q3,
   86|      0|    10 => &ac_qlookup_10_Q3,
   87|      0|    12 => &ac_qlookup_12_Q3,
   88|      0|    _ => unimplemented!(),
   89|       |  };
   90|    135|  select_qi(quantizer, qlookup)
   91|    135|}
_RNvMNtCsgzd1EjkjF4V_5rav1e8quantizeNtB2_19QuantizationContext6update:
  195|   439k|  pub fn update(
  196|   439k|    &mut self, qindex: u8, tx_size: TxSize, is_intra: bool, bit_depth: usize,
  197|   439k|    dc_delta_q: i8, ac_delta_q: i8,
  198|   439k|  ) {
  199|   439k|    self.log_tx_scale = get_log_tx_scale(tx_size);
  200|   439k|
  201|   439k|    self.dc_quant = dc_q(qindex, dc_delta_q, bit_depth) as u32;
  202|   439k|    self.dc_mul_add = divu_gen(self.dc_quant);
  203|   439k|
  204|   439k|    self.ac_quant = ac_q(qindex, ac_delta_q, bit_depth) as u32;
  205|   439k|    self.ac_mul_add = divu_gen(self.ac_quant);
  206|   439k|
  207|   439k|    // All of these biases were derived by measuring the cost of coding
  208|   439k|    // a zero vs coding a one on any given coefficient position, or, in
  209|   439k|    // the case of the EOB bias, the cost of coding the block with
  210|   439k|    // the chosen EOB (rounding to one) vs rounding to zero and continuing
  211|   439k|    // to choose a new EOB. This was done over several clips, with the
  212|   439k|    // average of the bit costs taken over all blocks in the set, and a new
  213|   439k|    // bias derived via the method outlined in Jean-Marc Valin's
  214|   439k|    // Journal of Dubious Theoretical Results[1], aka:
  215|   439k|    //
  216|   439k|    // lambda = ln(2) / 6.0
  217|   439k|    // threshold = 0.5 + (lambda * avg_rate_diff) / 2.0
  218|   439k|    // bias = 1 - threshold
  219|   439k|    //
  220|   439k|    // lambda is a constant since our offsets are already adjusted for the
  221|   439k|    // quantizer.
  222|   439k|    //
  223|   439k|    // Biases were then updated, and cost collection was re-run, until
  224|   439k|    // the calculated biases started to converge after 2-4 iterations.
  225|   439k|    //
  226|   439k|    // In theory, the rounding biases for inter should be somewhat smaller
  227|   439k|    // than the biases for intra, but this turns out to only be the case
  228|   439k|    // for EOB optimization, or at least, is covered by EOB optimization.
  229|   439k|    // The RD-optimal rounding biases for the actual coefficients seem
  230|   439k|    // to be quite close (+/- 1/256), for both inter and intra,
  231|   439k|    // post-deadzoning.
  232|   439k|    //
  233|   439k|    // [1] https://jmvalin.ca/notes/theoretical_results.pdf
  234|   439k|    self.dc_offset = self.dc_quant * (if is_intra { 109 } else { 108 }) / 256;
  235|   439k|    self.ac_offset0 = self.ac_quant * (if is_intra { 98 } else { 97 }) / 256;
  236|   439k|    self.ac_offset1 = self.ac_quant * (if is_intra { 109 } else { 108 }) / 256;
  237|       |    self.ac_offset_eob =
  238|   439k|      self.ac_quant * (if is_intra { 88 } else { 44 }) / 256;
  239|   439k|  }
