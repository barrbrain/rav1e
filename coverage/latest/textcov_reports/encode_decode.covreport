  218|  44.3M|  $($s)* fn half_kernel(
  219|  44.3M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  44.3M|  ) -> (T, T) {
  221|  44.3M|    let t = Self::ADD(p1, p0.0);
  222|  44.3M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
