 1504|  42.9M|fn get_mv_rate(
 1505|  42.9M|  a: MotionVector, b: MotionVector, allow_high_precision_mv: bool,
 1506|  42.9M|) -> u32 {
 1507|  42.9M|  #[inline(always)]
 1508|  42.9M|  fn diff_to_rate(diff: i16, allow_high_precision_mv: bool) -> u32 {
 1509|  42.9M|    let d = if allow_high_precision_mv { diff } else { diff >> 1 };
 1510|  42.9M|    2 * ILog::ilog(d.abs()) as u32
 1511|  42.9M|  }
