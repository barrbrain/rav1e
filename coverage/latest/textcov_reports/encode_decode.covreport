 1572|  1.40k|fn sse_optimize<T: Pixel>(
 1573|  1.40k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  1.40k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  1.40k|) -> [u8; 4] {
 1576|  1.40k|  // i64 allows us to accumulate a total of ~ 35 bits worth of pixels
 1577|  1.40k|  assert!(
 1578|  1.40k|    ILog::ilog(input.planes[0].plane_cfg.width)
 1579|  1.40k|      + ILog::ilog(input.planes[0].plane_cfg.height)
 1580|  1.40k|      < 35
 1581|  1.40k|  );
 1582|  1.40k|  let mut level = [0; 4];
 1583|  1.40k|  let planes = if monochrome { 1 } else { MAX_PLANES };
 1584|       |
 1585|  3.75k|  for pli in 0..planes {
 1586|  3.75k|    let mut v_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1587|  3.75k|    let mut h_tally: [i64; MAX_LOOP_FILTER + 2] = [0; MAX_LOOP_FILTER + 2];
 1588|  3.75k|
 1589|  3.75k|    sse_plane(
 1590|  3.75k|      &rec.planes[pli],
 1591|  3.75k|      &input.planes[pli],
 1592|  3.75k|      &mut v_tally,
 1593|  3.75k|      &mut h_tally,
 1594|  3.75k|      pli,
 1595|  3.75k|      blocks,
 1596|  3.75k|      crop_w,
 1597|  3.75k|      crop_h,
 1598|  3.75k|      bd,
 1599|  3.75k|    );
 1600|       |
 1601|   240k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   236k|      v_tally[i] += v_tally[i - 1];
 1603|   236k|      h_tally[i] += h_tally[i - 1];
 1604|   236k|    }
 1605|       |
 1606|  3.75k|    match pli {
 1607|       |      0 => {
 1608|  1.40k|        let mut best_v = 999;
 1609|  1.40k|        let mut best_h = 999;
 1610|  91.2k|        for i in 0..=MAX_LOOP_FILTER {
 1611|  89.8k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  2.20k|            best_v = i;
 1613|  87.6k|          };
 1614|  89.8k|          if best_h == 999 || h_tally[best_h] > h_tally[i] {
 1615|  2.01k|            best_h = i;
 1616|  87.8k|          };
 1617|       |        }
 1618|  1.40k|        level[0] = best_v as u8;
 1619|  1.40k|        level[1] = best_h as u8;
 1620|       |      }
 1621|       |      1 | 2 => {
 1622|  2.34k|        let mut best = 999;
 1623|   152k|        for i in 0..=MAX_LOOP_FILTER {
 1624|   150k|          if best == 999
 1625|   147k|            || v_tally[best] + h_tally[best] > v_tally[i] + h_tally[i]
 1626|  2.79k|          {
 1627|  2.79k|            best = i;
 1628|   147k|          };
 1629|       |        }
 1630|  2.34k|        level[pli + 1] = best as u8;
 1631|       |      }
 1632|      0|      _ => unreachable!(),
 1633|       |    }
 1634|       |  }
 1635|  1.40k|  level
 1636|  1.40k|}
