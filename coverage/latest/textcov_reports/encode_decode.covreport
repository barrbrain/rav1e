  239|  73.1M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  240|  73.1M|    let t = Self::ADD(p0, p1);
  241|  73.1M|    let (a, b, c) = (p0.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  242|  73.1M|    let out0 = b.sub(c);
  243|  73.1M|    let out1 = c.sub(a);
  244|  73.1M|    (out0, out1)
  245|  73.1M|  }
