  661|  5.22M|          ),
  662|  5.22M|        ),
  663|  5.22M|      ),
  664|  5.22M|      shift,
  665|  5.22M|    ),
  666|  5.22M|    blimit_to_level((p0 - q0).abs() * 2 + (p1 - q1).abs() / 2, shift),
  667|  5.22M|  ) as usize
  668|  5.22M|}
