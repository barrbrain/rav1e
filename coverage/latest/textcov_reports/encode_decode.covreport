 1601|   415k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   408k|      v_tally[i] += v_tally[i - 1];
 1603|   408k|      h_tally[i] += h_tally[i - 1];
 1604|   408k|    }
 1605|       |
 1606|  6.48k|    match pli {
 1607|       |      0 => {
 1608|  2.53k|        let mut best_v = 999;
 1609|  2.53k|        let mut best_h = 999;
 1610|   164k|        for i in 0..=MAX_LOOP_FILTER {
 1611|   162k|          if best_v == 999 || v_tally[best_v] > v_tally[i] {
 1612|  4.38k|            best_v = i;
