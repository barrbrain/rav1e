  321|   345M|$($s)* fn butterfly_neg<T: TxOperations>(p0: T, p1: T) -> (T, (T, T)) {
  322|   345M|  let p1 = p0.sub(p1);
  323|   345M|  let p1h = p1.rshift1();
  324|   345M|  let p0h = p0.sub(p1h);
  325|   345M|  (p0h, (p1h, p1))
  326|   345M|}
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward18butterfly_sub_asymNtB2_5I32X8EBa_:
  338|   430M|$($s)* fn butterfly_sub_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  339|   430M|  let p1 = p1h.sub(p0.0);
  340|   430M|  let p0 = p0.1.add(p1);
  341|   430M|  (p0, p1)
  342|   430M|}
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward18butterfly_neg_asymNtB2_5I32X8EBa_:
  346|   216M|$($s)* fn butterfly_neg_asym<T: TxOperations>(p0h: T, p1: (T, T)) -> (T, T) {
  347|   216M|  let p0 = p0h.add(p1.0);
  348|   216M|  let p1 = p0.sub(p1.1);
  349|   216M|  (p0, p1)
  350|   216M|}
