 1701|  12.6M|  $($s)* fn reorder_4<T: TxOperations>(
 1702|  12.6M|    output: &mut [T], i: usize, tmp: [T; 64], j: usize
 1703|  12.6M|  ) {
 1704|  12.6M|    output[0 + i * 4] = tmp[0 + j];
 1705|  12.6M|    output[1 + i * 4] = tmp[32 + j];
 1706|  12.6M|    output[2 + i * 4] = tmp[16 + j];
 1707|  12.6M|    output[3 + i * 4] = tmp[48 + j];
 1708|  12.6M|  }
