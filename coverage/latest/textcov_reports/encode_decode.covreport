_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward12RotateAddAvgINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  76.1M|  $($s)* fn half_kernel(
  219|  76.1M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  76.1M|  ) -> (T, T) {
  221|  76.1M|    let t = Self::ADD(p1, p0.0);
  222|  76.1M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  76.1M|    let out0 = b.add(c);
  224|  76.1M|    let shifted = Self::SHIFT(c);
  225|  76.1M|    let out1 = Self::SUB(a, shifted);
  226|  76.1M|    (out0, out1)
  227|  76.1M|  }
