   90|   128M|unsafe fn dequantize_avx2(
   91|   128M|  qindex: u8, coeffs_ptr: *const i16, _eob: usize, rcoeffs_ptr: *mut i16,
   92|   128M|  tx_size: TxSize, bit_depth: usize, dc_delta_q: i8, ac_delta_q: i8,
   93|   128M|) {
   94|   128M|  let log_tx_scale = _mm256_set1_epi32(get_log_tx_scale(tx_size) as i32);
   95|   128M|
   96|   128M|  let quants_ac =
   97|   128M|    _mm256_set1_epi32(ac_q(qindex, ac_delta_q, bit_depth) as i32);
   98|   128M|  // Use the dc quantize as first vector element for the first iteration
   99|   128M|  let mut quants = _mm256_insert_epi32(
  100|   128M|    quants_ac,
  101|   128M|    dc_q(qindex, dc_delta_q, bit_depth) as i32,
  102|   128M|    0,
  103|   128M|  );
  104|   128M|
  105|   128M|  let area: usize = av1_get_coded_tx_size(tx_size).area();
  106|   128M|  // Step by 16 (256/16) coefficients for each iteration
  107|   128M|  let step: usize = 16;
  108|   128M|  assert!(area >= step);
  109|       |
  110|       |  // Increase the pointers as we iterate
  111|   128M|  let mut coeffs_ptr: *const i16 = coeffs_ptr;
  112|   128M|  let mut rcoeffs_ptr: *mut i16 = rcoeffs_ptr;
  113|   470M|  for _i in (0..area).step_by(step) {
  114|   470M|    let coeffs = _mm256_load_si256(coeffs_ptr as *const _);
  115|   470M|    let coeffs_abs = _mm256_abs_epi16(coeffs);
  116|   470M|
  117|   470M|    // TODO: Since log_tx_scale is at most 2 and we gain an extra bit by taking
  118|   470M|    // the abs value (unless the range is [-(2^15), 2^15 + 1]), it might be
  119|   470M|    // possible to perform a 16-bit multiply and get the highest bit by
  120|   470M|    // comparing coeffs to (1<<16) / quant. The would cost 1 compare, 1 blend,
  121|   470M|    // and 1 add, but would get rid of 1 pack, 2 unpacks, 1 shift, and 1
  122|   470M|    // multiply.
  123|   470M|
  124|   470M|    let rcoeffs = _mm256_sign_epi16(
  125|   470M|      _mm256_packs_epi32(
  126|   470M|        // (abs_coeff * quant) >> log_tx_scale
  127|   470M|        _mm256_srlv_epi32(
  128|   470M|          _mm256_madd_epi16(
  129|   470M|            quants,
  130|   470M|            // Convert the first half of each lane to 32-bits
  131|   470M|            _mm256_unpacklo_epi16(coeffs_abs, _mm256_setzero_si256()),
  132|   470M|          ),
  133|   470M|          log_tx_scale,
  134|   470M|        ),
  135|   470M|        // Second half
  136|   470M|        _mm256_srlv_epi32(
  137|   470M|          _mm256_madd_epi16(
  138|   470M|            quants_ac,
  139|   470M|            _mm256_unpackhi_epi16(coeffs_abs, _mm256_setzero_si256()),
  140|   470M|          ),
  141|   470M|          log_tx_scale,
  142|   470M|        ),
  143|   470M|      ),
  144|   470M|      coeffs,
  145|   470M|    );
  146|   470M|    _mm256_store_si256(rcoeffs_ptr as *mut _, rcoeffs);
  147|   470M|
  148|   470M|    // Only use a dc quantizer for the first iteration
  149|   470M|    quants = quants_ac;
  150|   470M|    coeffs_ptr = coeffs_ptr.add(step);
  151|   470M|    rcoeffs_ptr = rcoeffs_ptr.add(step);
  152|   470M|  }
  153|   128M|}

