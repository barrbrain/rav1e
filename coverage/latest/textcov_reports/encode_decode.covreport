  654|  10.6M|  daala_fdct_ii_4(r0, r1, r2, r3, &mut output[0..4]);
  655|  10.6M|  daala_fdst_iv_4(r7, r6, r5, r4, &mut output[4..8]);
  656|  10.6M|  output[4..8].reverse();
  657|  10.6M|}
