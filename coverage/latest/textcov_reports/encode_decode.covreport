  178|   156k|pub fn sse_wxh<T: Pixel, F: Fn(Area, BlockSize) -> DistortionScale>(
  179|   156k|  src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, w: usize, h: usize,
  180|   156k|  compute_bias: F, bit_depth: usize, cpu: CpuFeatureLevel,
  181|   156k|) -> Distortion {
  182|   156k|  // See get_weighted_sse in src/dist.rs.
  183|   156k|  // Provide a scale to get_weighted_sse for each square region of this size.
  184|   156k|  const CHUNK_SIZE: usize = IMPORTANCE_BLOCK_SIZE >> 1;
  185|   156k|
  186|   156k|  // To bias the distortion correctly, compute it in blocks up to the size
  187|   156k|  // importance block size in a non-subsampled plane.
  188|   156k|  let imp_block_w = CHUNK_SIZE << src1.plane_cfg.xdec;
  189|   156k|  let imp_block_h = CHUNK_SIZE << src1.plane_cfg.ydec;
  190|   156k|
  191|   156k|  let imp_bsize = BlockSize::from_width_and_height(imp_block_w, imp_block_h);
  192|   156k|
  193|   156k|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|   156k|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|   156k|
  196|   156k|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|   156k|  // passed directly. To do this, we would need different versions of the
  198|   156k|  // weighted sse function for decimated/subsampled data. Also requires
  199|   156k|  // eliminating use of unbiased sse.
  200|   156k|  // It should also be noted that the current copy code does not auto-vectorize.
  201|   156k|
  202|   156k|  // Copy biases into a buffer.
  203|   156k|  let mut buf_storage = Aligned::new(
  204|   156k|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|   156k|  );
  206|   156k|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|   156k|  let buf = init_slice_repeat_mut(
  208|   156k|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|   156k|    0,
  210|   156k|  );
  211|       |
  212|   350k|  for block_y in 0..n_imp_blocks_h {
  213|   996k|    for block_x in 0..n_imp_blocks_w {
  214|   996k|      let block = Area::StartingAt {
  215|   996k|        x: (block_x * CHUNK_SIZE) as isize,
  216|   996k|        y: (block_y * CHUNK_SIZE) as isize,
  217|   996k|      };
  218|   996k|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|   996k|    }
  220|       |  }
  221|       |
  222|   156k|  Distortion(get_weighted_sse(
  223|   156k|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|   156k|  ))
  225|   156k|}
