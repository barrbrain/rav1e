_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward9RotateNegINtB4_15RotateKernelNegNtB4_5I32X8E6kernelBc_:
  239|  50.3M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  240|  50.3M|    let t = Self::ADD(p0, p1);
  241|  50.3M|    let (a, b, c) = (p0.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  242|  50.3M|    let out0 = b.sub(c);
  243|  50.3M|    let out1 = c.sub(a);
  244|  50.3M|    (out0, out1)
  245|  50.3M|  }
_RNvYNtNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward14RotateAddShiftINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|   129M|  $($s)* fn half_kernel(
  219|   129M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   129M|  ) -> (T, T) {
  221|   129M|    let t = Self::ADD(p1, p0.0);
  222|   129M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   129M|    let out0 = b.add(c);
  224|   129M|    let shifted = Self::SHIFT(c);
  225|   129M|    let out1 = Self::SUB(a, shifted);
  226|   129M|    (out0, out1)
  227|   129M|  }
_RINvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward21daala_fdct_ii_16_asymNtB2_5I32X8EBa_:
  947|  11.1M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  11.1M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  11.1M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|  11.1M|  seh: T, sf: (T, T), output: &mut [T],
  951|  11.1M|) {
  952|  11.1M|  // +/- Butterflies with asymmetric input.
  953|  11.1M|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|  11.1M|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|  11.1M|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|  11.1M|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|  11.1M|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|  11.1M|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|  11.1M|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|  11.1M|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|  11.1M|
  962|  11.1M|  // Embedded 8-point orthonormal transforms.
  963|  11.1M|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|  11.1M|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
  965|  11.1M|  output[8..16].reverse();
  966|  11.1M|}
_RINvNvNtNtNtNtCs5T1csxkeGwJ_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|  18.5M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  18.5M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  18.5M|    ) {
 1598|  18.5M|      let j = i * 2;
 1599|  18.5M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  18.5M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  18.5M|      half[i] = ah;
 1602|  18.5M|      half[31 - i] = dh;
 1603|  18.5M|      asym[i] = b;
 1604|  18.5M|      asym[31 - i] = c;
 1605|  18.5M|    }
