 1304|   221k|fn subpel_diamond_search<T: Pixel>(
 1305|   221k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1306|   221k|  _p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1307|   221k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1308|   221k|  h: usize, use_satd: bool, current: &mut MotionSearchResult,
 1309|   221k|  ref_frame: RefType,
 1310|   221k|) {
 1311|   221k|  use crate::util::Aligned;
 1312|   221k|
 1313|   221k|  // Motion compensation assembly has special requirements for edges
 1314|   221k|  let mc_w = w.next_power_of_two();
 1315|   221k|  let mc_h = (h + 1) & !1;
 1316|   221k|
