_RINvNtCs5T1csxkeGwJ_5rav1e2me13compute_mv_rdhEB4_:
 1438|  16.2M|fn compute_mv_rd<T: Pixel>(
 1439|  16.2M|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  16.2M|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  16.2M|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  16.2M|) -> MVCandidateRD {
 1443|  16.2M|  let sad = if use_satd {
 1444|  3.79M|    get_satd(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1445|       |  } else {
 1446|  12.4M|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  16.2M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  16.2M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  16.2M|  let rate = rate1.min(rate2 + 1);
 1452|  16.2M|
 1453|  16.2M|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
 1454|  16.2M|}
