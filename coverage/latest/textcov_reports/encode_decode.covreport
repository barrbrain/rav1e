  800|       |
  801|       |    // Four possibilities: no filter, wide8, narrow2 and narrow4
  802|   740k|    let none: [_; 6] = [p2, p1, p0, q0, q1, q2];
  803|   740k|    let wide8: [_; 6] = filter_wide8_6(p3, p2, p1, p0, q0, q1, q2, q3);
