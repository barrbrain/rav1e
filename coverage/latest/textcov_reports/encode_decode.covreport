  717|  21.2M|$($s)* fn daala_fdct_ii_16<T: TxOperations>(
  718|  21.2M|  s0: T, s1: T, s2: T, s3: T, s4: T, s5: T, s6: T, s7: T, s8: T, s9: T, sa: T,
  719|  21.2M|  sb: T, sc: T, sd: T, se: T, sf: T, output: &mut [T],
  720|  21.2M|) {
  721|  21.2M|  // +/- Butterflies with asymmetric output.
  722|  21.2M|  let (s0h, sf) = butterfly_neg(s0, sf);
  723|  21.2M|  let (s1, seh) = butterfly_add(s1, se);
  724|  21.2M|  let (s2h, sd) = butterfly_neg(s2, sd);
  725|  21.2M|  let (s3, sch) = butterfly_add(s3, sc);
  726|  21.2M|  let (s4h, sb) = butterfly_neg(s4, sb);
  727|  21.2M|  let (s5, sah) = butterfly_add(s5, sa);
  728|  21.2M|  let (s6h, s9) = butterfly_neg(s6, s9);
  729|  21.2M|  let (s7, s8h) = butterfly_add(s7, s8);
  730|  21.2M|
  731|  21.2M|  // Embedded 8-point transforms with asymmetric input.
  732|  21.2M|  daala_fdct_ii_8_asym(s0h, s1, s2h, s3, s4h, s5, s6h, s7, &mut output[0..8]);
  733|  21.2M|  daala_fdst_iv_8_asym(sf, seh, sd, sch, sb, sah, s9, s8h, &mut output[8..16]);
  734|  21.2M|  output[8..16].reverse();
  735|  21.2M|}
