  647|       |    };
  648|    705|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
  649|     40|      (84u8, blog64(30) - q57(QSCALE))
  650|    665|    } else if ibpp < 92 {
  651|    541|      (120u8, blog64(68) - q57(QSCALE))
  652|       |    } else {
  653|    124|      (68u8, blog64(4) - q57(QSCALE))
  654|       |    };
  655|    705|    let (b1_exp, b1_log_scale) = if ibpp < 2 {
  656|     40|      (87u8, blog64(27) - q57(QSCALE))
  657|    665|    } else if ibpp < 126 {
  658|    556|      (139u8, blog64(84) - q57(QSCALE))
  659|       |    } else {
  660|    109|      (61u8, blog64(1) - q57(QSCALE))
  661|       |    };
