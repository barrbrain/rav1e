 1586|   791k|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|   791k|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|   791k|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|   791k|  let mut half: [T; 32] = [T::zero(); 32];
 1591|   791k|  // +/- Butterflies with asymmetric output.
