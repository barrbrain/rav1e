 1572|  2.71k|fn sse_optimize<T: Pixel>(
 1573|  2.71k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  2.71k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  2.71k|) -> [u8; 4] {
