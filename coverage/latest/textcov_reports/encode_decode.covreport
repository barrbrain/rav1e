_RINvNtCsgGiEFdpFC8m_5rav1e2me13compute_mv_rdhEB4_:
 1438|  22.1M|fn compute_mv_rd<T: Pixel>(
 1439|  22.1M|  fi: &FrameInvariants<T>, pmv: [MotionVector; 2], lambda: u32,
 1440|  22.1M|  use_satd: bool, bit_depth: usize, w: usize, h: usize, cand_mv: MotionVector,
 1441|  22.1M|  plane_org: &PlaneRegion<'_, T>, plane_ref: &PlaneRegion<'_, T>,
 1442|  22.1M|) -> MVCandidateRD {
 1443|  22.1M|  let sad = if use_satd {
 1444|  5.20M|    get_satd(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1445|       |  } else {
 1446|  16.9M|    get_sad(plane_org, plane_ref, w, h, bit_depth, fi.cpu_feature_level)
 1447|       |  };
 1448|       |
 1449|  22.1M|  let rate1 = get_mv_rate(cand_mv, pmv[0], fi.allow_high_precision_mv);
 1450|  22.1M|  let rate2 = get_mv_rate(cand_mv, pmv[1], fi.allow_high_precision_mv);
 1451|  22.1M|  let rate = rate1.min(rate2 + 1);
 1452|  22.1M|
 1453|  22.1M|  MVCandidateRD { cost: 256 * sad as u64 + rate as u64 * lambda as u64, sad }
 1454|  22.1M|}
_RINvNtCsgGiEFdpFC8m_5rav1e2me17get_fullpel_mv_rdhEB4_:
 1379|  10.9M|fn get_fullpel_mv_rd<T: Pixel>(
 1380|  10.9M|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1381|  10.9M|  p_ref: &Plane<T>, bit_depth: usize, pmv: [MotionVector; 2], lambda: u32,
 1382|  10.9M|  use_satd: bool, mvx_min: isize, mvx_max: isize, mvy_min: isize,
 1383|  10.9M|  mvy_max: isize, w: usize, h: usize, cand_mv: MotionVector,
 1384|  10.9M|) -> MVCandidateRD {
 1385|  10.9M|  if (cand_mv.col as isize) < mvx_min
 1386|  10.8M|    || (cand_mv.col as isize) > mvx_max
 1387|  10.8M|    || (cand_mv.row as isize) < mvy_min
 1388|  10.7M|    || (cand_mv.row as isize) > mvy_max
 1389|       |  {
 1390|   209k|    return MVCandidateRD::empty();
 1391|  10.7M|  }
 1392|  10.7M|
 1393|  10.7M|  // Convert the motion vector into an full pixel offset.
 1394|  10.7M|  let plane_ref = p_ref.region(Area::StartingAt {
 1395|  10.7M|    x: po.x + (cand_mv.col / 8) as isize,
 1396|  10.7M|    y: po.y + (cand_mv.row / 8) as isize,
 1397|  10.7M|  });
 1398|  10.7M|  compute_mv_rd(
 1399|  10.7M|    fi, pmv, lambda, use_satd, bit_depth, w, h, cand_mv, org_region,
 1400|  10.7M|    &plane_ref,
 1401|  10.7M|  )
 1402|  10.9M|}
