 1404|   718k|fn get_subpel_mv_rd<T: Pixel>(
 1405|   718k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1406|   718k|  bit_depth: usize, pmv: [MotionVector; 2], lambda: u32, use_satd: bool,
 1407|   718k|  mvx_min: isize, mvx_max: isize, mvy_min: isize, mvy_max: isize, w: usize,
 1408|   718k|  h: usize, cand_mv: MotionVector, tmp_region: &mut PlaneRegionMut<T>,
 1409|   718k|  ref_frame: RefType,
 1410|   718k|) -> MVCandidateRD {
 1411|   718k|  if (cand_mv.col as isize) < mvx_min
 1412|   716k|    || (cand_mv.col as isize) > mvx_max
 1413|   715k|    || (cand_mv.row as isize) < mvy_min
 1414|   714k|    || (cand_mv.row as isize) > mvy_max
 1415|       |  {
 1416|  4.54k|    return MVCandidateRD::empty();
 1417|   713k|  }
 1418|   713k|
 1419|   713k|  let tmp_width = tmp_region.rect().width;
 1420|   713k|  let tmp_height = tmp_region.rect().height;
 1421|   713k|  let tile_rect =
 1422|   713k|    TileRect { x: 0, y: 0, width: tmp_width, height: tmp_height };
 1423|   713k|
 1424|   713k|  PredictionMode::NEWMV.predict_inter_single(
 1425|   713k|    fi, tile_rect, 0, po, tmp_region,
 1426|   713k|    // motion comp's w & h on edges can be different than distortion's
 1427|   713k|    tmp_width, tmp_height, ref_frame, cand_mv,
 1428|   713k|  );
 1429|   713k|  let plane_ref = tmp_region.as_const();
 1430|   713k|  compute_mv_rd(
 1431|   713k|    fi, pmv, lambda, use_satd, bit_depth, w, h, cand_mv, org_region,
 1432|   713k|    &plane_ref,
 1433|   713k|  )
