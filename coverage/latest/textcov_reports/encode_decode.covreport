  218|   357M|  $($s)* fn half_kernel(
  219|   357M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|   357M|  ) -> (T, T) {
  221|   357M|    let t = Self::ADD(p1, p0.0);
  222|   357M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|   357M|    let out0 = b.add(c);
  224|   357M|    let shifted = Self::SHIFT(c);
  225|   357M|    let out1 = Self::SUB(a, shifted);
  226|   357M|    (out0, out1)
  227|   357M|  }
