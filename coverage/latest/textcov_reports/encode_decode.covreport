  211|  4.00M|fn filter_narrow4_4(
  212|  4.00M|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  213|  4.00M|) -> [i32; 4] {
  214|  4.00M|  let filter1 =
  215|  4.00M|    clamp(3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  216|       |  // be certain our optimization removing a clamp is sound
  217|       |  debug_assert!({
  218|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  219|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  220|      0|    filter1 == test
