  614|  5.32M|$($s)* fn daala_fdst_iv_4<T: TxOperations>(
  615|  5.32M|  q0: T, q1: T, q2: T, q3: T, output: &mut [T],
  616|  5.32M|) {
  617|  5.32M|  // Stage 0
  618|  5.32M|  // 13623/16384 = (Sin[7*Pi/16] + Cos[7*Pi/16])/Sqrt[2] = 0.831469612302545
  619|  5.32M|  //   4551/4096 = (Sin[7*Pi/16] - Cos[7*Pi/16])*Sqrt[2] = 1.111140466039204
  620|  5.32M|  //  9041/32768 = Cos[7*Pi/16]*Sqrt[2]                  = 0.275899379282943
  621|  5.32M|  let (q0, q3) =
  622|  5.32M|    RotateAddShift::kernel(q0, q3, ((13623, 14), (4551, 12), (565, 11)));
  623|  5.32M|  // 16069/16384 = (Sin[5*Pi/16] + Cos[5*Pi/16])/Sqrt[2] = 0.9807852804032304
  624|  5.32M|  // 12785/32768 = (Sin[5*Pi/16] - Cos[5*Pi/16])*Sqrt[2] = 0.3901806440322566
  625|  5.32M|  //   1609/2048 = Cos[5*Pi/16]*Sqrt[2]                  = 0.7856949583871021
  626|  5.32M|  let (q2, q1) =
  627|  5.32M|    RotateSubShift::kernel(q2, q1, ((16069, 14), (12785, 15), (1609, 11)));
  628|  5.32M|
  629|  5.32M|  // Stage 1
  630|  5.32M|  let (q2, q3) = butterfly_sub_asym((q2.rshift1(), q2), q3);
  631|  5.32M|  let (q0, q1) = butterfly_sub_asym((q0.rshift1(), q0), q1);
  632|  5.32M|
  633|  5.32M|  // Stage 2
  634|  5.32M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  635|  5.32M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  636|  5.32M|  let (q2, q1) = RotatePi4AddAvg::kernel(q2, q1, ((11585, 13), (11585, 13)));
  637|  5.32M|
  638|  5.32M|  store_coeffs!(output, q0, q1, q2, q3);
  639|  5.32M|}
_RNvYNtNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward12RotateAddAvgINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  20.0M|  $($s)* fn half_kernel(
  219|  20.0M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  20.0M|  ) -> (T, T) {
  221|  20.0M|    let t = Self::ADD(p1, p0.0);
  222|  20.0M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  20.0M|    let out0 = b.add(c);
  224|  20.0M|    let shifted = Self::SHIFT(c);
  225|  20.0M|    let out1 = Self::SUB(a, shifted);
  226|  20.0M|    (out0, out1)
  227|  20.0M|  }
_RINvNtNtNtNtCsgLNdNkfkEgK_5rav1e3asm3x869transform7forward12daala_fdct64NtB2_5I32X8EBa_:
 1586|   380k|$($s)* fn daala_fdct64<T: TxOperations>(coeffs: &mut [T]) {
 1587|   380k|  assert!(coeffs.len() >= 64);
 1588|       |  // Use arrays to avoid ridiculous variable names
 1589|   380k|  let mut asym: [(T, T); 32] = [(T::zero(), T::zero()); 32];
 1590|   380k|  let mut half: [T; 32] = [T::zero(); 32];
 1591|   380k|  // +/- Butterflies with asymmetric output.
 1592|   380k|  {
 1593|   380k|    #[$m]
 1594|   380k|    #[inline]
 1595|   380k|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|   380k|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|   380k|    ) {
 1598|   380k|      let j = i * 2;
 1599|   380k|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|   380k|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|   380k|      half[i] = ah;
 1602|   380k|      half[31 - i] = dh;
 1603|   380k|      asym[i] = b;
 1604|   380k|      asym[31 - i] = c;
 1605|   380k|    }
 1606|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 0);
 1607|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 1);
 1608|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 2);
 1609|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 3);
 1610|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 4);
 1611|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 5);
 1612|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 6);
 1613|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 7);
 1614|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 8);
 1615|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 9);
 1616|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 10);
 1617|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 11);
 1618|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 12);
 1619|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 13);
 1620|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 14);
 1621|   380k|    butterfly_pair(&mut half, &mut asym, coeffs, 15);
 1622|   380k|  }
 1623|   380k|
 1624|   380k|  let mut temp_out: [T; 64] = [T::zero(); 64];
 1625|   380k|  // Embedded 2-point transforms with asymmetric input.
