   90|   150M|unsafe fn dequantize_avx2(
   91|   150M|  qindex: u8, coeffs_ptr: *const i16, _eob: usize, rcoeffs_ptr: *mut i16,
   92|   150M|  tx_size: TxSize, bit_depth: usize, dc_delta_q: i8, ac_delta_q: i8,
   93|   150M|) {
   94|   150M|  let log_tx_scale = _mm256_set1_epi32(get_log_tx_scale(tx_size) as i32);
   95|   150M|
   96|   150M|  let quants_ac =
   97|   150M|    _mm256_set1_epi32(ac_q(qindex, ac_delta_q, bit_depth) as i32);
   98|   150M|  // Use the dc quantize as first vector element for the first iteration
   99|   150M|  let mut quants = _mm256_insert_epi32(
  100|   150M|    quants_ac,
  101|   150M|    dc_q(qindex, dc_delta_q, bit_depth) as i32,
  102|   150M|    0,
  103|   150M|  );
  104|   150M|
  105|   150M|  let area: usize = av1_get_coded_tx_size(tx_size).area();
  106|   150M|  // Step by 16 (256/16) coefficients for each iteration
  107|   150M|  let step: usize = 16;
  108|   150M|  assert!(area >= step);
  109|       |
  110|       |  // Increase the pointers as we iterate
  111|   150M|  let mut coeffs_ptr: *const i16 = coeffs_ptr;
  112|   150M|  let mut rcoeffs_ptr: *mut i16 = rcoeffs_ptr;
  113|   550M|  for _i in (0..area).step_by(step) {
  114|   550M|    let coeffs = _mm256_load_si256(coeffs_ptr as *const _);
  115|   550M|    let coeffs_abs = _mm256_abs_epi16(coeffs);
  116|   550M|
  117|   550M|    // TODO: Since log_tx_scale is at most 2 and we gain an extra bit by taking
  118|   550M|    // the abs value (unless the range is [-(2^15), 2^15 + 1]), it might be
  119|   550M|    // possible to perform a 16-bit multiply and get the highest bit by
  120|   550M|    // comparing coeffs to (1<<16) / quant. The would cost 1 compare, 1 blend,
  121|   550M|    // and 1 add, but would get rid of 1 pack, 2 unpacks, 1 shift, and 1
  122|   550M|    // multiply.
  123|   550M|
  124|   550M|    let rcoeffs = _mm256_sign_epi16(
  125|   550M|      _mm256_packs_epi32(
  126|   550M|        // (abs_coeff * quant) >> log_tx_scale
  127|   550M|        _mm256_srlv_epi32(
  128|   550M|          _mm256_madd_epi16(
  129|   550M|            quants,
  130|   550M|            // Convert the first half of each lane to 32-bits
  131|   550M|            _mm256_unpacklo_epi16(coeffs_abs, _mm256_setzero_si256()),
  132|   550M|          ),
  133|   550M|          log_tx_scale,
  134|   550M|        ),
  135|   550M|        // Second half
  136|   550M|        _mm256_srlv_epi32(
  137|   550M|          _mm256_madd_epi16(
  138|   550M|            quants_ac,
  139|   550M|            _mm256_unpackhi_epi16(coeffs_abs, _mm256_setzero_si256()),
  140|   550M|          ),
  141|   550M|          log_tx_scale,
  142|   550M|        ),
  143|   550M|      ),
  144|   550M|      coeffs,
  145|   550M|    );
  146|   550M|    _mm256_store_si256(rcoeffs_ptr as *mut _, rcoeffs);
  147|   550M|
  148|   550M|    // Only use a dc quantizer for the first iteration
  149|   550M|    quants = quants_ac;
  150|   550M|    coeffs_ptr = coeffs_ptr.add(step);
  151|   550M|    rcoeffs_ptr = rcoeffs_ptr.add(step);
  152|   550M|  }
  153|   150M|}

