   51|    196|    MINQ as u8
   52|  22.2k|  } else if quantizer >= qlookup[MAXQ] as i64 {
   53|    914|    MAXQ as u8
   54|       |  } else {
   55|  21.3k|    match qlookup.binary_search(&(quantizer as i16)) {
