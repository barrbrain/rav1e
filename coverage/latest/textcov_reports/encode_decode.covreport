  532|  25.5M|$($s)* fn daala_fdst_iv_8<T: TxOperations>(
  533|  25.5M|  r0: T, r1: T, r2: T, r3: T, r4: T, r5: T, r6: T, r7: T, output: &mut [T],
  534|  25.5M|) {
  535|  25.5M|  // Stage 0
  536|  25.5M|  // 17911/16384 = Sin[15*Pi/32] + Cos[15*Pi/32] = 1.0932018670017576
  537|  25.5M|  // 14699/16384 = Sin[15*Pi/32] - Cos[15*Pi/32] = 0.8971675863426363
  538|  25.5M|  //    803/8192 = Cos[15*Pi/32]                 = 0.0980171403295606
  539|  25.5M|  let (r0, r7) =
  540|  25.5M|    RotateAdd::kernel(r0, r7, ((17911, 14), (14699, 14), (803, 13)));
  541|  25.5M|  // 20435/16384 = Sin[13*Pi/32] + Cos[13*Pi/32] = 1.24722501298667123
  542|  25.5M|  // 21845/32768 = Sin[13*Pi/32] - Cos[13*Pi/32] = 0.66665565847774650
  543|  25.5M|  //   1189/4096 = Cos[13*Pi/32]                 = 0.29028467725446233
  544|  25.5M|  let (r6, r1) =
  545|  25.5M|    RotateSub::kernel(r6, r1, ((20435, 14), (21845, 15), (1189, 12)));
  546|  25.5M|  // 22173/16384 = Sin[11*Pi/32] + Cos[11*Pi/32] = 1.3533180011743526
  547|  25.5M|  //   3363/8192 = Sin[11*Pi/32] - Cos[11*Pi/32] = 0.4105245275223574
  548|  25.5M|  // 15447/32768 = Cos[11*Pi/32]                 = 0.47139673682599764
  549|  25.5M|  let (r2, r5) =
  550|  25.5M|    RotateAdd::kernel(r2, r5, ((22173, 14), (3363, 13), (15447, 15)));
  551|  25.5M|  // 23059/16384 = Sin[9*Pi/32] + Cos[9*Pi/32] = 1.4074037375263826
  552|  25.5M|  //  2271/16384 = Sin[9*Pi/32] - Cos[9*Pi/32] = 0.1386171691990915
  553|  25.5M|  //   5197/8192 = Cos[9*Pi/32]                = 0.6343932841636455
  554|  25.5M|  let (r4, r3) =
  555|  25.5M|    RotateSub::kernel(r4, r3, ((23059, 14), (2271, 14), (5197, 13)));
  556|  25.5M|
  557|  25.5M|  // Stage 1
  558|  25.5M|  let (r0, r3h) = butterfly_add(r0, r3);
  559|  25.5M|  let (r2, r1h) = butterfly_sub(r2, r1);
  560|  25.5M|  let (r5, r6h) = butterfly_add(r5, r6);
  561|  25.5M|  let (r7, r4h) = butterfly_sub(r7, r4);
  562|  25.5M|
  563|  25.5M|  // Stage 2
  564|  25.5M|  let (r7, r6) = butterfly_add_asym(r7, r6h);
  565|  25.5M|  let (r5, r3) = butterfly_add_asym(r5, r3h);
  566|  25.5M|  let (r2, r4) = butterfly_add_asym(r2, r4h);
  567|  25.5M|  let (r0, r1) = butterfly_sub_asym(r0, r1h);
  568|  25.5M|
  569|  25.5M|  // Stage 3
  570|  25.5M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  571|  25.5M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  572|  25.5M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  573|  25.5M|  let (r3, r4) =
  574|  25.5M|    RotateSubAvg::kernel(r3, r4, ((10703, 13), (8867, 14), (3135, 12)));
  575|  25.5M|  // 10703/8192 = Sin[3*Pi/8] + Cos[3*Pi/8] = 1.3065629648763766
  576|  25.5M|  // 8867/16384 = Sin[3*Pi/8] - Cos[3*Pi/8] = 0.5411961001461969
  577|  25.5M|  //  3135/4096 = 2*Cos[3*Pi/8]             = 0.7653668647301796
  578|  25.5M|  let (r2, r5) =
  579|  25.5M|    RotateNegAvg::kernel(r2, r5, ((10703, 13), (8867, 14), (3135, 12)));
  580|  25.5M|  // 11585/8192 = Sin[Pi/4] + Cos[Pi/4] = 1.4142135623730951
  581|  25.5M|  // 11585/8192 = 2*Cos[Pi/4]           = 1.4142135623730951
  582|  25.5M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((11585, 13), (11585, 13)));
  583|  25.5M|
  584|  25.5M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
  585|  25.5M|}
