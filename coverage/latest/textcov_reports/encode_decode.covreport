 1098|  7.86k|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|  7.86k|
 1100|  7.86k|      let rd = get_fullpel_mv_rd(
 1101|  7.86k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|  7.86k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|  7.86k|      );
 1104|  7.86k|
 1105|  7.86k|      if rd.cost < best_cand.rd.cost {
 1106|  4.72k|        best_cand_idx = i;
 1107|  4.72k|        best_cand.mv = cand_mv;
 1108|  4.72k|        best_cand.rd = rd;
 1109|  4.72k|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  7.43k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  66.9k|  for &offset in &SQUARE_REFINE_PATTERN {
