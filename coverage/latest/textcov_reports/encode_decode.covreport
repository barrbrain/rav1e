  668|  78.4M|    let (left, not_left) = edge_buf.data.split_at_mut(2 * MAX_TX_SIZE);
  669|  78.4M|    let (top_left, above) = not_left.split_at_mut(1);
  670|  78.4M|
  671|  78.4M|    let x = po.x as usize;
