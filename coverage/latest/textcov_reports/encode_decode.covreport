  347|     80|              $trp_type::new(plane, units_x0, units_y0, units_cols0, units_rows0)
  348|     80|            },
  349|     80|            {
  350|     80|              let plane = planes_iter.next().unwrap();
  351|     80|              $trp_type::new(plane, units_x1, units_y1, units_cols1, units_rows1)
  352|     80|            },
  353|     80|            {
