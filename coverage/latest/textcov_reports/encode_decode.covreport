 1465|    958|  pub fn lrf_filter_frame<T: Pixel>(
 1466|    958|    &mut self, out: &mut Frame<T>, pre_cdef: &Frame<T>,
 1467|    958|    fi: &FrameInvariants<T>,
 1468|    958|  ) {
 1469|    958|    let cdeffed = out.clone();
 1470|    958|    let planes =
 1471|    958|      if fi.sequence.chroma_sampling == Cs400 { 1 } else { MAX_PLANES };
 1472|       |
 1473|       |    // unlike the other loop filters that operate over the padded
 1474|       |    // frame dimensions, restoration filtering and source pixel
 1475|       |    // accesses are clipped to the original frame dimensions
 1476|       |    // that's why we use fi.width and fi.height instead of PlaneConfig fields
 1477|       |
 1478|       |    // number of stripes (counted according to colocated Y luma position)
 1479|    958|    let stripe_n = (fi.height + 7) / 64 + 1;
 1480|    958|
 1481|    958|    // Buffers for the stripe filter.
 1482|    958|    let mut stripe_filter_buffer =
 1483|    958|      IntegralImageBuffer::zeroed(STRIPE_IMAGE_SIZE);
 1484|       |
 1485|  2.50k|    for pli in 0..planes {
 1486|  2.50k|      let rp = &self.planes[pli];
 1487|  2.50k|      let xdec = out.planes[pli].cfg.xdec;
 1488|  2.50k|      let ydec = out.planes[pli].cfg.ydec;
 1489|  2.50k|      let crop_w = (fi.width + (1 << xdec >> 1)) >> xdec;
 1490|  2.50k|      let crop_h = (fi.height + (1 << ydec >> 1)) >> ydec;
 1491|       |
 1492|  7.27k|      for si in 0..stripe_n {
 1493|  7.27k|        let (stripe_start_y, stripe_size) = if si == 0 {
 1494|  2.50k|          (0, (64 - 8) >> ydec)
 1495|       |        } else {
 1496|  4.76k|          let start = (si * 64 - 8) >> ydec;
 1497|  4.76k|          (
 1498|  4.76k|            start as isize,
 1499|  4.76k|            // one past, unlike spec
 1500|  4.76k|            (64 >> ydec).min(crop_h - start),
 1501|  4.76k|          )
 1502|       |        };
 1503|       |
 1504|       |        // horizontally, go rdu-by-rdu
 1505|  14.4k|        for rux in 0..rp.cfg.cols {
 1506|       |          // stripe x pixel locations must be clipped to frame, last may need to stretch
 1507|  14.4k|          let x = rux * rp.cfg.unit_size;
 1508|  14.4k|          let size =
 1509|  14.4k|            if rux == rp.cfg.cols - 1 { crop_w - x } else { rp.cfg.unit_size };
 1510|  14.4k|          let ru = rp.restoration_unit_by_stripe(si, rux);
