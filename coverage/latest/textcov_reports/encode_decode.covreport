 1277|  17.4k|  for i in 1..=iterations {
 1278|   297k|    for &offset in &UMH_PATTERN {
 1279|   279k|      let cand_mv = center + offset * i;
 1280|   279k|      let rd = get_fullpel_mv_rd(
 1281|   279k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|   279k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|   279k|      );
 1284|   279k|
 1285|   279k|      if rd.cost < current.rd.cost {
 1286|  5.76k|        current.mv = cand_mv;
 1287|  5.76k|        current.rd = rd;
 1288|   273k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|  2.91k|  hexagon_search(
 1294|  2.91k|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|  2.91k|    mvx_max, mvy_min, mvy_max, w, h,
 1296|  2.91k|  );
 1297|  2.91k|}
