 1598|  12.6k|      bd,
 1599|  12.6k|    );
 1600|       |
 1601|   810k|    for i in 1..=MAX_LOOP_FILTER {
 1602|   797k|      v_tally[i] += v_tally[i - 1];
 1603|   797k|      h_tally[i] += h_tally[i - 1];
