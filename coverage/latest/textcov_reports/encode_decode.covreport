  192|  15.7M|
  193|  15.7M|  let n_imp_blocks_w = (w + CHUNK_SIZE - 1) / CHUNK_SIZE;
  194|  15.7M|  let n_imp_blocks_h = (h + CHUNK_SIZE - 1) / CHUNK_SIZE;
  195|  15.7M|
  196|  15.7M|  // TODO: Copying biases into a buffer is slow. It would be best if biases were
  197|  15.7M|  // passed directly. To do this, we would need different versions of the
  198|  15.7M|  // weighted sse function for decimated/subsampled data. Also requires
  199|  15.7M|  // eliminating use of unbiased sse.
  200|  15.7M|  // It should also be noted that the current copy code does not auto-vectorize.
  201|  15.7M|
  202|  15.7M|  // Copy biases into a buffer.
  203|  15.7M|  let mut buf_storage = Aligned::new(
  204|  15.7M|    [MaybeUninit::<u32>::uninit(); 128 / CHUNK_SIZE * 128 / CHUNK_SIZE],
  205|  15.7M|  );
  206|  15.7M|  let buf_stride = n_imp_blocks_w.next_power_of_two();
  207|  15.7M|  let buf = init_slice_repeat_mut(
  208|  15.7M|    &mut buf_storage.data[..buf_stride * n_imp_blocks_h],
  209|  15.7M|    0,
  210|  15.7M|  );
  211|       |
  212|  34.6M|  for block_y in 0..n_imp_blocks_h {
  213|   126M|    for block_x in 0..n_imp_blocks_w {
  214|   126M|      let block = Area::StartingAt {
  215|   126M|        x: (block_x * CHUNK_SIZE) as isize,
  216|   126M|        y: (block_y * CHUNK_SIZE) as isize,
  217|   126M|      };
  218|   126M|      buf[block_y * buf_stride + block_x] = compute_bias(block, imp_bsize).0;
  219|   126M|    }
  220|       |  }
  221|       |
  222|  15.7M|  Distortion(get_weighted_sse(
  223|  15.7M|    src1, src2, buf, buf_stride, w, h, bit_depth, cpu,
  224|  15.7M|  ))
  225|  15.7M|}
