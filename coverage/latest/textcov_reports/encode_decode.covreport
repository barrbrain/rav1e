 1572|  2.53k|fn sse_optimize<T: Pixel>(
 1573|  2.53k|  rec: &Tile<T>, input: &Tile<T>, blocks: &TileBlocks, crop_w: usize,
 1574|  2.53k|  crop_h: usize, bd: usize, monochrome: bool,
 1575|  2.53k|) -> [u8; 4] {
