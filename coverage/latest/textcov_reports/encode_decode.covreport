  230|  2.83M|  let filter3 = (filter1 + 1) >> 1;
  231|  2.83M|  [
  232|  2.83M|    clamp(p1 + filter3, 0, (256 << shift) - 1),
  233|  2.83M|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  234|  2.83M|    clamp(q0 - filter1, 0, (256 << shift) - 1),
