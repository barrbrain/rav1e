  218|  88.8M|  $($s)* fn half_kernel(
  219|  88.8M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  88.8M|  ) -> (T, T) {
  221|  88.8M|    let t = Self::ADD(p1, p0.0);
  222|  88.8M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  88.8M|    let out0 = b.add(c);
  224|  88.8M|    let shifted = Self::SHIFT(c);
  225|  88.8M|    let out1 = Self::SUB(a, shifted);
  226|  88.8M|    (out0, out1)
  227|  88.8M|  }
