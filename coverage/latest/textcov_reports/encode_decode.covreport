  579|   447k|    }
  580|       |  }
  581|       |  // Calculate all other rows
  582|  6.19k|  let mut integral_slice = &mut integral_image[..];
  583|  6.19k|  let mut sq_integral_slice = &mut sq_integral_image[..];
  584|   378k|  for row in rows_iter {
  585|   372k|    let mut sum: u32 = 0;
  586|   372k|    let mut sq_sum: u32 = 0;
  587|   372k|
  588|   372k|    // Split the data between the previous row and future rows.
