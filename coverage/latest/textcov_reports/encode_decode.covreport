  231|  18.3k|  for y in (0..sb_h).step_by(mv_size) {
  232|  42.1k|    for x in (0..sb_w).step_by(mv_size) {
  233|  42.1k|      let corner: MVSamplingMode = if init {
  234|  3.22k|        MVSamplingMode::INIT
  235|       |      } else {
  236|       |        // Processing the block a size up produces data that can be used by
  237|       |        // the right and bottom corners.
  238|  38.8k|        MVSamplingMode::CORNER {
  239|  38.8k|          right: x as usize & mv_size == mv_size,
  240|  38.8k|          bottom: y as usize & mv_size == mv_size,
  241|  38.8k|        }
  242|       |      };
  243|       |
  244|  42.1k|      let sub_bo = tile_bo
  245|  42.1k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  246|  42.1k|
  247|  42.1k|      // Clamp to frame edge, rounding up in the case of subsampling.
  248|  42.1k|      // The rounding makes some assumptions about how subsampling is done.
  249|  42.1k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  250|  42.1k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  251|       |
  252|       |      // Run motion estimation.
  253|       |      // Note that the initial search (init) instructs the called function to
  254|       |      // perform a more extensive search.
  255|  42.1k|      if let Some(results) = estimate_motion(
  256|  42.1k|        fi,
  257|  42.1k|        ts,
  258|  42.1k|        w,
  259|  42.1k|        h,
  260|  42.1k|        sub_bo,
  261|  42.1k|        ref_frame,
  262|  42.1k|        None,
  263|  42.1k|        corner,
  264|  42.1k|        init,
  265|  42.1k|        ssdec,
  266|  42.1k|        Some(lambda),
  267|  42.1k|      ) {
  268|  39.3k|        // normalize sad to 128x128 block
  269|  39.3k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  270|  39.3k|          / (w * h) as u64) as u32;
  271|  39.3k|        save_me_stats(
  272|  39.3k|          ts,
  273|  39.3k|          mv_size_in_b_log2,
  274|  39.3k|          sub_bo,
  275|  39.3k|          ref_frame,
  276|  39.3k|          MEStats { mv: results.mv, normalized_sad: sad },
  277|  39.3k|        );
  278|  39.3k|      }
  279|       |    }
  280|       |  }
