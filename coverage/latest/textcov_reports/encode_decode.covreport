   29|  6.66G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  6.66G|  let nsymbs = 4;
   31|  6.66G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  6.66G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  6.66G|
   34|  6.66G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  6.66G|  // implementation:
   36|  6.66G|  //
   37|  6.66G|  // ```
   38|  6.66G|  // if i as u32 >= val {
   39|  6.66G|  //   *v -= *v >> rate;
   40|  6.66G|  // } else {
   41|  6.66G|  //   *v += (32768 - *v) >> rate;
   42|  6.66G|  // }
   43|  6.66G|  // ```
   44|  6.66G|  //
   45|  6.66G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  6.66G|  // transform in something like:
   47|  6.66G|  //
   48|  6.66G|  // ```
   49|  6.66G|  // if i as u32 >= val {
   50|  6.66G|  //   *v -= *v >> rate;
   51|  6.66G|  // } else {
   52|  6.66G|  //   *v -= -((32768 - *v) >> rate);
   53|  6.66G|  // }
   54|  6.66G|  // ```
   55|  6.66G|  //
   56|  6.66G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  6.66G|  // using the following rule:
   58|  6.66G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  6.66G|  // So we obtain
   60|  6.66G|  //
   61|  6.66G|  // ```
   62|  6.66G|  // if i as u32 >= val {
   63|  6.66G|  //   *v -= *v >> rate;
   64|  6.66G|  // } else {
   65|  6.66G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  6.66G|  // }
   67|  6.66G|  // ```
   68|  6.66G|  //
   69|  6.66G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  6.66G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  6.66G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  6.66G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  6.66G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  6.66G|  //
   75|  6.66G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  6.66G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  6.66G|
   78|  6.66G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  6.66G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  6.66G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  6.66G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  6.66G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  6.66G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  6.66G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  6.66G|  let shifted =
   86|  6.66G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  6.66G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  6.66G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  6.66G|
   90|  6.66G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  6.66G|  cdf[nsymbs - 1] = count;
   92|  6.66G|}
