_RNvNtCsgGiEFdpFC8m_5rav1e7deblock16filter_narrow2_4B3_:
  160|  6.76M|fn filter_narrow2_4(
  161|  6.76M|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  162|  6.76M|) -> [i32; 4] {
  163|  6.76M|  let filter0 = clamp(p1 - q1, -128 << shift, (128 << shift) - 1);
  164|  6.76M|  let filter1 =
  165|  6.76M|    clamp(filter0 + 3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  166|       |  // be certain our optimization removing a clamp is sound
  167|       |  debug_assert!({
  168|      0|    let base =
  169|      0|      clamp(filter0 + 3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  170|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  171|      0|    filter1 == test
  172|       |  });
  173|  6.76M|  let filter2 =
  174|  6.76M|    clamp(filter0 + 3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  175|       |  // be certain our optimization removing a clamp is sound
  176|       |  debug_assert!({
  177|      0|    let base =
  178|      0|      clamp(filter0 + 3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  179|      0|    let test = clamp(base + 3, -128 << shift, (128 << shift) - 1) >> 3;
  180|      0|    filter2 == test
  181|       |  });
  182|  6.76M|  [
  183|  6.76M|    p1,
  184|  6.76M|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  185|  6.76M|    clamp(q0 - filter1, 0, (256 << shift) - 1),
  186|  6.76M|    q1,
  187|  6.76M|  ]
  188|  6.76M|}
