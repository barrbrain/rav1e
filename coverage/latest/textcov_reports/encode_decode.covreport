 1164|  3.01k|fn uneven_multi_hex_search<T: Pixel>(
 1165|  3.01k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1166|  3.01k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1167|  3.01k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1168|  3.01k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize, me_range: i16,
 1169|  3.01k|) {
 1170|  3.01k|  assert!(!current.is_empty());
 1171|       |
 1172|       |  // Search in a cross pattern to obtain a rough approximate of motion.
 1173|       |  // The cross is split into a horizontal and vertical component. Video content
 1174|       |  // tends to have more horizontal motion, so the horizontal part of the cross
 1175|       |  // is twice as large as the vertical half.
 1176|       |  //        X        -
 1177|       |  //                 | <- me_range/2
 1178|       |  //        X        |
 1179|       |  // X X X XoX X X X -
 1180|       |  //        X
 1181|       |  //
 1182|       |  //        X
 1183|       |  // |------|
 1184|       |  //     \
 1185|       |  //    me_range
 1186|  3.01k|  let center = current.mv;
 1187|       |
 1188|       |  // The larger, horizontal, part of the cross search.
 1189|  36.1k|  for i in (1..=me_range).step_by(2) {
 1190|       |    const HORIZONTAL_LINE: [MotionVector; 2] = search_pattern!(
 1191|       |      col: [ 0, 0],
 1192|       |      row: [-1, 1]
 1193|       |    );
 1194|       |
 1195|   108k|    for &offset in &HORIZONTAL_LINE {
 1196|  72.2k|      let cand_mv = center + offset * i;
 1197|  72.2k|      let rd = get_fullpel_mv_rd(
 1198|  72.2k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1199|  72.2k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1200|  72.2k|      );
 1201|  72.2k|
 1202|  72.2k|      if rd.cost < current.rd.cost {
 1203|  3.13k|        current.mv = cand_mv;
 1204|  3.13k|        current.rd = rd;
 1205|  69.1k|      }
 1206|       |    }
 1207|       |  }
 1208|       |
 1209|       |  // The smaller, vertical, part of the cross search
 1210|  18.0k|  for i in (1..=me_range >> 1).step_by(2) {
 1211|       |    const VERTICAL_LINE: [MotionVector; 2] = search_pattern!(
 1212|       |      col: [-1, 1],
 1213|       |      row: [ 0, 0]
 1214|       |    );
 1215|       |
 1216|  54.1k|    for &offset in &VERTICAL_LINE {
 1217|  36.1k|      let cand_mv = center + offset * i;
 1218|  36.1k|      let rd = get_fullpel_mv_rd(
 1219|  36.1k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1220|  36.1k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1221|  36.1k|      );
 1222|  36.1k|
 1223|  36.1k|      if rd.cost < current.rd.cost {
 1224|    762|        current.mv = cand_mv;
 1225|    762|        current.rd = rd;
 1226|  35.3k|      }
 1227|       |    }
 1228|       |  }
 1229|       |
 1230|       |  // 5x5 full search. Search a 5x5 square region around the current best mv.
 1231|  3.01k|  let center = current.mv;
 1232|  18.0k|  for row in -2..=2 {
 1233|  90.3k|    for col in -2..=2 {
 1234|  75.2k|      if row == 0 && col == 0 {
 1235|  3.01k|        continue;
 1236|  72.2k|      }
 1237|  72.2k|      let cand_mv = center + MotionVector { row, col };
 1238|  72.2k|      let rd = get_fullpel_mv_rd(
 1239|  72.2k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1240|  72.2k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1241|  72.2k|      );
 1242|  72.2k|
 1243|  72.2k|      if rd.cost < current.rd.cost {
 1244|    569|        current.mv = cand_mv;
 1245|    569|        current.rd = rd;
 1246|  71.6k|      }
 1247|       |    }
 1248|       |  }
 1249|       |
 1250|       |  // Run the hexagons in uneven multi-hexagon. The hexagonal pattern is tested
 1251|       |  // around the best vector at multiple scales.
 1252|       |  // Example of the UMH pattern run on a scale of 1 and 2:
 1253|       |  //         2         -
 1254|       |  //                   | <- me_range
 1255|       |  //     2       2     |
 1256|       |  //                   |
 1257|       |  // 2       1       2 |
 1258|       |  //       1   1       |
 1259|       |  // 2   1       1   2 |
 1260|       |  //     1       1     |
 1261|       |  // 2   1   o   1   2 |
 1262|       |  //     1       1     |
 1263|       |  // 2   1       1   2 |
 1264|       |  //       1   1       |
 1265|       |  // 2       1       2 |
 1266|       |  //                   |
 1267|       |  //     2       2     |
 1268|       |  //                   |
 1269|       |  //         2         -
 1270|       |  // |---------------|
 1271|       |  //        \
 1272|       |  //       me_range
 1273|  3.01k|  let center = current.mv;
 1274|  3.01k|
 1275|  3.01k|  // Divide by 4, the radius of the UMH's hexagon.
 1276|  3.01k|  let iterations = me_range >> 2;
 1277|  18.0k|  for i in 1..=iterations {
 1278|   307k|    for &offset in &UMH_PATTERN {
 1279|   288k|      let cand_mv = center + offset * i;
 1280|   288k|      let rd = get_fullpel_mv_rd(
 1281|   288k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1282|   288k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1283|   288k|      );
 1284|   288k|
 1285|   288k|      if rd.cost < current.rd.cost {
 1286|  5.76k|        current.mv = cand_mv;
 1287|  5.76k|        current.rd = rd;
 1288|   283k|      }
 1289|       |    }
 1290|       |  }
 1291|       |
 1292|       |  // Refine the search results using a 'normal' hexagon search.
 1293|  3.01k|  hexagon_search(
 1294|  3.01k|    fi, po, org_region, p_ref, current, bit_depth, pmv, lambda, mvx_min,
 1295|  3.01k|    mvx_max, mvy_min, mvy_max, w, h,
 1296|  3.01k|  );
 1297|  3.01k|}
