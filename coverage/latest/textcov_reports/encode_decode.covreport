_RNvNtCs3tIhnEwGhQF_5rav1e8quantize8divu_gen:
  107|   122M|fn divu_gen(d: u32) -> (u32, u32, u32) {
  108|   122M|  let nbits = (mem::size_of_val(&d) as u64) * 8;
  109|   122M|  let m = nbits - d.leading_zeros() as u64 - 1;
  110|   122M|  if (d & (d - 1)) == 0 {
  111|  14.0M|    (0xFFFF_FFFF, 0xFFFF_FFFF, m as u32)
  112|       |  } else {
  113|   107M|    let d = d as u64;
  114|   107M|    let t = (1u64 << (m + nbits)) / d;
  115|   107M|    let r = (t * d + d) & ((1 << nbits) - 1);
  116|   107M|    if r <= 1u64 << m {
  117|  79.9M|      (t as u32 + 1, 0u32, m as u32)
  118|       |    } else {
  119|  28.0M|      (t as u32, t as u32, m as u32)
  120|       |    }
  121|       |  }
  122|   122M|}
