  532|  1.37k|    let mut log_q_y = log_target_q;
  533|  1.37k|    if !is_intra && bit_depth == 8 {
  534|    494|      log_q_y = log_target_q
  535|    494|        + (log_target_q >> 32) * Q_MODEL_MUL[chroma_sampling as usize]
  536|    494|        + Q_MODEL_ADD[chroma_sampling as usize];
  537|    880|    }
  538|       |
  539|  1.37k|    let quantizer = bexp64(log_q_y + scale);
  540|  1.37k|    let (offset_u, offset_v) =
  541|  1.37k|      chroma_offset(log_q_y + log_isqrt_mean_scale, chroma_sampling);
  542|  1.37k|    let mono = chroma_sampling == ChromaSampling::Cs400;
  543|  1.37k|    let log_q_u = log_q_y + offset_u;
  544|  1.37k|    let log_q_v = log_q_y + offset_v;
  545|  1.37k|    let quantizer_u = bexp64(log_q_u + scale);
  546|  1.37k|    let quantizer_v = bexp64(log_q_v + scale);
  547|  1.37k|    let lambda = (::std::f64::consts::LN_2 / 6.0)
  548|  1.37k|      * (((log_target_q + log_isqrt_mean_scale) as f64)
  549|  1.37k|        * Q57_SQUARE_EXP_SCALE)
