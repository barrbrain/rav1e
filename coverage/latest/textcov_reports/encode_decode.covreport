  643|  11.0M|$($s)* fn daala_fdct_ii_8_asym<T: TxOperations>(
  644|  11.0M|  r0h: T, r1: (T, T), r2h: T, r3: (T, T), r4h: T, r5: (T, T), r6h: T,
  645|  11.0M|  r7: (T, T), output: &mut [T],
  646|  11.0M|) {
  647|  11.0M|  // +/- Butterflies with asymmetric input.
  648|  11.0M|  let (r0, r7) = butterfly_neg_asym(r0h, r7);
  649|  11.0M|  let (r1, r6) = butterfly_sub_asym(r1, r6h);
  650|  11.0M|  let (r2, r5) = butterfly_neg_asym(r2h, r5);
  651|  11.0M|  let (r3, r4) = butterfly_sub_asym(r3, r4h);
  652|  11.0M|
  653|  11.0M|  // Embedded 4-point orthonormal transforms.
  654|  11.0M|  daala_fdct_ii_4(r0, r1, r2, r3, &mut output[0..4]);
  655|  11.0M|  daala_fdst_iv_4(r7, r6, r5, r4, &mut output[4..8]);
  656|  11.0M|  output[4..8].reverse();
  657|  11.0M|}
_RNvYNtNtNtNtNtCs3tIhnEwGhQF_5rav1e3asm3x869transform7forward12RotateAddAvgINtB4_12RotateKernelNtB4_5I32X8E11half_kernelBc_:
  218|  41.6M|  $($s)* fn half_kernel(
  219|  41.6M|    p0: (T, T), p1: T, m: ((i32, i32), (i32, i32), (i32, i32)),
  220|  41.6M|  ) -> (T, T) {
  221|  41.6M|    let t = Self::ADD(p1, p0.0);
  222|  41.6M|    let (a, b, c) = (p0.1.tx_mul(m.0), p1.tx_mul(m.1), t.tx_mul(m.2));
  223|  41.6M|    let out0 = b.add(c);
  224|  41.6M|    let shifted = Self::SHIFT(c);
  225|  41.6M|    let out1 = Self::SUB(a, shifted);
  226|  41.6M|    (out0, out1)
  227|  41.6M|  }
_RINvNtNtNtNtCs3tIhnEwGhQF_5rav1e3asm3x869transform7forward21daala_fdct_ii_16_asymNtB2_5I32X8EBa_:
  947|  7.11M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  7.11M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  7.11M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
  950|  7.11M|  seh: T, sf: (T, T), output: &mut [T],
  951|  7.11M|) {
  952|  7.11M|  // +/- Butterflies with asymmetric input.
  953|  7.11M|  let (s0, sf) = butterfly_neg_asym(s0h, sf);
  954|  7.11M|  let (s1, se) = butterfly_sub_asym(s1, seh);
  955|  7.11M|  let (s2, sd) = butterfly_neg_asym(s2h, sd);
  956|  7.11M|  let (s3, sc) = butterfly_sub_asym(s3, sch);
  957|  7.11M|  let (s4, sb) = butterfly_neg_asym(s4h, sb);
  958|  7.11M|  let (s5, sa) = butterfly_sub_asym(s5, sah);
  959|  7.11M|  let (s6, s9) = butterfly_neg_asym(s6h, s9);
  960|  7.11M|  let (s7, s8) = butterfly_sub_asym(s7, s8h);
  961|  7.11M|
  962|  7.11M|  // Embedded 8-point orthonormal transforms.
  963|  7.11M|  daala_fdct_ii_8(s0, s1, s2, s3, s4, s5, s6, s7, &mut output[0..8]);
  964|  7.11M|  daala_fdst_iv_8(sf, se, sd, sc, sb, sa, s9, s8, &mut output[8..16]);
  965|  7.11M|  output[8..16].reverse();
  966|  7.11M|}
_RINvNvNtNtNtNtCs3tIhnEwGhQF_5rav1e3asm3x869transform7forward12daala_fdct6414butterfly_pairNtB4_5I32X8EBc_:
 1595|  11.9M|    $($s)* fn butterfly_pair<T: TxOperations>(
 1596|  11.9M|      half: &mut [T; 32], asym: &mut [(T, T); 32], input: &[T], i: usize
 1597|  11.9M|    ) {
 1598|  11.9M|      let j = i * 2;
 1599|  11.9M|      let (ah, c) = butterfly_neg(input[j], input[63 - j]);
 1600|  11.9M|      let (b, dh) = butterfly_add(input[j + 1], input[63 - j - 1]);
 1601|  11.9M|      half[i] = ah;
 1602|  11.9M|      half[31 - i] = dh;
 1603|  11.9M|      asym[i] = b;
 1604|  11.9M|      asym[31 - i] = c;
 1605|  11.9M|    }
_RINvNtNtNtNtCs3tIhnEwGhQF_5rav1e3asm3x869transform7forward13butterfly_negNtB2_5I32X8EBa_:
  321|   247M|$($s)* fn butterfly_neg<T: TxOperations>(p0: T, p1: T) -> (T, (T, T)) {
  322|   247M|  let p1 = p0.sub(p1);
  323|   247M|  let p1h = p1.rshift1();
  324|   247M|  let p0h = p0.sub(p1h);
  325|   247M|  (p0h, (p1h, p1))
  326|   247M|}
_RINvNtNtNtNtCs3tIhnEwGhQF_5rav1e3asm3x869transform7forward18butterfly_sub_asymNtB2_5I32X8EBa_:
  338|   300M|$($s)* fn butterfly_sub_asym<T: TxOperations>(p0: (T, T), p1h: T) -> (T, T) {
  339|   300M|  let p1 = p1h.sub(p0.0);
  340|   300M|  let p0 = p0.1.add(p1);
  341|   300M|  (p0, p1)
  342|   300M|}
