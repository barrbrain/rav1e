 1562|    962|        2 + (above_backward || above_intra) as usize
 1563|  27.9k|      } else if left_single {
 1564|  1.09k|        2 + (left_backward || left_intra) as usize
 1565|       |      } else {
 1566|  26.8k|        4
 1567|       |      }
 1568|   350k|    } else if avail_up {
 1569|   133k|      if above_single {
 1570|   125k|        above_backward as usize
 1571|       |      } else {
 1572|  7.76k|        3
 1573|       |      }
 1574|   217k|    } else if avail_left {
 1575|   142k|      if left_single {
 1576|   134k|        left_backward as usize
 1577|       |      } else {
 1578|  8.01k|        3
 1579|       |      }
 1580|       |    } else {
 1581|  74.8k|      1
 1582|       |    }
 1583|   771k|  }
