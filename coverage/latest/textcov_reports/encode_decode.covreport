  492|  14.1M|      &coded_data.distortion_scales[y * coded_data.w_in_imp_b..][x0..x1],
  493|  14.1M|      MAX_SB_IN_IMP_B,
  494|  14.1M|    )
  495|  14.1M|    .iter()
  496|  14.1M|    .zip(
  497|  14.1M|      take_slice(
  498|  14.1M|        &coded_data.activity_scales[y * coded_data.w_in_imp_b..][x0..x1],
  499|  14.1M|        MAX_SB_IN_IMP_B,
  500|  14.1M|      )
  501|  14.1M|      .iter(),
  502|  14.1M|    )
  503|  14.1M|    .map(|(d, a)| d.0 as u64 * a.0 as u64)
  504|  14.1M|    .sum::<u64>();
  505|  14.1M|  }
