  237|  2.71M|  pub fn get_weighted_sse<T: Pixel>(
  238|  2.71M|    src1: &PlaneRegion<'_, T>, src2: &PlaneRegion<'_, T>, scale: &[u32],
  239|  2.71M|    scale_stride: usize, w: usize, h: usize, _bit_depth: usize,
  240|  2.71M|    _cpu: CpuFeatureLevel,
  241|  2.71M|  ) -> u64 {
  242|  2.71M|    // Always chunk and apply scaling on the sse of squares the size of
  243|  2.71M|    // decimated/sub-sampled importance block sizes.
  244|  2.71M|    // Warning: Changing this will require changing/disabling assembly.
  245|  2.71M|    let chunk_size = IMPORTANCE_BLOCK_SIZE >> 1;
  246|  2.71M|
  247|  2.71M|    let mut sse: u64 = 0;
  248|       |
  249|  7.22M|    for block_y in 0..(h + chunk_size - 1) / chunk_size {
  250|  26.3M|      for block_x in 0..(w + chunk_size - 1) / chunk_size {
  251|  26.3M|        let mut block_sse: u32 = 0;
  252|       |
  253|  96.2M|        for j in 0..chunk_size.min(h - block_y * chunk_size) {
  254|  96.2M|          let s1 = &src1[block_y * chunk_size + j]
  255|  96.2M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  256|  96.2M|          let s2 = &src2[block_y * chunk_size + j]
  257|  96.2M|            [block_x * chunk_size..((block_x + 1) * chunk_size).min(w)];
  258|  96.2M|
  259|  96.2M|          block_sse += s1
  260|  96.2M|            .iter()
  261|  96.2M|            .zip(s2)
  262|  96.2M|            .map(|(&a, &b)| {
  263|       |              let c = (i16::cast_from(a) - i16::cast_from(b)) as i32;
  264|       |              (c * c) as u32
  265|  96.2M|            })
  266|  96.2M|            .sum::<u32>();
  267|  96.2M|        }
  268|       |
  269|  26.3M|        sse += (block_sse as u64
  270|  26.3M|          * scale[block_y * scale_stride + block_x] as u64
  271|  26.3M|          + (1 << GET_WEIGHTED_SSE_SHIFT >> 1))
  272|  26.3M|          >> GET_WEIGHTED_SSE_SHIFT;
  273|       |      }
  274|       |    }
  275|  2.71M|    let den = DistortionScale::new(1, 1 << GET_WEIGHTED_SSE_SHIFT).0 as u64;
  276|  2.71M|    (sse + (den >> 1)) / den
  277|  2.71M|  }
_RINvNtNtCs5T1csxkeGwJ_5rav1e4dist4rust16cdef_dist_kernelhEB6_:
  296|  7.71M|  pub fn cdef_dist_kernel<T: Pixel>(
  297|  7.71M|    src: &PlaneRegion<'_, T>, dst: &PlaneRegion<'_, T>, w: usize, h: usize,
  298|  7.71M|    bit_depth: usize, _cpu: CpuFeatureLevel,
  299|  7.71M|  ) -> u32 {
  300|       |    // TODO: Investigate using different constants in ssim boost for block sizes
  301|       |    // smaller than 8x8.
  302|       |
  303|      0|    debug_assert!(src.plane_cfg.xdec == 0);
  304|      0|    debug_assert!(src.plane_cfg.ydec == 0);
  305|      0|    debug_assert!(dst.plane_cfg.xdec == 0);
  306|      0|    debug_assert!(dst.plane_cfg.ydec == 0);
  307|       |
  308|       |    // Limit kernel to 8x8
  309|      0|    debug_assert!(w <= 8);
  310|      0|    debug_assert!(h <= 8);
  311|       |
  312|       |    // Compute the following summations.
  313|  7.71M|    let mut sum_s: u32 = 0; // sum(src_{i,j})
  314|  7.71M|    let mut sum_d: u32 = 0; // sum(dst_{i,j})
  315|  7.71M|    let mut sum_s2: u32 = 0; // sum(src_{i,j}^2)
  316|  7.71M|    let mut sum_d2: u32 = 0; // sum(dst_{i,j}^2)
  317|  7.71M|    let mut sum_sd: u32 = 0; // sum(src_{i,j} * dst_{i,j})
  318|  42.4M|    for j in 0..h {
  319|  42.4M|      let row1 = &src[j][0..w];
  320|  42.4M|      let row2 = &dst[j][0..w];
  321|   214M|      for (s, d) in row1.iter().zip(row2) {
  322|   214M|        let s: u32 = u32::cast_from(*s);
  323|   214M|        let d: u32 = u32::cast_from(*d);
  324|   214M|        sum_s += s;
  325|   214M|        sum_d += d;
  326|   214M|
  327|   214M|        sum_s2 += s * s;
  328|   214M|        sum_d2 += d * d;
  329|   214M|        sum_sd += s * d;
  330|   214M|      }
  331|       |    }
  332|       |
  333|       |    // To get the distortion, compute sum of squared error and apply a weight
  334|       |    // based on the variance of the two planes.
  335|  7.71M|    let sse = sum_d2 + sum_s2 - 2 * sum_sd;
  336|  7.71M|
  337|  7.71M|    // Convert to 64-bits to avoid overflow when squaring
  338|  7.71M|    let sum_s = sum_s as u64;
  339|  7.71M|    let sum_d = sum_d as u64;
  340|  7.71M|
  341|  7.71M|    // Calculate the variance (more accurately variance*area) of each plane.
  342|  7.71M|    // var[iance] = avg(X^2) - avg(X)^2 = sum(X^2) / n - sum(X)^2 / n^2
  343|  7.71M|    //    (n = # samples i.e. area)
  344|  7.71M|    // var * n = sum(X^2) - sum(X)^2 / n
  345|  7.71M|    // When w and h are powers of two, this can be done via shifting.
  346|  7.71M|    let div = AREA_DIVISORS[w * h - 1] as u64;
  347|  7.71M|    let div_shift = AREA_DIVISOR_BITS;
  348|  7.71M|    // Due to rounding, negative values can occur when w or h aren't powers of
  349|  7.71M|    // two. Saturate to avoid underflow.
  350|  7.71M|    let mut svar = sum_s2.saturating_sub(
  351|  7.71M|      ((sum_s * sum_s * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  352|  7.71M|    );
  353|  7.71M|    let mut dvar = sum_d2.saturating_sub(
  354|  7.71M|      ((sum_d * sum_d * div + (1 << div_shift >> 1)) >> div_shift) as u32,
  355|  7.71M|    );
  356|  7.71M|
  357|  7.71M|    // Scale variances up to 8x8 size.
  358|  7.71M|    //   scaled variance = var * (8x8) / wxh
  359|  7.71M|    // For 8x8, this is a nop. For powers of 2, this is doable with shifting.
  360|  7.71M|    // TODO: It should be possible and faster to do this adjustment in ssim boost
  361|  7.71M|    let scale_shift = AREA_DIVISOR_BITS - 6;
  362|  7.71M|    svar =
  363|  7.71M|      ((svar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  364|  7.71M|    dvar =
  365|  7.71M|      ((dvar as u64 * div + (1 << scale_shift >> 1)) >> scale_shift) as u32;
  366|  7.71M|
  367|  7.71M|    apply_ssim_boost(sse, svar, dvar, bit_depth)
  368|  7.71M|  }
