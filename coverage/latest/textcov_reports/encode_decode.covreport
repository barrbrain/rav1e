 1538|   752k|      let bo_left = bo.with_offset(-1, 0);
 1539|   752k|      let ref_frames = &self.bc.blocks[bo_left].ref_frames;
 1540|   752k|      (ref_frames[0], ref_frames[1])
 1541|       |    } else {
 1542|   292k|      (INTRA_FRAME, NONE_FRAME)
 1543|       |    };
 1544|  1.04M|    let (above0, above1) = if avail_up {
 1545|   742k|      let bo_up = bo.with_offset(0, -1);
 1546|   742k|      let ref_frames = &self.bc.blocks[bo_up].ref_frames;
 1547|   742k|      (ref_frames[0], ref_frames[1])
 1548|       |    } else {
