  283|  2.70k|fn refine_subsampled_sb_motion<T: Pixel>(
  284|  2.70k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  285|  2.70k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, ssdec: u8, lambda: u32,
  286|  2.70k|) {
  287|  2.70k|  let pix_offset = tile_bo.to_luma_plane_offset();
  288|  2.70k|  let sb_h: usize = SB_SIZE.min(ts.height - pix_offset.y as usize);
  289|  2.70k|  let sb_w: usize = SB_SIZE.min(ts.width - pix_offset.x as usize);
  290|  2.70k|
  291|  2.70k|  let mv_size = MI_SIZE << mv_size_in_b_log2;
  292|       |
  293|       |  // Process in blocks, cropping at edges.
  294|  3.54k|  for y in (0..sb_h).step_by(mv_size) {
  295|  4.98k|    for x in (0..sb_w).step_by(mv_size) {
  296|  4.98k|      let sub_bo = tile_bo
  297|  4.98k|        .with_offset(x as isize >> MI_SIZE_LOG2, y as isize >> MI_SIZE_LOG2);
  298|  4.98k|
  299|  4.98k|      // Clamp to frame edge, rounding up in the case of subsampling.
  300|  4.98k|      // The rounding makes some assumptions about how subsampling is done.
  301|  4.98k|      let w = mv_size.min(sb_w - x + (1 << ssdec) - 1) >> ssdec;
  302|  4.98k|      let h = mv_size.min(sb_h - y + (1 << ssdec) - 1) >> ssdec;
  303|       |
  304|       |      // Refine the existing motion estimate
  305|  4.98k|      if let Some(results) = refine_subsampled_motion_estimate(
  306|  4.98k|        fi, ts, w, h, sub_bo, ref_frame, ssdec, lambda,
  307|  4.98k|      ) {
  308|  4.78k|        // normalize sad to 128x128 block
  309|  4.78k|        let sad = (((results.rd.sad as u64) << (MAX_SB_SIZE_LOG2 * 2))
  310|  4.78k|          / (w * h) as u64) as u32;
  311|  4.78k|        save_me_stats(
  312|  4.78k|          ts,
  313|  4.78k|          mv_size_in_b_log2,
  314|  4.78k|          sub_bo,
  315|  4.78k|          ref_frame,
  316|  4.78k|          MEStats { mv: results.mv, normalized_sad: sad },
  317|  4.78k|        );
  318|  4.78k|      }
  319|       |    }
  320|       |  }
  321|  2.70k|}
