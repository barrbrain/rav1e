 1704|  24.4M|    output[0 + i * 4] = tmp[0 + j];
 1705|  24.4M|    output[1 + i * 4] = tmp[32 + j];
 1706|  24.4M|    output[2 + i * 4] = tmp[16 + j];
 1707|  24.4M|    output[3 + i * 4] = tmp[48 + j];
 1708|  24.4M|  }
