  947|  7.32M|$($s)* fn daala_fdct_ii_16_asym<T: TxOperations>(
  948|  7.32M|  s0h: T, s1: (T, T), s2h: T, s3: (T, T), s4h: T, s5: (T, T), s6h: T,
  949|  7.32M|  s7: (T, T), s8h: T, s9: (T, T), sah: T, sb: (T, T), sch: T, sd: (T, T),
