  441|  66.2M|$($s)* fn daala_fdct_ii_4_asym<T: TxOperations>(
  442|  66.2M|  q0h: T, q1: (T, T), q2h: T, q3: (T, T), output: &mut [T],
  443|  66.2M|) {
  444|  66.2M|  // +/- Butterflies with asymmetric input.
  445|  66.2M|  let (q0, q3) = butterfly_neg_asym(q0h, q3);
  446|  66.2M|  let (q1, q2) = butterfly_sub_asym(q1, q2h);
  447|  66.2M|
  448|  66.2M|  // Embedded 2-point orthonormal transforms.
  449|  66.2M|  let (q0, q1) = daala_fdct_ii_2(q0, q1);
  450|  66.2M|  let (q3, q2) = daala_fdst_iv_2(q3, q2);
