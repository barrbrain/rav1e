  613|  57.6M|  fn rollback(
  614|  57.6M|    log: &mut CDFContextLogBase, fc: &mut CDFContext, checkpoint: usize,
  615|  57.6M|  ) {
  616|  57.6M|    let base = fc as *mut _ as *mut u8;
  617|  57.6M|    let mut len = log.data.len();
  618|  57.6M|    // SAFETY: We use unchecked pointers here for performance.
  619|  57.6M|    // Since we know the length, we can ensure not to go OOB.
  620|  57.6M|    unsafe {
  621|  57.6M|      let mut src = log.data.get_unchecked_mut(len) as *mut u16;
  622|  6.97G|      while len > checkpoint {
  623|  6.92G|        len -= Self::CDF_LEN_MAX + 1;
  624|  6.92G|        src = src.sub(Self::CDF_LEN_MAX + 1);
  625|  6.92G|        let offset = *src.add(Self::CDF_LEN_MAX) as usize;
  626|  6.92G|        let dst = base.add(offset) as *mut u16;
  627|  6.92G|        dst.copy_from_nonoverlapping(src, Self::CDF_LEN_MAX);
  628|  6.92G|      }
  629|  57.6M|      log.data.set_len(len);
  630|  57.6M|    }
  631|  57.6M|  }
