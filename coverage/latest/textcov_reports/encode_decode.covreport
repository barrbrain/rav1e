 1321|  15.7k|  match pli {
 1322|       |    0 => {
 1323|  5.65k|      if deblock.levels[0] == 0 && deblock.levels[1] == 0 {
 1324|      0|        return;
 1325|  5.65k|      }
 1326|       |    }
 1327|       |    1 => {
 1328|  5.05k|      if deblock.levels[2] == 0 {
 1329|    536|        return;
 1330|  4.52k|      }
 1331|       |    }
 1332|       |    2 => {
 1333|  5.05k|      if deblock.levels[3] == 0 {
 1334|    643|        return;
 1335|  4.41k|      }
 1336|       |    }
 1337|      0|    _ => return,
 1338|       |  }
 1339|       |
 1340|  14.5k|  let rect = p.rect();
 1341|  14.5k|  let cols = (cmp::min(
 1342|  14.5k|    blocks.cols(),
 1343|  14.5k|    ((crop_w - rect.x as usize) + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1344|  14.5k|  ) + (1 << xdec >> 1))
 1345|  14.5k|    >> xdec
 1346|  14.5k|    << xdec; // Clippy can go suck an egg
 1347|  14.5k|  let rows = (cmp::min(
 1348|  14.5k|    blocks.rows(),
 1349|  14.5k|    ((crop_h - rect.y as usize) + MI_SIZE - 1) >> MI_SIZE_LOG2,
 1350|  14.5k|  ) + (1 << ydec >> 1))
 1351|  14.5k|    >> ydec
 1352|  14.5k|    << ydec; // Clippy can go suck an egg
 1353|  14.5k|
