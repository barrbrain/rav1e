  247|  39.4M|    qcoeffs[0] = {
  248|  39.4M|      let coeff: i32 =
  249|  39.4M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|  39.4M|      let abs_coeff = coeff.unsigned_abs();
  251|  39.4M|      T::cast_from(copysign(
  252|  39.4M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|  39.4M|        coeff,
  254|  39.4M|      ))
  255|  39.4M|    };
  256|  39.4M|
  257|  39.4M|    // Find the last non-zero coefficient using our smaller biases and
  258|  39.4M|    // zero everything else.
  259|  39.4M|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|  39.4M|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|  39.4M|    let deadzone = T::cast_from(
  262|  39.4M|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|  39.4M|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|  39.4M|    );
  265|  39.4M|    let eob = {
  266|  39.4M|      // We skip the DC coefficient since it has its own quantizer index.
  267|  39.4M|      let eob_minus_two =
  268|  39.4M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|  39.4M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|  39.4M|      })
  276|  39.4M|    };
  277|  39.4M|
  278|  39.4M|    // Here we use different rounding biases depending on whether we've
  279|  39.4M|    // had recent coefficients that are larger than one, or less than
  280|  39.4M|    // one. The reason for this is that a block usually has a chunk of
  281|  39.4M|    // large coefficients and a tail of zeroes and ones, and the tradeoffs
  282|  39.4M|    // for coding these two are different. In the tail of zeroes and ones,
  283|  39.4M|    // you'll likely end up spending most bits just saying where that
  284|  39.4M|    // coefficient is in the block, whereas in the chunk of larger
  285|  39.4M|    // coefficients, most bits will be spent on coding its magnitude.
  286|  39.4M|    // To that end, we want to bias more toward rounding to zero for
  287|  39.4M|    // that tail of zeroes and ones than we do for the larger coefficients.
  288|  39.4M|    let mut level_mode = 1;
  289|  1.73G|    for &pos in scan.iter().take(eob).skip(1) {
  290|  1.73G|      let coeff = i32::cast_from(coeffs[pos as usize]) << self.log_tx_scale;
  291|  1.73G|      let abs_coeff = coeff.unsigned_abs();
  292|  1.73G|
  293|  1.73G|      let level0 = divu_pair(abs_coeff, self.ac_mul_add);
  294|  1.73G|      let offset = if level0 > 1 - level_mode {
  295|   769M|        self.ac_offset1
  296|       |      } else {
  297|   966M|        self.ac_offset0
  298|       |      };
  299|       |
  300|  1.73G|      let abs_qcoeff: u32 = divu_pair(abs_coeff + offset, self.ac_mul_add);
  301|  1.73G|      if level_mode != 0 && abs_qcoeff == 0 {
  302|   104M|        level_mode = 0;
  303|  1.63G|      } else if abs_qcoeff > 1 {
  304|   724M|        level_mode = 1;
  305|   906M|      }
  306|       |
  307|  1.73G|      qcoeffs[pos as usize] = T::cast_from(copysign(abs_qcoeff, coeff));
  308|       |    }
  309|       |
  310|       |    // Rather than zeroing the tail in scan order, assume that qcoeffs is
  311|       |    // pre-filled with zeros.
  312|       |
  313|       |    // Check the eob is correct
  314|       |    debug_assert_eq!(
  315|       |      eob,
  316|      0|      scan
  317|      0|        .iter()
  318|      0|        .rposition(|&i| qcoeffs[i as usize] != T::cast_from(0))
  319|      0|        .map(|n| n + 1)
  320|      0|        .unwrap_or(0)
  321|       |    );
  322|       |
  323|  39.4M|    eob
  324|  39.4M|  }

_RNvMs3_NtCsgLNdNkfkEgK_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|    561|  fn calc_flat_quantizer(
 1061|    561|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|    561|  ) -> (i64, i64) {
 1063|    561|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|    561|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|    561|    //  parameterize a "quality" configuration parameter).
 1066|    561|
 1067|    561|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|    561|    //  tables have unique entries, while the DC tables do not.
 1069|    561|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|    561|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|    561|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|    561|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|    561|    // Get the log quantizers as Q57.
 1074|    561|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|    561|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|    561|    // Target the midpoint of the chosen entries.
 1077|    561|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|    561|    // Adjust the quantizer for the frame type, result is Q57:
 1079|    561|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|    561|      + DQP_Q57[fti];
 1081|    561|    (log_base_q, log_q)
 1082|    561|  }
_RNvMNtCsgLNdNkfkEgK_5rav1e4rateNtB2_10IIRBessel23new:
  171|    500|  pub fn new(delay: i32, value: i32) -> IIRBessel2 {
  172|    500|    let (c0, c1, g) = iir_bessel2_get_parameters(delay);
  173|    500|    IIRBessel2 { c: [c0, c1], g, x: [value, value], y: [value, value] }
  174|    500|  }
_RNvNtCsgLNdNkfkEgK_5rav1e4rate13chroma_offset:
  509|    612|fn chroma_offset(
  510|    612|  log_target_q: i64, chroma_sampling: ChromaSampling,
  511|    612|) -> (i64, i64) {
  512|    612|  let x = log_target_q.max(0);
  513|       |  // Gradient optimized for CIEDE2000+PSNR on subset3
  514|    612|  let y = match chroma_sampling {
  515|     96|    ChromaSampling::Cs400 => 0,
  516|     74|    ChromaSampling::Cs420 => (x >> 2) + (x >> 6), // 0.266
  517|     48|    ChromaSampling::Cs422 => (x >> 3) + (x >> 4) - (x >> 7), // 0.180
  518|    394|    ChromaSampling::Cs444 => (x >> 4) + (x >> 5) + (x >> 8), // 0.098
  519|       |  };
  520|       |  // blog64(7) - blog64(4); blog64(5) - blog64(4)
  521|    612|  (0x19D_5D9F_D501_0B37 - y, 0xA4_D3C2_5E68_DC58 - y)
  522|    612|}
_RNvNtCsgLNdNkfkEgK_5rav1e4rate26iir_bessel2_get_parameters:
  140|    500|fn iir_bessel2_get_parameters(delay: i32) -> (i32, i32, i32) {
  141|    500|  // This borrows some code from an unreleased version of Postfish.
  142|    500|  // See the recipe at http://unicorn.us.com/alex/2polefilters.html for details
  143|    500|  //  on deriving the filter coefficients.
  144|    500|  // alpha is Q24
  145|    500|  let alpha = (1 << 24) / delay;
  146|    500|  // warp is 7.12 (5.12? the max value is 70386 in Q12).
  147|    500|  let warp = warp_alpha(alpha).max(1) as i64;
  148|    500|  // k1 is 9.12 (6.12?)
  149|    500|  let k1 = 3 * warp;
  150|    500|  // k2 is 16.24 (11.24?)
  151|    500|  let k2 = k1 * warp;
  152|    500|  // d is 16.15 (10.15?)
  153|    500|  let d = ((((1 << 12) + k1) << 12) + k2 + 256) >> 9;
  154|    500|  // a is 0.32, since d is larger than both 1.0 and k2
  155|    500|  let a = (k2 << 23) / d;
  156|    500|  // ik2 is 25.24
  157|    500|  let ik2 = (1i64 << 48) / k2;
  158|    500|  // b1 is Q56; in practice, the integer ranges between -2 and 2.
  159|    500|  let b1 = 2 * a * (ik2 - (1i64 << 24));
  160|    500|  // b2 is Q56; in practice, the integer ranges between -2 and 2.
  161|    500|  let b2 = (1i64 << 56) - ((4 * a) << 24) - b1;
  162|    500|  // All of the filter parameters are Q24.
  163|    500|  (
  164|    500|    ((b1 + (1i64 << 31)) >> 32) as i32,
  165|    500|    ((b2 + (1i64 << 31)) >> 32) as i32,
  166|    500|    ((a + 128) >> 8) as i32,
  167|    500|  )
  168|    500|}
_RNvMs3_NtCsgLNdNkfkEgK_5rav1e4rateNtB5_7RCState3new:
  597|    125|  pub fn new(
  598|    125|    frame_width: i32, frame_height: i32, framerate_num: i64,
  599|    125|    framerate_den: i64, target_bitrate: i32, maybe_ac_qi_max: Option<u8>,
  600|    125|    ac_qi_min: u8, max_key_frame_interval: i32,
  601|    125|    maybe_reservoir_frame_delay: Option<i32>,
  602|    125|  ) -> RCState {
  603|    125|    // The default buffer size is set equal to 1.5x the keyframe interval, or 240
  604|    125|    //  frames; whichever is smaller, with a minimum of 12.
  605|    125|    // For user set values, we enforce a minimum of 12.
  606|    125|    // The interval is short enough to allow reaction, but long enough to allow
  607|    125|    //  looking into the next GOP (avoiding the case where the last frames
  608|    125|    //  before an I-frame get starved), in most cases.
  609|    125|    // The 12 frame minimum gives us some chance to distribute bit estimation
  610|    125|    //  errors in the worst case.
  611|    125|    let reservoir_frame_delay = maybe_reservoir_frame_delay
  612|    125|      .unwrap_or_else(|| ((max_key_frame_interval * 3) >> 1).min(240))
  613|    125|      .max(12);
  614|    125|    // TODO: What are the limits on these?
  615|    125|    let npixels = (frame_width as i64) * (frame_height as i64);
  616|    125|    // Insane framerates or frame sizes mean insane bitrates.
  617|    125|    // Let's not get carried away.
  618|    125|    // We also subtract 16 bits from each temporal unit to account for the
  619|    125|    //  temporal delimiter, whose bits are not included in the frame sizes
  620|    125|    //  reported to update_state().
  621|    125|    // TODO: Support constraints imposed by levels.
  622|    125|    let bits_per_tu = clamp(
  623|    125|      (target_bitrate as i64) * framerate_den / framerate_num,
  624|    125|      40,
  625|    125|      0x4000_0000_0000,
  626|    125|    ) - (TEMPORAL_DELIMITER.len() * 8) as i64;
  627|    125|    let reservoir_max = bits_per_tu * (reservoir_frame_delay as i64);
  628|    125|    // Start with a buffer fullness and fullness target of 50%.
  629|    125|    let reservoir_target = (reservoir_max + 1) >> 1;
  630|    125|    // Pick exponents and initial scales for quantizer selection.
  631|    125|    let ibpp = npixels / bits_per_tu;
  632|       |    // These have been derived by encoding many clips at every quantizer
  633|       |    // and running a piecewise-linear regression in binary log space.
  634|    125|    let (i_exp, i_log_scale) = if ibpp < 1 {
  635|      0|      (48u8, blog64(36) - q57(QSCALE))
  636|    125|    } else if ibpp < 4 {
  637|      9|      (61u8, blog64(55) - q57(QSCALE))
  638|       |    } else {
  639|    116|      (77u8, blog64(129) - q57(QSCALE))
  640|       |    };
  641|    125|    let (p_exp, p_log_scale) = if ibpp < 2 {
  642|      1|      (69u8, blog64(32) - q57(QSCALE))
  643|    124|    } else if ibpp < 139 {
  644|    114|      (104u8, blog64(84) - q57(QSCALE))
  645|       |    } else {
  646|     10|      (83u8, blog64(19) - q57(QSCALE))
  647|       |    };
  648|    125|    let (b0_exp, b0_log_scale) = if ibpp < 2 {
  649|      1|      (84u8, blog64(30) - q57(QSCALE))
  650|    124|    } else if ibpp < 92 {
  651|    112|      (120u8, blog64(68) - q57(QSCALE))
  652|       |    } else {
  653|     12|      (68u8, blog64(4) - q57(QSCALE))
  654|       |    };
  655|    125|    let (b1_exp, b1_log_scale) = if ibpp < 2 {
  656|      1|      (87u8, blog64(27) - q57(QSCALE))
  657|    124|    } else if ibpp < 126 {
  658|    114|      (139u8, blog64(84) - q57(QSCALE))
  659|       |    } else {
  660|     10|      (61u8, blog64(1) - q57(QSCALE))
  661|       |    };
  662|       |
  663|       |    // TODO: Add support for "golden" P frames.
  664|    125|    RCState {
  665|    125|      target_bitrate,
  666|    125|      reservoir_frame_delay,
  667|    125|      reservoir_frame_delay_is_set: maybe_reservoir_frame_delay.is_some(),
  668|    125|      maybe_ac_qi_max,
  669|    125|      ac_qi_min,
  670|    125|      drop_frames: false,
  671|    125|      cap_overflow: true,
  672|    125|      cap_underflow: false,
  673|    125|      pass1_log_base_q: 0,
  674|    125|      twopass_state: PASS_SINGLE,
  675|    125|      log_npixels: blog64(npixels),
  676|    125|      bits_per_tu,
  677|    125|      reservoir_fullness: reservoir_target,
  678|    125|      reservoir_target,
  679|    125|      reservoir_max,
  680|    125|      log_scale: [i_log_scale, p_log_scale, b0_log_scale, b1_log_scale],
  681|    125|      exp: [i_exp, p_exp, b0_exp, b1_exp],
  682|    125|      scalefilter: [
  683|    125|        IIRBessel2::new(4, q57_to_q24(i_log_scale)),
  684|    125|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(p_log_scale)),
  685|    125|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b0_log_scale)),
  686|    125|        IIRBessel2::new(INTER_DELAY_TARGET_MIN, q57_to_q24(b1_log_scale)),
  687|    125|      ],
  688|    125|      // TODO VFR
  689|    125|      nframes: [0; FRAME_NSUBTYPES + 1],
  690|    125|      inter_delay: [INTER_DELAY_TARGET_MIN; FRAME_NSUBTYPES - 1],
  691|    125|      inter_delay_target: reservoir_frame_delay >> 1,
  692|    125|      rate_bias: 0,
  693|    125|      nencoded_frames: 0,
  694|    125|      nsef_frames: 0,
  695|    125|      pass1_buffer: [0; TWOPASS_HEADER_SZ],
  696|    125|      pass1_data_retrieved: true,
  697|    125|      pass1_summary_retrieved: false,
  698|    125|      pass2_data_ready: false,
  699|    125|      prev_metrics: RCFrameMetrics::new(),
  700|    125|      cur_metrics: RCFrameMetrics::new(),
  701|    125|      frame_metrics: Vec::new(),
  702|    125|      nframe_metrics: 0,
  703|    125|      frame_metrics_head: 0,
  704|    125|      ntus: 0,
  705|    125|      ntus_total: 0,
  706|    125|      ntus_left: 0,
  707|    125|      nframes_total: [0; FRAME_NSUBTYPES + 1],
  708|    125|      nframes_total_total: 0,
  709|    125|      nframes_left: [0; FRAME_NSUBTYPES + 1],
  710|    125|      scale_sum: [0; FRAME_NSUBTYPES],
  711|    125|      scale_window_ntus: 0,
  712|    125|      scale_window_nframes: [0; FRAME_NSUBTYPES + 1],
  713|    125|      scale_window_sum: [0; FRAME_NSUBTYPES],
  714|    125|      des: RCDeserialize::default(),
  715|    125|    }
  716|    125|  }
_RNvMs3_NtCsgLNdNkfkEgK_5rav1e4rateNtB5_7RCState18needs_trial_encode:
