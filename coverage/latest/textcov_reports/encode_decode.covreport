  242|  78.4M|  pub fn quantize<T: Coefficient>(
  243|  78.4M|    &self, coeffs: &[T], qcoeffs: &mut [T], tx_size: TxSize, tx_type: TxType,
  244|  78.4M|  ) -> usize {
  245|  78.4M|    let scan = av1_scan_orders[tx_size as usize][tx_type as usize].scan;
  246|  78.4M|
  247|  78.4M|    qcoeffs[0] = {
  248|  78.4M|      let coeff: i32 =
  249|  78.4M|        i32::cast_from(coeffs[0]) << (self.log_tx_scale as usize);
  250|  78.4M|      let abs_coeff = coeff.unsigned_abs();
  251|  78.4M|      T::cast_from(copysign(
  252|  78.4M|        divu_pair(abs_coeff + self.dc_offset, self.dc_mul_add),
  253|  78.4M|        coeff,
  254|  78.4M|      ))
  255|  78.4M|    };
  256|  78.4M|
  257|  78.4M|    // Find the last non-zero coefficient using our smaller biases and
  258|  78.4M|    // zero everything else.
  259|  78.4M|    // This threshold is such that `abs(coeff) < deadzone` implies:
  260|  78.4M|    // (abs(coeff << log_tx_scale) + ac_offset_eob) / ac_quant == 0
  261|  78.4M|    let deadzone = T::cast_from(
  262|  78.4M|      (self.ac_quant as usize - self.ac_offset_eob as usize)
  263|  78.4M|        .align_power_of_two_and_shift(self.log_tx_scale),
  264|  78.4M|    );
  265|  78.4M|    let eob = {
  266|  78.4M|      // We skip the DC coefficient since it has its own quantizer index.
  267|  78.4M|      let eob_minus_two =
  268|  78.4M|        scan[1..].iter().rposition(|&i| coeffs[i as usize].abs() >= deadzone);
  269|  78.4M|      eob_minus_two.map(|n| n + 2).unwrap_or_else(|| {
  270|       |        if qcoeffs[0] == T::cast_from(0) {
  271|       |          0
  272|       |        } else {
  273|       |          1
  274|       |        }
  275|  78.4M|      })
  276|  78.4M|    };
  277|  78.4M|
  278|  78.4M|    // Here we use different rounding biases depending on whether we've
  279|  78.4M|    // had recent coefficients that are larger than one, or less than
  280|  78.4M|    // one. The reason for this is that a block usually has a chunk of
  281|  78.4M|    // large coefficients and a tail of zeroes and ones, and the tradeoffs
  282|  78.4M|    // for coding these two are different. In the tail of zeroes and ones,
  283|  78.4M|    // you'll likely end up spending most bits just saying where that
  284|  78.4M|    // coefficient is in the block, whereas in the chunk of larger
  285|  78.4M|    // coefficients, most bits will be spent on coding its magnitude.
  286|  78.4M|    // To that end, we want to bias more toward rounding to zero for
  287|  78.4M|    // that tail of zeroes and ones than we do for the larger coefficients.
  288|  78.4M|    let mut level_mode = 1;
  289|  3.57G|    for &pos in scan.iter().take(eob).skip(1) {
  290|  3.57G|      let coeff = i32::cast_from(coeffs[pos as usize]) << self.log_tx_scale;
  291|  3.57G|      let abs_coeff = coeff.unsigned_abs();
  292|  3.57G|
  293|  3.57G|      let level0 = divu_pair(abs_coeff, self.ac_mul_add);
  294|  3.57G|      let offset = if level0 > 1 - level_mode {
  295|  1.48G|        self.ac_offset1
  296|       |      } else {
  297|  2.09G|        self.ac_offset0
  298|       |      };
  299|       |
  300|  3.57G|      let abs_qcoeff: u32 = divu_pair(abs_coeff + offset, self.ac_mul_add);
  301|  3.57G|      if level_mode != 0 && abs_qcoeff == 0 {
  302|   222M|        level_mode = 0;
  303|  3.35G|      } else if abs_qcoeff > 1 {
  304|  1.39G|        level_mode = 1;
  305|  1.95G|      }
  306|       |
  307|  3.57G|      qcoeffs[pos as usize] = T::cast_from(copysign(abs_qcoeff, coeff));
  308|       |    }
  309|       |
  310|       |    // Rather than zeroing the tail in scan order, assume that qcoeffs is
  311|       |    // pre-filled with zeros.
  312|       |
  313|       |    // Check the eob is correct
  314|       |    debug_assert_eq!(
  315|       |      eob,
  316|      0|      scan
  317|      0|        .iter()
  318|      0|        .rposition(|&i| qcoeffs[i as usize] != T::cast_from(0))
  319|      0|        .map(|n| n + 1)
  320|      0|        .unwrap_or(0)
  321|       |    );
  322|       |
  323|  78.4M|    eob
  324|  78.4M|  }

_RNvMs3_NtCs3tIhnEwGhQF_5rav1e4rateNtB5_7RCState19calc_flat_quantizer:
 1060|  1.26k|  fn calc_flat_quantizer(
 1061|  1.26k|    base_qi: u8, bit_depth: usize, fti: usize,
 1062|  1.26k|  ) -> (i64, i64) {
 1063|  1.26k|    // TODO: Rename "quantizer" something that indicates it is a quantizer
 1064|  1.26k|    //  index, and move it somewhere more sensible (or choose a better way to
 1065|  1.26k|    //  parameterize a "quality" configuration parameter).
 1066|  1.26k|
 1067|  1.26k|    // We use the AC quantizer as the source quantizer since its quantizer
 1068|  1.26k|    //  tables have unique entries, while the DC tables do not.
 1069|  1.26k|    let ac_quantizer = ac_q(base_qi as u8, 0, bit_depth) as i64;
 1070|  1.26k|    // Pick the nearest DC entry since an exact match may be unavailable.
 1071|  1.26k|    let dc_qi = select_dc_qi(ac_quantizer, bit_depth);
 1072|  1.26k|    let dc_quantizer = dc_q(dc_qi as u8, 0, bit_depth) as i64;
 1073|  1.26k|    // Get the log quantizers as Q57.
 1074|  1.26k|    let log_ac_q = blog64(ac_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1075|  1.26k|    let log_dc_q = blog64(dc_quantizer) - q57(QSCALE + bit_depth as i32 - 8);
 1076|  1.26k|    // Target the midpoint of the chosen entries.
 1077|  1.26k|    let log_base_q = (log_ac_q + log_dc_q + 1) >> 1;
 1078|  1.26k|    // Adjust the quantizer for the frame type, result is Q57:
 1079|  1.26k|    let log_q = ((log_base_q + (1i64 << 11)) >> 12) * (MQP_Q12[fti] as i64)
 1080|  1.26k|      + DQP_Q57[fti];
 1081|  1.26k|    (log_base_q, log_q)
 1082|  1.26k|  }
