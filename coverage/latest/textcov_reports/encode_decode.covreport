   29|  5.61G|unsafe fn update_cdf_4_sse2(cdf: &mut [u16], val: u32) {
   30|  5.61G|  let nsymbs = 4;
   31|  5.61G|  let rate = 5 + (cdf[nsymbs - 1] >> 4) as usize;
   32|  5.61G|  let count = cdf[nsymbs - 1] + (cdf[nsymbs - 1] < 32) as u16;
   33|  5.61G|
   34|  5.61G|  // A bit of explanation of what is happening down here. First of all, let's look at the simple
   35|  5.61G|  // implementation:
   36|  5.61G|  //
   37|  5.61G|  // ```
   38|  5.61G|  // if i as u32 >= val {
   39|  5.61G|  //   *v -= *v >> rate;
   40|  5.61G|  // } else {
   41|  5.61G|  //   *v += (32768 - *v) >> rate;
   42|  5.61G|  // }
   43|  5.61G|  // ```
   44|  5.61G|  //
   45|  5.61G|  // We want to perform the same arithmetic operation in the two branches, therefore we can
   46|  5.61G|  // transform in something like:
   47|  5.61G|  //
   48|  5.61G|  // ```
   49|  5.61G|  // if i as u32 >= val {
   50|  5.61G|  //   *v -= *v >> rate;
   51|  5.61G|  // } else {
   52|  5.61G|  //   *v -= -((32768 - *v) >> rate);
   53|  5.61G|  // }
   54|  5.61G|  // ```
   55|  5.61G|  //
   56|  5.61G|  // It is possible to bring the "minus" for the second branch logically before the right shift
   57|  5.61G|  // using the following rule:
   58|  5.61G|  // -(x >> y) = (-1 - x) >> y + 1
   59|  5.61G|  // So we obtain
   60|  5.61G|  //
   61|  5.61G|  // ```
   62|  5.61G|  // if i as u32 >= val {
   63|  5.61G|  //   *v -= *v >> rate;
   64|  5.61G|  // } else {
   65|  5.61G|  //   *v -= (-1 - (32768 - *v)) >> rate + 1;
   66|  5.61G|  // }
   67|  5.61G|  // ```
   68|  5.61G|  //
   69|  5.61G|  // Good. A range `0..4` can be compared against `val` in order to have a starting point to work
   70|  5.61G|  // in different ways on the two branches. `cmplt` returns `-1` if `lhs < rhs`, 0 otherwise.
   71|  5.61G|  // It is possible to use the `avg` SIMD operator, which performs `(lhs + rhs + 1) >> 1`. This is
   72|  5.61G|  // useful because `avg` treats numbers as unsigned, `-1 = 0xFFFF`, therefore `(0xFFFF + 0 + 1) >>
   73|  5.61G|  // 1 = 0x8000 = 32768`. Obviously `(0 + 0 + 1) >> 1 = 0`.
   74|  5.61G|  //
   75|  5.61G|  // Now the result of `cmplt` can be used along with the result from `avg` and the data in `cdf`
   76|  5.61G|  // in order to obtain the right hand side of the subtraction from `cdf`.
   77|  5.61G|
   78|  5.61G|  let val_splat = _mm_set1_epi16(val as i16);
   79|  5.61G|  let indices = _mm_set_epi16(0, 0, 0, 0, 3, 2, 1, 0);
   80|  5.61G|  let index_lt_val = _mm_cmplt_epi16(indices, val_splat);
   81|  5.61G|  let k = _mm_avg_epu16(index_lt_val, _mm_setzero_si128());
   82|  5.61G|  let cdf_simd = _mm_loadl_epi64(cdf.as_mut_ptr() as *const __m128i);
   83|  5.61G|  let k_minus_v = _mm_sub_epi16(k, cdf_simd);
   84|  5.61G|  let negated_if_lt_val = _mm_sub_epi16(index_lt_val, k_minus_v);
   85|  5.61G|  let shifted =
   86|  5.61G|    _mm_sra_epi16(negated_if_lt_val, _mm_set_epi32(0, 0, 0, rate as i32));
   87|  5.61G|  let fixed_if_lt_val = _mm_sub_epi16(shifted, index_lt_val);
   88|  5.61G|  let result = _mm_sub_epi16(cdf_simd, fixed_if_lt_val);
   89|  5.61G|
   90|  5.61G|  _mm_storel_epi64(cdf.as_mut_ptr() as *mut __m128i, result);
   91|  5.61G|  cdf[nsymbs - 1] = count;
   92|  5.61G|}
