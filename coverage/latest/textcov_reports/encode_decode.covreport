  951|   446k|fn fullpel_diamond_search<T: Pixel>(
  952|   446k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
  953|   446k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
  954|   446k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
  955|   446k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
  956|   446k|) {
  957|   446k|  // Define the initial and the final scale (log2) of the diamond.
  958|   446k|  let (mut diamond_radius_log2, diamond_radius_end_log2) = (1u8, 0u8);
  959|       |
  960|  1.21M|  loop {
  961|  1.21M|    // Find the best candidate from the diamond pattern.
