_RNvNtCsixsdkNzQ5tW_5rav1e2me12get_mv_range:
  338|   149k|fn get_mv_range(
  339|   149k|  w_in_b: usize, h_in_b: usize, bo: PlaneBlockOffset, blk_w: usize,
  340|   149k|  blk_h: usize,
  341|   149k|) -> (isize, isize, isize, isize) {
  342|   149k|  let border_w = 128 + blk_w as isize * 8;
  343|   149k|  let border_h = 128 + blk_h as isize * 8;
  344|   149k|  let mvx_min = -(bo.0.x as isize) * (8 * MI_SIZE) as isize - border_w;
  345|   149k|  let mvx_max = ((w_in_b - bo.0.x) as isize - (blk_w / MI_SIZE) as isize)
  346|   149k|    * (8 * MI_SIZE) as isize
  347|   149k|    + border_w;
  348|   149k|  let mvy_min = -(bo.0.y as isize) * (8 * MI_SIZE) as isize - border_h;
  349|   149k|  let mvy_max = ((h_in_b - bo.0.y) as isize - (blk_h / MI_SIZE) as isize)
  350|   149k|    * (8 * MI_SIZE) as isize
  351|   149k|    + border_h;
  352|   149k|
  353|   149k|  // <https://aomediacodec.github.io/av1-spec/#assign-mv-semantics>
  354|   149k|  use crate::context::{MV_LOW, MV_UPP};
  355|   149k|  (
  356|   149k|    mvx_min.max(MV_LOW as isize + 1),
  357|   149k|    mvx_max.min(MV_UPP as isize - 1),
  358|   149k|    mvy_min.max(MV_LOW as isize + 1),
  359|   149k|    mvy_max.min(MV_UPP as isize - 1),
  360|   149k|  )
  361|   149k|}
