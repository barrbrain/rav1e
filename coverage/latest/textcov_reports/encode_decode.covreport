  230|  68.6M|  $($s)* fn kernel(p0: T, p1: T, m: ((i32, i32), (i32, i32), (i32, i32))) -> (T, T) {
  231|  68.6M|    Self::half_kernel((p0, p0), p1, m)
  232|  68.6M|  }
