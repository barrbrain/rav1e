  521|    102|pub fn setup_integral_image<T: Pixel>(
  522|    102|  integral_image_buffer: &mut IntegralImageBuffer,
  523|    102|  integral_image_stride: usize, crop_w: usize, crop_h: usize, stripe_w: usize,
  524|    102|  stripe_h: usize, cdeffed: &PlaneSlice<T>, deblocked: &PlaneSlice<T>,
  525|    102|) {
