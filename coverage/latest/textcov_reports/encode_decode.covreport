_RNvNtCsgzd1EjkjF4V_5rav1e7deblock16filter_narrow2_4B3_:
  160|  68.7k|fn filter_narrow2_4(
  161|  68.7k|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  162|  68.7k|) -> [i32; 4] {
  163|  68.7k|  let filter0 = clamp(p1 - q1, -128 << shift, (128 << shift) - 1);
  164|  68.7k|  let filter1 =
  165|  68.7k|    clamp(filter0 + 3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  166|       |  // be certain our optimization removing a clamp is sound
  167|       |  debug_assert!({
  168|      0|    let base =
  169|      0|      clamp(filter0 + 3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  170|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  171|      0|    filter1 == test
  172|       |  });
  173|  68.7k|  let filter2 =
  174|  68.7k|    clamp(filter0 + 3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  175|       |  // be certain our optimization removing a clamp is sound
  176|       |  debug_assert!({
  177|      0|    let base =
  178|      0|      clamp(filter0 + 3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  179|      0|    let test = clamp(base + 3, -128 << shift, (128 << shift) - 1) >> 3;
  180|      0|    filter2 == test
  181|       |  });
  182|  68.7k|  [
  183|  68.7k|    p1,
  184|  68.7k|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  185|  68.7k|    clamp(q0 - filter1, 0, (256 << shift) - 1),
  186|  68.7k|    q1,
  187|  68.7k|  ]
  188|  68.7k|}
