_RNvMsj_NtNtCsgzd1EjkjF4V_5rav1e6tiling22tile_restoration_stateNtB5_23TileRestorationStateMut16get_units_region:
  362|    240|      fn get_units_region(
  363|    240|        rs: &RestorationState,
  364|    240|        sbo: PlaneSuperBlockOffset,
  365|    240|        sb_width: usize,
  366|    240|        sb_height: usize,
  367|    240|        pli: usize,
  368|    240|      ) -> (usize, usize, usize, usize) {
  369|    240|        let sb_h_shift = rs.planes[pli].cfg.sb_h_shift;
  370|    240|        let sb_v_shift = rs.planes[pli].cfg.sb_v_shift;
  371|       |        // there may be several super-blocks per restoration unit
  372|       |        // the given super-block offset must match the start of a restoration unit
  373|      0|        debug_assert!(sbo.0.x % (1 << sb_h_shift) == 0);
  374|      0|        debug_assert!(sbo.0.y % (1 << sb_v_shift) == 0);
  375|       |
  376|    240|        let units_x = sbo.0.x >> sb_h_shift;
  377|    240|        let units_y = sbo.0.y >> sb_v_shift;
  378|    240|        let units_cols = sb_width + (1 << sb_h_shift) - 1 >> sb_h_shift;
  379|    240|        let units_rows = sb_height + (1 << sb_v_shift) - 1 >> sb_v_shift;
  380|    240|
  381|    240|        let FrameRestorationUnits { cols: rs_cols, rows: rs_rows, .. } = rs.planes[pli].units;
  382|       |        // +1 because the last super-block may use the "stretched" restoration unit
  383|       |        // from its neighbours
  384|       |        // <https://github.com/xiph/rav1e/issues/631#issuecomment-454419152>
  385|      0|        debug_assert!(units_x < rs_cols + 1);
  386|      0|        debug_assert!(units_y < rs_rows + 1);
  387|      0|        debug_assert!(units_x + units_cols <= rs_cols + 1);
  388|      0|        debug_assert!(units_y + units_rows <= rs_rows + 1);
  389|       |
  390|    240|        let units_x = units_x.min(rs_cols);
  391|    240|        let units_y = units_y.min(rs_rows);
  392|    240|        let units_cols = units_cols.min(rs_cols - units_x);
  393|    240|        let units_rows = units_rows.min(rs_rows - units_y);
  394|    240|        (units_x, units_y, units_cols, units_rows)
  395|    240|      }
