   54|   623k|    //  get as large as 2.0); we could get another bit if we dropped the sign,
   55|   623k|    //  but we'll recover that bit later anyway.
   56|   623k|    // Ideally this should start out as
   57|   623k|    //   \lim_{n->\infty} 2^{61}/\product_{i=1}^n \sqrt{1-2^{-2i}}
   58|   623k|    //  but in order to guarantee convergence we have to repeat iterations 4,
   59|   623k|    //  13 (=3*4+1), and 40 (=3*13+1, etc.), so it winds up somewhat larger.
   60|   623k|    w = 0x26A3D0E401DD846D;
