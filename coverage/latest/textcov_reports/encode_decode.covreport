  199|   149M|    _mm256_set1_epi32(bdm8 as i32),
  200|   149M|  );
  201|   149M|  let scaled_ssq = _mm256_srlv_epi32(
  202|   149M|    _mm256_add_epi32(ssq, _mm256_set1_epi32(1 << (2 * bdm8) as i32 >> 1)),
  203|   149M|    _mm256_set1_epi32(2 * bdm8 as i32),
