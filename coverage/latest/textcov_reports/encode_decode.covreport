  676|  11.6M|  //   1189/2048 = Sin[11*Pi/32] - Cos[11*Pi/32])*Sqrt[2] = 0.580569354508925
  677|  11.6M|  //   5461/8192 = Cos[11*Pi/32]*Sqrt[2]                  = 0.666655658477747
  678|  11.6M|  let (r2, r5) =
  679|  11.6M|    RotateAdd::half_kernel(r2, r5h, ((15679, 14), (1189, 11), (5461, 13)));
  680|  11.6M|  // 16305/16384 = (Sin[9*Pi/32] + Cos[9*Pi/32])/Sqrt[2] = 0.9951847266721969
  681|  11.6M|  //    803/4096 = (Sin[9*Pi/32] - Cos[9*Pi/32])*Sqrt[2] = 0.1960342806591213
  682|  11.6M|  // 14699/16384 = Cos[9*Pi/32]*Sqrt[2]                  = 0.8971675863426364
  683|  11.6M|  let (r4, r3) =
  684|  11.6M|    RotateSub::half_kernel(r4, r3h, ((16305, 14), (803, 12), (14699, 14)));
