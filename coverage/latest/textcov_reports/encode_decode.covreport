  413|  75.3M|        let input = array_ref!(col_coeffs, 0, 4);
  414|  75.3M|        transpose_4x4_avx2(input, buf);
  415|  75.3M|      }
  416|       |    }
  417|       |  }
  418|       |
  419|       |  // Rows
  420|   168M|  for rg in (0..txfm_size_row).step_by(8) {
  421|   168M|    let row_coeffs = &mut buf[rg / 8 * txfm_size_col..][..txfm_size_col];
  422|   168M|
  423|   168M|    if cfg.lr_flip {
  424|      0|      row_coeffs.reverse();
  425|   168M|    }
  426|       |
  427|   168M|    txfm_func_row(row_coeffs);
  428|   168M|    round_shift_array_avx2(row_coeffs, -cfg.shift[2]);
  429|   168M|
  430|   168M|    // Write out the coefficients using the correct method for transforms of
  431|   168M|    // this size.
  432|   168M|    match row_class {
  433|       |      SizeClass1D::X8UP => {
  434|       |        // Store output in at most 32x32 chunks. See rust code for details.
  435|       |
  436|       |        // Output is grouped into 32x32 chunks so a stride of at most 32 is
  437|       |        // used for each chunk
  438|  74.5M|        let output_stride = txfm_size_row.min(32);
  439|  74.5M|
  440|  74.5M|        // Split the first 32 rows from the last 32 rows and offset by rg % 32
  441|  74.5M|        let output = &mut output[(rg & 31)
  442|  74.5M|          + (rg >= 32) as usize * output_stride * txfm_size_col.min(32)..];
  443|       |
  444|  75.5M|        for cg in (0..txfm_size_col).step_by(32) {
  445|       |          // Offset by zero or half of output
  446|  75.5M|          let output = &mut output[txfm_size_row * cg..];
  447|       |
  448|   923M|          for c in 0..txfm_size_col.min(32) {
  449|   923M|            match T::Pixel::type_enum() {
  450|   923M|              PixelType::U8 => {
  451|   923M|                let vec = row_coeffs[c + cg].vec();
  452|   923M|                let lo = _mm256_castsi256_si128(vec);
  453|   923M|                let hi = _mm256_extracti128_si256(vec, 1);
  454|   923M|                _mm_storeu_si128(
  455|   923M|                  output[c * output_stride..].as_mut_ptr() as *mut _,
  456|   923M|                  _mm_packs_epi32(lo, hi),
  457|   923M|                );
  458|   923M|              }
  459|      0|              PixelType::U16 => {
  460|      0|                _mm256_storeu_si256(
  461|      0|                  output[c * output_stride..].as_mut_ptr() as *mut _,
  462|      0|                  row_coeffs[c + cg].vec(),
  463|      0|                );
  464|      0|              }
  465|       |            }
  466|       |          }
  467|       |        }
  468|       |      }
  469|       |      SizeClass1D::X4 => {
  470|       |        // Write out coefficients in normal order - it isn't possible to have
  471|       |        // more than 32 rows.
  472|   448M|        for c in 0..txfm_size_col {
  473|   448M|          match T::Pixel::type_enum() {
  474|   448M|            PixelType::U8 => {
  475|   448M|              let lo = _mm256_castsi256_si128(row_coeffs[c].vec());
  476|   448M|              _mm_storel_epi64(
  477|   448M|                output[c * txfm_size_row + rg..].as_mut_ptr() as *mut _,
  478|   448M|                _mm_packs_epi32(lo, lo),
  479|   448M|              );
  480|   448M|            }
  481|      0|            PixelType::U16 => {
  482|      0|              _mm256_storeu_si256(
  483|      0|                output[c * txfm_size_row + rg..].as_mut_ptr() as *mut _,
  484|      0|                row_coeffs[c].vec(),
  485|      0|              );
  486|      0|            }
  487|       |          }
  488|       |        }
  489|       |      }
  490|       |    }
  491|       |  }
  492|   150M|}
