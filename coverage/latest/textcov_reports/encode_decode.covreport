  219|  27.5k|fn estimate_sb_motion<T: Pixel>(
  220|  27.5k|  fi: &FrameInvariants<T>, ts: &mut TileStateMut<'_, T>, ref_frame: RefType,
  221|  27.5k|  mv_size_in_b_log2: usize, tile_bo: TileBlockOffset, init: bool, ssdec: u8,
  222|  27.5k|  lambda: u32,
