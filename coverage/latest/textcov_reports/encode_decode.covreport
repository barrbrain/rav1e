  582|  18.5M|  let (r1, r6) = RotatePi4SubAvg::kernel(r1, r6, ((11585, 13), (11585, 13)));
  583|  18.5M|
  584|  18.5M|  store_coeffs!(output, r0, r1, r2, r3, r4, r5, r6, r7);
