_RNvMNtCsgLNdNkfkEgK_5rav1e4rateNtB2_10IIRBessel26update:
  190|      7|  pub fn update(&mut self, x: i32) -> i32 {
  191|      7|    let c0 = self.c[0] as i64;
  192|      7|    let c1 = self.c[1] as i64;
  193|      7|    let g = self.g as i64;
  194|      7|    let x0 = self.x[0] as i64;
  195|      7|    let x1 = self.x[1] as i64;
  196|      7|    let y0 = self.y[0] as i64;
  197|      7|    let y1 = self.y[1] as i64;
  198|      7|    let ya =
  199|      7|      ((((x as i64) + x0 * 2 + x1) * g + y0 * c0 + y1 * c1 + (1i64 << 23))
  200|      7|        >> 24) as i32;
  201|      7|    self.x[1] = self.x[0];
  202|      7|    self.x[0] = x;
  203|      7|    self.y[1] = self.y[0];
  204|      7|    self.y[0] = ya;
  205|      7|    ya
  206|      7|  }
_RNvXs0_NtCsgLNdNkfkEgK_5rav1e4rateNtB5_13RCDeserializeNtNtCsgzatMpfs9d8_4core7default7Default7default:
