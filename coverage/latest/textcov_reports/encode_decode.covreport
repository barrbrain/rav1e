  211|  1.70M|fn filter_narrow4_4(
  212|  1.70M|  p1: i32, p0: i32, q0: i32, q1: i32, shift: usize,
  213|  1.70M|) -> [i32; 4] {
  214|  1.70M|  let filter1 =
  215|  1.70M|    clamp(3 * (q0 - p0) + 4, -128 << shift, (128 << shift) - 1) >> 3;
  216|       |  // be certain our optimization removing a clamp is sound
  217|       |  debug_assert!({
  218|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  219|      0|    let test = clamp(base + 4, -128 << shift, (128 << shift) - 1) >> 3;
  220|      0|    filter1 == test
  221|       |  });
  222|  1.70M|  let filter2 =
  223|  1.70M|    clamp(3 * (q0 - p0) + 3, -128 << shift, (128 << shift) - 1) >> 3;
  224|       |  // be certain our optimization removing a clamp is sound
  225|       |  debug_assert!({
  226|      0|    let base = clamp(3 * (q0 - p0), -128 << shift, (128 << shift) - 1);
  227|      0|    let test = clamp(base + 3, -128 << shift, (128 << shift) - 1) >> 3;
  228|      0|    filter2 == test
  229|       |  });
  230|  1.70M|  let filter3 = (filter1 + 1) >> 1;
  231|  1.70M|  [
  232|  1.70M|    clamp(p1 + filter3, 0, (256 << shift) - 1),
  233|  1.70M|    clamp(p0 + filter2, 0, (256 << shift) - 1),
  234|  1.70M|    clamp(q0 - filter1, 0, (256 << shift) - 1),
  235|  1.70M|    clamp(q1 - filter3, 0, (256 << shift) - 1),
  236|  1.70M|  ]
  237|  1.70M|}
