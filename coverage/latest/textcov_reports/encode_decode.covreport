 1050|  2.91k|fn hexagon_search<T: Pixel>(
 1051|  2.91k|  fi: &FrameInvariants<T>, po: PlaneOffset, org_region: &PlaneRegion<T>,
 1052|  2.91k|  p_ref: &Plane<T>, current: &mut MotionSearchResult, bit_depth: usize,
 1053|  2.91k|  pmv: [MotionVector; 2], lambda: u32, mvx_min: isize, mvx_max: isize,
 1054|  2.91k|  mvy_min: isize, mvy_max: isize, w: usize, h: usize,
 1055|  2.91k|) {
 1056|  2.91k|  // The first iteration of hexagon search is implemented separate from
 1057|  2.91k|  // subsequent iterations, which overlap with previous iterations.
 1058|  2.91k|
 1059|  2.91k|  // Holds what candidate is used (if any). This is used to determine which
 1060|  2.91k|  // candidates have already been tested in a previous iteration and can be
 1061|  2.91k|  // skipped.
 1062|  2.91k|  let mut best_cand_idx: usize = 0;
 1063|  2.91k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1064|       |
 1065|       |  // First iteration of hexagon search. There are six candidates to consider.
 1066|  20.3k|  for i in 0..6 {
 1067|  17.4k|    let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1068|  17.4k|    let rd = get_fullpel_mv_rd(
 1069|  17.4k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1070|  17.4k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1071|  17.4k|    );
 1072|  17.4k|
 1073|  17.4k|    if rd.cost < best_cand.rd.cost {
 1074|  6.00k|      best_cand_idx = i;
 1075|  6.00k|      best_cand.mv = cand_mv;
 1076|  6.00k|      best_cand.rd = rd;
 1077|  11.4k|    }
 1078|       |  }
 1079|       |
 1080|       |  // Run additional iterations of hexagon search until the search location
 1081|       |  // doesn't update.
 1082|  3.68k|  while best_cand.rd.cost < current.rd.cost {
 1083|       |    // Update the search location.
 1084|    772|    *current = best_cand;
 1085|    772|    best_cand = MotionSearchResult::empty();
 1086|    772|
 1087|    772|    // Save the index/direction taken in the previous iteration to the current
 1088|    772|    // search location.
 1089|    772|    let center_cand_idx = best_cand_idx;
 1090|       |
 1091|       |    // Look only at candidates that don't overlap with previous iterations. This
 1092|       |    // corresponds with the three offsets (2D) with the closest direction to
 1093|       |    // that traveled by the previous iteration. HEXAGON_PATTERN has clockwise
 1094|       |    // order, so the last direction -1, +0, and +1 (mod 6) give the indices for
 1095|       |    // these offsets.
 1096|  3.08k|    for idx_offset_mod6 in 5..=7 {
 1097|  2.31k|      let i = (center_cand_idx + idx_offset_mod6) % 6;
 1098|  2.31k|      let cand_mv = current.mv + HEXAGON_PATTERN[i];
 1099|  2.31k|
 1100|  2.31k|      let rd = get_fullpel_mv_rd(
 1101|  2.31k|        fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1102|  2.31k|        mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1103|  2.31k|      );
 1104|  2.31k|
 1105|  2.31k|      if rd.cost < best_cand.rd.cost {
 1106|  1.38k|        best_cand_idx = i;
 1107|  1.38k|        best_cand.mv = cand_mv;
 1108|  1.38k|        best_cand.rd = rd;
 1109|  1.38k|      }
 1110|       |    }
 1111|       |  }
 1112|       |
 1113|       |  // Refine the motion after completing hexagon search.
 1114|  2.91k|  let mut best_cand: MotionSearchResult = MotionSearchResult::empty();
 1115|  26.2k|  for &offset in &SQUARE_REFINE_PATTERN {
 1116|  23.3k|    let cand_mv = current.mv + offset;
 1117|  23.3k|    let rd = get_fullpel_mv_rd(
 1118|  23.3k|      fi, po, org_region, p_ref, bit_depth, pmv, lambda, false, mvx_min,
 1119|  23.3k|      mvx_max, mvy_min, mvy_max, w, h, cand_mv,
 1120|  23.3k|    );
 1121|  23.3k|
 1122|  23.3k|    if rd.cost < best_cand.rd.cost {
 1123|  7.73k|      best_cand.mv = cand_mv;
 1124|  7.73k|      best_cand.rd = rd;
 1125|  15.5k|    }
 1126|       |  }
 1127|  2.91k|  if best_cand.rd.cost < current.rd.cost {
 1128|    316|    *current = best_cand;
 1129|  2.59k|  }
 1130|       |
 1131|  2.91k|  assert!(!current.is_empty());
 1132|  2.91k|}
