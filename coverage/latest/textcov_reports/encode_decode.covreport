_RNvMNtCsixsdkNzQ5tW_5rav1e4rateNtB2_10IIRBessel26update:
  190|     38|  pub fn update(&mut self, x: i32) -> i32 {
  191|     38|    let c0 = self.c[0] as i64;
  192|     38|    let c1 = self.c[1] as i64;
  193|     38|    let g = self.g as i64;
  194|     38|    let x0 = self.x[0] as i64;
  195|     38|    let x1 = self.x[1] as i64;
  196|     38|    let y0 = self.y[0] as i64;
  197|     38|    let y1 = self.y[1] as i64;
  198|     38|    let ya =
  199|     38|      ((((x as i64) + x0 * 2 + x1) * g + y0 * c0 + y1 * c1 + (1i64 << 23))
  200|     38|        >> 24) as i32;
  201|     38|    self.x[1] = self.x[0];
  202|     38|    self.x[0] = x;
  203|     38|    self.y[1] = self.y[0];
  204|     38|    self.y[0] = ya;
  205|     38|    ya
  206|     38|  }
