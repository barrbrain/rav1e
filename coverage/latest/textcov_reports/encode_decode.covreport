  366|   133M|$($s)* fn daala_fdct_ii_4<T: TxOperations>(
  367|   133M|  q0: T, q1: T, q2: T, q3: T, output: &mut [T],
  368|   133M|) {
  369|   133M|  // +/- Butterflies with asymmetric output.
  370|   133M|  let (q0h, q3) = butterfly_neg(q0, q3);
  371|   133M|  let (q1, q2h) = butterfly_add(q1, q2);
  372|   133M|
